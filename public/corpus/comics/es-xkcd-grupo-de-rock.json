  "cards": [
    {
      "id": "word-sabéis--you-know-discourse",
      "kind": "word",
      "promptEs": "sabéis",
      "answerEn": "you know? (addressing several people informally, mainly in Spain)",
      "noteEn": "Sabéis is the present form of saber used with vosotros or vosotras, the informal plural ‘you’ used mainly in Spain. As a brief question, ¿sabéis? can introduce a remark much like English ‘you know?’ or ‘you know what?’",
      "example": {
        "es": "¿Sabéis? Tengo una idea.",
        "en": "You know what? I have an idea."
      },
      "tags": [
        "word",
        "saber",
        "discourse",
        "vosotros",
        "Spain",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-grupo-de-rock",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-vosotros-informal-plural",
      "kind": "grammar",
      "promptEs": "vosotros/as: vuestro, podéis, habéis…",
      "questionEn": "How does Spanish in Spain address several people informally?",
      "answerEn": "Use vosotros or vosotras forms, such as vuestro for “your” and podéis for “you all can.”",
      "noteEn": "Vosotros addresses a mixed or all-male group; vosotras addresses an all-female group. These forms are common in Spain. Most of Latin America uses ustedes instead, with different verb and possessive forms.",
      "example": {
        "es": "Vosotras podéis traer vuestros libros.",
        "en": "You all can bring your books."
      },
      "tags": [
        "grammar",
        "Spain",
        "plural you",
        "A2"
