    {
      "id": "word-me--pronominal-marker",
      "kind": "word",
      "promptEs": "me",
      "answerEn": "no separate English word here; marks an “I” verb that is used with me",
      "noteEn": "Some Spanish verbs conventionally come with me, te, se, nos, or os even when no one literally acts on themselves. Me marks the speaker's form. English usually absorbs it into the verb's meaning.",
      "example": {
        "es": "Me quejo del ruido.",
        "en": "I complain about the noise."
      },
      "tags": [
        "word",
        "pronouns",
        "pronominal verbs",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-alucinaciones",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "phrase-acostumbrarse-a",
      "kind": "phrase",
      "promptEs": "acostumbrarse a + nombre o verbo en forma de diccionario",
      "questionEn": "How do you say that someone gets used to a thing or activity?",
      "answerEn": "Use a matching form of me, te, se, nos, or os with acostumbrar, then a, then the thing or activity that becomes familiar.",
      "noteEn": "The small pronoun matches the person: me acostumbro, te acostumbras, se acostumbra, nos acostumbramos, or se acostumbran. Acostumbrar changes for the person and time. If an activity follows a, its verb stays in the dictionary form ending in -ar, -er, or -ir. The plus sign in the prompt means ‘followed by.’",
      "example": {
        "es": "Nos acostumbramos al ruido.",
        "en": "We got used to the noise."
      },
      "tags": [
        "phrase",
        "acostumbrarse",
        "verb complement",
        "infinitive",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-pesadillas",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-acostumbré--got-used",
      "kind": "word",
      "promptEs": "acostumbré",
      "answerEn": "I got used to",
      "noteEn": "Acostumbré is a completed-past form used by the speaker. With me before it and a after it, acostumbrarse a means to become familiar or comfortable with something through repeated experience.",
      "example": {
        "es": "Me acostumbré al ruido.",
        "en": "I got used to the noise."
      },
      "tags": [
        "word",
        "acostumbrarse",
        "preterite",
        "first person",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
