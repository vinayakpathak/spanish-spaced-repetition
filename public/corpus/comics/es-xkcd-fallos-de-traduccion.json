    {
      "id": "word-de--after-quantity",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "of; or no separate English word, linking an amount to what it measures",
      "noteEn": "After a quantity expression, de introduces the substance or thing being measured. English uses “of” in expressions such as a lot of or the amount of, but may leave de untranslated in others, such as un poco de agua, “a little water.”",
      "example": {
        "es": "Quiero un poco de agua.",
        "en": "I want a little water."
      },
      "tags": [
        "word",
        "quantity",
        "partitive",
        "preposition"
      ],
      "reviewStatus": "ai-authored-internal-qa",
