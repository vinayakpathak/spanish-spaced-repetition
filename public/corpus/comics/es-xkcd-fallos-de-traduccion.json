    {
      "id": "word-par--couple",
      "kind": "word",
      "promptEs": "par",
      "answerEn": "couple; pair",
      "noteEn": "Un par de before a plural noun commonly means “a couple of,” often an approximate small quantity rather than an exact matched pair.",
