    {
      "id": "word-de--type-classifier",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; links an item to its type",
      "noteEn": "Spanish often uses de between an item and the noun that identifies its type. English often puts the type noun first instead: libro de historia becomes “history book.”",
      "example": {
        "es": "Compré un libro de historia.",
        "en": "I bought a history book."
      },
