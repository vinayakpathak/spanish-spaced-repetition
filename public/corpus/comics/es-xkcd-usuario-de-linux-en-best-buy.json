    {
      "id": "grammar-estar-interesado-en",
      "kind": "grammar",
      "promptEs": "estar interesado o interesada en una actividad",
      "questionEn": "How do you say that someone is interested in doing something?",
      "answerEn": "Use a form of estar, then interesado or interesada, then en, then the action verb in its unchanged dictionary form.",
      "noteEn": "Change estar for the person and time. Change interesado to match the person or group: interesado, interesada, interesados, or interesadas. En introduces the activity, and that activity stays in the dictionary form ending in -ar, -er, or -ir; English often uses an -ing form instead.",
      "example": {
        "es": "Ana está interesada en aprender italiano.",
        "en": "Ana is interested in learning Italian."
      },
      "tags": [
        "grammar",
        "interest",
        "prepositions",
        "infinitives",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-usuario-de-linux-en-best-buy",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-formal-address",
      "kind": "grammar",
      "promptEs": "usted + verbo en tercera persona",
      "answerEn": "Use the same singular verb form used with él or ella (“he” or “she”).",
      "noteEn": "Although usted refers to the listener, Spanish treats it like “he” or “she” when choosing the verb. Compare tú necesitas for informal “you need” with usted necesita for formal “you need.” Spanish often leaves usted unspoken when the context makes it clear.",
      "tags": [
        "A2",
        "grammar",
        "register",
        "formal"
      ],
      "questionEn": "When usted means polite or formal “you,” which verb form goes with it?",
      "example": {
        "es": "¿Necesita ayuda?",
        "en": "Do you need help? (formal)"
      },
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
