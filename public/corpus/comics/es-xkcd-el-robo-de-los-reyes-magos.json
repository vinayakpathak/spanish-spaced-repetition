  "cards": [
    {
      "id": "word-mira--attention-getter",
      "kind": "word",
      "promptEs": "mira",
      "answerEn": "look; listen; hey (to get someone's attention)",
      "noteEn": "Mira is the positive command form of mirar used with one familiar person. At the start of a comment, it often simply gets the listener's attention, like “look,” “listen,” or “hey,” without asking them to look at an object.",
      "example": {
        "es": "Mira, tengo una idea.",
        "en": "Listen, I have an idea."
      },
      "tags": [
        "word",
        "attention getter",
        "command",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-el-robo-de-los-reyes-magos",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-affirmative-tu-command",
      "kind": "grammar",
      "promptEs": "orden afirmativa para tú: habla, come, escribe",
      "questionEn": "How do you give one friend or familiar person a positive command?",
      "answerEn": "Use the informal singular command form, often the same form used for “he” or “she” in the present.",
      "noteEn": "For many regular verbs, -ar becomes -a and -er or -ir becomes -e: hablar becomes habla, comer becomes come, and escribir becomes escribe. Some common verbs are irregular or change their stem. Negative commands use a different form and are a separate pattern.",
      "example": {
        "es": "Abre la ventana.",
        "en": "Open the window."
      },
      "tags": [
        "grammar",
        "commands",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-sustituto",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-vendí",
      "kind": "word",
      "promptEs": "vendí",
      "answerEn": "I sold",
      "noteEn": "Vendí is the completed-past form of vender used when the speaker says yo. The written accent keeps the stress on the final í.",
      "example": {
        "es": "Ayer vendí mi bicicleta.",
        "en": "Yesterday I sold my bicycle."
      },
      "tags": [
        "word",
        "verb",
        "completed past",
        "A2"
      ],
