    {
      "id": "grammar-descriptive-adjective-after-noun",
      "kind": "grammar",
      "promptEs": "sustantivo + adjetivo descriptivo",
      "questionEn": "Where does a basic Spanish describing word usually go relative to its noun?",
      "answerEn": "Put it after the noun in the common neutral order.",
      "noteEn": "Many ordinary descriptive words follow the person or thing they describe: un coche rojo, una casa grande. Some adjectives commonly come before the noun, and moving an adjective can change emphasis or meaning, so this is a useful default rather than an absolute rule.",
      "example": {
        "es": "Necesito una mochila nueva.",
        "en": "I need a new backpack."
      },
      "tags": [
        "grammar",
        "word order",
        "adjective",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-bibliotecarias",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-adjective-gender-agreement",
      "kind": "grammar",
      "promptEs": "adjetivo que concuerda con masculino o femenino",
      "questionEn": "How does a Spanish describing word change for a man, woman, or gendered noun?",
      "answerEn": "Make the describing word match the gender and number of the person or thing it describes.",
      "noteEn": "Many describing words ending in -o change to -a for a feminine singular person or noun: cansado becomes cansada. Plurals normally add -s. Some describing words have one form for both genders.",
      "example": {
        "es": "Pedro está cansado y Ana está cansada.",
        "en": "Pedro is tired and Ana is tired."
      },
      "tags": [
        "grammar",
        "agreement",
        "gender",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
