    {
      "id": "concept-unmatched-opening-parenthesis-tension",
      "kind": "concept",
      "promptEs": "( · paréntesis sin cerrar · tensión no resuelta",
      "questionEn": "How do the title, the first symbol, and the sentence create the same unresolved feeling?",
      "answerEn": "The comic opens a parenthesis but never prints its matching closing mark, so the reader visually experiences the tension that the text leaves open.",
      "noteEn": "An opening parenthesis conventionally promises a later closing parenthesis. Here the title is itself “(”, the raster begins with another large opening mark, and neither is balanced. The form of the comic therefore performs its claim rather than merely mentioning it.",
      "example": {
        "es": "En «Ana (mi vecina llegó», falta cerrar el paréntesis.",
        "en": "In “Ana (my neighbor arrived,” the parenthesis still needs to be closed."
      },
      "tags": [
        "concept",
        "punctuation",
        "parenthesis",
        "typography",
        "joke"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
