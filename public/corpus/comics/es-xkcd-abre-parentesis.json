    {
      "id": "grammar-sin-infinitive",
      "kind": "grammar",
      "promptEs": "sin + infinitivo",
      "questionEn": "How do you say that someone does one thing without doing another?",
      "answerEn": "Put sin before the second action verb in its unchanged dictionary form.",
      "noteEn": "The dictionary form is the unchanged verb ending in -ar, -er, or -ir. When the same person performs both actions, Spanish uses sin directly before that form; it does not add a word equivalent to English “-ing.”",
      "example": {
        "es": "Salió sin cerrar la puerta.",
        "en": "She left without closing the door."
      },
