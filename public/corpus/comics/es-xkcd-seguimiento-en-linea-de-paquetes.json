    {
      "id": "word-en--fixed-en-linea",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "no separate English word; part of en línea (“online”)",
      "noteEn": "The two words en línea work together as the standard expression for something online or connected through a network. In this use, en is not translated on its own.",
      "example": {
        "es": "El curso está en línea.",
        "en": "The course is online."
      },
      "tags": [
        "word",
        "fixed expression",
        "internet"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
