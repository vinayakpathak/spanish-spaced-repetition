        "ownerComicId": "es-xkcd-seguimiento-en-linea-de-paquetes",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "phrase-en-linea",
      "kind": "phrase",
      "promptEs": "en línea",
      "questionEn": "How do you say that a service or activity is available online?",
      "answerEn": "Use en línea after the noun or verb it describes.",
      "noteEn": "En línea is the standard expression for being online or connected through a network. Línea stays singular and normally has no article in this expression.",
      "example": {
        "es": "La tienda está en línea.",
        "en": "The store is online."
      },
      "tags": [
        "phrase",
        "internet",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-seguimiento-en-linea-de-paquetes",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-línea--online",
      "kind": "word",
      "promptEs": "línea",
      "answerEn": "line; part of en línea (“online”)",
      "noteEn": "Línea normally means “line,” but the complete expression en línea describes something available or happening online.",
      "example": {
        "es": "Hicimos la reserva en línea.",
