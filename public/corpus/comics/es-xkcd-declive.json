    {
      "id": "grammar-empezar-a-infinitive",
      "kind": "grammar",
      "promptEs": "empezar a + infinitivo",
      "questionEn": "How do you say that someone starts doing an action?",
      "answerEn": "Use a form of empezar, then a, then the action verb in its unchanged dictionary form.",
      "noteEn": "The plus sign means “followed by.” The dictionary form, also called the infinitive, is the unchanged form ending in -ar, -er, or -ir. Empezar changes for the person and time; a stays fixed, and the action verb stays unchanged.",
      "example": {
        "es": "Lucía empieza a leer.",
        "en": "Lucía starts to read."
      },
      "tags": [
        "grammar",
        "beginning actions",
        "A2"
      ],
