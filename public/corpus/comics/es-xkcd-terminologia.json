    {
      "id": "word-yo--self-reference",
      "kind": "word",
      "promptEs": "yo",
      "answerEn": "me; myself (self-reference rather than a sentence subject)",
      "noteEn": "Yo normally means “I” when it is the subject of a verb. When someone identifies, labels, or addresses their own self, natural English may use “me” or “myself,” while Spanish still uses yo.",
      "example": {
        "es": "La persona de la foto soy yo.",
        "en": "The person in the photo is me."
