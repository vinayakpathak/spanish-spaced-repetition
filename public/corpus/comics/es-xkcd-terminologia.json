    {
      "id": "word-fastidiado--annoyed",
      "kind": "word",
      "promptEs": "fastidiado",
      "answerEn": "annoyed; bothered (completed-action form)",
      "noteEn": "Fastidiado is the completed-action form of fastidiar, ‘to annoy’ or ‘to bother.’ After a form of haber such as ha, it stays unchanged.",
      "example": {
        "es": "Ese ruido me ha fastidiado todo el día.",
        "en": "That noise has bothered me all day."
