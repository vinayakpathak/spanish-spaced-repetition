    {
      "id": "concept-east-west-cultural-geography",
      "kind": "concept",
      "promptEs": "el este y el oeste como regiones culturales",
      "questionEn": "Why can “the East” lie west of someone while “the West” lies east of them?",
      "answerEn": "These are conventional cultural and geographic labels, not directions measured from the current observer.",
      "noteEn": "The labels grew from a Europe-centered view: East Asia became ‘the East,’ while Europe and societies historically grouped with it became ‘the West.’ From North America, traveling toward East Asia can mean going west across the Pacific, while traveling toward Europe can mean going east across the Atlantic. That mismatch creates the joke.",
      "example": {
        "es": "Desde California, Japón queda al oeste.",
        "en": "From California, Japan lies to the west."
      },
      "tags": [
        "concept",
        "geography",
        "cultural labels",
        "map joke"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-terminologia",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-este--cultural-region",
      "kind": "word",
      "promptEs": "este",
      "answerEn": "the East; a broad eastern geographic or cultural region",
      "noteEn": "Este can name the compass direction or, by convention, a broad geographic or cultural region. The article el is used because the word is acting as a noun; context, not the article alone, selects the regional sense.",
      "example": {
        "es": "El libro compara el este con el oeste.",
        "en": "The book compares the East with the West."
      },
      "tags": [
        "word",
        "geography",
        "cultural region",
        "sense split",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-terminologia",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-oeste--direction",
      "kind": "word",
      "promptEs": "oeste",
      "answerEn": "west (the compass direction)",
      "noteEn": "Oeste names the direction where the sun sets. This literal direction is distinct from el Oeste used as a broad cultural or geopolitical label.",
      "example": {
        "es": "El barco navega hacia el oeste.",
        "en": "The ship sails west."
      },
      "tags": [
