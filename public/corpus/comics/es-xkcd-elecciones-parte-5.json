    {
      "id": "word-te--experiencer",
      "kind": "word",
      "promptEs": "te",
      "answerEn": "marks you as the person who feels, likes, or experiences something",
      "noteEn": "Te identifies one familiar listener as the person having a feeling, impression, or preference. English often starts with 'you,' while Spanish builds the sentence around what produces the reaction: te gusta el libro, but te gustan los libros. Te stays the same.",
      "example": {
        "es": "Te gustan estas canciones.",
        "en": "You like these songs."
      },
      "tags": [
        "word",
        "contextual sense"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
