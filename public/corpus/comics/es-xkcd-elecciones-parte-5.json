    {
      "id": "grammar-gustar-infinitive",
      "kind": "grammar",
      "promptEs": "me, te, le, nos, os o les + gusta + actividad",
      "questionEn": "How do you use gusta to say that someone likes doing an activity?",
      "answerEn": "Choose the short word for the person, add gusta, then name the activity with the verb's dictionary form.",
      "noteEn": "Use me for me, te for familiar singular you, le for him/her/formal singular you, nos for us, os for familiar plural you mainly in Spain, and les for them or plural you with ustedes. Ustedes is the usual plural you in Latin America and formal plural you in most of Spain. The activity is what pleases that person, so gusta stays singular for one activity even with les. Its action verb keeps its -ar, -er, or -ir dictionary form. To name or emphasize the people, add a before their name or group: a mis amigos les gusta leer. No before the short word makes it negative.",
      "example": {
        "es": "A mis vecinos les gusta cocinar.",
        "en": "My neighbors like cooking."
      },
      "tags": [
        "grammar",
        "gustar",
        "activities",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-elecciones-parte-5",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-gusta--i-like",
      "kind": "word",
      "promptEs": "gusta",
      "answerEn": "is pleasing; like(s)",
      "noteEn": "Gusta expresses liking, but the thing or activity that is liked controls its form. Use gusta for one thing or an activity, and gustan for several things. A short word identifies who likes it: me means to me, te to you, and le or les to another person or people.",
      "example": {
        "es": "A mis vecinos les gusta caminar.",
        "en": "My neighbors like walking."
      },
      "tags": [
        "word",
