    {
      "id": "phrase-perdona-si",
      "kind": "phrase",
      "promptEs": "perdona si...",
      "questionEn": "How do you politely acknowledge that what you are about to say may be awkward or inconvenient?",
      "answerEn": "Use perdona si followed by the situation.",
      "noteEn": "Perdona is an informal singular request for forgiveness. Si introduces the condition the speaker is apologizing for, such as si esto es raro (“if this is weird”).",
      "example": {
        "es": "Perdona si llego tarde.",
        "en": "Sorry if I arrive late."
      },
      "tags": [
        "A2",
        "phrase",
        "politeness"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-elecciones-parte-5",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-si",
      "kind": "word",
      "promptEs": "si",
      "answerEn": "if",
      "noteEn": "Unaccented si introduces a condition or possibility. With an opening y in a question, ¿y si...? invites someone to consider 'what if ...?' This differs from accented sí, 'yes.'",
      "example": {
        "es": "¿Y si esperamos?",
        "en": "What if we wait?"
      },
      "tags": [
        "word",
        "contextual sense"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
