    {
      "id": "word-perdona--apology",
      "kind": "word",
      "promptEs": "perdona",
      "answerEn": "sorry; excuse me (informal)",
      "noteEn": "Perdona is the familiar singular command of perdonar, “to forgive.” It is commonly used to apologize or to get one person's attention.",
      "example": {
        "es": "Perdona, ¿tienes un minuto?",
        "en": "Excuse me, do you have a minute?"
      },
      "tags": [
        "word",
        "apologies",
        "commands",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
