    {
      "id": "grammar-deberia-expectation",
      "kind": "grammar",
      "promptEs": "debería + infinitivo (expectativa)",
      "answerEn": "It can say that something is expected or likely to happen.",
      "noteEn": "Context decides between advice and expectation. Deberías descansar tells a person what they should do. El tren debería llegar pronto predicts what is expected to happen. In both uses, the following action stays in its dictionary form.",
      "tags": [
        "B1",
        "grammar",
        "modal meaning"
      ],
      "questionEn": "Besides giving advice, what can debería followed by a verb mean?",
      "example": {
        "es": "El tren debería llegar pronto.",
        "en": "The train should arrive soon."
      },
      "reviewStatus": "ai-authored-internal-qa",
