    {
      "id": "grammar-lo-predicate-proform",
      "kind": "grammar",
      "promptEs": "lo con ser o parecer",
      "questionEn": "How do you avoid repeating a description or classification after ser or parecer?",
      "answerEn": "Put the unchanged word lo before a form of ser or parecer to stand for that description or classification.",
      "noteEn": "This lo does not replace a particular masculine noun and does not change for a feminine or plural subject. It stands for the whole property, identity, or classification already understood, as in lo es or lo parece.",
      "example": {
        "es": "¿Es difícil? No lo parece.",
        "en": "Is it difficult? It doesn't seem so."
