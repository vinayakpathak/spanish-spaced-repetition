    {
      "id": "grammar-e-ie-stem-change-present",
      "kind": "grammar",
      "promptEs": "cerrar → cierro, cierras, cierra, cierran",
      "questionEn": "Why does a verb such as cerrar change its middle e to ie in forms such as cierras?",
      "answerEn": "For certain verbs, change the stressed e in the verb's base to ie in most present-time forms.",
      "noteEn": "The stressed e is the e in the syllable you naturally pronounce most strongly. The base is what remains after removing -ar, -er, or -ir. Cerrar has the base cerr-, which becomes cierr- in cierro, cierras, cierra, and cierran. The forms for nosotros and vosotros keep e: cerramos and cerráis. Only some e verbs follow this pattern, so learn the change with each verb.",
      "example": {
        "es": "Ella cierra la ventana.",
        "en": "She closes the window."
      },
      "tags": [
        "grammar",
        "present",
        "stem change",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
