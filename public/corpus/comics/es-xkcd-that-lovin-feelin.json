    {
      "id": "grammar-relative-que",
      "kind": "grammar",
      "promptEs": "persona o cosa + que + información",
      "questionEn": "How do you add information about a named person or thing using “who,” “that,” or “which”?",
      "answerEn": "Put que after the person or thing, then add a verb and the information about it.",
      "noteEn": "Que links the added description to the person or thing before it. It does not change for masculine, feminine, singular, or plural nouns. The added part needs a verb: la casa que vimos means “the house that we saw.”",
      "example": {
        "es": "La casa que vimos es azul.",
        "en": "The house that we saw is blue."
      },
      "tags": [
        "grammar",
