    {
      "id": "concept-days-since-counter-sign",
      "kind": "concept",
      "promptEs": "cartel de “días desde…”",
      "answerEn": "a safety-style counter sign that reports how long it has been since an incident",
      "noteEn": "Workplaces often display the number of days since the last accident or another unwanted event. This sign is self-referential: it counts the days since someone reset the sign itself, even though resetting is also how its displayed count would normally be updated.",
      "tags": [
        "concept",
        "workplace safety",
        "signs",
        "self-reference"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-poner-a-cero",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-desde--since-event",
      "kind": "word",
      "promptEs": "desde",
      "answerEn": "since; from the time when (with que)",
      "noteEn": "Desde marks a starting point. Followed by que and a full event, it means that the event supplies the point from which a later period is measured.",
      "example": {
        "es": "Vivo aquí desde que terminé los estudios.",
        "en": "I have lived here since I finished my studies."
      },
      "tags": [
        "word",
        "time",
        "starting point",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-poner-a-cero",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-desde-que-evento",
      "kind": "grammar",
      "promptEs": "desde que + evento",
      "questionEn": "How do you say that a period or situation has continued since an event?",
      "answerEn": "Use desde que, then state the event that marks the starting point.",
      "noteEn": "Desde marks the starting point, and que allows a full event with its own verb to follow. When that event happened at one completed moment in the past, use a completed-past form such as llegó, terminó, or cambió. The period or situation that continues appears outside the desde que part.",
      "example": {
        "es": "Trabajo aquí desde que terminé la universidad.",
        "en": "I have worked here since I finished university."
      },
      "tags": [
        "grammar",
        "time",
        "starting point",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-poner-a-cero",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-que--fixed-desde-que",
      "kind": "word",
      "promptEs": "que",
      "answerEn": "no separate English word; completes desde que, “since”",
      "noteEn": "Que lets desde introduce a whole event with its own verb. Learn the two words together as desde que when the starting point is an event rather than a date or place.",
      "example": {
        "es": "No lo veo desde que cambió de trabajo.",
        "en": "I have not seen him since he changed jobs."
      },
      "tags": [
        "word",
        "fixed connector",
        "time",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
