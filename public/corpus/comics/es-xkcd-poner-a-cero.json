    },
    {
      "id": "word-a--fixed-poner-a-cero",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; links poner to cero in poner a cero",
      "noteEn": "A is required between a form of poner and cero in this expression. The full expression poner algo a cero means to reset something or set it to zero.",
      "example": {
        "es": "Pon el reloj a cero.",
        "en": "Reset the clock to zero."
