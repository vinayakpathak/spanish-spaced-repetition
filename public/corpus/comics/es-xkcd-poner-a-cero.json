    {
      "id": "word-puso--set-to-zero",
      "kind": "word",
      "promptEs": "puso",
      "answerEn": "reset; set (something) to zero (with a cero)",
      "noteEn": "Puso is a completed-past form of poner used with one doer. Poner has several meanings; with a cero, it means to return a counter, device, or value to zero.",
      "example": {
        "es": "El técnico puso el contador a cero.",
        "en": "The technician reset the counter to zero."
      },
      "tags": [
        "word",
        "verb",
        "completed past",
        "reset",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
