      }
    },
    {
      "id": "phrase-poner-a-cero",
      "kind": "phrase",
      "promptEs": "poner algo a cero",
      "questionEn": "How do you say that someone resets a counter, device, or value to zero?",
      "answerEn": "Use a form of poner with a cero, and name the thing being reset.",
      "noteEn": "Change poner to match the doer and time, but keep a cero unchanged. The thing being reset can appear before a cero, as in puso el contador a cero, or after it, as in puso a cero el contador.",
      "example": {
        "es": "Marta puso el cronómetro a cero.",
        "en": "Marta reset the stopwatch to zero."
      },
      "tags": [
        "phrase",
        "reset",
        "numbers",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
