    {
      "id": "grammar-explicit-subject-pronoun",
      "kind": "grammar",
      "promptEs": "verbo + pronombre de sujeto enfático",
      "questionEn": "Why might Spanish say tú or yo when the verb already tells you who acts?",
      "answerEn": "Say the subject pronoun to add emphasis, contrast, or clarity; otherwise Spanish often leaves it out.",
      "noteEn": "A verb form such as eres already points to “you.” Adding tú can stress that particular person, especially in a contrast or a surprised question. The pronoun may appear after the verb.",
      "example": {
        "es": "Yo no fui; fuiste tú.",
        "en": "I didn't go; you did."
      },
      "tags": [
        "A2",
        "grammar",
        "subject pronouns",
        "emphasis"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-donald-knuth",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "concept-burning-bush-c3po-r2d2-mashup",
      "kind": "concept",
      "promptEs": "Yo soy el que soy · compañero R2-D2",
      "questionEn": "What two stories are being combined in the joke?",
      "answerEn": "The visible scene merges the burning-bush declaration from Exodus with an implied C-3PO-style introduction of R2-D2.",
      "noteEn": "In Exodus, God speaks to Moses from a burning bush and identifies himself with an ‘I am’ declaration and the lineage of Abraham, Isaac, and Jacob. The comic then introduces visible R2-D2 as the speaker's companion and gives him electronic sounds. That points toward C-3PO, R2-D2's usual Star Wars companion and a robot built for languages and etiquette, even though C-3PO is never printed or drawn. The official title text reinforces the implication by asking about Bocce, a language C-3PO claims to speak; its droid-like LO-M can also be read as an echo of Elohim, a Hebrew name for God.",
      "tags": [
        "concept",
        "Exodus",
        "Star Wars",
        "parody",
        "joke"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-yo-soy",
        "contextualSenseReviewed": true
      }
    },
