    {
      "id": "word-el--the-one-before-que",
      "kind": "word",
      "promptEs": "el",
      "answerEn": "the one (masculine singular, before que)",
      "noteEn": "When no noun is written before el que, el identifies one unnamed masculine person or thing and que introduces what defines it. This differs from ordinary el before a noun and from a use after a linking word, such as en el que, ‘in which.’",
      "example": {
        "es": "Él es el que organiza las reuniones.",
        "en": "He is the one who organizes the meetings."
      },
      "tags": [
        "word",
        "relative expression",
        "noun omitted",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
