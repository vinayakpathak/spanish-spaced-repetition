    {
      "id": "concept-search-result-count-matrix-parody",
      "kind": "concept",
      "promptEs": "resultados de búsqueda · X chicas · Y vasos",
      "questionEn": "What does the colored number grid represent?",
      "answerEn": "Each cell gives a mock Google result count for a query containing the row's number of girls and the column's number of cups.",
      "noteEn": "The unusually large red cell at two girls and one cup alludes to a notorious viral shock-video title. The comic turns the two numbers into variables and compares many nearby searches without describing the video itself.",
      "example": {
        "es": "Cada casilla combina una fila con una columna.",
        "en": "Each cell combines one row with one column."
      },
