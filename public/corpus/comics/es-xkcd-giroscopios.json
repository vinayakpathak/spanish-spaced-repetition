    {
      "id": "word-a--fixed-a-pesar-de",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; begins a pesar de, ‘despite’",
      "noteEn": "Inside a pesar de, a is a fixed part of the connector rather than a separately translated direction word.",
      "example": {
        "es": "Salimos a pesar de la lluvia.",
        "en": "We went out despite the rain."
      },
      "tags": [
        "word",
        "fixed expression",
        "contrast",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
