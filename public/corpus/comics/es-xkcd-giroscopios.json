        "contextualSenseReviewed": true
      }
    },
    {
      "id": "phrase-a-pesar-de",
      "kind": "phrase",
      "promptEs": "a pesar de + situación, cosa o acción",
      "questionEn": "How do you say that something happens despite another fact, obstacle, or action?",
      "answerEn": "Use a pesar de before the situation, thing, or action that did not prevent the result.",
      "noteEn": "A pesar de works as one connector meaning ‘despite’ or ‘in spite of.’ It can be followed by a noun or by an action verb in its unchanged dictionary form ending in -ar, -er, or -ir.",
      "example": {
        "es": "Caminamos a pesar de estar cansados.",
        "en": "We walked despite being tired."
      },
      "tags": [
        "phrase",
        "contrast",
        "connector",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-giroscopios",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-pesar--fixed-a-pesar-de",
      "kind": "word",
      "promptEs": "pesar",
      "answerEn": "no separate English word; middle of a pesar de, ‘despite’",
      "noteEn": "Pesar normally relates to weight or regret, but inside a pesar de the three words form one connector meaning ‘despite’ or ‘in spite of.’",
      "example": {
        "es": "Salimos a pesar de la lluvia.",
        "en": "We went out despite the rain."
      },
      "tags": [
