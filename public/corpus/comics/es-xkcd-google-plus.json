    {
      "id": "phrase-unirse-a",
      "kind": "phrase",
      "promptEs": "unirse a + grupo o actividad",
      "questionEn": "How do you say that someone joins a group or activity?",
      "answerEn": "Use the matching form of unirse, then a, then name the group or activity.",
      "noteEn": "The small part of unirse changes with the person: me uno, te unes, se une, nos unimos, os unís, or se unen. The word a remains before the group; a plus el contracts to al.",
      "example": {
        "es": "Lucía se unió al equipo.",
        "en": "Lucía joined the team."
      },
      "tags": [
        "phrase",
        "membership",
        "verb complement",
        "A2"
