    {
      "id": "grammar-infinitive-attached-pronominal-marker",
      "kind": "grammar",
      "promptEs": "verbo pronominal en -ar/-er/-ir + me/te/se/nos/os/se",
      "questionEn": "Where does me, te, se, nos, or os go when a verb used with one of those words stays in its dictionary form?",
      "answerEn": "Attach the matching small word to the end: unir + me becomes unirme.",
      "noteEn": "A pronominal verb is learned with se, such as unirse or acostarse. When its action verb remains in the unchanged dictionary form ending in -ar, -er, or -ir, replace se with the form that matches the person and write it as part of the same word: acostarme, unirte, or irnos.",
      "example": {
        "es": "Quiero acostarme temprano.",
        "en": "I want to go to bed early."
      },
      "tags": [
        "grammar",
        "pronominal verbs",
        "infinitive",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
