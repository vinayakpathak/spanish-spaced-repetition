    {
      "id": "phrase-cita-requerida",
      "kind": "phrase",
      "promptEs": "cita requerida",
      "questionEn": "What Spanish editorial notice says that a claim needs a source?",
      "answerEn": "Use cita requerida: “citation needed” or “citation required.”",
      "noteEn": "This is a conventional notice in collaborative reference writing, especially on Spanish Wikipedia. It is often displayed in brackets as [cita requerida]. Short notices commonly omit an article such as una.",
      "example": {
        "es": "El editor añadió «cita requerida» después de la afirmación.",
        "en": "The editor added “citation needed” after the claim."
      },
      "tags": [
        "phrase",
