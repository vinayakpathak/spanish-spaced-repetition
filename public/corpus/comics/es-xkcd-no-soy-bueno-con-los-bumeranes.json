    {
      "id": "word-dejo--end-relationship",
      "kind": "word",
      "promptEs": "dejo",
      "answerEn": "I am leaving; I am ending a romantic relationship",
      "noteEn": "Dejo is the present form of dejar used by the speaker. Dejar can mean leaving a thing somewhere; with a romantic partner as the person affected, it can mean ending the relationship.",
      "example": {
        "es": "Hoy dejo a mi pareja.",
        "en": "Today I am leaving my partner."
