    {
      "id": "phrase-de-momento",
      "kind": "phrase",
      "promptEs": "de momento",
      "questionEn": "How do you say that something is true for now, but may change later?",
      "answerEn": "Use de momento.",
      "noteEn": "De momento refers to the current temporary situation. It is close to ‘for now’ or ‘at the moment.’",
      "example": {
        "es": "De momento, esperamos aquí.",
        "en": "For now, we are waiting here."
      },
      "tags": [
        "phrase",
        "time",
        "temporary state",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
