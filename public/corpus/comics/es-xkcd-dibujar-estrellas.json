    {
      "id": "word-momento--fixed-de-momento",
      "kind": "word",
      "promptEs": "momento",
      "answerEn": "now; completes de momento, ‘for now’",
      "noteEn": "Momento completes the fixed expression de momento. By itself, momento means ‘moment,’ but the two-word expression describes the present temporary situation.",
      "example": {
        "es": "De momento, todo funciona.",
        "en": "For now, everything works."
      },
