    {
      "id": "word-de--fixed-de-momento",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "for; first part of de momento, ‘for now’",
      "noteEn": "De combines with momento in the fixed time expression de momento. Its meaning comes from the whole expression rather than from the usual possession or origin uses of de.",
      "example": {
        "es": "De momento, no hay cambios.",
        "en": "For now, there are no changes."
      },
      "tags": [
        "word",
