    {
      "id": "grammar-descriptive-adjective-after-noun",
      "kind": "grammar",
      "promptEs": "sustantivo + adjetivo descriptivo",
      "questionEn": "Where does a basic Spanish describing word usually go relative to its noun?",
      "answerEn": "Put it after the noun in the common neutral order.",
      "noteEn": "Many ordinary descriptive words follow the person or thing they describe: un coche rojo, una casa grande. Some adjectives commonly come before the noun, and moving an adjective can change emphasis or meaning, so this is a useful default rather than an absolute rule.",
      "example": {
        "es": "Necesito una mochila nueva.",
        "en": "I need a new backpack."
      },
      "tags": [
        "grammar",
        "word order",
        "adjective",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-bibliotecarias",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-adjective-gender-agreement",
      "kind": "grammar",
      "promptEs": "adjetivo que concuerda con masculino o femenino",
      "questionEn": "How does a Spanish describing word change for a man, woman, or gendered noun?",
      "answerEn": "Make the describing word match the gender and number of the person or thing it describes.",
      "noteEn": "Many describing words ending in -o change to -a for a feminine singular person or noun: cansado becomes cansada. Plurals normally add -s. Some describing words have one form for both genders.",
      "example": {
        "es": "Pedro está cansado y Ana está cansada.",
        "en": "Pedro is tired and Ana is tired."
      },
      "tags": [
        "grammar",
        "agreement",
        "gender",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-frases-para-ligar",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "concept-combination-vision-test-42",
      "kind": "concept",
      "promptEs": "test de visión combinado · número 42 · sinestesia · daltonismo",
      "questionEn": "Why does this single number picture claim to test two unrelated kinds of perception at once?",
      "answerEn": "It combines an Ishihara-style color-vision plate with a number whose large shapes are themselves made from many smaller numbers.",
      "noteEn": "Ishihara plates normally use colored dots to test color discrimination. Here the large 4 is drawn mainly from small 2s, the large 2 mainly from small 4s, and the surrounding field from other digits. The caption jokingly diagnoses color blindness if only one large figure is seen and synesthesia if the viewer treats the small numbers as creating the larger forms. The title text extends the mock diagnosis with diplopia and myopia under still more contrived viewing conditions.",
      "tags": [
        "concept",
        "vision",
        "Ishihara test",
        "synesthesia",
        "42",
        "joke"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-test-de-vision-combinado",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-de--noun-classifier",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "often no separate English word; links a noun to another noun that names its type or use",
      "noteEn": "Spanish often uses de between two nouns where English uses a noun directly before another noun. For example, una taza de café is ‘a coffee cup,’ and material de oficina is ‘office material.’",
      "example": {
        "es": "Necesito una taza de café.",
        "en": "I need a coffee cup."
      },
      "tags": [
        "word",
        "preposition",
        "noun modifier",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
