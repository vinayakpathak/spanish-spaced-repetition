    {
      "id": "phrase-mirada-a",
      "kind": "phrase",
      "promptEs": "mirada a + tema",
      "questionEn": "How do you introduce a look at, overview of, or examination of a topic?",
      "answerEn": "Use mirada a followed by the topic, normally with an article such as una before mirada.",
      "noteEn": "Mirada literally relates to looking, but this expression often introduces a discussion or overview. Use al when a is followed by the masculine article el.",
      "example": {
        "es": "El artículo ofrece una mirada a la historia local.",
        "en": "The article offers a look at local history."
      },
      "tags": [
