    {
      "id": "word-potencias--mathematical",
      "kind": "word",
      "promptEs": "potencias",
      "answerEn": "powers; exponentiated values",
      "noteEn": "In mathematics, a potencia is the result of raising a number to an exponent. The plural is potencias.",
      "example": {
        "es": "Dos, cuatro y ocho son potencias de dos.",
        "en": "Two, four, and eight are powers of two."
      },
      "tags": [
        "word",
        "mathematics",
        "plural"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-potencias-de-uno",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "concept-powers-of-one",
      "kind": "concept",
      "promptEs": "potencias de uno · 1ⁿ = 1",
      "answerEn": "any power of one is still one",
      "noteEn": "Raising one to an integer power means multiplying copies of one, so the value remains one: 1⁰, 1¹, 1², and 1³ all equal 1. A negative power also remains one because its reciprocal is 1/1.",
      "tags": [
        "mathematics",
        "exponents",
        "joke concept"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
