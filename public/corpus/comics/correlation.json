    {
      "id": "phrase-dejar-de-infinitive",
      "kind": "phrase",
      "promptEs": "dejar de + infinitivo",
      "answerEn": "Use a form of dejar, then de, then the action verb in its dictionary form.",
      "noteEn": "The dictionary form of a verb is called the infinitive. It usually ends in -ar, -er, or -ir. Only dejar changes to show who acts and when; the final verb stays in its dictionary form. Keep de in this pattern: dejar alone usually means “to leave” or “to let,” while dejar de + action means to stop doing that action.",
      "tags": [
        "A2",
        "verb pattern",
        "cessation"
      ],
      "questionEn": "How do you say that someone stops doing something?",
      "example": {
        "es": "Quiero dejar de fumar.",
        "en": "I want to stop smoking."
      },
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-de--verb-complement",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; a required verb complement",
      "noteEn": "Some Spanish verbs require de before their complement or a following infinitive. English often absorbs this de into the verb’s translation: dejar de means “to stop doing,” while disfrutar de means “to enjoy.”",
      "example": {
        "es": "Dejé de fumar.",
        "en": "I stopped smoking."
      },
      "tags": [
        "word",
        "contextual sense"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
