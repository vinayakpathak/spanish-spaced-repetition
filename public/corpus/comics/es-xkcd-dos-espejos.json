    {
      "id": "word-verónica--mirror-legend",
      "kind": "word",
      "promptEs": "verónica",
      "answerEn": "Verónica (the name invoked in a mirror legend)",
      "noteEn": "Verónica is a Spanish given name. In a Spanish mirror-invocation legend, it names the figure people try to summon by repeating the name before a mirror.",
      "example": {
        "es": "Cuenta la leyenda que Verónica aparece en el espejo.",
        "en": "The legend says that Verónica appears in the mirror."
      },
      "tags": [
