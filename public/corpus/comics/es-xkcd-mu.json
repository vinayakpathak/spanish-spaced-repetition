      }
    },
    {
      "id": "word-ueeeeeeeee--chair-spin-sound",
      "kind": "word",
      "promptEs": "ueeeeeeeee",
      "answerEn": "wheeeee!; a delighted spinning sound",
      "noteEn": "The initial u approximates the start of the cry, and the nine written e letters show that the vowel is held for a long time. This expressive spelling is playful rather than a standard dictionary form.",
      "example": {
        "es": "¡Ueeee, qué rápido!",
        "en": "Wheeee, how fast!"
      },
      "tags": [
