    {
      "id": "phrase-coeficiente-de-rozamiento",
      "kind": "phrase",
      "promptEs": "coeficiente de rozamiento",
      "questionEn": "What is the Spanish physics term for coefficient of friction?",
      "answerEn": "Use coeficiente de rozamiento.",
      "noteEn": "Rozamiento is friction between surfaces. The coefficient is a dimensionless number used in a model of that friction; it is often written with the Greek letter µ.",
      "example": {
        "es": "El caucho tiene un coeficiente de rozamiento alto.",
        "en": "Rubber has a high coefficient of friction."
      },
