    {
      "id": "concept-friction-coefficient-chair-spin-productivity-graph",
      "kind": "concept",
      "promptEs": "productividad · coeficiente de rozamiento · silla de oficina",
      "questionEn": "What scientific convention turns the office-chair graph into a joke?",
      "answerEn": "Physics commonly uses µ for a friction coefficient, while the graph treats chair friction as though it controlled workplace productivity.",
      "noteEn": "Lower friction lets a swivel chair spin more freely. The curve gives that amusement a mock productivity optimum, while the title text extends the joke: as µ approaches zero, other people join chair-spinning contests and the group's productivity becomes negative.",
      "tags": [
        "concept",
        "physics",
        "friction",
        "graph",
        "joke"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
