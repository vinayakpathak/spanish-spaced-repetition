  "cards": [
    {
      "id": "word-es--impersonal-evaluation",
      "kind": "word",
      "promptEs": "es",
      "answerEn": "it is (introducing an evaluation)",
      "noteEn": "Spanish can begin an impersonal evaluation with es plus a describing word. English normally supplies an impersonal ‘it,’ but Spanish does not add a separate subject word.",
      "example": {
        "es": "Es extraño que llueva.",
        "en": "It is strange that it is raining."
      },
      "tags": [
        "word",
        "ser",
        "impersonal expression",
        "evaluation",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-tecnologia-avanzada",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-evaluative-subjunctive",
      "kind": "grammar",
      "promptEs": "es + adjetivo de valoración + que + subjuntivo",
      "answerEn": "Use the subjunctive for the situation being judged.",
      "noteEn": "Phrases such as es importante, es bueno, and es raro express a judgment about what follows. Spanish marks the verb after que with the subjunctive. In the example, descansas—the ordinary statement form—changes to descanses.",
      "tags": [
        "B1",
        "grammar",
        "subjunctive",
        "evaluation"
      ],
      "questionEn": "After “It is important/good/strange that…,” which form does the next Spanish verb take?",
      "example": {
        "es": "Es importante que descanses.",
        "en": "It is important that you rest."
      },
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-increíble",
      "kind": "word",
      "promptEs": "increíble",
      "answerEn": "incredible; amazing",
      "noteEn": "Increíble has the same form for a masculine or feminine singular subject. Its plural is increíbles.",
      "example": {
        "es": "La vista es increíble.",
        "en": "The view is amazing."
      },
      "tags": [
        "word",
        "adjective",
        "evaluation",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-tecnologia-avanzada",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-que--clause-link",
      "kind": "word",
      "promptEs": "que",
      "answerEn": "that (introducing a clause)",
      "noteEn": "Que introduces a clause after verbs such as creer, saber, esperar, or decir. English often uses “that,” but may leave it unstated.",
      "example": {
        "es": "Creo que Ana viene.",
        "en": "I think that Ana is coming."
      },
      "tags": [
        "word",
        "contextual sense"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-tengas--subjunctive-evaluation",
      "kind": "word",
      "promptEs": "tengas",
      "answerEn": "you have (special form after an evaluation)",
      "noteEn": "Tengas is a special form of tener for familiar singular ‘you.’ After an impersonal judgment such as es increíble que, Spanish normally changes the ordinary tienes to tengas.",
      "example": {
        "es": "Es bueno que tengas tiempo.",
        "en": "It is good that you have time."
      },
      "tags": [
        "word",
        "tener",
        "subjunctive",
        "evaluation",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-tecnologia-avanzada",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "concept-von-neumann-self-replicating-machine",
      "kind": "concept",
      "promptEs": "máquina autorreplicante de Von Neumann",
      "answerEn": "a theoretical machine that can construct another machine from a description and pass that description to the result",
      "noteEn": "John von Neumann's self-reproduction model combines a universal constructor with a copied description of the machine. The comic loosely treats the human reproductive system as an internal ‘factory’ that makes more people; humans are not literal copies of one another or implementations of the formal machine.",
      "tags": [
        "concept",
