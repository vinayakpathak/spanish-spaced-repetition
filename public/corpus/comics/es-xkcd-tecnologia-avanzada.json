  "cards": [
    {
      "id": "word-es",
      "kind": "word",
      "promptEs": "es",
      "answerEn": "is; are (formal singular you)",
      "noteEn": "Es is a present form of ser for one person or thing, including usted, the formal way to address one person as 'you.' It can identify, classify, describe, evaluate, or state a time. Spanish can leave the person or thing understood, where English supplies 'he,' 'she,' or 'it.' Compare es with eres for familiar 'you' and son for several people or things.",
      "example": {
        "es": "Es una buena idea.",
        "en": "It is a good idea."
      },
      "tags": [
        "word",
        "contextual sense"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-evaluative-subjunctive",
      "kind": "grammar",
      "promptEs": "ser + valoración + que + acción",
      "questionEn": "After es importante que or es mejor que, how do you express the action being judged?",
      "answerEn": "Use a form of ser, the evaluation, que, and the action in its special subjunctive form.",
      "noteEn": "Subjunctive is the name for the verb form used here because the action is being evaluated, not simply reported. Compare descansas ('you rest') with es importante que descanses ('it is important that you rest'): descansas changes to descanses. Ser can change for time, as in será mejor que llegues. This applies to judgments such as bueno, importante, raro, or mejor, not every adjective: es cierto que presents something as true and normally uses an ordinary statement form. For an activity in general without a separate person, use es importante descansar, with no que.",
      "example": {
        "es": "Es mejor que descanses.",
        "en": "It is better for you to rest."
      },
      "tags": [
        "grammar",
        "evaluation",
        "subjunctive",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-increíble",
      "kind": "word",
      "promptEs": "increíble",
      "answerEn": "incredible; amazing",
      "noteEn": "Increíble has the same form for a masculine or feminine singular subject. Its plural is increíbles.",
      "example": {
        "es": "La vista es increíble.",
        "en": "The view is amazing."
      },
      "tags": [
        "word",
        "adjective",
        "evaluation",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
