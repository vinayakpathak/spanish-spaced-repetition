    {
      "id": "word-hacer--make",
      "kind": "word",
      "promptEs": "hacer",
      "answerEn": "to make; to create",
      "noteEn": "Hacer can mean creating or producing a physical thing. This is distinct from its very common sense “to do.”",
      "example": {
        "es": "Vamos a hacer una mesa.",
        "en": "We are going to make a table."
      },
