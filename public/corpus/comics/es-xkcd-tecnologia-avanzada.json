    {
      "id": "word-más--more-ones",
      "kind": "word",
      "promptEs": "más",
      "answerEn": "more; more people or things (with the noun understood)",
      "noteEn": "Más can stand without a following noun when the context already makes clear what ‘more’ refers to. The accent distinguishes más, ‘more,’ from mas, a literary word for ‘but.’",
      "example": {
        "es": "Necesitamos más como estas.",
        "en": "We need more like these."
      },
