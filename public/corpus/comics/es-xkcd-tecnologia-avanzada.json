    {
      "id": "grammar-para-infinitive-purpose",
      "kind": "grammar",
      "promptEs": "para + acción en forma de diccionario",
      "questionEn": "How do you use para to explain a purpose or what something can be used for?",
      "answerEn": "Use para followed by the action verb in its unchanged dictionary form.",
      "noteEn": "The dictionary form ends in -ar, -er, or -ir and is also called the infinitive. It names an intended action: estudio para aprender ('I study to learn') or tiempo para leer ('time for reading'). After para, that action has no separate verb ending for a new person; its doer is understood from context. To give the intended action its own explicitly stated person and changed verb, use the different para que pattern, as in para que Ana aprenda.",
      "example": {
        "es": "Estudio para aprender.",
        "en": "I study in order to learn."
      },
      "tags": [
        "grammar",
        "purpose",
        "intended use",
        "infinitive",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
