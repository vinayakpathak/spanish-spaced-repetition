    {
      "id": "phrase-cada-pocos-time-periods",
      "kind": "phrase",
      "promptEs": "cada pocos/pocas + períodos de tiempo",
      "questionEn": "How do you say that something happens every few days, weeks, months, or similar periods?",
      "answerEn": "Use cada, then pocos or pocas, then the plural time period.",
      "noteEn": "Pocos or pocas matches the time noun: cada pocos días, cada pocas semanas, cada pocos meses. This describes a recurring interval without saying its exact length.",
      "example": {
        "es": "Nos reunimos cada pocas semanas.",
        "en": "We meet every few weeks."
      },
      "tags": [
