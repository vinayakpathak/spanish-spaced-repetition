    {
      "id": "grammar-siglo-roman-numeral",
      "kind": "grammar",
      "promptEs": "siglo + número romano",
      "questionEn": "How do Spanish texts label a numbered century, such as the nineteenth or twentieth century?",
      "answerEn": "Put siglo before a Roman numeral, as in siglo XIX or siglo XX.",
      "noteEn": "Roman numerals use letters such as X, V, and I to represent numbers. For centuries after ten, Spanish normally reads the numeral as an ordinary number: siglo XIX is read siglo diecinueve, and siglo XX is siglo veinte. Del siglo dates something to that century.",
      "example": {
        "es": "El puente es del siglo XX.",
        "en": "The bridge is from the twentieth century."
      },
      "tags": [
        "grammar",
        "dates",
        "centuries",
        "Roman numerals",
