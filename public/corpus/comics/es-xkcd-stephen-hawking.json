    {
      "id": "question-words",
      "kind": "grammar",
      "promptEs": "qué · cómo · cuándo…",
      "answerEn": "Write qué, cómo, cuándo, and similar words with an accent when they ask a question or add an exclamation.",
      "noteEn": "This includes direct questions (¿Qué quieres?), questions inside another sentence (No sé qué quiere), and exclamations (¡Qué bonito!). Without the accent, these words usually connect parts of a sentence instead: el libro que quiero means “the book that I want.”",
      "tags": [
        "A1",
        "grammar",
        "questions",
        "accents"
      ],
      "questionEn": "Why do words such as que, como, and cuando sometimes have a written accent?",
      "example": {
        "es": "¿Cómo te llamas?",
        "en": "What is your name?"
      },
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-sabrá--speculative-future",
      "kind": "word",
      "promptEs": "sabrá",
      "answerEn": "might know; could know (a guess about what is true now)",
      "noteEn": "Sabrá is formed from saber's future stem sabr- and the singular ending -á. A future-looking form can also express uncertainty or a guess about the present, especially in a question, rather than knowledge at a later time.",
      "example": {
        "es": "¿Qué sabrá Marta del problema?",
        "en": "What might Marta know about the problem?"
      },
      "tags": [
        "word",
        "saber",
        "future form",
        "conjecture",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
