        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-future-conjecture",
      "kind": "grammar",
      "promptEs": "futuro para una conjetura presente",
      "questionEn": "How can a future-looking verb form express a guess about what is true now?",
      "answerEn": "Use the future form to present a conclusion as likely rather than certain; English often uses “probably,” “must,” or “I wonder.”",
      "noteEn": "Spanish future endings do not always place an event later in time. With enough context, a form such as será or querrá can signal the speaker's inference about the present. The exact English wording depends on whether the line is a statement or a question.",
      "example": {
        "es": "Estará en casa.",
        "en": "She is probably at home."
      },
      "tags": [
        "grammar",
        "future",
        "inference",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
