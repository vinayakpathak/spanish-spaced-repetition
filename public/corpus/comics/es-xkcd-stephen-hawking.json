    {
      "id": "word-pensado--haber-participle",
      "kind": "word",
      "promptEs": "pensado",
      "answerEn": "thought; considered (completed-action form used after haber)",
      "noteEn": "Pensado is the regular completed-action form of pensar. After he, has, ha, hemos, habéis, or han, it stays unchanged and helps describe a thought connected to the present.",
      "example": {
        "es": "He pensado en otra opción.",
        "en": "I have thought about another option."
