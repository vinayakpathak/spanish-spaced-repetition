    {
      "id": "grammar-simple-conditional",
      "kind": "grammar",
      "promptEs": "infinitivo + terminación condicional (-ía, -ías, -íamos…)",
      "questionEn": "How do you form a Spanish “would” verb such as “would forget”?",
      "answerEn": "Keep the whole dictionary form and add a conditional ending such as -ía.",
      "noteEn": "The same endings attach to verbs ending in -ar, -er, and -ir. The ending changes for the person: -ía, -ías, -ía, -íamos, -íais, or -ían.",
      "example": {
        "es": "Viajaríamos en tren.",
        "en": "We would travel by train."
      },
      "tags": [
