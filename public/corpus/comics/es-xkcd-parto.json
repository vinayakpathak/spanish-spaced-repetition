    {
      "id": "word-está--progressive-auxiliary",
      "kind": "word",
      "promptEs": "está",
      "answerEn": "is; helps form an ongoing action",
      "noteEn": "Before an action form ending in -ando or -iendo, está says that one other person or thing is doing that action now or around the time being discussed.",
      "example": {
        "es": "Marta está leyendo.",
        "en": "Marta is reading."
