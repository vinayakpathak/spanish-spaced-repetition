    {
      "id": "word-arrastrándose--crawling",
      "kind": "word",
      "promptEs": "arrastrándose",
      "answerEn": "crawling; dragging itself along",
      "noteEn": "Arrastrarse means ‘to crawl’ or literally to drag oneself along. For an action in progress, arrastrar becomes arrastrando and the matching se is attached at the end. The written accent keeps the original stress: arrastrándose.",
      "example": {
        "es": "El gato está arrastrándose bajo la mesa.",
        "en": "The cat is crawling under the table."
      },
      "tags": [
