    {
      "id": "word-espere--formal-command",
      "kind": "word",
      "promptEs": "espere",
      "answerEn": "wait; a formal command to one person",
      "noteEn": "Espere tells usted, the polite singular ‘you,’ to wait. With a regular verb ending in -ar, the polite command changes that ending to -e: esperar becomes espere. The informal command is espera.",
      "example": {
        "es": "Espere aquí, por favor.",
        "en": "Wait here, please."
      },
      "tags": [
        "word",
        "esperar",
        "formal command",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
