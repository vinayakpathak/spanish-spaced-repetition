    {
      "id": "grammar-estar-gerundio",
      "kind": "grammar",
      "promptEs": "estar + gerundio (-ando/-iendo)",
      "answerEn": "Use a form of estar followed by an action word ending in -ando or -iendo.",
      "noteEn": "Estar changes to show who is doing the action: estoy, estás, está, and so on. For most verbs, replace -ar with -ando (hablar → hablando) and replace -er or -ir with -iendo (comer → comiendo, vivir → viviendo). This is similar to English “am/is/are doing.”",
      "tags": [
        "A2",
        "grammar",
        "actions in progress"
      ],
      "questionEn": "How do you say that someone is in the middle of doing something?",
      "example": {
        "es": "Estoy leyendo.",
        "en": "I am reading."
      },
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "seed-curriculum",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-mirando--looking-at",
      "kind": "word",
      "promptEs": "mirando",
      "answerEn": "looking at; watching",
      "noteEn": "Mirar already includes the idea expressed by English ‘at.’ Spanish normally puts the thing being watched directly after mirar, without adding a separate word for ‘at.’",
      "example": {
        "es": "Estoy mirando la pantalla.",
        "en": "I am looking at the screen."
