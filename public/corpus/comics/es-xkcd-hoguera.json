    {
      "id": "grammar-ser-identity-estar-location",
      "kind": "grammar",
      "promptEs": "ser para identidad · estar para ubicación",
      "questionEn": "Which Spanish “to be” verb says what something is, and which says where it is?",
      "answerEn": "Use ser for identity or a defining description; use estar for the location of a person or thing.",
      "noteEn": "This contrast is not simply permanent versus temporary. Forms of ser such as soy and es identify or describe what something is. Forms of estar such as están normally locate people and things. Events are a common exception: Spanish uses ser to say where or when an event takes place.",
      "example": {
        "es": "El museo es famoso y está en Madrid.",
        "en": "The museum is famous and is in Madrid."
      },
