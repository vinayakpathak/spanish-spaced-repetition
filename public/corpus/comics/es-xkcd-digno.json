        "ownerComicId": "es-xkcd-digno",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "word-a--fixed-a-empujones",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "by; with (as part of a empujones, “by shoving”)",
      "noteEn": "In the fixed expression a empujones, a introduces the repeated pushes that describe how something moves. It is not the usual destination meaning of a.",
      "example": {
        "es": "Movieron la mesa a empujones.",
        "en": "They moved the table by shoving it."
      },
      "tags": [
        "word",
        "fixed expression",
        "manner"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
