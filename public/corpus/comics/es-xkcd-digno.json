        "contextualSenseReviewed": true
      }
    },
    {
      "id": "phrase-a-empujones",
      "kind": "phrase",
      "promptEs": "a empujones",
      "questionEn": "How do you say that someone or something moves because it is shoved repeatedly?",
      "answerEn": "Use a empujones to mean “by shoving” or “with repeated pushes.”",
      "noteEn": "Empujón means one push or shove. Spanish normally uses its plural, empujones, after a in this fixed expression. The complete expression describes the manner of movement; neither word changes.",
      "example": {
        "es": "Movieron la mesa a empujones.",
        "en": "They moved the table by shoving it."
      },
      "tags": [
