    {
      "id": "phrase-de-cabeza--headfirst",
      "kind": "phrase",
      "promptEs": "de cabeza",
      "questionEn": "How do you say that a person or thing moves with the head leading?",
      "answerEn": "Put de cabeza after the movement verb to mean “headfirst.”",
      "noteEn": "Cabeza means “head.” In this fixed expression, de does not have its ordinary “of” meaning; de cabeza describes the direction or manner of the movement. The expression stays unchanged.",
      "example": {
        "es": "Cayó de cabeza al agua.",
        "en": "He fell headfirst into the water."
      },
