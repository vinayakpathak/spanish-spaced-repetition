    {
      "id": "grammar-third-person-plural-unnamed-agent",
      "kind": "grammar",
      "promptEs": "verbo en forma de ellos/ellas sin agente nombrado",
      "questionEn": "How can Spanish describe an action by unnamed people, where English might use a vague “they” or a passive sentence?",
      "answerEn": "Use the plural “they” form of the verb and do not name who performed the action.",
      "noteEn": "The plural verb ending points to people who did the action, but the speaker leaves them unidentified. Depending on the context, English may use “they,” “people,” “someone,” or a passive form such as “was built.” For a completed regular -ar action, the plural ending is -aron, as in llamaron.",
      "example": {
        "es": "Construyeron el puente en 1990.",
        "en": "The bridge was built in 1990."
      },
      "tags": [
        "grammar",
        "unnamed agent",
        "plural verb",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
