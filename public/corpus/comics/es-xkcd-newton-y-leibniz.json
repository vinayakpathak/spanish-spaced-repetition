      }
    },
    {
      "id": "word-inventado",
      "kind": "word",
      "promptEs": "inventado",
      "answerEn": "invented",
      "noteEn": "Inventado is the completed-action form of inventar. After he, it says that the speaker has invented something; inventado itself does not change for the speaker.",
