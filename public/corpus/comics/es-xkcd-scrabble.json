    {
      "id": "word-si--scrabble-tile-ambiguity",
      "kind": "word",
      "promptEs": "si",
      "answerEn": "sí (‘yes’) or si (‘if’); Spanish Scrabble tiles omit the accent mark",
      "noteEn": "Standard Spanish distinguishes sí, ‘yes,’ from si, ‘if.’ Spanish Scrabble uses unaccented vowel tiles even for words that carry a written accent in ordinary text, so the played SI can represent either spelling. Without a sentence, the board alone does not choose between them.",
      "example": {
        "es": "Sí, iré si puedo.",
        "en": "Yes, I will go if I can."
      },
      "tags": [
        "word",
        "accent",
        "spelling",
        "board game",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
