    {
      "id": "grammar-no-infinitive-prohibition",
      "kind": "grammar",
      "promptEs": "no + infinitivo en letreros",
      "questionEn": "How do signs tell people not to do something?",
      "answerEn": "Use no followed by the action verb in its unchanged dictionary form.",
      "noteEn": "The unchanged dictionary form is the verb form ending in -ar, -er, or -ir, such as pasar, comer, or salir. Public notices often use no plus this form without naming a person: no pasar means that entering is prohibited. A command spoken directly to someone normally uses a different verb form.",
      "example": {
        "es": "No fumar.",
        "en": "No smoking."
      },
