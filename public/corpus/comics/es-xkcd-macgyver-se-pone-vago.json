    {
      "id": "grammar-adverbial-gerund",
      "kind": "grammar",
      "promptEs": "-ando / -iendo para una acción simultánea o un medio",
      "questionEn": "How can you add an action that happens at the same time or explains how something is done?",
      "answerEn": "Use the action form ending in -ando or -iendo, such as hablando or corriendo.",
      "noteEn": "Spanish calls this form the gerund. It does not change for the person. Used on its own, it can describe a simultaneous action or the means used: Entró corriendo means the person entered by running. This differs from estar plus the same form, which focuses on an action in progress.",
      "example": {
        "es": "Entró corriendo.",
        "en": "She came in running."
      },
      "tags": [
        "grammar",
        "gerund",
        "B1"
      ],
