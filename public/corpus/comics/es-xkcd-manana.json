    {
      "id": "grammar-preparar-a-alguien-para-algo",
      "kind": "grammar",
      "promptEs": "preparar a alguien para algo",
      "questionEn": "How do you say that someone or something prepares a person for a later situation?",
      "answerEn": "Use preparar, identify the person being prepared, then use para before the later situation or action.",
      "noteEn": "Only preparar changes for the person and time. A short object word such as me, te, lo, la, nos, los, or las goes before a changed form of preparar. A named person instead follows a, the marker Spanish puts before a specific person receiving an action: prepara a Ana. Para then introduces what that person is being prepared for.",
      "example": {
        "es": "El curso prepara a Ana para el examen.",
        "en": "The course prepares Ana for the exam."
      },
      "tags": [
        "grammar",
        "preparar",
        "verb pattern",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
