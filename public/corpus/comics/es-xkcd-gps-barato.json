    {
      "id": "word-templado--proximity-game",
      "kind": "word",
      "promptEs": "templado",
      "answerEn": "warm; getting closer to the target in a hot-and-cold game",
      "noteEn": "Templado literally describes a mild or warm temperature. As a game clue, it marks progress between frío, which is far away, and caliente, which is very close.",
      "example": {
        "es": "Templado... Acércate un poco más.",
        "en": "Warm... Come a little closer."
      },
