      "id": "word-estoy--location",
      "kind": "word",
      "promptEs": "estoy",
      "answerEn": "I am (at a location)",
      "noteEn": "Spanish uses a form of estar, rather than ser, to say where someone or something is. Estoy is the form for the speaker.",
      "example": {
        "es": "Estoy en casa.",
        "en": "I am at home."
      },
      "tags": [
        "word",
        "location",
        "estar",
        "A1"
      ],
