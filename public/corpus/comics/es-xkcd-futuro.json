    {
      "id": "word-ven--come-command",
      "kind": "word",
      "promptEs": "ven",
      "answerEn": "come (informal command to one person)",
      "noteEn": "Ven is the irregular positive command of venir, ‘to come,’ for tú, the familiar singular ‘you.’",
      "example": {
        "es": "Ven aquí, por favor.",
        "en": "Come here, please."
      },
      "tags": [
        "word",
        "command",
        "venir",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-futuro",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-affirmative-tu-command",
      "kind": "grammar",
      "promptEs": "orden afirmativa para tú: habla, come, escribe",
      "questionEn": "How do you give one friend or familiar person a positive command?",
      "answerEn": "Use the informal singular command form, often the same form used for “he” or “she” in the present.",
      "noteEn": "For many regular verbs, -ar becomes -a and -er or -ir becomes -e: hablar becomes habla, comer becomes come, and escribir becomes escribe. Some common verbs are irregular or change their stem. Negative commands use a different form and are a separate pattern.",
      "example": {
        "es": "Abre la ventana.",
        "en": "Open the window."
      },
      "tags": [
        "grammar",
        "commands",
        "A2"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-sustituto",
        "contextualSenseReviewed": true
      }
    },
    {
      "id": "grammar-venir-a-infinitive-purpose",
      "kind": "grammar",
      "promptEs": "venir a + verbo en forma de diccionario",
      "questionEn": "How do you say that someone comes in order to do an activity?",
      "answerEn": "Use a form of venir, then a, then the action verb in its unchanged dictionary form.",
      "noteEn": "Venir changes for the person, time, or command: viene, vinieron, ven, and so on. The activity after a stays in its dictionary form ending in -ar, -er, or -ir. This lesson is about literal movement for a purpose; other figurative uses of venir a are separate.",
      "example": {
        "es": "Lucía viene a estudiar.",
        "en": "Lucía comes to study."
      },
      "tags": [
        "grammar",
        "movement",
        "purpose",
        "infinitive",
        "A1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
