    {
      "id": "grammar-relative-superlative",
      "kind": "grammar",
      "promptEs": "el/la/los/las + sustantivo + más + adjetivo",
      "questionEn": "How do you describe someone or something as the most of a quality?",
      "answerEn": "Use the matching form of “the,” name the person or thing, then add más plus the describing word.",
      "noteEn": "The opening el, la, los, or las agrees with the noun. Más stays unchanged, while the final adjective changes when Spanish normally requires agreement.",
      "example": {
        "es": "Es la calle más larga.",
        "en": "It is the longest street."
      },
      "tags": [
