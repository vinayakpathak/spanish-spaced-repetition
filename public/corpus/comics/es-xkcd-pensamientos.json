    {
      "id": "word-conocerte",
      "kind": "word",
      "promptEs": "conocerte",
      "answerEn": "to meet you; to get to know you",
      "noteEn": "Conocerte combines conocer, “to meet or get to know,” with te, the informal singular word for “you.” Te attaches to the unchanged dictionary form conocer.",
      "example": {
        "es": "Quiero conocerte mejor.",
        "en": "I want to get to know you better."
      },
      "tags": [
