    {
      "id": "word-a--personal-a",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; marks a specific person as the object",
      "noteEn": "Spanish generally places a before a specific person who receives a verb’s action. This “personal a” is not translated as a separate English word.",
      "example": {
        "es": "Veo a Marta.",
        "en": "I see Marta."
      },
