    {
      "id": "grammar-cuando-future-subjunctive",
      "kind": "grammar",
      "promptEs": "cuando + presente de subjuntivo para un hecho futuro",
      "questionEn": "After cuando, how do you describe an event that has not happened yet?",
      "answerEn": "Use cuando followed by a present subjunctive form for the future event; put the main result in an ordinary future or command form.",
      "noteEn": "The subjunctive is a special verb form used here because the time of the future event is not yet a fact. For example, mover changes to mueva. Spanish does not normally put a future-tense form immediately after cuando in this pattern.",
      "example": {
        "es": "Te llamaré cuando llegue.",
        "en": "I will call you when I arrive."
      },
      "tags": [
        "grammar",
        "time clauses",
        "subjunctive",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
      "schedulable": true,
      "provenance": {
        "method": "ai-authored-internal-qa",
        "ownerComicId": "es-xkcd-fuerza-centrifuga",
        "contextualSenseReviewed": true
      }
    },
