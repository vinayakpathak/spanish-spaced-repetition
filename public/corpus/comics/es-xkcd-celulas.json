    {
      "id": "word-afirme--future-subjunctive",
      "kind": "word",
      "promptEs": "afirme",
      "answerEn": "claims; asserts (a future-triggered special form)",
      "noteEn": "Afirme is the present subjunctive form of afirmar for one person. After cuando, it presents a future claim whose occurrence is not yet a fact.",
      "example": {
        "es": "Escucha cuando ella afirme algo distinto.",
        "en": "Listen when she claims something different."
      },
      "tags": [
        "word",
        "subjunctive",
        "future time",
        "B1"
      ],
      "reviewStatus": "ai-authored-internal-qa",
