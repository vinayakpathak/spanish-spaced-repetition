    {
      "id": "grammar-interesarse-en",
      "kind": "grammar",
      "promptEs": "interesarse en + actividad",
      "questionEn": "How do you say that someone becomes interested in an activity?",
      "answerEn": "Use a reflexive form of interesarse, then en, then the activity.",
      "noteEn": "The small reflexive word changes with the person: me intereso, te interesas, se interesa, and so on. En introduces the subject or activity that attracts the person's interest.",
      "example": {
        "es": "Me interesé en aprender italiano.",
        "en": "I became interested in learning Italian."
      },
      "tags": ["A2", "grammar", "reflexive verb", "preposition"]
    },
    {
      "id": "phrase-hacer-ejercicio",
      "kind": "phrase",
      "promptEs": "hacer ejercicio",
      "questionEn": "How do you say “to exercise” or “to work out”?",
      "answerEn": "Use hacer ejercicio.",
      "noteEn": "Spanish commonly builds this activity with hacer, “to do,” plus ejercicio. The expression covers physical exercise generally.",
      "example": {
        "es": "Hago ejercicio tres veces por semana.",
        "en": "I exercise three times a week."
      },
      "tags": ["A1", "expression", "fitness"]
    },
    {
      "id": "grammar-asociar-algo-a-algo",
      "kind": "grammar",
      "promptEs": "asociar algo a otra cosa",
      "questionEn": "How do you say that you connect one thing with another in your mind?",
      "answerEn": "Use asociar for the first thing, then a before the thing it is connected with.",
      "noteEn": "The first thing can be a noun or an object word such as lo. The a introduces the second idea. Spanish also uses asociar con in many varieties and contexts.",
      "example": {
        "es": "Asocio esa canción a mis vacaciones.",
        "en": "I associate that song with my vacation."
      },
      "tags": ["B1", "grammar", "verb pattern", "preposition"]
    },
    {
      "id": "phrase-subir-de-nivel",
      "kind": "phrase",
      "promptEs": "subir de nivel",
      "questionEn": "How do you say “to level up” or advance to a higher level?",
      "answerEn": "Use subir de nivel.",
      "noteEn": "This expression is common in games, study systems, and other ranked progress. Subir supplies the upward movement, while de nivel names the change in level.",
      "example": {
        "es": "Necesito más puntos para subir de nivel.",
        "en": "I need more points to level up."
      },
      "tags": ["A2", "expression", "gaming", "progress"]
    },
    {
      "id": "concept-rpg-character-attributes",
