      "id": "word-y--so-question",
      "kind": "word",
      "promptEs": "y",
      "answerEn": "so?; and? (asking why that matters)",
      "noteEn": "A standalone ¿y? asks for the point or consequence of what was just said. This is different from ordinary y joining two items with ‘and.’",
      "example": {
        "es": "—Voy a salir. —¿Y?",
        "en": "—I'm going out. —So?"
      },
      "tags": ["word", "conversation", "question", "discourse", "A1"]
    },
