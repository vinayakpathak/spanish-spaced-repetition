    { "id": "word-vuestro", "kind": "word", "promptEs": "vuestro", "answerEn": "your (informal plural, before a masculine singular noun)", "noteEn": "", "tags": ["word", "possessive", "informal plural"] },
    {
      "id": "grammar-ir-a-infinitive-movement",
      "kind": "grammar",
      "promptEs": "ir a + infinitivo · movimiento con propósito",
      "questionEn": "How do you say that someone physically goes to do an action?",
      "answerEn": "Use a form of ir, then a, then the action verb in its unchanged dictionary form.",
      "noteEn": "Ir changes for the person and time, while the final action stays in the dictionary form ending in -ar, -er, or -ir. Context can make this pattern describe real movement toward an activity, rather than the separate near-future meaning “going to do.”",
      "example": { "es": "Fuimos a buscar pan.", "en": "We went to get bread." },
      "tags": ["A2", "grammar", "movement", "purpose"]
    },
    {
      "id": "grammar-nosotros-command",
      "kind": "grammar",
      "promptEs": "propuesta para nosotros: hablemos, comamos, vivamos",
      "questionEn": "How do you propose an action for a group that includes yourself, like “let's talk”?",
      "answerEn": "Use the special “we” proposal form: most -ar verbs take -emos, while most -er and -ir verbs take -amos.",
      "noteEn": "Start from the verb's dictionary form, the unchanged form ending in -ar, -er, or -ir. Hablar becomes hablemos, comer becomes comamos, and vivir becomes vivamos. Some verbs also change their spelling or base, so learn unfamiliar forms as you meet them.",
      "example": { "es": "Busquemos otra mesa.", "en": "Let's look for another table." },
      "tags": ["A2", "grammar", "proposals", "we-form"]
    },
    {
      "id": "phrase-qué-tal-option",
      "kind": "phrase",
      "promptEs": "¿qué tal + opción?",
      "questionEn": "How do you ask for an opinion about an option or suggest it for consideration?",
      "answerEn": "Use ¿qué tal...? before or around the option, much like “how about...?”",
      "noteEn": "Qué keeps its written accent in the question. Tal completes this fixed expression, and the option can be a noun, a pronoun such as ese, or a time such as mañana.",
      "example": { "es": "¿Qué tal el viernes?", "en": "How about Friday?" },
      "tags": ["A1", "phrase", "suggestions", "questions"]
    },
    {
      "id": "phrase-salir-a-cuenta",
      "kind": "phrase",
      "promptEs": "salir(le) (más) a cuenta",
      "questionEn": "How do you say that a choice is worthwhile or works out as better value for someone?",
      "answerEn": "Use a form of salir followed by a cuenta. Add más for “better value,” and place me, te, le, nos, os, or les before salir when naming who benefits.",
      "noteEn": "This is a fixed use of salir; translating it as “to go out” would be misleading. Salir changes for the thing being evaluated, while a cuenta stays fixed. The short word before salir identifies the person affected, if one is stated.",
      "example": { "es": "Nos sale más a cuenta el abono mensual.", "en": "The monthly pass works out as better value for us." },
      "tags": ["B1", "phrase", "value", "shopping"]
    },
    {
      "id": "grammar-duration-después",
      "kind": "grammar",
      "promptEs": "cantidad de tiempo + después",
      "questionEn": "How do you say that something happens a stated amount of time later?",
      "answerEn": "Put the length of time before después.",
      "noteEn": "The duration comes first: tres días después means “three days later.” This differs from después de tres días, which presents the same duration after después and means “after three days.”",
      "example": { "es": "Tres días después, llegó la carta.", "en": "Three days later, the letter arrived." },
      "tags": ["A2", "grammar", "time", "sequence"]
    }
