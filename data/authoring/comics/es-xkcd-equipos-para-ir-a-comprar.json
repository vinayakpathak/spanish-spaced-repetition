    {
      "id": "word-pillemos--lets-get",
      "kind": "word",
      "promptEs": "pillemos",
      "answerEn": "let's get; let's grab",
      "noteEn": "Pillemos is a “we” proposal form of pillar, an informal verb that can mean “to get” or “to grab.” The -emos ending turns pillar into a suggestion for the group.",
      "example": { "es": "Pillemos un taxi.", "en": "Let's get a taxi." },
      "tags": ["word", "proposal", "colloquial", "we-form"]
    },
    {
      "id": "word-ese--pronoun",
      "kind": "word",
      "promptEs": "ese",
      "answerEn": "that one (masculine singular)",
      "noteEn": "When ese appears without a following noun, it stands in for a masculine singular thing already visible or understood.",
      "example": { "es": "Prefiero ese.", "en": "I prefer that one." },
      "tags": ["word", "demonstrative", "pronoun"]
    },
    {
      "id": "word-qué--fixed-qué-tal",
      "kind": "word",
      "promptEs": "qué",
      "answerEn": "how (as part of qué tal, “how about...?”)",
      "noteEn": "In qué tal, qué keeps its accent and joins tal to ask for an opinion or propose an option. Translate the two words together rather than assigning qué its ordinary “what” meaning by itself.",
      "example": { "es": "¿Qué tal esta mesa?", "en": "How about this table?" },
      "tags": ["word", "fixed expression", "questions"]
    },
    {
      "id": "word-tal--fixed-qué-tal",
      "kind": "word",
      "promptEs": "tal",
      "answerEn": "no separate English word; completes qué tal, “how about...?”",
      "noteEn": "Tal completes qué tal, a common expression used to ask how something is or to suggest an option. It does not have a useful separate English translation in this expression.",
      "example": { "es": "¿Qué tal mañana?", "en": "How about tomorrow?" },
      "tags": ["word", "fixed expression", "questions"]
    },
    {
      "id": "word-sale--fixed-salir-a-cuenta",
      "kind": "word",
      "promptEs": "sale",
      "answerEn": "is worthwhile; works out as good value (as part of salir a cuenta)",
      "noteEn": "Sale normally comes from salir, “to go out,” but in salir a cuenta it describes whether a choice works out as worthwhile or good value.",
      "example": { "es": "El pase mensual sale a cuenta.", "en": "The monthly pass is worthwhile." },
      "tags": ["word", "fixed expression", "value"]
    },
    {
      "id": "word-a--fixed-salir-a-cuenta",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; part of salir a cuenta",
      "noteEn": "This a is required inside the fixed expression salir a cuenta, meaning that something works out as worthwhile or good value.",
      "example": { "es": "Comprar el paquete sale a cuenta.", "en": "Buying the package is worthwhile." },
      "tags": ["word", "fixed expression", "preposition"]
    },
    {
      "id": "word-cuenta--fixed-salir-a-cuenta",
      "kind": "word",
      "promptEs": "cuenta",
      "answerEn": "no separate English word; completes salir a cuenta, “to be worthwhile”",
      "noteEn": "Cuenta can mean an account or a bill elsewhere. In salir a cuenta, the whole expression evaluates whether something is advantageous or good value.",
      "example": { "es": "El billete de ida y vuelta sale a cuenta.", "en": "The round-trip ticket is good value." },
      "tags": ["word", "fixed expression", "value"]
    },
    {
      "id": "word-nos--beneficiary",
      "kind": "word",
      "promptEs": "nos",
      "answerEn": "for us; to our advantage",
      "noteEn": "Before a verb such as salir or resultar, nos can identify the people for whom an outcome is advantageous, costly, easy, or difficult.",
      "example": { "es": "Nos resulta más barato viajar juntos.", "en": "It works out cheaper for us to travel together." },
      "tags": ["word", "pronoun", "affected person"]
    },
