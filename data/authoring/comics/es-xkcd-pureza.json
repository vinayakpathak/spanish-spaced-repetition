  "titleText": {
    "es": "Por otro lado, a los físicos les gusta decir que la física es a la matemática lo que el sexo a la masturbación.",
    "en": "On the other hand, physicists like to say physics is to math as sex is to masturbation.",
    "noteEn": "The Spanish archive preserves the same separate analogy as the official English title text."
  },
  "cardDefinitions": [
    {
      "id": "word-campos--academic-fields",
      "kind": "word",
      "promptEs": "campos",
      "answerEn": "fields; areas of study",
      "noteEn": "Campo can mean a physical field, but in an academic context it means an area of knowledge or study. Campos is its plural.",
      "example": { "es": "La historia y la química son campos distintos.", "en": "History and chemistry are different fields." },
      "tags": ["word", "academia", "plural", "A2"]
    },
    {
      "id": "word-ordenados--ranked",
      "kind": "word",
      "promptEs": "ordenados",
      "answerEn": "ordered; ranked (masculine plural)",
      "noteEn": "Ordenados describes several masculine or mixed items placed in an order. In a heading, that order can be a ranking by some criterion.",
      "example": { "es": "Los resultados están ordenados por fecha.", "en": "The results are ordered by date." },
      "tags": ["word", "ordering", "past participle", "plural", "A2"]
    },
    {
      "id": "word-pureza",
      "kind": "word",
      "promptEs": "pureza",
      "answerEn": "purity",
      "noteEn": "Pureza is the quality of being pure. It can be literal, or figurative when an idea is presented as abstract and free from practical complications.",
      "example": { "es": "El laboratorio mide la pureza del agua.", "en": "The laboratory measures the purity of the water." },
      "tags": ["word", "quality", "noun", "B1"]
    },
    {
      "id": "word-puros",
      "kind": "word",
      "promptEs": "puros",
      "answerEn": "pure (masculine plural)",
      "noteEn": "Puros is the masculine plural form of puro. In a ranking of academic fields, it describes fields as more abstract or theoretical rather than more practical.",
      "example": { "es": "Buscan materiales puros.", "en": "They are looking for pure materials." },
      "tags": ["word", "adjective", "plural", "B1"]
    },
    {
      "id": "word-sociología",
      "kind": "word",
      "promptEs": "sociología",
      "answerEn": "sociology",
      "noteEn": "Sociología is the study of societies, social relationships, and institutions.",
      "example": { "es": "Estudia sociología en la universidad.", "en": "She studies sociology at the university." },
      "tags": ["word", "academic field", "social science", "A2"]
    },
    {
      "id": "word-psicología",
      "kind": "word",
      "promptEs": "psicología",
      "answerEn": "psychology",
      "noteEn": "Psicología is the study of the mind, behavior, and mental processes.",
      "example": { "es": "La psicología estudia la conducta humana.", "en": "Psychology studies human behavior." },
      "tags": ["word", "academic field", "social science", "A2"]
    },
    {
      "id": "word-biología",
      "kind": "word",
      "promptEs": "biología",
      "answerEn": "biology",
      "noteEn": "Biología is the scientific study of living things.",
      "example": { "es": "La biología estudia los seres vivos.", "en": "Biology studies living things." },
      "tags": ["word", "academic field", "science", "A2"]
    },
    {
      "id": "word-química",
      "kind": "word",
      "promptEs": "química",
      "answerEn": "chemistry",
      "noteEn": "Química is the science of substances, their properties, and how they change.",
      "example": { "es": "Tenemos una clase de química.", "en": "We have a chemistry class." },
      "tags": ["word", "academic field", "science", "A2"]
    },
    {
      "id": "word-aplicada--academic-field",
      "kind": "word",
      "promptEs": "aplicada",
      "answerEn": "applied; put to practical use (feminine singular)",
      "noteEn": "In the name or description of a field, aplicada contrasts practical use with more abstract theory. Use feminine singular aplicada with a feminine singular field name, such as física or lingüística.",
      "example": { "es": "El curso trata de lingüística aplicada.", "en": "The course is about applied linguistics." },
      "tags": ["word", "adjective", "academia", "feminine singular", "B1"]
    },
    {
      "id": "word-está--impersonal-evaluation",
      "kind": "word",
      "promptEs": "está",
      "answerEn": "it is (introducing an evaluation)",
      "noteEn": "In está bien followed by an action, está introduces a general judgment. Spanish does not add a separate word for English “it.”",
      "example": { "es": "Está bien pedir ayuda.", "en": "It is good to ask for help." },
      "tags": ["word", "estar", "impersonal evaluation", "A2"]
    },
    {
      "id": "word-cima",
      "kind": "word",
      "promptEs": "cima",
      "answerEn": "top; summit",
      "noteEn": "Cima is the highest point of a mountain or, figuratively, the top position in a ranking.",
      "example": { "es": "Llegaron a la cima de la montaña.", "en": "They reached the summit of the mountain." },
      "tags": ["word", "location", "ranking", "A2"]
    },
    {
      "id": "word-lejos",
      "kind": "word",
      "promptEs": "lejos",
      "answerEn": "far; far away",
      "noteEn": "Lejos describes distance. It normally appears without changing form and often follows de before the point of reference.",
      "example": { "es": "La estación está lejos de aquí.", "en": "The station is far from here." },
      "tags": ["word", "distance", "adverb", "A1"]
    },
    {
      "id": "word-sociólogos",
