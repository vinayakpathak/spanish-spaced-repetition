    {
      "id": "phrase-gracias-por-infinitive",
      "kind": "phrase",
      "promptEs": "gracias por una acción",
      "questionEn": "How do you thank someone for doing something?",
      "answerEn": "Say gracias por, then put the action verb in its unchanged dictionary form.",
      "noteEn": "Por introduces the reason for the thanks. The following action stays in the dictionary form ending in -ar, -er, or -ir, even where English uses a verb ending in -ing.",
      "example": { "es": "Gracias por venir.", "en": "Thank you for coming." },
      "tags": ["phrase", "thanks", "infinitives", "A1"]
    },
    {
      "id": "grammar-no-parar-de-infinitive",
      "kind": "grammar",
      "promptEs": "no parar de hacer algo",
      "questionEn": "How do you say that something keeps doing an action without stopping?",
      "answerEn": "Use no, then a changed form of parar, then de, then the action verb in its unchanged dictionary form.",
      "noteEn": "Only parar changes for the person and time. The action after de stays in its dictionary form ending in -ar, -er, or -ir. Although the words literally say that the action does not stop, natural English often uses “keep doing.”",
      "example": { "es": "El bebé no para de reír.", "en": "The baby keeps laughing." },
      "tags": ["grammar", "continuation", "infinitives", "A2"]
    },
    {
      "id": "phrase-sin-control",
      "kind": "phrase",
      "promptEs": "sin control",
      "questionEn": "How do you say that something is uncontrolled or out of control?",
      "answerEn": "Use sin control.",
      "noteEn": "Sin means “without,” so sin control can describe movement or change that is no longer controlled. English may use “out of control” or an adverb such as “uncontrollably.”",
      "example": { "es": "El coche gira sin control.", "en": "The car spins out of control." },
      "tags": ["phrase", "control", "manner", "A2"]
    },
    {
      "id": "phrase-quedarse-con-alguien--tease",
      "kind": "phrase",
      "promptEs": "quedarse con alguien para bromear o engañar",
      "questionEn": "How can you say that someone is teasing, fooling, or putting another person on?",
      "answerEn": "In Spain, use a form of quedarse con followed by the person being teased or fooled.",
      "noteEn": "The small pronoun in quedarse changes with the person doing it: me, te, se, nos, or os. Context matters because quedarse con can also literally mean to keep something or stay with someone. In this idiomatic use, it describes not speaking sincerely to the other person.",
      "example": { "es": "No te quedes conmigo; dime la verdad.", "en": "Don't mess with me; tell me the truth." },
      "tags": ["phrase", "idioms", "Spain", "pronominal verbs", "B1"]
    },
    {
      "id": "phrase-palabra-clave",
      "kind": "phrase",
      "promptEs": "palabra clave",
      "questionEn": "How do you say “keyword” or “key term” in Spanish?",
      "answerEn": "Use palabra clave.",
      "noteEn": "Palabra names the word, and clave says it is important for access, searching, or identifying a topic. The common plural is palabras clave.",
      "example": { "es": "Busca una palabra clave.", "en": "Look for a keyword." },
      "tags": ["phrase", "technology", "search", "A2"]
    },
    {
      "id": "concept-linux-windows-aol-support-mismatch",
      "kind": "concept",
      "promptEs": "Apache y Linux frente a Menú Inicio, Mis Documentos y AOL",
      "answerEn": "Apache can run as a web server on Linux, while Start and My Documents are Windows interface names and AOL Keywords belonged to AOL. Those steps do not address the caller's Linux server problem.",
      "noteEn": "The Black Hat character deliberately gives obsolete, mismatched consumer-computer instructions. The growing mismatch is the central support-call joke.",
      "tags": ["concept", "technology", "Linux", "Windows", "AOL", "support"]
    }
  ],
