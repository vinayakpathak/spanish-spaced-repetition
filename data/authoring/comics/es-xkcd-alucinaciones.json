    {
      "id": "word-nos--pronominal-marker",
      "kind": "word",
      "promptEs": "nos",
      "answerEn": "no separate English word here; marks a “we” verb that is used with nos",
      "noteEn": "Some Spanish verbs conventionally come with me, te, se, nos, or os even when no one literally acts on themselves. Nos marks the form for a group that includes the speaker. English usually absorbs it into the verb's meaning.",
      "example": {
        "es": "Nos quejamos del ruido.",
        "en": "We complain about the noise."
      },
      "tags": ["word", "pronouns", "pronominal verbs", "A2"]
    },
    {
      "id": "word-me--pronominal-marker",
      "kind": "word",
      "promptEs": "me",
      "answerEn": "no separate English word here; marks an “I” verb that is used with me",
      "noteEn": "Some Spanish verbs conventionally come with me, te, se, nos, or os even when no one literally acts on themselves. Me marks the speaker's form. English usually absorbs it into the verb's meaning.",
      "example": {
        "es": "Me quejo del ruido.",
        "en": "I complain about the noise."
      },
      "tags": ["word", "pronouns", "pronominal verbs", "A2"]
    },
    {
      "id": "word-tomemos--take-subjunctive",
      "kind": "word",
      "promptEs": "tomemos",
      "answerEn": "we take; we handle (in a form used after a judgment or reaction)",
      "noteEn": "Tomemos is a “we” form of tomar used when the action is presented through a judgment, reaction, wish, or similar trigger rather than as a plain fact. The ordinary form tomamos changes its -amos ending to -emos.",
      "example": {
        "es": "Es importante que tomemos notas.",
        "en": "It is important that we take notes."
      },
      "tags": ["word", "verbs", "subjunctive", "B1"]
    },
    {
      "id": "word-soñar--act-of-dreaming",
      "kind": "word",
      "promptEs": "soñar",
      "answerEn": "dreaming; the act of dreaming",
      "noteEn": "Soñar is the verb's unchanged dictionary form, normally meaning “to dream.” When el appears before it, Spanish can treat the activity itself like a noun.",
      "example": {
        "es": "El soñar inspira a la artista.",
        "en": "Dreaming inspires the artist."
      },
      "tags": ["word", "verbs", "sleep", "B1"]
