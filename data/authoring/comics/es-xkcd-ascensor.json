    { "id": "word-planta--building-floor", "kind": "word", "promptEs": "planta", "answerEn": "floor; storey (of a building)", "noteEn": "Planta can mean a plant, the sole of a foot, or a floor in a building. On an elevator sign or building directory, planta means a floor of a building.", "example": { "es": "La oficina está en la tercera planta.", "en": "The office is on the third floor." }, "tags": ["word", "building", "floor", "polysemy"] },
    { "id": "word-escribe--action-caption", "kind": "word", "promptEs": "escribe", "answerEn": "writes; is writing (action caption)", "noteEn": "Escribe is the present form of escribir for él, ella, or usted. The same written form can also be an informal command. In an action caption, it narrates what the person does.", "example": { "es": "Marta escribe una nota.", "en": "Marta writes a note." }, "tags": ["word", "escribir", "present", "third person", "caption"] },
    { "id": "word-zepelin--printed-missing-accent", "kind": "word", "promptEs": "zepelin", "answerEn": "zeppelin; printed without the accent required in standard Spanish", "noteEn": "The visible label says ZEPELIN. Standard Spanish writes zepelín, with one p and an accent on í; the German/English proper name is Zeppelin, with two p's.", "example": { "es": "El zepelín cruzó el cielo.", "en": "The zeppelin crossed the sky." }, "tags": ["word", "airship", "printed anomaly", "spelling", "accent"] },
    { "id": "word-pulsa--action-caption", "kind": "word", "promptEs": "pulsa", "answerEn": "presses; pushes (a button)", "noteEn": "Pulsa is the present form of pulsar for él, ella, or usted. It can also be an informal command; in an action caption it reports what the person does.", "example": { "es": "Ella pulsa el botón rojo.", "en": "She presses the red button." }, "tags": ["word", "pulsar", "present", "third person", "caption"] },
    { "id": "word-ding--sound", "kind": "word", "promptEs": "ding", "answerEn": "ding (bell or elevator sound)", "noteEn": "", "tags": ["word", "onomatopoeia", "sound"] },
    {
      "id": "grammar-present-third-person-regular",
      "kind": "grammar",
      "promptEs": "presente regular para él/ella/usted",
      "questionEn": "How do regular present-tense verbs change for “he,” “she,” or formal singular “you”?",
      "answerEn": "For -ar verbs, replace -ar with -a; for -er and -ir verbs, replace the ending with -e.",
      "noteEn": "Hablar becomes habla, comer becomes come, and escribir becomes escribe. Comics also use this same form as a short caption that reports one person's action. Some verbs are irregular and must be learned separately.",
      "example": { "es": "Ella abre la ventana.", "en": "She opens the window." },
      "tags": ["grammar", "present", "third person", "regular verbs", "A1"]
    },
    {
      "id": "concept-zeppelin-airship",
      "kind": "concept",
      "promptEs": "zepelín / Zeppelin",
      "answerEn": "a large rigid airship whose shape is held by an internal framework",
      "noteEn": "The craft is named after German airship pioneer Ferdinand von Zeppelin. A blimp keeps its shape mainly from internal gas pressure; a Zeppelin-style rigid airship has a structural frame.",
      "tags": ["concept", "airship", "transport", "history"]
    }
