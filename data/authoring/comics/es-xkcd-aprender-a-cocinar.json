      ]
    },
    {
      "id": "word-sartén",
      "kind": "word",
      "promptEs": "sartén",
      "answerEn": "frying pan; pan",
      "noteEn": "Sartén names the shallow pan used for frying or cooking on a stove. It can be masculine or feminine depending on region; this occurrence uses feminine la.",
      "example": {
        "es": "Calienta aceite en la sartén.",
        "en": "Heat oil in the frying pan."
