    {
      "id": "phrase-saber-bien--taste-good",
      "kind": "phrase",
      "promptEs": "saber bien",
      "questionEn": "How do you say that food or drink tastes good?",
      "answerEn": "Use a form of saber followed by bien.",
      "noteEn": "Here saber describes flavor rather than knowledge. Saber changes to match what has the flavor: la sopa sabe bien, las verduras saben bien. Bien stays unchanged.",
      "example": {
        "es": "Este té sabe bien.",
        "en": "This tea tastes good."
      },
      "tags": [
        "phrase",
        "taste",
        "food",
        "A2"
      ]
    },
    {
      "id": "grammar-ir-gerundio",
      "kind": "grammar",
      "promptEs": "ir + acción en -ando/-iendo",
      "questionEn": "How do you say that an action or change develops gradually?",
      "answerEn": "Use a matching form of ir followed by the action form ending in -ando or -iendo.",
      "noteEn": "Ir changes for the person and time: voy, vas, va, vamos, van. The following action form stays unchanged and presents a process unfolding bit by bit: mejorar becomes mejorando.",
      "example": {
        "es": "La situación va mejorando.",
        "en": "The situation is gradually improving."
      },
      "tags": [
        "grammar",
        "gradual change",
        "gerund",
        "B1"
      ]
    },
    {
      "id": "concept-cooking-leftovers-delay-cycle",
      "kind": "concept",
      "promptEs": "cocinar · sobras · pizza · ingredientes",
      "questionEn": "How does the flowchart turn an attempt to cook into a repeating cycle?",
      "answerEn": "Each attempt produces leftovers, delayed takeout meals, and discarded food before the desire to cook returns.",
      "noteEn": "The arrows trace a self-defeating routine: ingredients are bought and partly cooked, pizza replaces the leftovers, the remaining food spoils over progressively longer delays, and the months-later arrow returns to the original resolution. The structure makes procrastination itself the recipe.",
      "example": {
        "es": "El diagrama muestra un ciclo que vuelve al principio.",
        "en": "The diagram shows a cycle that returns to the beginning."
      },
      "tags": [
        "concept",
        "cooking",
        "flowchart",
        "procrastination",
        "joke"
      ]
    }
