    },
    {
      "id": "word-poner",
      "kind": "word",
      "promptEs": "poner",
      "answerEn": "to put; to place",
      "noteEn": "Poner is an irregular verb whose first-person present form is pongo. Its dictionary form stays poner after words such as deber or poder.",
      "example": {
        "es": "Voy a poner el plato en la mesa.",
        "en": "I am going to put the plate on the table."
      },
      "tags": [
