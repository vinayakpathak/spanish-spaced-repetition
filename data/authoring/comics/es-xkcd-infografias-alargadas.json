  "titleEn": "Tall Infographics",
  "titleEs": "Infografías alargadas",
  "titleText": {
    "es": "'Big Data' no significa aumentar el tamaño de la letra.",
    "en": "'Big Data' doesn't just mean increasing the font size.",
    "noteEn": "Both title attributes are preserved exactly. The source is one intentionally tall infographic rather than dialogue panels. OCR fused 2019 with 2020, omitted several small chart labels, split the artistic vertical SERÁ and MESES layouts, and mistook chart artwork for letters; the transcript follows the legible raster instead."
  },
  "cardDefinitions": [
    {
      "id": "word-comunicada--communicated",
      "kind": "word",
      "promptEs": "comunicada",
      "answerEn": "communicated; conveyed",
      "noteEn": "Comunicada is the feminine singular completed-action form of comunicar. It can describe feminine information or news that is conveyed.",
      "example": {
        "es": "La decisión será comunicada mañana.",
        "en": "The decision will be communicated tomorrow."
      },
      "tags": [
        "word",
        "communication",
        "participle",
        "B1"
      ]
    },
    {
      "id": "word-conciso",
      "kind": "word",
      "promptEs": "conciso",
      "answerEn": "concise; brief and clear",
      "noteEn": "Conciso describes something that expresses what is needed without unnecessary words.",
      "example": {
        "es": "El informe es claro y conciso.",
        "en": "The report is clear and concise."
      },
      "tags": [
        "word",
        "description",
        "adjective",
        "B1"
      ]
    },
    {
      "id": "word-formato",
      "kind": "word",
