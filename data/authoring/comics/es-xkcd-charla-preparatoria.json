  "titleEn": "Pep Talk",
  "titleEs": "Charla preparatoria",
  "titleText": {
    "es": "¡Escuchad! ¡Dicen que un equipo de jugadores de ajedrez entrenados por alguien que no sabe nada de baloncesto nunca sería competitivo en la NBA! Bien, resultaron ser bastante perspicaces.",
    "en": "Listen!  They said a team of chess players coached by someone with no understanding of basketball would never be competitive in the NBA!  Well, it turns out they're pretty perceptive.",
    "noteEn": "The Spanish archive closely translates the official title text and uses escuchad, an informal plural command common in Spain. The English text preserves the official two-space breaks after the exclamations."
  },
  "cardDefinitions": [
    {
      "id": "word-venga--encouragement",
      "kind": "word",
      "promptEs": "venga",
      "answerEn": "come on; let's go (encouragement)",
      "noteEn": "Venga is a form of venir, but speakers also use it by itself to urge or encourage someone. In that use it does not literally tell the listener to come to a place.",
      "example": { "es": "¡Venga, equipo, podemos hacerlo!", "en": "Come on, team, we can do it!" },
      "tags": ["word", "encouragement", "interjection", "A2"]
    },
    {
      "id": "word-vamos--score-standing",
      "kind": "word",
      "promptEs": "vamos",
      "answerEn": "we are; we stand (at a current score or level)",
      "noteEn": "A form of ir can describe how a game, result, or process is going. In vamos tres puntos por debajo, vamos reports the team's current standing rather than movement toward a place or a proposal to act.",
      "example": { "es": "Vamos dos puntos por encima.", "en": "We are two points ahead." },
      "tags": ["word", "ir", "sports", "current standing", "A2"]
    },
    {
      "id": "word-dieciséis",
      "kind": "word",
      "promptEs": "dieciséis",
      "answerEn": "sixteen",
      "noteEn": "Dieciséis is written as one word and carries a written accent on the final e sound.",
      "example": { "es": "Hay dieciséis sillas.", "en": "There are sixteen chairs." },
      "tags": ["word", "number", "A1"]
    },
    {
      "id": "word-por--score-behind",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "no separate English word; works with por debajo after an amount",
      "noteEn": "After a difference in points or another measured amount, por links that amount to debajo or encima. English usually expresses the whole combination as an amount behind, below, ahead, or above.",
      "example": { "es": "Van tres puntos por debajo.", "en": "They are three points behind." },
      "tags": ["word", "preposition", "score", "fixed pattern", "A2"]
    },
    {
      "id": "word-debajo--score-standing",
      "kind": "word",
      "promptEs": "debajo",
      "answerEn": "behind; down (after an amount and por)",
      "noteEn": "Por debajo can describe a lower position. After an amount in a game or comparison, debajo gives the idea of being that amount behind or down.",
      "example": { "es": "El equipo va un gol por debajo.", "en": "The team is one goal behind." },
      "tags": ["word", "position", "score", "A2"]
    },
    {
      "id": "word-queremos",
      "kind": "word",
      "promptEs": "queremos",
      "answerEn": "we want",
      "noteEn": "Queremos is the present form of querer for nosotros or nosotras. A following action stays in its unchanged dictionary form: queremos salir.",
      "example": { "es": "Queremos descansar.", "en": "We want to rest." },
      "tags": ["word", "querer", "we", "A1"]
    },
    {
      "id": "word-remontar--sports-comeback",
      "kind": "word",
      "promptEs": "remontar",
      "answerEn": "to come back; to recover from a deficit",
      "noteEn": "In a game or competition, remontar means to overcome a disadvantage in the score or standings. Outside sports it can also describe overcoming another difficult situation.",
      "example": { "es": "El equipo logró remontar en la segunda parte.", "en": "The team managed to come back in the second half." },
      "tags": ["word", "sports", "competition", "verb", "B1"]
    },
    {
      "id": "word-esta--situation-pronoun",
      "kind": "word",
      "promptEs": "esta",
      "answerEn": "this one; this situation (standing without a following noun)",
      "noteEn": "Esta can stand in for a feminine thing or situation that is already understood instead of appearing before a noun. Modern standard spelling normally leaves it without a written accent in this use.",
      "example": { "es": "Prefiero esta.", "en": "I prefer this one." },
      "tags": ["word", "demonstrative", "pronoun", "A2"]
    },
    {
      "id": "word-ohhh--cheer",
      "kind": "word",
      "promptEs": "ohhh",
      "answerEn": "ooh!; whoa! (an excited cheer)",
      "noteEn": "Ohhh represents an excited vocal reaction. Writers can lengthen the h to show that the sound is being held for longer.",
      "example": { "es": "¡Ohhh, qué jugada!", "en": "Ooh, what a play!" },
      "tags": ["word", "interjection", "sound", "excitement", "A1"]
    },
    {
      "id": "word-canasta--basketball-score",
      "kind": "word",
      "promptEs": "canasta",
      "answerEn": "basket; score (in basketball)",
      "noteEn": "A canasta is a basket. In basketball, ¡Canasta! can announce that a shot has gone in and scored points.",
      "example": { "es": "El tiro terminó en canasta.", "en": "The shot ended in a basket." },
      "tags": ["word", "basketball", "sports", "feminine noun", "A2"]
    },
    {
      "id": "word-dieciocho",
      "kind": "word",
      "promptEs": "dieciocho",
      "answerEn": "eighteen",
      "noteEn": "Dieciocho is written as one word and does not carry a written accent.",
      "example": { "es": "El curso tiene dieciocho estudiantes.", "en": "The course has eighteen students." },
      "tags": ["word", "number", "A1"]
    },
    {
      "id": "word-escuchad--vosotros-command",
      "kind": "word",
      "promptEs": "escuchad",
      "answerEn": "listen (command to several people, mainly in Spain)",
      "noteEn": "Escuchad is the positive command form of escuchar for vosotros or vosotras. Most positive vosotros commands replace the dictionary form's final -r with -d: escuchar becomes escuchad.",
      "example": { "es": "Escuchad con atención.", "en": "Listen carefully, all of you." },
      "tags": ["word", "command", "vosotros", "Spain", "A2"]
    },
    {
      "id": "word-empiezo--begin",
      "kind": "word",
      "promptEs": "empiezo",
      "answerEn": "I start; I begin",
      "noteEn": "Empiezo is the present form of empezar for the speaker. The e changes to ie in this stressed form: empezar becomes empiezo.",
      "example": { "es": "Empiezo a trabajar a las nueve.", "en": "I start working at nine." },
      "tags": ["word", "empezar", "stem change", "A1"]
    },
    {
      "id": "word-descanso--halftime",
      "kind": "word",
      "promptEs": "descanso",
      "answerEn": "halftime; break; intermission",
      "noteEn": "Descanso can mean a rest or break. In a sports context, el descanso commonly names the interval between the two parts of a game.",
      "example": { "es": "Hablaron durante el descanso.", "en": "They talked during halftime." },
      "tags": ["word", "sports", "time", "masculine noun", "A2"]
    },
    {
      "id": "grammar-ir-cantidad-por-encima-debajo",
      "kind": "grammar",
      "promptEs": "ir + cantidad + por encima/debajo",
      "questionEn": "How do you state how far a team or result is currently ahead or behind?",
      "answerEn": "Use the matching form of ir, then the amount, followed by por encima for ahead or por debajo for behind.",
      "noteEn": "The plus signs mean “followed by,” the slash shows a choice between encima and debajo, and cantidad means the amount or difference. Here ir reports how a game, result, or process is currently going rather than movement toward a place. The amount can include its unit, as in vamos tres puntos por debajo.",
      "example": { "es": "Vamos tres puntos por debajo.", "en": "We are three points behind." },
      "tags": ["grammar", "ir", "amount", "comparison", "sports", "A2"]
    }
  ],
