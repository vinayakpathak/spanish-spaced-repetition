    {
      "id": "grammar-ser-clock-time",
      "kind": "grammar",
      "promptEs": "es la una · son las dos, tres...",
      "questionEn": "How do you state the clock time in Spanish?",
      "answerEn": "Use es la for one o'clock and son las for every other hour.",
      "noteEn": "Es and son are forms of ser, 'to be.' Spanish treats one o'clock as singular, es la una, and the other hours as plural, son las dos, son las tres, and so on. The feminine article la or las appears because hora or horas is understood.",
      "example": {
        "es": "Son las ocho.",
        "en": "It is eight o'clock."
      },
      "tags": ["grammar", "ser", "clock time", "agreement", "A1"]
    },
