    { "id": "word-descubrí--found-out", "kind": "word", "promptEs": "descubrí", "answerEn": "I discovered; I found out", "noteEn": "", "tags": ["word", "verb", "preterite", "A2"] },
    {
      "id": "word-había--past-perfect-helper",
      "kind": "word",
      "promptEs": "había",
      "answerEn": "had (helper for an earlier completed action)",
      "noteEn": "Before a completed-action form such as escrito, había is a past form of the helper haber. It places one completed action before another point in the past.",
      "example": { "es": "Ya había comido cuando llamaste.", "en": "I had already eaten when you called." },
      "tags": ["word", "helper verb", "past perfect", "B1"]
    },
    {
      "id": "word-escrito--completed-action",
      "kind": "word",
      "promptEs": "escrito",
      "answerEn": "written (completed-action form of escribir)",
      "noteEn": "Escrito is the irregular completed-action form, also called the past participle, of escribir. After a form of haber, it helps express that writing as completed.",
      "example": { "es": "Ana ha escrito una carta.", "en": "Ana has written a letter." },
      "tags": ["word", "verb form", "past participle", "A2"]
    },
    {
      "id": "word-dulce--sentimental",
      "kind": "word",
      "promptEs": "dulce",
      "answerEn": "sweet; sentimental",
      "noteEn": "Dulce can describe affectionate words or gestures as “sweet,” not only the taste of food.",
      "example": { "es": "Fue un gesto muy dulce.", "en": "It was a very sweet gesture." },
      "tags": ["word", "adjective", "figurative sense", "A2"]
    },
