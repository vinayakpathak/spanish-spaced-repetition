    {
      "id": "word-sector--disk-area",
      "kind": "word",
      "promptEs": "sector",
      "answerEn": "sector; fixed-size area of a disk",
      "noteEn": "In computing, a sector is one of the small fixed-size storage areas into which a disk is divided.",
      "example": { "es": "El disco tiene un sector dañado.", "en": "The disk has a damaged sector." },
      "tags": ["word", "computing", "noun", "B1"]
    },
    {
      "id": "word-arranque--startup-noun",
      "kind": "word",
      "promptEs": "arranque",
      "answerEn": "startup; booting",
      "noteEn": "In computing, arranque is the process of starting a computer and loading its operating system.",
      "example": { "es": "El arranque del ordenador fue lento.", "en": "The computer's startup was slow." },
      "tags": ["word", "computing", "noun", "B1"]
    },
    {
      "id": "grammar-estar-adjective-state",
      "kind": "grammar",
      "promptEs": "estar + palabra que describe un estado",
      "questionEn": "How do you describe how someone or something is feeling or doing at a particular time?",
      "answerEn": "Use a form of estar followed by a describing word for the state.",
      "noteEn": "Estar changes to match who or what has the state: estoy means “I am,” está means “he, she, or it is,” and están means “they are.” The describing word matches the person or thing in gender and number: enfadado, enfadada, enfadados, or enfadadas. This pattern presents the quality as a condition or state; ser is normally used for identity or a defining description.",
      "example": { "es": "Clara está cansada.", "en": "Clara is tired." },
      "tags": ["grammar", "estar", "states", "agreement", "A1"]
    },
    {
      "id": "grammar-past-perfect",
      "kind": "grammar",
      "promptEs": "había/habías/habíamos/habíais/habían + forma de acción completada",
      "questionEn": "How do you say that something had already happened before another past moment?",
      "answerEn": "Use the matching past form of haber, then the action verb's completed-action form.",
      "noteEn": "Use había for I, he, she, or one thing; habías for informal singular “you”; habíamos for “we”; habíais for informal plural “you” in Spain; and habían for “they” or plural formal “you.” The second verb uses a completed-action form, called a past participle: most -ar verbs end in -ado and most -er or -ir verbs end in -ido, although some are irregular, such as escribir → escrito. Only haber changes for the person; the completed-action form stays unchanged.",
      "example": { "es": "Ya habíamos terminado cuando llegó Luis.", "en": "We had already finished when Luis arrived." },
      "tags": ["grammar", "past perfect", "haber", "past sequence", "B1"]
    },
    {
      "id": "phrase-nota-de-amor",
      "kind": "phrase",
      "promptEs": "nota de amor",
      "questionEn": "How do you refer to a short written message that expresses romantic affection?",
      "answerEn": "Use nota de amor for a love note.",
      "noteEn": "Nota names the short message, and de amor identifies it by its romantic subject or purpose. Spanish uses de where English naturally puts love directly before note.",
      "example": { "es": "Le dejó una nota de amor.", "en": "She left him a love note." },
      "tags": ["phrase", "writing", "affection", "A2"]
    },
    {
      "id": "concept-boot-sector",
      "kind": "concept",
      "promptEs": "sector de arranque",
      "answerEn": "A boot sector is a small disk area that contains information used when a computer starts.",
      "noteEn": "A computer reads boot information before the operating system is fully running. Replacing that information with an ordinary message can stop startup and produce an error such as “Operating system not found,” which is the technical premise of the joke.",
      "tags": ["concept", "computing", "boot sector", "operating system"]
    }
  ],
