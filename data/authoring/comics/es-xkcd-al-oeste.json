      "noteEn": "",
      "tags": ["word", "noun", "A1"]
    },
    {
      "id": "word-profundo--depths",
      "kind": "word",
      "promptEs": "profundo",
      "answerEn": "deep part; depths (after lo)",
      "noteEn": "Lo can turn profundo, “deep,” into the general idea of a deep or innermost part.",
      "example": { "es": "La luz no llega a lo profundo de la cueva.", "en": "The light does not reach the depths of the cave." },
      "tags": ["word", "depth", "neutral lo", "A2"]
    },
    {
      "id": "word-profundo--adverbially-deep",
      "kind": "word",
      "promptEs": "profundo",
      "answerEn": "deep; deeply (describing how an action is done)",
      "noteEn": "Some Spanish describing words can also tell how an action is done. In this use profundo stays in its masculine singular form rather than changing to profundamente.",
      "example": { "es": "Respira profundo.", "en": "Breathe deeply." },
      "tags": ["word", "manner", "adverbial adjective", "A2"]
    },
    {
      "id": "word-imágenes",
      "kind": "word",
      "promptEs": "imágenes",
      "answerEn": "images; pictures",
      "noteEn": "",
      "tags": ["word", "plural noun", "A1"]
    },
    {
      "id": "word-para--availability-level",
      "kind": "word",
      "promptEs": "para",
      "answerEn": "for; at (a level or setting something is available for)",
      "noteEn": "Para can introduce the level or setting that a resource supports. English may use “for” or, with a level, “at.”",
      "example": { "es": "No hay datos para ese nivel de detalle.", "en": "There is no data at that level of detail." },
      "tags": ["word", "preposition", "availability", "A2"]
    },
    {
      "id": "word-zoom",
      "kind": "word",
      "promptEs": "zoom",
      "answerEn": "zoom; magnification",
      "noteEn": "Spanish uses the borrowed noun zoom for changing how close or enlarged an image appears.",
      "example": { "es": "Aumenta el zoom del mapa.", "en": "Increase the map's zoom." },
      "tags": ["word", "technology", "loanword", "A2"]
    },
    {
      "id": "word-ya--realization",
      "kind": "word",
      "promptEs": "ya",
      "answerEn": "I see; right (showing realization)",
      "noteEn": "Spoken on its own with a pause, ya can show that the speaker has just understood what is happening. This differs from its time meaning ‘already.’",
      "example": { "es": "Ya... ahora lo entiendo.", "en": "I see... now I understand it." },
      "tags": ["word", "discourse", "realization", "A2"]
    },
    {
      "id": "phrase-lo-sentimos",
      "kind": "phrase",
      "promptEs": "lo sentimos",
      "questionEn": "How does a group or organization say “we're sorry” in Spanish?",
      "answerEn": "Use lo sentimos for “we're sorry.”",
      "noteEn": "This is the plural counterpart of lo siento. Lo stays fixed, while siento changes to sentimos because the speakers are saying “we feel.” Learn the two words together as an apology rather than translating them literally.",
      "example": { "es": "Lo sentimos por la confusión.", "en": "We're sorry for the confusion." },
      "tags": ["phrase", "apology", "politeness", "A1"]
    },
    {
      "id": "phrase-no-puede-ser",
      "kind": "phrase",
      "promptEs": "no puede ser",
      "questionEn": "How do you react when something seems impossible or unbelievable?",
      "answerEn": "Say no puede ser for “that can't be” or “no way.”",
      "noteEn": "No negates the claim, puede is the form of poder used for one situation, and ser stays in its unchanged dictionary form. The expression can reject a fact literally or serve as a surprised reaction.",
      "example": { "es": "¡No puede ser! Otra vez no.", "en": "No way! Not again." },
      "tags": ["phrase", "reaction", "disbelief", "A2"]
    },
    {
      "id": "grammar-adverbial-adjective-manner",
      "kind": "grammar",
      "promptEs": "verbo + adjetivo usado para describir el modo",
      "questionEn": "How can words such as claro, alto, or profundo describe how an action is done without adding -mente?",
      "answerEn": "In certain common combinations, put the describing word after the verb and keep it in its masculine singular form.",
      "noteEn": "A word that normally describes a noun can sometimes work like an English -ly word and describe the action instead: hablar claro, volar alto, respirar profundo. It does not change for the person doing the action. This use is conventional, so it cannot be applied freely to every adjective.",
      "example": { "es": "Los pájaros vuelan alto.", "en": "The birds fly high." },
      "tags": ["grammar", "manner", "adverbial adjective", "A2"]
    },
    {
      "id": "concept-google-maps-deep-zoom-joke",
      "kind": "concept",
      "promptEs": "Google Maps: imágenes y nivel de zoom",
      "questionEn": "Why does a Google Maps zoom message turn the romantic scene into a joke?",
      "answerEn": "Map services may lack imagery at very close zoom levels; the scene treats looking deeply into a person's eyes as if it were zooming into a map.",
      "noteEn": "The woman has just joined the Google Maps team. The mapping-service limitation therefore appears where a romantic revelation should be, combining her new job with the literal idea of looking deeper.",
      "example": { "es": "Amplía el mapa para ver la calle.", "en": "Zoom in on the map to see the street." },
      "tags": ["concept", "Google Maps", "zoom", "visual joke"]
    }
  ],
