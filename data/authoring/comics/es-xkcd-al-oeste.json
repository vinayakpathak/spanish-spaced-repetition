  "titleText": {
    "es": "",
    "en": "Listen, they request that you stop submitting a listing for your house labeled 'WHERE YOU BROKE MY HEART'.",
    "noteEn": "The Spanish archive leaves its title text empty. The official English text extends the joke by treating the man's heartbreak as a Google Maps house-listing label."
  },
  "cardDefinitions": [
    {
      "id": "word-sentimos--apology",
      "kind": "word",
      "promptEs": "sentimos",
      "answerEn": "we're sorry (in lo sentimos)",
      "noteEn": "Sentimos normally means “we feel.” In the fixed expression lo sentimos, it is the plural apology used by a group or organization.",
      "example": { "es": "Lo sentimos por la demora.", "en": "We're sorry for the delay." },
      "tags": ["word", "apology", "sentir", "A1"]
    },
    {
      "id": "word-contratado--hired",
      "kind": "word",
      "promptEs": "contratado",
      "answerEn": "hired; employed",
      "noteEn": "Contratado is the completed-action form of contratar, “to hire.” After a form of haber such as ha, it stays unchanged.",
      "example": { "es": "La empresa ha contratado a Julia.", "en": "The company has hired Julia." },
      "tags": ["word", "work", "completed-action form", "A2"]
    },
    {
      "id": "word-mudarme--move-home",
      "kind": "word",
      "promptEs": "mudarme",
      "answerEn": "to move home; to relocate",
      "noteEn": "Mudarme joins mudar with me. The attached me identifies the speaker as the person changing homes.",
      "example": { "es": "Quiero mudarme pronto.", "en": "I want to move soon." },
      "tags": ["word", "moving home", "attached pronoun", "A2"]
    },
    {
      "id": "word-california",
