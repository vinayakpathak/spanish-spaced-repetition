    {
      "id": "word-sí--self-after-preposition",
      "kind": "word",
      "promptEs": "sí",
      "answerEn": "himself; herself; itself; themselves (after a preposition)",
      "noteEn": "After a preposition such as de, para, or por, stressed sí points back to a third-person subject. It has a written accent and often appears with mismo, misma, mismos, or mismas for emphasis.",
      "example": {
        "es": "Guardó el secreto para sí misma.",
        "en": "She kept the secret to herself."
      },
      "tags": ["word", "pronoun", "preposition", "self-reference", "A2"]
