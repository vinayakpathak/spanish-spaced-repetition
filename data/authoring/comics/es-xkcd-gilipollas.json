    {
      "id": "phrase-creerse-descripcion",
      "kind": "phrase",
      "promptEs": "creerse + descripción",
      "questionEn": "How do you say that someone thinks of themself as having a certain quality?",
      "answerEn": "Use a matching form of creerse followed by the description.",
      "noteEn": "Creerse is a pronominal verb, meaning that it uses a short marker matching the person: me creo, te crees, se cree, nos creemos, os creéis, or se creen. The description can be an adjective or comparison and changes to match the person when its form allows. With the -iendo action form, the marker can attach: creyendo plus se becomes creyéndose.",
      "example": {
        "es": "Raúl se cree imprescindible.",
        "en": "Raúl thinks he is indispensable."
      },
      "tags": ["phrase", "creerse", "pronominal verb", "self-perception", "B1"]
    },
    {
      "id": "phrase-pagado-de-si-mismo",
      "kind": "phrase",
      "promptEs": "pagado/a de sí mismo/a",
      "questionEn": "How do you describe someone as smug or excessively pleased with themself?",
      "answerEn": "Use pagado de sí mismo for a man or pagada de sí misma for a woman.",
      "noteEn": "This is a fixed, critical description meaning self-satisfied or full of oneself. The endings match the person: pagados de sí mismos for a masculine or mixed plural group and pagadas de sí mismas for a feminine plural group.",
      "example": {
        "es": "Parecía muy pagada de sí misma.",
        "en": "She seemed very full of herself."
      },
      "tags": ["phrase", "fixed expression", "personality", "agreement", "B2"]
    },
    {
      "id": "grammar-gerund-attached-pronominal-marker",
      "kind": "grammar",
      "promptEs": "verbo pronominal en -ando/-iendo + me/te/se/nos/os/se",
      "questionEn": "How do you attach the matching marker of a pronominal verb to an ongoing-action form?",
      "answerEn": "Join me, te, se, nos, os, or se to the end of the -ando or -iendo form, adding a written accent when needed to preserve the original stress.",
      "noteEn": "A pronominal verb is learned with se, such as verse or prepararse. Its short marker changes with the person. When the marker follows an ongoing-action form as one word, spelling may need an accent: viendo + me becomes viéndome, and preparando + se becomes preparándose.",
      "example": { "es": "Estoy preparándome para salir.", "en": "I am getting ready to leave." },
      "tags": ["grammar", "gerund", "pronominal verb", "spelling", "A2"]
    },
