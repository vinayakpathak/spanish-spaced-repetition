    {
      "id": "grammar-si-imperfect-subjunctive-conditional",
      "kind": "grammar",
      "promptEs": "si + imperfecto de subjuntivo, condicional",
      "questionEn": "How do you describe an imagined “if…, …would…” situation?",
      "answerEn": "Use si followed by a hypothetical past verb form for the condition, and use a “would” form for the result.",
      "noteEn": "Spanish calls the condition's verb form the imperfect subjunctive. It often ends in -ra or -se, as in tuviera or tuviese. The result uses the conditional, often ending in -ría, as in haría. In this pattern, do not put the conditional directly after si.",
      "example": {
        "es": "Si tuviera tiempo, viajaría más.",
        "en": "If I had time, I would travel more."
      },
      "tags": ["B1", "grammar", "hypothetical", "conditional"]
    },
    {
      "id": "grammar-volverse-adjective",
      "kind": "grammar",
      "promptEs": "volverse + adjetivo",
      "questionEn": "How do you say that someone or something becomes a certain way?",
      "answerEn": "Use a form of volverse followed by a describing word for the new state.",
      "noteEn": "The short part of volverse changes to me, te, se, nos, os, or se to match who changes, and volver changes for the person and time. The describing word—called an adjective—can also change for gender or number. Volver without the short pronoun usually means “to return.”",
      "example": {
        "es": "Con el tiempo, se volvieron pacientes.",
        "en": "Over time, they became patient."
      },
      "tags": ["A2", "grammar", "change of state", "reflexive verb"]
    },
    {
      "id": "grammar-tan-como-para-infinitive",
      "kind": "grammar",
      "promptEs": "tan + adjetivo + como para + infinitivo",
      "questionEn": "How can Spanish say that someone is kind enough to help, or so kind that they help?",
      "answerEn": "Put tan before the describing word, then como para, then the action verb in its unchanged dictionary form.",
      "noteEn": "The dictionary form—called the infinitive—is the unchanged verb ending in -ar, -er, or -ir. This pattern says that a quality reaches the degree needed for the following action. It is different from the ordinary comparison tan… como, which means “as… as.”",
      "example": {
        "es": "Fue tan generosa como para ayudarnos.",
        "en": "She was generous enough to help us."
      },
      "tags": ["B1", "grammar", "degree", "result"]
    },
    {
      "id": "phrase-un-momento-interruption",
      "kind": "phrase",
      "promptEs": "¡Un momento!",
      "questionEn": "What does ¡Un momento! mean when someone interrupts or suddenly realizes something?",
      "answerEn": "It means “Wait a moment!” or “Hold on!”",
      "noteEn": "This fixed conversational interruption can ask someone to pause, or it can announce that the speaker has just noticed something important. Its function is broader than literally measuring one moment.",
      "example": {
        "es": "¡Un momento! Creo que tengo la llave.",
        "en": "Hold on! I think I have the key."
      },
      "tags": ["A1", "phrase", "conversation", "interruption"]
    },
    {
      "id": "phrase-a-traves-de",
      "kind": "phrase",
      "promptEs": "a través de",
      "questionEn": "How do you say that something goes or can be seen through something?",
      "answerEn": "Use a través de before the thing: it means “through” or “across.”",
      "noteEn": "Keep all three parts together. Before masculine singular el, de and el combine as del: a través del bosque. Before a feminine noun, use a través de la, as in a través de la ventana. The expression can describe literal passage or a figurative means.",
      "example": {
        "es": "La luz entra a través de la ventana.",
        "en": "The light comes in through the window."
      },
      "tags": ["A2", "phrase", "preposition", "movement"]
    },
    {
      "id": "grammar-preposition-article-que-relative",
      "kind": "grammar",
      "promptEs": "preposición + el/la/los/las que",
      "questionEn": "How do you say “in which,” “with which,” or “for which” when referring back to a thing?",
      "answerEn": "Put the needed preposition before el que, la que, los que, or las que, matching the earlier thing.",
      "noteEn": "A preposition is a short relationship word such as en (“in”), con (“with”), or para (“for”). Choose el, la, los, or las to match the gender and number of the thing being described; que itself does not change.",
      "example": {
        "es": "Esta es la silla en la que me siento.",
        "en": "This is the chair that I sit in."
      },
      "tags": ["B1", "grammar", "relative clause", "preposition"]
    },
    {
      "id": "grammar-ser-identity-estar-location",
      "kind": "grammar",
      "promptEs": "ser para identidad · estar para ubicación",
      "questionEn": "Which Spanish “to be” verb says what something is, and which says where it is?",
      "answerEn": "Use ser for identity or a defining description; use estar for the location of a person or thing.",
      "noteEn": "This contrast is not simply permanent versus temporary. Forms of ser such as soy and es identify or describe what something is. Forms of estar such as están normally locate people and things. Events are a common exception: Spanish uses ser to say where or when an event takes place.",
      "example": {
        "es": "El museo es famoso y está en Madrid.",
        "en": "The museum is famous and is in Madrid."
      },
      "tags": ["A1", "grammar", "ser", "estar", "location"]
    },
    {
      "id": "concept-the-matrix",
      "kind": "concept",
      "promptEs": "Matrix · código · el Elegido",
      "answerEn": "references The Matrix, where Neo discovers a simulated world and becomes “the One”",
      "noteEn": "In The Matrix, computer code underlies the world people perceive. Neo learns to see that code and bend the simulation's physical rules. The joke gives a Pong paddle the same awakening inside its much simpler game world.",
      "tags": ["film", "science fiction", "technology", "joke reference"]
    }
