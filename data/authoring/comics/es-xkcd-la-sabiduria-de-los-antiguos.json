  "titleEn": "Wisdom of the Ancients",
  "titleEs": "La sabiduría de los antiguos",
  "titleText": {
    "es": "Todos los hilos de ayuda largos deberían tener arriba un post ",
    "en": "All long help threads should have a sticky globally-editable post at the top saying 'DEAR PEOPLE FROM THE FUTURE: Here's what we've figured out so far ...'",
    "noteEn": "The Spanish archive title attribute is preserved exactly, including its trailing space and truncation after post; the raw page's malformed quoted text prevents the remainder from appearing in the manifest. The official English title attribute is preserved exactly. Vision omitted the accent in QUIÉN, and GOOGLE, DENVERCODER9, and 2003 are inventoried as non-lexical exclusions."
  },
  "cardDefinitions": [
    {
      "id": "word-sentido--felt",
      "kind": "word",
      "promptEs": "sentido",
      "answerEn": "felt; experienced a feeling",
      "noteEn": "Sentido is the irregular completed-action form of sentir. With a matching short word such as me and the helper haber, it describes how someone has felt.",
      "example": {
        "es": "Nunca me he sentido tan tranquilo.",
        "en": "I have never felt so calm."
      },
      "tags": [
        "word",
        "sentir",
        "past participle",
        "feeling",
        "A2"
      ]
    },
    {
      "id": "word-cercano",
      "kind": "word",
      "promptEs": "cercano",
      "answerEn": "close; emotionally near",
      "noteEn": "Cercano can describe physical nearness or a close emotional connection. It changes to cercana, cercanos, or cercanas to agree with the person or thing described.",
      "example": {
        "es": "Me siento cercano a mi familia.",
        "en": "I feel close to my family."
      },
      "tags": [
        "word",
        "adjective",
        "closeness",
        "A2"
      ]
    },
    {
      "id": "word-a--cercano-complement",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "to; required after cercano before the person or thing",
      "noteEn": "Cercano normally uses a before naming what someone or something is close to. English also commonly uses ‘to’ here.",
      "example": {
        "es": "El pueblo está cercano a la costa.",
        "en": "The town is close to the coast."
      },
      "tags": [
        "word",
        "adjective complement",
        "preposition",
        "A2"
      ]
    },
    {
      "id": "word-busco--search",
      "kind": "word",
      "promptEs": "busco",
      "answerEn": "I search for; I look up",
      "noteEn": "Busco is the present form of buscar used by the speaker. The spelling uses c before o.",
      "example": {
        "es": "Busco la respuesta en internet.",
        "en": "I search for the answer online."
      },
      "tags": [
        "word",
        "buscar",
        "present",
        "search",
        "A1"
      ]
    },
    {
      "id": "word-resultado",
      "kind": "word",
      "promptEs": "resultado",
      "answerEn": "result; search result",
      "noteEn": "Resultado names an outcome. In an online search, it can mean one returned result or listing.",
      "example": {
        "es": "La búsqueda dio un solo resultado.",
        "en": "The search returned only one result."
      },
      "tags": [
        "word",
        "result",
        "internet",
        "A2"
      ]
    },
    {
      "id": "word-hilo--online-thread",
      "kind": "word",
      "promptEs": "hilo",
      "answerEn": "thread; online discussion",
      "noteEn": "Hilo literally means ‘thread.’ Online, it names a connected discussion made of an opening post and its replies.",
      "example": {
        "es": "Leí todo el hilo del foro.",
        "en": "I read the whole forum thread."
      },
      "tags": [
        "word",
        "internet",
        "discussion",
        "A2"
      ]
    },
    {
      "id": "word-iniciado--started",
      "kind": "word",
      "promptEs": "iniciado",
      "answerEn": "started; initiated",
      "noteEn": "Iniciado is the masculine singular completed-action form of iniciar. Used after a noun, it describes something that was started.",
      "example": {
        "es": "Es un proyecto iniciado en mayo.",
        "en": "It is a project started in May."
      },
      "tags": [
        "word",
        "participle",
        "adjective",
        "A2"
      ]
    },
    {
      "id": "word-respuesta",
      "kind": "word",
      "promptEs": "respuesta",
      "answerEn": "answer; reply",
      "noteEn": "Respuesta can be an answer to a question or a reply in a conversation or online discussion.",
      "example": {
        "es": "Todavía no hay respuesta.",
        "en": "There is still no answer."
      },
      "tags": [
        "word",
        "answer",
        "noun",
        "A1"
      ]
    },
    {
      "id": "word-alguna--postnegative-any",
      "kind": "word",
      "promptEs": "alguna",
      "answerEn": "any; at all (after a noun in a negative expression)",
      "noteEn": "After a negative idea such as sin, alguno can follow the noun and strengthens the absence: sin respuesta alguna means no answer at all. It agrees with the noun, so feminine respuesta takes alguna.",
      "example": {
        "es": "Salió sin explicación alguna.",
        "en": "She left without any explanation."
      },
      "tags": [
        "word",
        "negative expression",
        "agreement",
        "B1"
      ]
    },
    {
      "id": "word-publicado--published",
      "kind": "word",
      "promptEs": "publicado",
      "answerEn": "published; posted",
      "noteEn": "Publicado is the masculine singular completed-action form of publicar. It can describe material made public online as well as in print.",
      "example": {
        "es": "El artículo fue publicado ayer.",
        "en": "The article was published yesterday."
      },
      "tags": [
        "word",
        "publishing",
        "participle",
        "A2"
      ]
    },
    {
      "id": "phrase-cercano-a",
      "kind": "phrase",
      "promptEs": "cercano a + persona o cosa",
      "questionEn": "How do you say that someone or something is close to another person or thing?",
      "answerEn": "Use the matching form of cercano followed by a.",
      "noteEn": "Cercano changes to agree with what is described, while a introduces the person, place, or thing it is close to.",
      "example": {
        "es": "La estación está cercana al centro.",
        "en": "The station is close to downtown."
      },
      "tags": [
        "phrase",
        "closeness",
        "adjective complement",
        "A2"
      ]
    },
    {
      "id": "grammar-sin-noun-alguno",
      "kind": "grammar",
      "promptEs": "sin + nombre + alguno/alguna",
      "questionEn": "How can Spanish emphasize that there is no item of a certain kind at all?",
      "answerEn": "Use sin, name the missing thing, and put a matching form of alguno after the noun.",
      "noteEn": "After sin, postposed alguno adds strong negative force: sin motivo alguno and sin respuesta alguna. The ending agrees with the noun. English normally uses ‘any’ or ‘at all.’",
      "example": {
        "es": "No hubo cambio alguno.",
        "en": "There was no change at all."
      },
      "tags": [
        "grammar",
        "negative expression",
        "alguno",
        "agreement",
        "B1"
      ]
    },
    {
      "id": "concept-denvercoder9-unanswered-thread",
      "kind": "concept",
      "promptEs": "error · un resultado · hilo · sin respuesta · DenverCoder9",
      "questionEn": "Why does the old unanswered thread feel like contact with a lost person?",
      "answerEn": "A highly specific search finds one old post from someone with the same problem, but the thread contains no solution or later trace of its author.",
      "noteEn": "The emotional joke treats an abandoned technical-help thread like an ancient message. The official title text imagines a prominent, editable summary that future visitors could update with whatever has been learned.",
      "tags": [
        "concept",
        "internet search",
        "support thread",
        "joke"
      ]
    }
  ],
