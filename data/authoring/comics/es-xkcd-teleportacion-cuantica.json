    {
      "id": "grammar-cada-vez-que",
      "kind": "grammar",
      "promptEs": "cada vez que + situación",
      "questionEn": "How do you say that something happens every time another event occurs?",
      "answerEn": "Use cada vez que, then state the event that triggers the repetition.",
      "noteEn": "Cada means “each” or “every,” vez means an occurrence, and que joins those words to the triggering event. The verb after que changes normally for its person and time; repeated facts often use a present-time form.",
      "example": { "es": "Cada vez que llueve, llevo paraguas.", "en": "Every time it rains, I carry an umbrella." },
      "tags": ["grammar", "time", "repetition", "connector", "A2"]
    },
    {
      "id": "grammar-ustedes-third-person-plural",
      "kind": "grammar",
      "promptEs": "ustedes + hablan / comen / viven",
      "questionEn": "Which verb form goes with ustedes when it means plural “you”?",
      "answerEn": "Use the same plural verb form used with ellos or ellas: ustedes hablan, comen, or viven.",
      "noteEn": "Although ustedes addresses the listeners, its verb takes the form also used for “they.” For example, vosotros escribís is informal plural usage in most of Spain, while ustedes escriben is used throughout Latin America and in formal plural address in Spain.",
      "example": { "es": "Ustedes trabajan aquí.", "en": "You all work here." },
      "tags": ["grammar", "ustedes", "verb agreement", "plural", "A2"]
    },
    {
      "id": "phrase-irse-a-lugar",
      "kind": "phrase",
      "promptEs": "irse a + lugar",
      "questionEn": "How do you say that someone leaves for or goes off to a destination?",
      "answerEn": "Use a matching form of irse, then a and the destination: me voy a…, se va a…, or nos vamos a….",
      "noteEn": "The short word before ir changes with the person: me, te, se, nos, os, or se. Plain ir focuses on going somewhere; irse often highlights leaving the current place. The destination may include an article, as in a la playa or a las islas.",
      "example": { "es": "Nos vamos a la playa.", "en": "We are leaving for the beach." },
      "tags": ["phrase", "irse", "movement", "destination", "A2"]
    },
    {
      "id": "concept-quantum-teleportation-vs-sci-fi",
      "kind": "concept",
      "promptEs": "teleportación cuántica frente a un teleportador de ciencia ficción",
      "answerEn": "Quantum teleportation transfers the state of a quantum system; it does not transport an intact person or object like a science-fiction teleporter.",
      "noteEn": "The scientist is annoyed because reporters expect the Star Trek meaning. The labeled switch then reveals a separate “normal” teleporter that does exactly what he denied quantum teleportation does, and he uses it to leave. That reversal is the punchline.",
      "tags": ["concept", "quantum physics", "teleportation", "science fiction", "xkcd joke"]
    }
