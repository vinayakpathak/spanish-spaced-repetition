    {
      "id": "word-cuente--count-as",
      "kind": "word",
      "promptEs": "cuente",
      "answerEn": "counts; qualifies (as)",
      "noteEn": "Cuente is a special form of contar used when the idea is doubted or not presented as a fact. In contar como, contar means to qualify as something rather than to count numbers or tell a story; the ordinary present form is cuenta.",
      "example": {
        "es": "Dudo que eso cuente como ayuda.",
        "en": "I doubt that counts as help."
      },
      "tags": ["word", "contar como", "subjunctive", "classification", "B1"]
    },
    {
      "id": "word-como--fixed-contar-como",
      "kind": "word",
      "promptEs": "como",
      "answerEn": "as; completes contar como, “to count as”",
      "noteEn": "After a form of contar meaning to qualify, como introduces the category or description that applies. It has no written accent in this use.",
      "example": {
        "es": "La práctica cuenta como experiencia.",
        "en": "The internship counts as experience."
      },
      "tags": ["word", "contar como", "classification", "B1"]
    },
    {
      "id": "word-sexy",
      "kind": "word",
      "promptEs": "sexy",
      "answerEn": "sexy; sexually attractive",
