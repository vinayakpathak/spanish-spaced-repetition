    },
    {
      "id": "word-quítate--remove-clothing",
      "kind": "word",
      "promptEs": "quítate",
      "answerEn": "take off; remove from yourself (informal command)",
      "noteEn": "Quita is the positive command of quitar for one familiar listener. Te attaches to the end because the listener removes something from themself, and the written accent keeps the original stress.",
      "example": {
        "es": "Quítate el abrigo.",
        "en": "Take off your coat."
      },
      "tags": ["word", "quitarse", "command", "clothing", "A2"]
    },
    {
      "id": "word-los--clothing-owner-clear",
      "kind": "word",
      "promptEs": "los",
      "answerEn": "your here; Spanish uses los before clothing whose wearer is clear",
      "noteEn": "Spanish often uses el, la, los, or las rather than a possessive before clothing when a verb or a short word such as me, te, or se already identifies the wearer. Los is the masculine plural form.",
      "example": {
        "es": "Se puso los guantes.",
        "en": "She put on her gloves."
      },
      "tags": ["word", "definite article", "clothing", "possession", "A2"]
    },
    {
      "id": "grammar-nuevo-position-meaning",
      "kind": "grammar",
      "promptEs": "una nueva persona o cosa · una persona o cosa nueva",
      "questionEn": "What difference can the position of nuevo make?",
      "answerEn": "Before the person or thing, nuevo often means newly added or newly in that role; after it, nuevo more often stresses that the thing itself is brand-new.",
      "noteEn": "Nuevo changes to nueva, nuevos, or nuevas to match what it describes. Una nueva compañera usually means someone who has recently become a coworker or classmate. Una mesa nueva more often means a newly made or unused table. Context can blur the contrast, so this is a common tendency rather than an absolute rule.",
      "example": {
        "es": "Laura tiene una nueva compañera.",
        "en": "Laura has a new coworker."
      },
      "tags": ["grammar", "adjective position", "nuevo", "meaning", "B1"]
    },
    {
      "id": "phrase-soldar-al-arco",
      "kind": "phrase",
      "promptEs": "soldar al arco",
      "questionEn": "How do you say “to arc-weld” or “to weld using an electric arc”?",
      "answerEn": "Use soldar al arco.",
      "noteEn": "Al combines a and el inside this conventional technical expression. Arco names the bright electrical discharge whose heat melts metal. Soldar changes for the person and time, while al arco stays unchanged.",
      "example": {
        "es": "El técnico suelda al arco.",
        "en": "The technician arc-welds."
      },
      "tags": ["phrase", "welding", "electricity", "technical", "B1"]
    },
    {
      "id": "phrase-contar-como",
      "kind": "phrase",
      "promptEs": "contar como + categoría o descripción",
      "questionEn": "How do you say that something counts or qualifies as a particular category?",
      "answerEn": "Use a matching form of contar, then como and the category or description.",
      "noteEn": "Contar changes for the person, thing, and time: cuenta, contó, contará, or cuente. Como stays unchanged and has no written accent. Together, contar como is about classification, not counting numbers or telling a story.",
      "example": {
        "es": "La práctica cuenta como experiencia.",
        "en": "The internship counts as experience."
      },
      "tags": ["phrase", "classification", "contar", "B1"]
    },
    {
      "id": "grammar-quitarse-clothing-definite-article",
      "kind": "grammar",
      "promptEs": "quitarse el abrigo · quitarse los zapatos",
      "questionEn": "How do you say that someone takes off their own clothing?",
      "answerEn": "Use a matching form of quitarse, then el, la, los, or las and the clothing item.",
      "noteEn": "The short part me, te, se, or nos identifies the wearer, so Spanish normally uses the definite article—the words el, la, los, or las—instead of a possessive such as mi or tu. The verb changes for the person and time: me quito el abrigo, se quitó la chaqueta. In a positive command to one familiar person, te attaches at the end: quítate los zapatos.",
      "example": {
        "es": "Marta se quita la chaqueta.",
        "en": "Marta takes off her jacket."
      },
      "tags": ["grammar", "quitarse", "clothing", "definite article", "A2"]
    }
  ],
