    {
      "id": "grammar-querer-conditional-politeness",
      "kind": "grammar",
      "promptEs": "querría / querríamos + lo pedido",
      "questionEn": "How do you politely say “I would like” or “we would like” when requesting something?",
      "answerEn": "Use querría for one speaker or querríamos for “we,” then name what is wanted.",
      "noteEn": "These polite forms come from querer, “to want.” The middle changes to querr-, and the endings -ía or -íamos express “would.” They make an order or request less direct than quiero or queremos.",
      "example": {
        "es": "Querría un café, por favor.",
        "en": "I would like a coffee, please."
      },
      "tags": ["grammar", "politeness", "requests", "A2"]
    },
    {
      "id": "phrase-lo-mas-posible",
      "kind": "phrase",
      "promptEs": "lo más + descripción + posible",
      "questionEn": "How do you say that something should be as fast, simple, close, or otherwise extreme as possible?",
      "answerEn": "Use lo más, then the description, then posible.",
      "noteEn": "Lo and posible stay fixed around the description being pushed to its greatest practical degree. The middle word can describe a quality or manner, as in lo más claro posible or lo más pronto posible.",
      "example": {
        "es": "Explícalo lo más claro posible.",
        "en": "Explain it as clearly as possible."
      },
      "tags": ["phrase", "degree", "maximum", "A2"]
    },
