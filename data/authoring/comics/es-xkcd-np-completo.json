    {
      "id": "word-np--complexity-class",
      "kind": "word",
      "promptEs": "np",
      "answerEn": "NP (a computer-science complexity class)",
      "noteEn": "NP is an international computer-science abbreviation. It groups decision problems whose proposed solutions can be checked efficiently.",
      "example": {
        "es": "El problema pertenece a NP.",
        "en": "The problem belongs to NP."
      },
      "tags": ["word", "abbreviation", "computer science", "complexity"]
