    {
      "id": "concept-np-complete",
      "kind": "concept",
      "promptEs": "problemas NP-completos",
      "answerEn": "problems whose proposed solutions are quick to check but which have no known efficient general solver",
      "noteEn": "NP-complete problems are the hardest problems in the class NP, in a precise sense: every NP problem can be efficiently translated into any NP-complete problem. If an efficient general algorithm were found for one of them, it would efficiently solve every problem in NP. No such algorithm is currently known.",
      "tags": ["concept", "computer science", "complexity", "NP-complete"]
    },
    {
      "id": "concept-knapsack-subset-sum",
      "kind": "concept",
      "promptEs": "problema de la mochila · suma exacta",
      "answerEn": "select a subset of available items that obeys a limit or hits an exact target",
      "noteEn": "The classic knapsack problem chooses items with weights and values under a capacity limit. Asking which menu prices add to one exact total is more specifically the closely related subset-sum problem. The decision versions are NP-complete, so the restaurant request hides a computationally difficult search inside an ordinary order.",
      "tags": ["concept", "computer science", "knapsack", "subset sum", "joke concept"]
    },
    {
      "id": "concept-traveling-salesperson-problem",
      "kind": "concept",
      "promptEs": "problema del viajante",
      "answerEn": "find the shortest route that visits every required stop",
      "noteEn": "The traveling-salesperson problem asks for the shortest tour through a set of locations. Comparing all possible routes becomes difficult as the number of stops grows; its decision version is NP-complete. Visiting several restaurant tables as quickly as possible supplies the comic's second example.",
      "tags": ["concept", "computer science", "routing", "NP-complete", "joke concept"]
    }
