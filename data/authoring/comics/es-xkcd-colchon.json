  "cardDefinitions": [
    {
      "id": "word-hacerse--reciprocal-arrumacos",
      "kind": "word",
      "promptEs": "hacerse",
      "answerEn": "to give each other; helps express mutual affection with arrumacos",
      "noteEn": "Hacer normally means ‘to do’ or ‘to make.’ Its attached se can show that two or more people exchange the action. In hacerse arrumacos, the whole expression describes affectionate cuddling or caressing.",
      "example": { "es": "Los amigos se hacen regalos.", "en": "The friends give each other gifts." },
      "tags": ["word", "reciprocal action", "affection", "A2"]
    },
    {
      "id": "word-arrumacos",
      "kind": "word",
      "promptEs": "arrumacos",
      "answerEn": "cuddles; affectionate caresses",
      "noteEn": "",
      "tags": ["word", "affection", "plural", "A2"]
    },
    {
      "id": "word-a--fixed-cara-a-cara",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; links the two copies of cara in cara a cara",
      "noteEn": "In cara a cara, a is a fixed middle link. Translate the three words together as ‘face-to-face’ rather than giving a its usual direction meaning.",
      "example": { "es": "Prefiero hablar cara a cara.", "en": "I prefer to speak face-to-face." },
      "tags": ["word", "fixed expression", "preposition", "A2"]
    },
