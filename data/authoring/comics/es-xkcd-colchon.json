    {
      "id": "word-molestado--bothered",
      "kind": "word",
      "promptEs": "molestado",
      "answerEn": "bothered; annoyed",
      "noteEn": "Molestado is the completed-action form of molestar, ‘to bother’ or ‘to annoy.’ After ha, it stays unchanged even when the affected person changes.",
      "example": { "es": "El ruido nos ha molestado.", "en": "The noise has bothered us." },
      "tags": ["word", "verb", "completed action", "A2"]
    },
    {
      "id": "word-uno--one-item",
      "kind": "word",
      "promptEs": "uno",
      "answerEn": "one (a masculine item already understood)",
      "noteEn": "Uno can stand in for a masculine singular noun that has already been mentioned or is obvious from the situation, just as English can use ‘one.’",
      "example": { "es": "Necesito un lápiz; dame uno.", "en": "I need a pencil; give me one." },
      "tags": ["word", "pronoun", "noun omission", "A1"]
    },
    {
      "id": "word-quedan--remain",
      "kind": "word",
      "promptEs": "quedan",
      "answerEn": "they remain; they stay",
      "noteEn": "With se, quedan is a present-time form of quedarse. It says that several people or things continue in, or end up in, the state named next.",
      "example": { "es": "Los niños se quedan quietos.", "en": "The children stay still." },
      "tags": ["word", "verb", "quedarse", "A2"]
    },
    {
      "id": "word-colgando--hanging",
      "kind": "word",
      "promptEs": "colgando",
      "answerEn": "hanging; dangling",
      "noteEn": "Colgando is the ongoing-action form of colgar, ‘to hang.’ For an action verb ending in -ar, this form normally replaces -ar with -ando; it can describe something that remains suspended or dangling.",
      "example": { "es": "La lámpara sigue colgando.", "en": "The lamp remains hanging." },
      "tags": ["word", "verb form", "position", "A2"]
    },
    {
      "id": "word-hacéis--vosotros-do",
      "kind": "word",
      "promptEs": "hacéis",
      "answerEn": "you all do; you all make (informal plural, mainly Spain)",
      "noteEn": "Hacéis is the present-time form of hacer used with vosotros, the informal ‘you all’ used mainly in Spain. In most of Latin America, speakers normally use ustedes hacen instead.",
      "example": { "es": "Hacéis un buen trabajo.", "en": "You all do good work." },
      "tags": ["word", "verb", "vosotros", "Spain", "A2"]
    },
    {
      "id": "word-ellos--after-preposition",
      "kind": "word",
      "promptEs": "ellos",
      "answerEn": "them (masculine or mixed group, after a preposition)",
      "noteEn": "Ellos usually means ‘they,’ but after a preposition such as con, para, or sin, English uses ‘them.’",
      "example": { "es": "Voy con ellos.", "en": "I am going with them." },
      "tags": ["word", "pronoun", "preposition", "A1"]
    },
    {
      "id": "word-hicimos--made",
      "kind": "word",
      "promptEs": "hicimos",
      "answerEn": "we made; we did",
      "noteEn": "Hicimos is the completed-past ‘we’ form of hacer, ‘to do’ or ‘to make.’ Hacer changes its stem to hic- in this past tense, and hicimos has no written accent.",
      "example": { "es": "Hicimos una mesa.", "en": "We made a table." },
      "tags": ["word", "verb", "completed past", "irregular", "A2"]
    },
    {
      "id": "word-gran--major",
      "kind": "word",
      "promptEs": "gran",
      "answerEn": "major; significant (before a singular noun)",
      "noteEn": "Grande shortens to gran directly before a singular noun. Here it describes importance or significance rather than physical size.",
      "example": { "es": "Tomamos una gran decisión.", "en": "We made a major decision." },
      "tags": ["word", "adjective", "importance", "grande", "A2"]
    },
