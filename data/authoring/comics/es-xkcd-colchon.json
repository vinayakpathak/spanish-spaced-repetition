    {
      "id": "phrase-hacerse-arrumacos",
      "kind": "phrase",
      "promptEs": "hacerse arrumacos",
      "questionEn": "How do you say that people cuddle or exchange affectionate caresses with each other?",
      "answerEn": "Use the matching form of hacerse followed by arrumacos.",
      "noteEn": "Hacerse arrumacos is a conventional expression for mutual affectionate touching. In the dictionary form, se is attached to hacer. With a stated subject, the matching short word usually stands before the changed verb: nos hacemos arrumacos or se hacen arrumacos.",
      "example": { "es": "La pareja se hace arrumacos en el sofá.", "en": "The couple cuddles on the sofa." },
      "tags": ["phrase", "affection", "reciprocal action", "A2"]
    },
    {
      "id": "phrase-cara-a-cara",
      "kind": "phrase",
      "promptEs": "cara a cara",
      "questionEn": "How do you say that people are directly facing one another or meeting in person?",
      "answerEn": "Use cara a cara after the action or state.",
      "noteEn": "Cara a cara works as one expression meaning ‘face-to-face.’ The fixed a stays between the repeated word cara. It can describe physical orientation or a direct personal conversation or meeting.",
      "example": { "es": "Hablamos cara a cara.", "en": "We speak face-to-face." },
      "tags": ["phrase", "position", "meeting", "A2"]
    }
  ],
