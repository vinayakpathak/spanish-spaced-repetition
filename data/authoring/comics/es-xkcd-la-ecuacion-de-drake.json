    {
      "id": "phrase-comunicarse",
      "kind": "phrase",
      "promptEs": "comunicarse (con alguien o por un medio)",
      "questionEn": "How do you say that people communicate or get in touch?",
      "answerEn": "Use a matching short marker with a form of comunicar: me comunico, te comunicas, se comunica, nos comunicamos, os comunicáis, or se comunican.",
      "noteEn": "The short marker changes with the person or group, and comunicar changes for that same person or group. Con can introduce who receives the communication; por can introduce the medium used.",
      "example": {
        "es": "Nos comunicamos por mensajes.",
        "en": "We communicate by text messages."
      },
      "tags": ["phrase", "pronominal verb", "communication", "A2"]
    },
    {
      "id": "grammar-probabilidad-de-que-subjunctive",
      "kind": "grammar",
      "promptEs": "probabilidad de que + resultado incierto",
      "questionEn": "How do you introduce an outcome whose probability or chance is being discussed?",
      "answerEn": "Use probabilidad de que, then describe the uncertain outcome with the special verb form Spanish uses for possibilities.",
      "noteEn": "This special form is called the subjunctive. It presents the outcome as possible rather than asserted as a fact: ordinary llueve changes to llueva, and se hace changes to se haga. The plus sign in the prompt means “followed by.”",
      "example": {
        "es": "Hay poca probabilidad de que llueva.",
        "en": "There is little chance that it will rain."
      },
      "tags": ["grammar", "probability", "subjunctive", "B1"]
    },
    {
      "id": "phrase-adecuado-para",
      "kind": "phrase",
      "promptEs": "adecuado/adecuada/adecuados/adecuadas para + uso",
      "questionEn": "How do you say that something is suitable for a particular use, person, or situation?",
      "answerEn": "Use the matching form of adecuado, then para, then name the use, person, situation, or action.",
      "noteEn": "Adecuado changes its ending to match what is suitable: adecuado, adecuada, adecuados, or adecuadas. If an action follows para, that action stays in its unchanged dictionary form ending in -ar, -er, or -ir. The slash marks alternatives, and the plus sign means “followed by.”",
      "example": {
        "es": "Esta sala es adecuada para estudiar.",
        "en": "This room is suitable for studying."
      },
      "tags": ["phrase", "suitability", "adjective", "preposition", "A2"]
    },
    {
      "id": "grammar-estar-dispuesto-a-infinitive",
      "kind": "grammar",
      "promptEs": "estar dispuesto/dispuesta a + verbo en forma de diccionario",
      "questionEn": "How do you say that someone is willing or prepared to do something?",
      "answerEn": "Use a form of estar, then a matching form of dispuesto, then a, then the action verb in its unchanged dictionary form.",
      "noteEn": "Estar changes for the person and time. Dispuesto changes to match that person in gender and number. The action after a remains in its dictionary form ending in -ar, -er, or -ir. The slash marks alternatives, and the plus sign means “followed by.”",
      "example": {
        "es": "Ana está dispuesta a ayudar.",
        "en": "Ana is willing to help."
      },
      "tags": ["grammar", "willingness", "infinitive", "agreement", "A2"]
    },
    {
      "id": "concept-drake-equation",
      "kind": "concept",
      "promptEs": "ecuación de Drake",
      "answerEn": "a framework that multiplies estimated factors to approximate how many extraterrestrial civilizations might communicate in the Milky Way",
      "noteEn": "Astronomer Frank Drake introduced the framework in 1961. Its factors concern stars, planets, life, intelligence, communication, and how long detectable civilizations last; their uncertain values make the result an estimate, not a measured count.",
      "tags": ["concept", "astronomy", "extraterrestrial life", "Drake equation"]
    },
    {
      "id": "concept-drake-equation-bs-parody",
      "kind": "concept",
      "promptEs": "factor B_s en esta parodia de la ecuación de Drake",
      "answerEn": "the comic's invented “bullshit” factor: how much of Drake's speculation someone is willing to accept",
      "noteEn": "B_s is not part of the real Drake equation. The comic turns skepticism about uncertain inputs into one more fake multiplier, making the amount of accepted nonsense determine the answer.",
      "tags": ["concept", "joke", "Drake equation", "parody"]
    }
