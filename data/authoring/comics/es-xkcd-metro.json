  },
  "cardDefinitions": [
    {
      "id": "word-anda--surprise",
      "kind": "word",
      "promptEs": "anda",
      "answerEn": "hey; wow; well, look at that",
      "noteEn": "Anda literally comes from andar, “to walk,” but it is also a common conversational reaction in Spain. It can show surprise, encourage someone, or draw attention; tone supplies the exact feeling.",
      "example": { "es": "¡Anda, has venido!", "en": "Oh, you came!" },
      "tags": ["word", "interjection", "surprise", "Spain"]
    },
    {
      "id": "word-metro--tape-measure",
      "kind": "word",
      "promptEs": "metro",
      "answerEn": "tape measure; measuring tape",
      "noteEn": "Besides naming the unit “meter,” metro can refer to a tape measure in Spain. The surrounding object makes that meaning clear here.",
      "example": { "es": "Mide la mesa con un metro.", "en": "Measure the table with a tape measure." },
      "tags": ["word", "tool", "measurement", "Spain"]
    },
    {
      "id": "word-extiende--action-label",
      "kind": "word",
      "promptEs": "extiende",
      "answerEn": "extends; stretches out",
      "noteEn": "Extiende is a present form of extender for él, ella, or usted, and it is also the positive command for informal singular tú. In this comic it labels the repeated action of the tape stretching outward.",
      "example": { "es": "La cinta se extiende dos metros.", "en": "The tape extends two meters." },
      "tags": ["word", "extender", "action", "present"]
    },
    { "id": "word-ruido", "kind": "word", "promptEs": "ruido", "answerEn": "noise; sound", "noteEn": "", "tags": ["word", "sound"] },
    { "id": "word-flooop--sound", "kind": "word", "promptEs": "flooop", "answerEn": "floop; a long sliding or unrolling sound", "noteEn": "", "tags": ["word", "onomatopoeia", "sound"] },
    {
      "id": "word-ohh--impressed",
      "kind": "word",
      "promptEs": "ohh",
      "answerEn": "ooh; oh (an impressed reaction)",
      "noteEn": "Writing extra letters stretches the spoken reaction. Here ohh shows pleased surprise at the measurement, rather than disappointment.",
      "example": { "es": "¡Ohh, qué bonito!", "en": "Ooh, how pretty!" },
      "tags": ["word", "interjection", "reaction", "expressive spelling"]
    },
    {
      "id": "word-pregunto--wonder",
      "kind": "word",
      "promptEs": "pregunto",
      "answerEn": "I wonder; I ask myself",
      "noteEn": "Pregunto normally means “I ask.” With me, the form me pregunto means that the speaker wonders or asks himself or herself a question.",
      "example": { "es": "Me pregunto si Ana vendrá.", "en": "I wonder whether Ana will come." },
      "tags": ["word", "preguntar", "thought", "first person"]
    },
    {
      "id": "word-si--whether",
      "kind": "word",
      "promptEs": "si",
      "answerEn": "whether; if (introducing an indirect yes-or-no question)",
      "noteEn": "Unaccented si can introduce a condition or an indirect yes-or-no question. In me pregunto si, English usually uses “whether.” Accented sí means “yes.”",
      "example": { "es": "No sé si está abierto.", "en": "I do not know whether it is open." },
      "tags": ["word", "connector", "indirect question"]
    },
    { "id": "word-record--achievement", "kind": "word", "promptEs": "récord", "answerEn": "record; best known result", "noteEn": "Spanish writes an accent in récord because the stress falls on the first syllable.", "example": { "es": "El atleta batió el récord mundial.", "en": "The athlete broke the world record." }, "tags": ["word", "achievement", "loanword"] },
    {
      "id": "word-vamoos--chant",
      "kind": "word",
      "promptEs": "vamoos",
      "answerEn": "come on! go! (vamos stretched as a cheer)",
      "noteEn": "The ordinary spelling is vamos. An extra o imitates a crowd holding the vowel while cheering; this is expressive informal spelling, not the standard written form.",
      "example": { "es": "¡Vamos, equipo!", "en": "Come on, team!" },
      "tags": ["word", "cheer", "expressive spelling"]
    },
    {
      "id": "word-vamooooos--chant",
      "kind": "word",
      "promptEs": "vamooooos",
      "answerEn": "coooome on! go! (a prolonged cheer)",
      "noteEn": "The ordinary spelling is vamos. Five written o letters represent a much longer shouted vowel; the added letters are playful and nonstandard.",
      "example": { "es": "¡Vamooooos!", "en": "Cooooome on!" },
      "tags": ["word", "cheer", "expressive spelling"]
    },
    {
      "id": "grammar-indirect-question-si",
      "kind": "grammar",
      "promptEs": "preguntarse/saber + si + pregunta de sí o no",
      "questionEn": "How do you introduce an indirect question whose answer could be yes or no?",
      "answerEn": "Use unaccented si before the question stated as a normal clause.",
      "noteEn": "After expressions such as me pregunto, no sé, or quiero saber, si usually means “whether.” Do not write an accent: sí with an accent means “yes.” The following words keep statement order rather than direct-question order.",
      "example": { "es": "Quiero saber si Marta viene.", "en": "I want to know whether Marta is coming." },
      "tags": ["grammar", "indirect question", "si", "A2"]
    },
    {
      "id": "phrase-vamos-encouragement",
      "kind": "phrase",
      "promptEs": "¡Vamos!",
      "questionEn": "How do you cheer someone on with “Come on!” or “Go!”?",
      "answerEn": "Use ¡Vamos!",
      "noteEn": "Although vamos literally means “we go,” as an exclamation it encourages a person or team. A speaker may stretch the o while shouting, but standard writing remains vamos.",
      "example": { "es": "¡Vamos, puedes hacerlo!", "en": "Come on, you can do it!" },
      "tags": ["phrase", "encouragement", "cheer", "A1"]
    },
    {
      "id": "grammar-expressive-letter-lengthening",
      "kind": "grammar",
      "promptEs": "letras repetidas para alargar una voz",
      "questionEn": "How can informal writing show that a speaker holds a sound for a long time?",
      "answerEn": "Repeat the letter that represents the stretched sound.",
      "noteEn": "This is expressive spelling used in comics, messages, and informal writing, not a standard dictionary form. More repeated letters usually suggest a longer or stronger shout: vamos can become vamooos.",
      "example": { "es": "¡Nooooo!", "en": "Nooooo!" },
      "tags": ["grammar", "writing", "expressive spelling", "informal"]
    }
  ],
