  "titleText": {
    "es": "DEP, Gary.",
    "en": "RIP, Gary.",
    "noteEn": "DEP abbreviates Descanse en paz, the Spanish counterpart of RIP. Gary refers to Gary Gygax, who died shortly before this strip was published."
  },
  "cardDefinitions": [
    {
      "id": "word-al--fixed-al-habla",
      "kind": "word",
      "promptEs": "al",
      "answerEn": "no separate English word; part of al habla (‘speaking’)",
      "noteEn": "In the fixed telephone formula al habla, al does not express ordinary movement ‘to the.’ The complete formula identifies the person currently speaking.",
      "example": { "es": "¿Señor López? Al habla.", "en": "Mr. López? Speaking." },
      "tags": ["word", "fixed expression", "telephone", "A2"]
    },
    {
      "id": "word-habla--fixed-al-habla",
      "kind": "word",
      "promptEs": "habla",
      "answerEn": "speaking (as part of al habla)",
      "noteEn": "Habla normally relates to speaking, but al habla is a fixed telephone response meaning that the requested person is the one speaking. Habla is not a command here.",
      "example": { "es": "—¿Ana Ruiz? —Al habla.", "en": "—Ana Ruiz? —Speaking." },
      "tags": ["word", "fixed expression", "telephone", "A2"]
    },
    { "id": "word-jefe", "kind": "word", "promptEs": "jefe", "answerEn": "boss; chief", "noteEn": "", "tags": ["word", "work", "noun", "A1"] },
    {
      "id": "word-dónde--direct-question",
      "kind": "word",
      "promptEs": "dónde",
      "answerEn": "where",
      "noteEn": "Dónde carries a written accent when it directly or indirectly asks about a location. In a direct question, Spanish also uses the opening question mark ¿.",
      "example": { "es": "¿Dónde está la estación?", "en": "Where is the station?" },
      "tags": ["word", "question word", "location", "A1"]
    },
    {
      "id": "word-hace--elapsed-duration",
      "kind": "word",
      "promptEs": "hace",
      "answerEn": "it has been; for (introducing elapsed time)",
      "noteEn": "Before an amount of time and que, hace measures how long a situation has continued. It is an impersonal form of hacer: it stays hace rather than changing to match a person.",
      "example": { "es": "Hace una semana que estudio aquí.", "en": "I have studied here for a week." },
      "tags": ["word", "time", "duration", "A2"]
    },
    {
      "id": "word-que--after-hace-continuing-duration",
      "kind": "word",
      "promptEs": "que",
      "answerEn": "no separate English word; connects an elapsed period to a situation still continuing",
      "noteEn": "In hace + amount of time + que + situation, que connects the measured time to what has continued through the present. Natural English usually expresses the connection with ‘for.’",
      "example": { "es": "Hace tres días que llueve.", "en": "It has been raining for three days." },
      "tags": ["word", "time", "connector", "continuing situation", "A2"]
    },
    {
      "id": "word-pasas--stop-by",
      "kind": "word",
      "promptEs": "pasas",
      "answerEn": "you stop by; you come by",
      "noteEn": "Pasas is the present form of pasar for one familiar person. With por and a place, pasar can mean making a brief visit or coming through that place.",
      "example": { "es": "¿Pasas por mi casa esta tarde?", "en": "Are you stopping by my house this afternoon?" },
      "tags": ["word", "verb", "brief visit", "informal singular", "A2"]
    },
    {
      "id": "word-por--pasar-por-lugar",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "by; through (after pasar)",
      "noteEn": "After pasar, por introduces the place someone passes through or stops by.",
      "example": { "es": "Paso por el banco después.", "en": "I’ll stop by the bank later." },
      "tags": ["word", "preposition", "verb complement", "place", "A2"]
    },
    {
      "id": "word-vamos--running-state",
      "kind": "word",
      "promptEs": "vamos",
      "answerEn": "we are running; we are doing (in a current state)",
      "noteEn": "Vamos is normally ‘we go.’ With an adjective describing progress, such as atrasados, it reports how a schedule or group is doing rather than literal movement.",
      "example": { "es": "Vamos bien con el proyecto.", "en": "We are doing well with the project." },
      "tags": ["word", "verb", "progress", "state", "A2"]
    },
    {
      "id": "word-atrasados--behind-schedule",
      "kind": "word",
      "promptEs": "atrasados",
      "answerEn": "behind schedule; running late",
      "noteEn": "Atrasados is masculine plural because it describes a mixed or masculine group. A feminine group would be atrasadas, while one person or thing would use atrasado or atrasada.",
      "example": { "es": "Los autobuses van atrasados.", "en": "The buses are running late." },
      "tags": ["word", "adjective", "schedule", "agreement", "A2"]
    },
    { "id": "word-muere", "kind": "word", "promptEs": "muere", "answerEn": "dies", "noteEn": "", "tags": ["word", "verb", "death", "A1"] },
    {
      "id": "word-retarme--challenge-me",
      "kind": "word",
      "promptEs": "retarme",
      "answerEn": "to challenge me",
      "noteEn": "Retarme joins the verb's unchanged dictionary form retar, ‘to challenge,’ to me, which identifies the speaker as the person being challenged.",
      "example": { "es": "Lucía quiere retarme a una carrera.", "en": "Lucía wants to challenge me to a race." },
      "tags": ["word", "verb", "attached pronoun", "challenge", "A2"]
    },
    {
      "id": "word-a--challenge-target",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "to (introducing the contest in a challenge)",
      "noteEn": "After retar and the challenged person, a introduces the game, contest, or action proposed as the challenge.",
      "example": { "es": "Retaron a Marta a un duelo.", "en": "They challenged Marta to a duel." },
      "tags": ["word", "preposition", "verb complement", "challenge", "A2"]
    },
    {
      "id": "word-por--at-stake",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "for; with ... at stake",
      "noteEn": "Por can introduce what the participants hope to win, keep, or decide through a contest.",
      "example": { "es": "Jugaron por el campeonato.", "en": "They played for the championship." },
      "tags": ["word", "preposition", "stakes", "contest", "A2"]
    },
    { "id": "word-alma", "kind": "word", "promptEs": "alma", "answerEn": "soul", "noteEn": "", "tags": ["word", "noun", "A2"] },
    { "id": "word-procedimiento", "kind": "word", "promptEs": "procedimiento", "answerEn": "procedure; process", "noteEn": "", "tags": ["word", "noun", "process", "A2"] },
    {
      "id": "word-contábamos--counted-on",
      "kind": "word",
      "promptEs": "contábamos",
      "answerEn": "we were counting on; we had expected",
      "noteEn": "Contábamos is a past form of contar for ‘we.’ With con, contar means to count on, rely on, or include someone or something in one's expectations—not to count numbers. The -ábamos ending presents that earlier expectation as background.",
      "example": { "es": "Contábamos con más tiempo.", "en": "We were counting on more time." },
      "tags": ["word", "verb", "fixed expression", "imperfect", "A2"]
    },
    {
      "id": "word-con--contar-con",
      "kind": "word",
      "promptEs": "con",
      "answerEn": "on; with (after contar)",
      "noteEn": "In contar con, con introduces the person, thing, or resource someone relies on or expects.",
      "example": { "es": "Puedes contar con nosotros.", "en": "You can count on us." },
      "tags": ["word", "preposition", "fixed expression", "reliance", "A2"]
    },
    {
      "id": "word-lleve--take-time-subjunctive",
      "kind": "word",
      "promptEs": "lleve",
      "answerEn": "it may take (time)",
      "noteEn": "Llevar can mean ‘to take’ when talking about the time an activity requires. Lleve is a special subjunctive form used here after puede que because the duration is only a possibility; the ordinary statement form would be lleva.",
      "example": { "es": "Puede que lleve una hora.", "en": "It may take an hour." },
      "tags": ["word", "verb", "time required", "subjunctive", "A2"]
    },
    { "id": "word-añado", "kind": "word", "promptEs": "añado", "answerEn": "I add; I am adding", "noteEn": "", "tags": ["word", "verb", "A2"] },
    {
      "id": "word-a--addition-target",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "to; into (the group or collection something is added to)",
      "noteEn": "After añadir, a introduces the destination group, list, collection, or place that receives the new item.",
      "example": { "es": "Añadí su nombre a la lista.", "en": "I added her name to the list." },
      "tags": ["word", "preposition", "addition", "verb complement", "A2"]
    },
    { "id": "word-paladín", "kind": "word", "promptEs": "paladín", "answerEn": "paladin; holy warrior", "noteEn": "", "tags": ["word", "fantasy", "role-playing games"] },
    {
      "id": "word-sacando--taking-out",
      "kind": "word",
      "promptEs": "sacando",
      "answerEn": "taking out; pulling out",
      "noteEn": "Sacando is sacar's ongoing-action form. With a physical object, sacar often means taking or pulling it out from where it was kept.",
      "example": { "es": "Está sacando un cuaderno de la mochila.", "en": "She is taking a notebook out of the backpack." },
      "tags": ["word", "verb", "gerund", "movement", "A2"]
    },
    {
      "id": "phrase-al-habla",
      "kind": "phrase",
      "promptEs": "al habla",
      "questionEn": "How can you identify yourself as the requested person speaking on the telephone?",
      "answerEn": "Use al habla after your name or title, or by itself as a response.",
      "noteEn": "Al habla is a fixed telephone formula equivalent to saying that the requested person is speaking. Although habla normally relates to speech, this formula is not a command and al does not keep its ordinary movement meaning.",
      "example": { "es": "—¿Doctora Vega? —Al habla.", "en": "—Dr. Vega? —Speaking." },
      "tags": ["phrase", "telephone", "identification", "A2"]
    },
    {
      "id": "grammar-hace-periodo-que",
      "kind": "grammar",
      "promptEs": "hace + período + que + situación",
      "questionEn": "How do you say that a situation started an amount of time ago and is still continuing?",
      "answerEn": "Use hace, then the amount of time, then que and the continuing situation.",
      "noteEn": "Hace stays unchanged and measures the elapsed period. Que connects that period to a situation that continues through now. This differs from hace + time used with a finished event: Llegó hace dos días means ‘She arrived two days ago,’ while Hace dos días que está aquí means ‘She has been here for two days.’",
      "example": { "es": "Hace dos meses que trabajo aquí.", "en": "I have worked here for two months." },
      "tags": ["grammar", "duration", "continuing situation", "A2"]
    },
    {
      "id": "phrase-pasar-por-lugar",
      "kind": "phrase",
      "promptEs": "pasar por + lugar",
      "questionEn": "How do you say that someone passes through or stops briefly at a place?",
      "answerEn": "Use the matching form of pasar, then por and the place.",
      "noteEn": "Pasar por can describe going through a place on the way elsewhere or making a brief visit there. Pasar changes for the person and time; por stays unchanged before the place.",
      "example": { "es": "Paso por la farmacia después.", "en": "I’ll stop by the pharmacy later." },
      "tags": ["phrase", "movement", "brief visit", "place", "A2"]
    },
    {
      "id": "phrase-ir-atrasado",
      "kind": "phrase",
      "promptEs": "ir atrasado/atrasada",
      "questionEn": "How do you say that a person, group, or schedule is running late or falling behind?",
      "answerEn": "Use the matching form of ir followed by atrasado, atrasada, atrasados, or atrasadas.",
      "noteEn": "Here ir describes how something is progressing rather than physical movement. Ir changes for the person and time. Atrasado changes its ending to match who or what is behind: va atrasada for one feminine subject and van atrasados for a masculine or mixed plural group.",
      "example": { "es": "El proyecto va atrasado.", "en": "The project is running behind schedule." },
      "tags": ["phrase", "schedule", "progress", "agreement", "A2"]
    },
    {
      "id": "phrase-retar-a-alguien-a-algo",
      "kind": "phrase",
      "promptEs": "retar a alguien a algo",
      "questionEn": "How do you say that someone challenges another person to a game, contest, or action?",
      "answerEn": "Use a form of retar, identify the challenged person with a, then use another a before the contest or action.",
      "noteEn": "The first a marks the person being challenged: reto a Ana. A short object word can replace that person, as in me reta or retarme. The second a introduces the proposed contest or action and remains visible: a una carrera or a jugar.",
      "example": { "es": "Reto a Luis a una carrera.", "en": "I challenge Luis to a race." },
      "tags": ["phrase", "challenge", "verb complements", "A2"]
    },
    {
      "id": "phrase-contar-con",
      "kind": "phrase",
      "promptEs": "contar con alguien o algo",
      "questionEn": "How do you say that someone counts on, relies on, or expects a person or thing?",
      "answerEn": "Use the matching form of contar, then con and the person or thing relied on or expected.",
      "noteEn": "Contar by itself often means counting numbers or telling a story. Contar con forms a separate expression about relying on support, having something available, or including it in one's expectations. Contar changes for the person and time; con stays unchanged.",
      "example": { "es": "Contamos con tu ayuda.", "en": "We are counting on your help." },
      "tags": ["phrase", "reliance", "expectation", "A2"]
    },
    {
      "id": "concept-gary-gygax-dnd",
      "kind": "concept",
      "promptEs": "Gary Gygax y Dungeons & Dragons",
      "answerEn": "Gary Gygax co-created the tabletop role-playing game Dungeons & Dragons.",
      "noteEn": "Paladins, adventuring groups, and extensive rulebooks are familiar parts of Dungeons & Dragons. The comic imagines that Gygax has turned Death's simple game for his soul into a long tabletop campaign, and the title text memorializes him shortly after his death in 2008.",
      "tags": ["concept", "Dungeons & Dragons", "tabletop role-playing game", "xkcd joke"]
    }
  ],
