    {
      "id": "grammar-tener-que-infinitive",
      "kind": "grammar",
      "promptEs": "tener que + verbo en forma de diccionario",
      "questionEn": "How do you say that someone has to do something?",
      "answerEn": "Use a form of tener, then que, then the action verb in its unchanged dictionary form.",
      "noteEn": "Only tener changes for the person and time: tengo que, tienes que, tiene que, and so on. The final action keeps its -ar, -er, or -ir ending.",
      "example": {
        "es": "Tengo que salir temprano.",
        "en": "I have to leave early."
      },
      "tags": ["A1", "grammar", "obligation", "verb pattern"]
    },
    {
      "id": "grammar-relative-superlative",
      "kind": "grammar",
      "promptEs": "el/la/los/las + sustantivo + más + adjetivo",
      "questionEn": "How do you describe someone or something as the most of a quality?",
      "answerEn": "Use the matching form of “the,” name the person or thing, then add más plus the describing word.",
      "noteEn": "The opening el, la, los, or las agrees with the noun. Más stays unchanged, while the final adjective changes when Spanish normally requires agreement.",
      "example": {
        "es": "Es la calle más larga.",
        "en": "It is the longest street."
      },
      "tags": ["A2", "grammar", "superlative", "comparison"]
    },
    {
      "id": "grammar-es-adjective-infinitive",
      "kind": "grammar",
      "promptEs": "es + adjetivo + verbo en forma de diccionario",
      "questionEn": "How do you say that doing an activity is great, difficult, useful, or another quality?",
      "answerEn": "Use es, add the describing word, and put the activity verb in its unchanged dictionary form.",
      "noteEn": "This pattern evaluates an activity in general. The final verb keeps its -ar, -er, or -ir ending because no particular person is stated as its subject.",
      "example": {
        "es": "Es difícil esperar.",
        "en": "Waiting is difficult."
      },
      "tags": ["A2", "grammar", "evaluation", "infinitive"]
    },
    {
      "id": "grammar-poder-infinitive",
      "kind": "grammar",
      "promptEs": "poder + verbo en forma de diccionario",
      "questionEn": "How do you say that someone can, could, or may do something?",
      "answerEn": "Use a form of poder for the person and situation, then keep the action verb in its unchanged dictionary form.",
      "noteEn": "Poder changes to forms such as puedo, puedes, puede, podemos, and pueden for present ability or possibility. Podría can present a possible or imagined option. The following action keeps its -ar, -er, or -ir ending.",
      "example": {
        "es": "Podemos entrar ahora.",
        "en": "We can enter now."
      },
      "tags": ["A1", "grammar", "ability", "possibility", "verb pattern"]
    },
    {
      "id": "grammar-pronoun-attached-to-infinitive",
      "kind": "grammar",
      "promptEs": "verbo en forma de diccionario + pronombre unido",
      "questionEn": "Where can a short object word such as me, te, lo, or la go with an unchanged action verb?",
      "answerEn": "Attach it to the end of the verb and write the result as one word.",
      "noteEn": "An unchanged dictionary-form verb ends in -ar, -er, or -ir. Short object words can attach directly: conocer + te becomes conocerte, and ayudar + me becomes ayudarme.",
      "example": {
        "es": "Quiero ayudarte.",
        "en": "I want to help you."
      },
      "tags": ["A2", "grammar", "object pronouns", "infinitive"]
    },
    {
      "id": "phrase-al-fin",
      "kind": "phrase",
      "promptEs": "al fin",
      "questionEn": "How do you express relief that something has finally happened?",
      "answerEn": "Use al fin to mean “finally” or “at last.”",
      "noteEn": "This fixed expression often highlights that a wait, delay, or difficulty has ended. It can appear before or after the action.",
      "example": {
        "es": "Al fin llegó el autobús.",
        "en": "At last, the bus arrived."
      },
      "tags": ["A2", "expression", "time", "relief"]
    }
  ],
