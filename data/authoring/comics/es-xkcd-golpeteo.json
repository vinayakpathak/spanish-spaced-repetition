      "id": "word-sacar--produce-sound",
      "kind": "word",
      "promptEs": "sacar",
      "answerEn": "to get; to produce (a sound or pitch)",
      "noteEn": "Sacar often means “to take out.” With a sound, note, or tone, it can instead mean getting or producing that sound from an object or instrument.",
      "example": {
        "es": "Sacó un sonido claro de la flauta.",
        "en": "She got a clear sound from the flute."
      },
      "tags": ["word", "sound", "polysemy", "A2"]
