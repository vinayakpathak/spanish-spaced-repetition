    {
      "id": "word-en--first-to",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "to; required before the action after primero or primera",
      "noteEn": "When primero or primera identifies who does something before everyone else, en links it to the unchanged action verb.",
      "example": {
        "es": "Fue la primera en responder.",
        "en": "She was the first to answer."
      },
      "tags": [
        "word",
        "preposition",
        "order",
        "A2"
      ]
    },
    {
      "id": "word-anhelo",
      "kind": "word",
      "promptEs": "anhelo",
      "answerEn": "longing; deep desire",
      "noteEn": "Anhelo is a strong, sustained wish rather than an ordinary momentary preference.",
      "example": {
        "es": "Sentía un anhelo de libertad.",
        "en": "He felt a longing for freedom."
      },
      "tags": [
        "word",
        "desire",
        "noun",
        "B1"
      ]
    },
    {
      "id": "word-por--longing-complement",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "for; introduces what a longing is directed toward",
      "noteEn": "After anhelo, por can introduce the desired person, thing, or action.",
      "example": {
        "es": "Su anhelo por viajar creció.",
        "en": "Her longing to travel grew."
      },
      "tags": [
        "word",
        "preposition",
        "desire",
        "B1"
      ]
    },
    {
      "id": "word-buscarnos",
      "kind": "word",
      "promptEs": "buscarnos",
      "answerEn": "to look for us; to search for us",
      "noteEn": "Buscar is the unchanged action form, and nos is attached to its end to identify the speaker's group as the people sought.",
      "example": {
        "es": "Van a buscarnos mañana.",
        "en": "They are going to look for us tomorrow."
      },
      "tags": [
        "word",
        "buscar",
        "attached pronoun",
        "A2"
      ]
    },
    {
      "id": "phrase-docenas-de",
      "kind": "phrase",
      "promptEs": "docenas de + nombre",
      "questionEn": "How do you say that there are dozens of something?",
      "answerEn": "Use docenas de before the thing being counted.",
      "noteEn": "Docenas stays plural when it means an approximate large count. De is required before the following noun: docenas de cartas. The noun is normally plural when it names countable items.",
      "example": {
        "es": "Vimos docenas de estrellas.",
        "en": "We saw dozens of stars."
      },
      "tags": [
        "phrase",
        "quantity",
        "approximation",
        "A2"
      ]
    },
    {
      "id": "grammar-si-imperfect-subjunctive-conditional-perfect",
      "kind": "grammar",
      "promptEs": "si + situación hipotética actual, resultado con habría + participio",
      "questionEn": "How do you say that an unreal situation now would already have produced an earlier result?",
      "answerEn": "Use si with a special hypothetical form for the present situation, then use habría, habrías, habríamos, or habrían plus a completed-action form for the imagined earlier result.",
      "noteEn": "The form after si is called the imperfect subjunctive, even though it can describe an unreal situation now: hay can become hubiera. In the result, the conditional form of haber changes for the person, while the completed-action form stays unchanged: habría visto, habríamos visto. Do not use the conditional habría directly after si in this pattern.",
      "example": {
        "es": "Si Clara viviera aquí, ya habría conocido a todos.",
        "en": "If Clara lived here, she would already have met everyone."
      },
      "tags": [
        "grammar",
        "mixed counterfactual",
        "conditional perfect",
        "subjunctive",
        "B2"
      ]
    },
    {
      "id": "grammar-primero-en-infinitivo",
      "kind": "grammar",
      "promptEs": "ser el/la primero/a en + infinitivo",
      "questionEn": "How do you say that someone is the first to do an action?",
      "answerEn": "Use el primero or la primera, then en, then the action verb in its unchanged dictionary form.",
      "noteEn": "Primero changes to match the person or thing: primero for masculine and primera for feminine. En stays fixed. The following infinitive is the verb's unchanged -ar, -er, or -ir form, such as llegar or responder.",
      "example": {
        "es": "Nora fue la primera en llegar.",
        "en": "Nora was the first to arrive."
      },
      "tags": [
        "grammar",
        "order",
        "infinitive",
        "A2"
      ]
    },
    {
      "id": "phrase-anhelo-por",
      "kind": "phrase",
      "promptEs": "anhelo por + nombre/infinitivo",
      "questionEn": "How can you name the person, thing, or action that a deep longing is directed toward?",
      "answerEn": "Use anhelo por, then a noun or an action verb in its unchanged dictionary form.",
      "noteEn": "Anhelo names a deep desire and por introduces its target. With an action, keep the verb in its unchanged -ar, -er, or -ir form: anhelo por volver.",
      "example": {
        "es": "Sentía un anhelo por volver a casa.",
        "en": "She felt a longing to return home."
      },
      "tags": [
        "phrase",
        "longing",
        "desire",
        "infinitive",
        "B1"
      ]
    },
    {
      "id": "concept-ant-pheromones-search-for-intelligence",
      "kind": "concept",
      "promptEs": "hormigas · feromonas · búsqueda de vida inteligente",
      "questionEn": "Why do the ants' pheromone trails mirror a human search for intelligent life?",
      "answerEn": "Ants communicate largely through chemical trails, so they imagine that any intelligent beings should leave pheromone messages across nearby tiles. Their search repeats human reasoning about detectable extraterrestrial signals at an absurd ant-sized scale.",
      "noteEn": "The caption adds another reversal: the ants are themselves the newly intelligent civilization doing the searching, while humans remain outside the signals they know how to detect.",
      "tags": [
        "concept",
        "ants",
        "pheromones",
        "search for intelligence",
        "xkcd joke"
      ]
    }
  ],
