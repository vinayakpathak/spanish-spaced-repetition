  "titleEs": "Diapositivas",
  "titleText": {
    "es": "¿Sabíais que te pueden echar físicamente del SIGGRAPH?",
    "en": "Did you all know that they can physically throw you out of SIGGRAPH?",
    "noteEn": "The Spanish title text switches from plural informal sabíais to singular informal te. The official English source leaves the number of listeners unspecified and also includes ‘actually,’ which the Spanish version omits."
  },
  "cardDefinitions": [
    {
      "id": "word-gráfica--chart",
      "kind": "word",
      "promptEs": "gráfica",
      "answerEn": "chart; graph",
      "noteEn": "Here gráfica is a visual display of data, not the feminine form of an adjective meaning ‘graphic.’",
      "example": { "es": "La gráfica muestra las temperaturas.", "en": "The chart shows the temperatures." },
      "tags": ["word", "data", "feminine noun", "A2"]
    },
    {
      "id": "word-explicaba--background-description",
      "kind": "word",
      "promptEs": "explicaba",
      "answerEn": "explained; was explaining (as background)",
      "noteEn": "Explicaba is a past form of explicar. Its -aba ending presents the explaining as part of the background or an ongoing past situation, without marking a separate completed endpoint.",
      "example": { "es": "La guía explicaba el mapa.", "en": "The guide was explaining the map." },
      "tags": ["word", "past", "background", "B1"]
    },
    {
      "id": "word-cuántico--quantum-physics",
      "kind": "word",
      "promptEs": "cuántico",
      "answerEn": "quantum; relating to quantum physics (masculine singular)",
      "noteEn": "Cuántico describes phenomena governed by quantum physics, especially at atomic and subatomic scales. Its ending changes to cuántica with a feminine singular noun.",
      "example": { "es": "Estudian un sistema cuántico.", "en": "They study a quantum system." },
      "tags": ["word", "physics", "adjective", "technical"]
    },
    {
      "id": "word-disculpan--excuse-listeners",
      "kind": "word",
      "promptEs": "disculpan",
      "answerEn": "you excuse; you pardon (addressing a group)",
      "noteEn": "Disculpan is a present form of disculpar used with ustedes, the usual plural ‘you’ throughout Latin America and a formal plural ‘you’ in Spain. In si me disculpan, it makes a polite request for the listeners' brief patience.",
      "example": { "es": "¿Me disculpan un momento?", "en": "Will you excuse me for a moment?" },
      "tags": ["word", "politeness", "plural you", "A2"]
    },
    {
      "id": "word-pluviosidad--rainfall",
      "kind": "word",
      "promptEs": "pluviosidad",
      "answerEn": "rainfall; amount of rain",
      "noteEn": "Pluviosidad is a technical or formal word for how much rain a place receives over a period.",
      "example": { "es": "La pluviosidad aumenta en otoño.", "en": "Rainfall increases in autumn." },
      "tags": ["word", "weather", "measurement", "B2"]
    },
    {
      "id": "word-sobre--over-area",
      "kind": "word",
      "promptEs": "sobre",
      "answerEn": "over; across (an area)",
      "noteEn": "Sobre can introduce the geographical area across which something is measured or happens. This is different from sobre meaning ‘about’ a topic.",
      "example": { "es": "La tormenta avanza sobre la costa.", "en": "The storm moves over the coast." },
      "tags": ["word", "preposition", "area", "A2"]
    },
    {
      "id": "word-cuenca--drainage-basin",
      "kind": "word",
      "promptEs": "cuenca",
      "answerEn": "drainage basin; river basin",
      "noteEn": "A cuenca is the land area whose water drains into the same river or body of water.",
      "example": { "es": "El río recoge agua de toda la cuenca.", "en": "The river collects water from the whole basin." },
      "tags": ["word", "geography", "water", "technical"]
    },
    {
      "id": "word-amazonas--river-region",
      "kind": "word",
      "promptEs": "amazonas",
      "answerEn": "Amazon; the Amazon River region",
      "noteEn": "Spanish commonly uses el Amazonas for the Amazon River. Cuenca del Amazonas therefore names the broad area drained by that river.",
      "example": { "es": "El Amazonas cruza una región enorme.", "en": "The Amazon crosses an enormous region." },
      "tags": ["word", "place name", "river", "geography"]
    },
    {
      "id": "word-paras--stop-doing",
      "kind": "word",
      "promptEs": "paras",
      "answerEn": "you stop (doing something)",
      "noteEn": "Paras is the present form of parar used for tú, one familiar listener. Before de and another action verb, it means that the listener stops doing that action.",
      "example": { "es": "Paras de hablar.", "en": "You stop talking." },
      "tags": ["word", "stopping", "present", "informal singular", "A2"]
    },
    {
      "id": "word-de--after-parar",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; links parar to the action that stops",
      "noteEn": "Spanish requires de between a form of parar and the following action verb. English does not translate this linking word separately.",
      "example": { "es": "Paramos de correr.", "en": "We stop running." },
      "tags": ["word", "linking word", "stopping", "A2"]
    },
    {
      "id": "word-tardará--take-time",
      "kind": "word",
      "promptEs": "tardará",
      "answerEn": "will take (an amount of time)",
      "noteEn": "Tardará keeps the complete verb tardar and adds -á to place the time-taking in the future for one person, group, or thing.",
      "example": { "es": "La reparación tardará una hora.", "en": "The repair will take an hour." },
      "tags": ["word", "time", "future", "B1"]
    },
    {
      "id": "word-rato--short-while",
      "kind": "word",
      "promptEs": "rato",
      "answerEn": "while; a short or unspecified period of time",
      "noteEn": "Un rato refers to an imprecise stretch of time. Its length depends on the situation rather than on a fixed number of minutes.",
      "example": { "es": "Descansamos un rato.", "en": "We rest for a while." },
      "tags": ["word", "time", "noun", "A2"]
    },
    {
      "id": "word-darse--realize",
      "kind": "word",
      "promptEs": "darse",
      "answerEn": "to realize; to notice (as part of darse cuenta)",
      "noteEn": "Darse combines the dictionary form dar with se attached. It does not mean ‘to give oneself’ here: darse cuenta is the complete fixed expression for realizing or noticing something.",
      "example": { "es": "Marta puede darse cuenta del error.", "en": "Marta can notice the error." },
      "tags": ["word", "fixed expression", "attached pronoun", "A2"]
    },
    {
      "id": "word-les--plural-recipient",
      "kind": "word",
      "promptEs": "les",
      "answerEn": "to them; marks them as the people receiving something",
      "noteEn": "Les identifies more than one receiver. It normally appears before a verb that changes for the person and time, although it can attach to some unchanged verb forms and positive commands.",
      "example": { "es": "Les envío una foto.", "en": "I send them a photo." },
      "tags": ["word", "recipient", "plural", "pronoun", "A2"]
    },
    {
      "id": "word-mostrando--showing",
      "kind": "word",
      "promptEs": "mostrando",
      "answerEn": "showing; displaying",
      "noteEn": "Mostrando is the ongoing-action form of mostrar. Regular verbs ending in -ar replace -ar with -ando to make this form.",
      "example": { "es": "Estoy mostrando una fotografía.", "en": "I am showing a photograph." },
      "tags": ["word", "ongoing action", "showing", "A2"]
    },
    {
      "id": "word-diapositivas--presentation-slides",
      "kind": "word",
      "promptEs": "diapositivas",
      "answerEn": "slides; presentation slides",
      "noteEn": "Diapositiva can name one image or page shown as part of a presentation. The plural diapositivas refers to several such slides.",
      "example": { "es": "La presentación tiene diez diapositivas.", "en": "The presentation has ten slides." },
      "tags": ["word", "presentation", "plural", "A2"]
    },
    {
      "id": "word-aleatorias--random-feminine-plural",
      "kind": "word",
      "promptEs": "aleatorias",
      "answerEn": "random (feminine plural)",
      "noteEn": "Aleatorias describes several feminine things selected or arranged without a planned pattern. The -as ending matches a feminine plural noun such as diapositivas.",
      "example": { "es": "Elegimos tres preguntas aleatorias.", "en": "We choose three random questions." },
      "tags": ["word", "description", "feminine plural", "B1"]
    },
    {
      "id": "phrase-si-me-disculpa-un-momento",
      "kind": "phrase",
      "promptEs": "si me disculpa(n) un momento",
      "questionEn": "How can you politely ask one formal listener or several listeners to excuse a brief interruption?",
      "answerEn": "Say si me disculpa un momento to one formal listener, or si me disculpan un momento when addressing several people as ustedes.",
      "noteEn": "Si means ‘if,’ me identifies the speaker asking to be excused, and un momento gives the brief time requested. Disculpa addresses one formal listener. Disculpan addresses any group in Latin America and a formal group in Spain; an informal group in Spain would use disculpáis. The parentheses in the prompt show that the final n is added only for the disculpan form.",
      "example": { "es": "Si me disculpa un momento, voy a buscar el informe.", "en": "If you'll excuse me for a moment, I am going to get the report." },
      "tags": ["phrase", "politeness", "brief interruption", "A2"]
    },
    {
      "id": "grammar-parar-de-infinitive",
      "kind": "grammar",
      "promptEs": "parar de + verbo en forma de diccionario",
      "questionEn": "How do you say that someone stops doing an action?",
      "answerEn": "Use a form of parar, then de, then the action verb in its unchanged dictionary form.",
      "noteEn": "The plus signs in the prompt show the order of the three pieces. The dictionary form is the unchanged verb ending in -ar, -er, or -ir. Only parar changes for the person and time: paro de hablar, paras de hablar, pararon de hablar. De is required even though English does not translate it separately.",
      "example": { "es": "Elena para de hablar.", "en": "Elena stops talking." },
      "tags": ["grammar", "stopping", "infinitive", "A2"]
    },
    {
      "id": "grammar-recipient-pronoun-before-conjugated-verb",
      "kind": "grammar",
      "promptEs": "me/te/le/nos/os/les delante del verbo que cambia",
      "questionEn": "Where do you put the short word that identifies who receives something?",
      "answerEn": "Put me, te, le, nos, os, or les before the first verb that changes for the person and time.",
      "noteEn": "The slashes in the prompt mean to choose the one receiver word that fits. A verb that changes for the person and time is often called a conjugated verb: estoy rather than the dictionary form estar. In a multiword verb phrase, the receiver word goes before that changed verb, so les estoy enviando places les before estoy, not between estoy and enviando.",
      "example": { "es": "Les estoy enviando una foto.", "en": "I am sending them a photo." },
      "tags": ["grammar", "recipient", "word order", "A2"]
    }
  ],
