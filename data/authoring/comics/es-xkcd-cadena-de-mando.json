      "id": "phrase-cadena-de-mando",
      "kind": "phrase",
      "promptEs": "cadena de mando",
      "questionEn": "How do you refer to the hierarchy through which authority and orders pass?",
      "answerEn": "Use cadena de mando.",
      "noteEn": "Cadena pictures authority as a sequence of linked levels. De mando identifies the sequence as one of command rather than a physical chain.",
      "example": { "es": "La petición siguió la cadena de mando.", "en": "The request followed the chain of command." },
      "tags": ["phrase", "organization", "authority", "B1"]
