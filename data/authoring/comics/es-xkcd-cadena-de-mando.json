      "promptEs": "secretario de Defensa",
      "questionEn": "How do you name the cabinet official responsible for national defense?",
      "answerEn": "Use secretario de Defensa for a man and secretaria de Defensa for a woman.",
      "noteEn": "The title begins with secretario or secretaria for the official. De links the office to its area of responsibility, Defensa. Capitalization can vary by editorial style.",
      "example": { "es": "La secretaria de Defensa habló ante el parlamento.", "en": "The defense secretary spoke before parliament." },
