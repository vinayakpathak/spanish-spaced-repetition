      "id": "grammar-tras-infinitive",
      "kind": "grammar",
      "promptEs": "tras + verbo en forma de diccionario",
      "questionEn": "How do you say that one action happens after another action?",
      "answerEn": "Use tras, then put the earlier action in its unchanged dictionary form.",
      "noteEn": "The action after tras keeps its -ar, -er, or -ir ending. Tras is a compact alternative to después de; both can mean “after doing something.”",
      "example": {
        "es": "Tras terminar, llamé a Ana.",
        "en": "After finishing, I called Ana."
      },
      "tags": ["B1", "grammar", "time", "infinitive"]
    },
    {
      "id": "phrase-bajar-la-voz",
      "kind": "phrase",
      "promptEs": "bajar la voz",
      "questionEn": "How do you tell someone to speak more quietly by saying “lower your voice”?",
      "answerEn": "Use bajar la voz.",
      "noteEn": "Bajar means to lower, and la voz means the voice. Change bajar for the person and situation; an informal positive command is baja la voz.",
      "example": {
        "es": "Por favor, baja la voz.",
        "en": "Please lower your voice."
      },
      "tags": ["A2", "expression", "conversation"]
    },
