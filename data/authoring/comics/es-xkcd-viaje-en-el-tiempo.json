  "titleEn": "Time Travel",
  "titleEs": "Viaje en el tiempo",
  "titleText": {
    "es": "También empieza todas sus cartas con: «Querido <tu nombre> del futuro».",
    "en": "She also starts every letter with \"Dear Future <your name>\".",
    "noteEn": "The Spanish archive and official xkcd source both identify comic #630. The archive translates the official title text while preserving its angle-bracket name slot."
  },
  "cardDefinitions": [
    {
      "id": "word-vengo--come-from",
      "kind": "word",
      "promptEs": "vengo",
      "answerEn": "I come; I come from",
      "noteEn": "Vengo is the present form of venir for the speaker. With de or del, it identifies the speaker's origin.",
      "example": {
        "es": "Vengo del centro.",
        "en": "I come from downtown."
      },
      "tags": [
        "word",
        "venir",
        "origin",
        "present",
        "A1"
      ]
    },
    {
      "id": "word-queda--left",
      "kind": "word",
      "promptEs": "queda",
      "answerEn": "is left; remains",
      "noteEn": "Queda is singular here because the question asks whether any one item remains.",
      "example": {
        "es": "¿Queda pan?",
        "en": "Is there any bread left?"
      },
      "tags": [
        "word",
        "quedar",
        "remaining",
        "present",
        "A2"
      ]
    },
    {
      "id": "word-algún--any-question",
      "kind": "word",
      "promptEs": "algún",
      "answerEn": "any (before a masculine singular noun in a question)",
      "noteEn": "Algún is the shortened form of alguno used directly before a masculine singular noun. In a question, natural English often uses “any.”",
      "example": {
        "es": "¿Hay algún problema?",
        "en": "Is there any problem?"
      },
      "tags": [
        "word",
        "indefinite",
        "question",
        "A2"
      ]
    },
    {
      "id": "word-donut",
      "kind": "word",
      "promptEs": "donut",
      "answerEn": "doughnut; donut",
      "noteEn": "Donut is a common borrowed food word in Spanish; dónut is also written with an accent in edited Spanish.",
      "example": {
        "es": "Compré un donut de chocolate.",
        "en": "I bought a chocolate doughnut."
      },
      "tags": [
        "word",
        "food",
        "loanword",
        "A1"
      ]
    },
    {
      "id": "word-técnicamente",
      "kind": "word",
      "promptEs": "técnicamente",
      "answerEn": "technically",
      "noteEn": "Técnicamente describes something as true according to a strict or technical reading.",
      "example": {
        "es": "Técnicamente, la tienda sigue abierta.",
        "en": "Technically, the shop is still open."
      },
      "tags": [
        "word",
        "adverb",
        "manner",
        "A2"
      ]
    },
    {
      "id": "word-cierto--true-predicate",
      "kind": "word",
      "promptEs": "cierto",
      "answerEn": "true; correct",
      "noteEn": "After es, cierto describes a statement or claim as true.",
      "example": {
        "es": "Eso es cierto.",
        "en": "That is true."
      },
      "tags": [
        "word",
        "truth",
        "adjective",
        "A1"
      ]
    },
    {
      "id": "word-preferiría--would-prefer",
      "kind": "word",
      "promptEs": "preferiría",
      "answerEn": "I would prefer",
      "noteEn": "Preferiría keeps the full verb preferir and adds -ía. This conditional form makes the preference sound less direct.",
      "example": {
        "es": "Preferiría esperar aquí.",
        "en": "I would prefer to wait here."
      },
      "tags": [
        "word",
        "preferir",
        "conditional",
        "politeness",
        "B1"
      ]
    },
    {
      "id": "word-dejara--preferred-action",
      "kind": "word",
      "promptEs": "dejara",
      "answerEn": "that she stop; she would stop (after a preference)",
      "noteEn": "Here dejara is the special form of dejar used for an action the speaker wants another person to take. Ordinary deja changes to dejara after preferiría que.",
      "example": {
        "es": "Preferiría que Marta dejara la puerta abierta.",
        "en": "I would prefer Marta to leave the door open."
      },
      "tags": [
        "word",
        "dejar",
        "preference",
        "subjunctive",
        "B1"
      ]
    },
    {
      "id": "word-de--after-antes-noun",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "before; required after antes when a noun follows",
      "noteEn": "Antes de comes before a noun or an unchanged action verb. The two Spanish words often correspond to the single English word “before.”",
      "example": {
        "es": "Llegué antes de la cena.",
        "en": "I arrived before dinner."
      },
      "tags": [
        "word",
        "time",
        "antes de",
        "A2"
      ]
    },
    {
      "id": "word-frases",
      "kind": "word",
      "promptEs": "frases",
      "answerEn": "sentences; phrases",
      "noteEn": "",
      "tags": [
        "word",
        "language",
        "plural",
        "A1"
      ]
    },
    {
      "id": "grammar-alguno-to-algun-before-masculine-noun",
      "kind": "grammar",
      "promptEs": "alguno → algún + nombre masculino singular",
      "questionEn": "What happens to alguno when it comes directly before one masculine noun?",
      "answerEn": "Shorten alguno to algún directly before a masculine singular noun.",
      "noteEn": "The final -o disappears and the written accent remains: alguno can stand alone, but algún día and algún libro place the shortened form before a masculine singular noun. Feminine alguna does not shorten.",
      "example": {
        "es": "Necesito algún consejo.",
        "en": "I need some advice."
      },
      "tags": [
        "grammar",
        "indefinite",
        "shortened adjective",
        "A2"
      ]
    },
    {
      "id": "grammar-quedar-remaining-quantity",
      "kind": "grammar",
      "promptEs": "quedar + cantidad restante",
      "questionEn": "How can you say that some amount or item is still left?",
      "answerEn": "Use quedar with the thing or amount that remains: queda for one thing and quedan for more than one.",
      "noteEn": "The remaining thing controls the verb. Use queda with a singular or uncounted thing, as in queda café, and quedan with plural things, as in quedan dos entradas.",
      "example": {
        "es": "Quedan tres minutos.",
        "en": "There are three minutes left."
      },
      "tags": [
        "grammar",
        "quedar",
        "remaining",
        "agreement",
        "A2"
      ]
    },
    {
      "id": "grammar-aunque-indicative-known-fact",
      "kind": "grammar",
      "promptEs": "aunque + hecho presentado como cierto",
      "questionEn": "How do you introduce a contrast while presenting the following information as a known fact?",
      "answerEn": "Use aunque, then the ordinary verb form used for a fact.",
      "noteEn": "Aunque means “although” or “even though.” When the speaker treats the information as real or already established, the following verb stays in the ordinary fact form: es, tiene, or ocurrió. A different special form can appear when the point is uncertain or hypothetical.",
      "example": {
        "es": "Aunque llueve, salimos.",
        "en": "Although it is raining, we are going out."
      },
      "tags": [
        "grammar",
        "aunque",
        "contrast",
        "indicative",
        "B1"
      ]
    },
    {
      "id": "grammar-preferir-que-subjunctive",
      "kind": "grammar",
      "promptEs": "preferir que + acción de otra persona",
      "questionEn": "How do you express a preference about what another person does?",
      "answerEn": "Use a form of preferir, then que, then a specially changed form of the other person's action.",
      "noteEn": "The form after que is called the subjunctive: it presents a wanted action rather than a stated fact. For an -ar verb, the ending changes to an -e-family form: hablas becomes hable, and dejas can become deje or dejara depending on the time and tone.",
      "example": {
        "es": "Prefiero que Marta llame mañana.",
        "en": "I prefer Marta to call tomorrow."
      },
      "tags": [
        "grammar",
        "preferir",
        "subjunctive",
        "preference",
        "B1"
      ]
    }
  ],
