    {
      "id": "phrase-ventajas-de-infinitive",
      "kind": "phrase",
      "promptEs": "ventajas de + infinitivo",
      "questionEn": "How do you introduce the advantages of doing an activity?",
      "answerEn": "Use ventajas de followed by the action verb in its unchanged dictionary form.",
      "noteEn": "The action verb ends in -ar, -er, or -ir and names the activity whose benefits are being discussed.",
      "example": { "es": "Hablamos de las ventajas de caminar.", "en": "We are talking about the advantages of walking." },
      "tags": ["phrase", "evaluation", "infinitive", "A2"]
    },
    {
      "id": "phrase-salir-con-alguien",
      "kind": "phrase",
      "promptEs": "salir con alguien",
      "questionEn": "How do you say that someone is dating another person?",
      "answerEn": "Use a form of salir, then con, then the person.",
      "noteEn": "This relationship meaning depends on con plus a person. In other settings, salir can simply mean “to go out” or “to leave.”",
      "example": { "es": "Luis sale con mi hermano.", "en": "Luis is dating my brother." },
      "tags": ["phrase", "relationships", "A2"]
    },
    {
      "id": "phrase-no-hay-mas-que-hablar",
      "kind": "phrase",
      "promptEs": "no hay más que hablar",
      "questionEn": "How do you say firmly that there is nothing more to discuss?",
      "answerEn": "Use no hay más que hablar.",
      "noteEn": "The expression closes a discussion by presenting the decision as final. Más means “more,” while que links it to hablar, the remaining possible discussion.",
      "example": { "es": "La decisión está tomada; no hay más que hablar.", "en": "The decision is made; there is nothing more to discuss." },
      "tags": ["phrase", "decision", "conversation", "A2"]
    },
    {
      "id": "phrase-ah-si-challenge",
      "kind": "phrase",
      "promptEs": "¿Ah, sí?",
      "questionEn": "How do you react with a skeptical or challenging “Oh, really?”",
      "answerEn": "Use ¿Ah, sí?",
      "noteEn": "The same two words can sound genuinely surprised or openly challenging; the speaker's tone and the situation supply the difference.",
      "example": { "es": "—No puedes hacerlo. —¿Ah, sí?", "en": "“You cannot do it.” “Oh, really?”" },
      "tags": ["phrase", "reaction", "challenge", "A1"]
    },
    {
      "id": "phrase-libro-de-tapa-dura",
      "kind": "phrase",
      "promptEs": "libro de tapa dura",
      "questionEn": "How do you say “hardcover book” in Spanish?",
      "answerEn": "Use libro de tapa dura.",
      "noteEn": "Spanish builds the description literally as a book “of hard cover.” De links the book to its cover type, and dura agrees with the feminine noun tapa.",
      "example": { "es": "Compré un libro de tapa dura.", "en": "I bought a hardcover book." },
      "tags": ["phrase", "books", "description", "A2"]
    },
    {
      "id": "phrase-no-ser-capaz-challenge",
      "kind": "phrase",
      "promptEs": "no ser capaz (de + infinitivo) · como reto",
      "questionEn": "How can you challenge someone by implying that they would not dare or be able to do something?",
      "answerEn": "Use no, a form of ser, and capaz, often followed by de and the action verb in its unchanged dictionary form.",
      "noteEn": "The literal meaning is “not be capable,” but said directly to someone it can function as a dare. The action may be left unstated when the situation makes it obvious.",
      "example": {
        "es": "No serás capaz de saltar.",
        "en": "You wouldn't dare jump."
      },
      "tags": ["phrase", "challenge", "dare", "ability", "A2"]
    },
    {
      "id": "grammar-descriptive-adjective-after-noun",
      "kind": "grammar",
      "promptEs": "sustantivo + adjetivo descriptivo",
      "questionEn": "Where does a basic Spanish describing word usually go relative to its noun?",
      "answerEn": "Put it after the noun in the common neutral order.",
      "noteEn": "Many ordinary descriptive words follow the person or thing they describe: un coche rojo, una casa grande. Some adjectives commonly come before the noun, and moving an adjective can change emphasis or meaning, so this is a useful default rather than an absolute rule.",
      "example": { "es": "Necesito una mochila nueva.", "en": "I need a new backpack." },
      "tags": ["grammar", "word order", "adjective", "A1"]
    }
