  "titleText": {
    "es": "Ya nos divorciamos una vez por el asunto del avión sobre una cinta transportadora. (Respuesta preventiva a los inevitables hilos que van a discutir sobre el tema: estáis todos equivocados en internet).",
    "en": "We actually divorced once over the airplane/treadmill argument.  (Preemptive response to the inevitable threads arguing about it:  you're all wrong on the internet.)",
    "noteEn": "The English text is the official xkcd title text, including its two spaces before the parenthesis and after the colon. The Spanish archive renders the treadmill as una cinta transportadora and uses the Spain form estáis todos equivocados."
  },
  "cardDefinitions": [
    {
      "id": "word-echó--threw-out",
      "kind": "word",
      "promptEs": "echó",
      "answerEn": "threw out; kicked out",
      "noteEn": "Echó is a completed-past form of echar. With a person and de plus a place, echar means forcing that person to leave the place.",
      "example": { "es": "El casero lo echó del piso.", "en": "The landlord threw him out of the apartment." },
      "tags": ["word", "echar", "removal", "completed past", "A2"]
    },
    {
      "id": "word-de--echar-out-of",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "out of; from (after echar)",
      "noteEn": "After echar in the sense of forcing someone to leave, de introduces the place the person must leave.",
      "example": { "es": "Lo echaron de la oficina.", "en": "They threw him out of the office." },
      "tags": ["word", "preposition", "echar", "removal", "A2"]
    },
    {
      "id": "word-pronuncies--negative-command",
      "kind": "word",
      "promptEs": "pronuncies",
      "answerEn": "say; utter (negative command to one familiar person)",
      "noteEn": "For an ordinary statement to tú, pronunciar gives pronuncias. After no in a negative command to that same person, the ending changes to pronuncies.",
      "example": { "es": "No pronuncies su nombre.", "en": "Do not say his name." },
      "tags": ["word", "pronunciar", "negative command", "tú", "A2"]
    },
    {
      "id": "word-pasado--elapsed",
      "kind": "word",
      "promptEs": "pasado",
      "answerEn": "passed; elapsed",
      "noteEn": "Pasado is the completed-action form of pasar. With a form of haber and a duration, it says that an amount of time has gone by.",
      "example": { "es": "Han pasado tres semanas.", "en": "Three weeks have passed." },
      "tags": ["word", "pasar", "time", "completed-action form", "A2"]
    },
    {
      "id": "word-pensé",
      "kind": "word",
      "promptEs": "pensé",
      "answerEn": "I thought",
      "noteEn": "Pensé is the completed-past form of pensar for the speaker. Before que, it introduces what the speaker thought.",
      "example": { "es": "Pensé que llegabas mañana.", "en": "I thought you were arriving tomorrow." },
      "tags": ["word", "pensar", "completed past", "thought", "A2"]
    },
    {
      "id": "word-estarían--would-be-state",
      "kind": "word",
      "promptEs": "estarían",
      "answerEn": "they would be (in a state)",
      "noteEn": "Estarían keeps the full dictionary form estar and adds -ían. It can describe the later state of several people or things from a past point of view.",
      "example": { "es": "Creí que estarían listos.", "en": "I thought they would be ready." },
      "tags": ["word", "estar", "conditional", "state", "plural", "A2"]
    },
    {
      "id": "word-curadas",
      "kind": "word",
      "promptEs": "curadas",
      "answerEn": "healed (feminine plural)",
      "noteEn": "Curadas is the feminine plural completed-action form of curar when it describes the resulting state of feminine plural things.",
      "example": { "es": "Las lesiones ya están curadas.", "en": "The injuries are already healed." },
      "tags": ["word", "curar", "resulting state", "feminine plural", "A2"]
    },
    {
      "id": "word-mantengo--stand-by",
      "kind": "word",
      "promptEs": "mantengo",
      "answerEn": "I stand by; I maintain",
      "noteEn": "Mantengo is the present form of mantener for the speaker. With a statement, opinion, or decision, it means continuing to support it rather than changing one's position.",
      "example": { "es": "Mantengo lo que escribí.", "en": "I stand by what I wrote." },
      "tags": ["word", "mantener", "position", "present", "B1"]
    },
    {
      "id": "word-dije",
      "kind": "word",
      "promptEs": "dije",
      "answerEn": "I said",
      "noteEn": "Dije is the completed-past form of decir for the speaker.",
      "example": { "es": "Dije la verdad ayer.", "en": "I told the truth yesterday." },
      "tags": ["word", "decir", "completed past", "A2"]
    },
    {
      "id": "word-plutón",
      "kind": "word",
      "promptEs": "plutón",
      "answerEn": "Pluto",
      "noteEn": "Spanish writes the astronomical name Plutón with an accent on the final syllable.",
      "example": { "es": "Plutón está más lejos del Sol que Neptuno.", "en": "Pluto is farther from the Sun than Neptune." },
      "tags": ["word", "astronomy", "proper name", "Pluto"]
    },
    {
      "id": "word-tuvo--past-obligation",
      "kind": "word",
      "promptEs": "tuvo",
      "answerEn": "had to",
      "noteEn": "Tuvo is a completed-past form of tener. Before que and an unchanged action verb, it forms a past version of tener que, meaning that something was necessary or required.",
      "example": { "es": "La máquina tuvo que parar.", "en": "The machine had to stop." },
      "tags": ["word", "tener que", "necessity", "completed past", "A2"]
    },
    {
      "id": "phrase-echar-a-alguien-de-lugar",
      "kind": "phrase",
      "promptEs": "echar a alguien de un lugar",
      "questionEn": "How do you say that someone is forced to leave a place?",
      "answerEn": "Use a form of echar for forcing the person out, then de before the place being left.",
      "noteEn": "The person can follow echar with personal a: echaron a Leo del aula. A short object word instead goes before a changed form of echar: lo echaron del aula, me echó de casa. De introduces the place the person is forced to leave.",
      "example": { "es": "La directora lo echó del aula.", "en": "The principal threw him out of the classroom." },
      "tags": ["phrase", "echar", "removal", "object pronoun", "A2"]
    },
    {
      "id": "concept-pluto-planet-status",
      "kind": "concept",
      "promptEs": "Plutón · planeta enano",
      "answerEn": "Pluto was classified as a dwarf planet rather than one of the Solar System's eight planets under the International Astronomical Union's 2006 definition.",
      "noteEn": "The 2006 definition requires a Solar System planet to orbit the Sun, be nearly round, and have cleared the neighbourhood around its orbit. Pluto meets the first two conditions but not the third, so the IAU placed it in the distinct dwarf-planet category.",
      "tags": ["concept", "astronomy", "Pluto", "planet definition"]
    }
  ],
