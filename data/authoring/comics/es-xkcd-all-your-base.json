  "cardDefinitions": [
    { "id": "word-murió", "kind": "word", "promptEs": "murió", "answerEn": "died", "noteEn": "Murió is the completed past form of morir for one person or thing.", "example": { "es": "La planta murió durante el invierno.", "en": "The plant died during the winter." }, "tags": ["word", "morir", "past", "third person"] },
    { "id": "word-hace--time-ago", "kind": "word", "promptEs": "hace", "answerEn": "ago (before a length of time)", "noteEn": "Before a length of time, hace tells you how long ago something happened. It does not mean “does” in this use.", "example": { "es": "Llegué hace dos horas.", "en": "I arrived two hours ago." }, "tags": ["word", "time", "past", "hace"] },
    { "id": "word-cinco", "kind": "word", "promptEs": "cinco", "answerEn": "five", "noteEn": "", "tags": ["word", "number"] },
    { "id": "word-del--topic", "kind": "word", "promptEs": "del", "answerEn": "about the (de + el, introducing a topic)", "noteEn": "Del combines de and el. After an expression that introduces a subject of discussion, de can mean “about,” so del introduces a masculine topic.", "example": { "es": "Hablamos del nuevo proyecto.", "en": "We talked about the new project." }, "tags": ["word", "topic", "contraction"] },
    { "id": "word-como--approximation", "kind": "word", "promptEs": "como", "answerEn": "like; about (approximately)", "noteEn": "Before a number or amount of time, como can show that the amount is approximate rather than exact.", "example": { "es": "Esperamos como veinte minutos.", "en": "We waited about twenty minutes." }, "tags": ["word", "approximation", "quantity", "time"] },
    { "id": "word-primer--before-masculine-noun", "kind": "word", "promptEs": "primer", "answerEn": "first (before a masculine singular noun)", "noteEn": "Primero shortens to primer directly before a masculine singular noun: el primer libro. In other positions, use primero.", "example": { "es": "Es mi primer viaje a México.", "en": "It is my first trip to Mexico." }, "tags": ["word", "ordinal", "masculine", "apocope"] },
    { "id": "word-meme", "kind": "word", "promptEs": "meme", "answerEn": "meme", "noteEn": "", "tags": ["word", "internet", "loanword"] },
    { "id": "word-favorito--favorite-one", "kind": "word", "promptEs": "favorito", "answerEn": "favorite; favorite one", "noteEn": "Favorito can stand without a repeated noun when the noun is already understood: mi favorito means “my favorite one.”", "example": { "es": "De todos los libros, este es mi favorito.", "en": "Of all the books, this one is my favorite." }, "tags": ["word", "adjective", "noun omitted"] },
    { "id": "word-se--cansarse", "kind": "word", "promptEs": "se", "answerEn": "no separate English word; marks cansarse, “to get tired”", "noteEn": "Cansarse uses a small pronoun that changes with the person: me canso, te cansas, se cansa. Use se with él, ella, usted, ellos, ellas, or ustedes.", "example": { "es": "Ellos se cansan de esperar.", "en": "They get tired of waiting." }, "tags": ["word", "pronoun", "pronominal verb", "cansarse"] },
    { "id": "word-cansado--tired-of", "kind": "word", "promptEs": "cansado", "answerEn": "gotten tired; fed up (before de)", "noteEn": "Cansado is the completed-action form of cansar. With a form of haber and cansarse de, cansado helps say that someone has become tired of something.", "example": { "es": "Me he cansado del ruido.", "en": "I have gotten tired of the noise." }, "tags": ["word", "cansar", "participle", "emotion"] },
    { "id": "word-él--masculine-thing", "kind": "word", "promptEs": "él", "answerEn": "it (referring back to a masculine singular thing)", "noteEn": "Él normally means “he” or “him,” but after a preposition it can also replace a masculine singular thing already named. English then uses “it.” Keep the accent to distinguish él from el, “the.”", "example": { "es": "El ruido es fuerte, pero me acostumbré a él.", "en": "The noise is loud, but I got used to it." }, "tags": ["word", "pronoun", "masculine", "inanimate referent"] },
    { "id": "word-espero--wait", "kind": "word", "promptEs": "espero", "answerEn": "I wait", "noteEn": "Esperar can mean either “to wait” or “to hope/expect.” When no hoped-for event or object follows, context can give it the simple meaning “to wait.”", "example": { "es": "Yo espero aquí.", "en": "I wait here." }, "tags": ["word", "esperar", "first person", "wait"] },
    { "id": "word-algún", "kind": "word", "promptEs": "algún", "answerEn": "some; some day/time (before a masculine noun)", "noteEn": "Alguno shortens to algún directly before a masculine singular noun: algún día, algún libro.", "example": { "es": "Algún vecino tendrá la llave.", "en": "Some neighbor will have the key." }, "tags": ["word", "indefinite", "masculine", "apocope"] },
    { "id": "word-dentro--future-time", "kind": "word", "promptEs": "dentro", "answerEn": "in; within (a time from now)", "noteEn": "Dentro de followed by a length of time looks forward from now: dentro de una semana means “in a week.”", "example": { "es": "Volveré dentro de una hora.", "en": "I will return in an hour." }, "tags": ["word", "time", "future", "fixed expression"] },
    { "id": "word-de--fixed-dentro-de", "kind": "word", "promptEs": "de", "answerEn": "no separate English word; completes dentro de, “in”", "noteEn": "When dentro de introduces a future delay, translate the two words together as “in.”", "example": { "es": "La película empieza dentro de diez minutos.", "en": "The movie starts in ten minutes." }, "tags": ["word", "fixed expression", "time"] },
    { "id": "word-décadas", "kind": "word", "promptEs": "décadas", "answerEn": "decades", "noteEn": "", "tags": ["word", "time", "plural"] },
    { "id": "word-habrá--future-perfect-helper", "kind": "word", "promptEs": "habrá", "answerEn": "will have (helper for a completed future action)", "noteEn": "Habrá is the future form of the helper haber for one person or thing. Before a completed-action form such as terminado, it helps build “will have finished.”", "example": { "es": "Marta habrá terminado mañana.", "en": "Marta will have finished tomorrow." }, "tags": ["word", "haber", "future perfect", "helper verb"] },
    { "id": "word-olvidado", "kind": "word", "promptEs": "olvidado", "answerEn": "forgotten", "noteEn": "Olvidado is the completed-action form of olvidar, “to forget.” It follows a form of haber in perfect constructions.", "example": { "es": "He olvidado su nombre.", "en": "I have forgotten his name." }, "tags": ["word", "olvidar", "participle"] },
    { "id": "word-será", "kind": "word", "promptEs": "será", "answerEn": "will be", "noteEn": "Será is the future form of ser for one person or thing.", "example": { "es": "Mañana será otro día.", "en": "Tomorrow will be another day." }, "tags": ["word", "ser", "future", "third person"] },
    { "id": "word-retro", "kind": "word", "promptEs": "retro", "answerEn": "retro; fashionable because it recalls the past", "noteEn": "Retro describes a style, object, or idea that deliberately evokes an earlier time.", "example": { "es": "El café tiene una decoración retro.", "en": "The café has retro decor." }, "tags": ["word", "style", "loanword"] },
    { "id": "word-llegue--future-event", "kind": "word", "promptEs": "llegue", "answerEn": "arrives; comes (special form for a future event)", "noteEn": "Llegue is a form of llegar used after cuando when the arrival has not happened yet. The written u keeps the hard g sound before e.", "example": { "es": "Te llamaré cuando llegue.", "en": "I will call you when I arrive." }, "tags": ["word", "llegar", "subjunctive", "future event"] },
    { "id": "word-estaré", "kind": "word", "promptEs": "estaré", "answerEn": "I will be", "noteEn": "Estaré is the first-person future form of estar.", "example": { "es": "Estaré en casa esta noche.", "en": "I will be at home tonight." }, "tags": ["word", "estar", "future", "first person"] },
    { "id": "word-preparado", "kind": "word", "promptEs": "preparado", "answerEn": "ready; prepared (masculine singular)", "noteEn": "", "tags": ["word", "adjective", "state"] },
    { "id": "word-necesitas", "kind": "word", "promptEs": "necesitas", "answerEn": "you need (informal singular)", "noteEn": "", "tags": ["word", "necesitar", "present", "tú"] },
    { "id": "word-hobby", "kind": "word", "promptEs": "hobby", "answerEn": "hobby; pastime", "noteEn": "Hobby is an English loanword used in Spanish. A common Spanish alternative is afición or pasatiempo.", "example": { "es": "La fotografía es mi hobby.", "en": "Photography is my hobby." }, "tags": ["word", "loanword", "leisure"] },
    {
      "id": "phrase-que-es-todo-esto-de",
      "kind": "phrase",
      "promptEs": "¿Qué es todo esto de + tema?",
      "questionEn": "How can you ask what all the talk, activity, or fuss about a topic is?",
      "answerEn": "Use ¿Qué es todo esto de ...? and name the topic after de.",
      "noteEn": "This conversational frame asks for an explanation of something the speaker has noticed. De combines with el as del when the following topic takes that article.",
      "example": { "es": "¿Qué es todo esto de la reunión sorpresa?", "en": "What is all this about the surprise meeting?" },
      "tags": ["phrase", "question", "topic", "A2"]
    },
    {
      "id": "grammar-hace-duration-ago",
      "kind": "grammar",
      "promptEs": "hace + cantidad de tiempo",
      "questionEn": "How do you say how long ago a past event happened?",
      "answerEn": "Put hace before the length of time.",
      "noteEn": "Spanish places hace before a duration: hace dos semanas means “two weeks ago.” The verb that describes the event itself is normally in a past form.",
      "example": { "es": "Nos conocimos hace tres meses.", "en": "We met three months ago." },
      "tags": ["grammar", "time", "past", "A2"]
    },
    {
      "id": "phrase-cansarse-de",
      "kind": "phrase",
      "promptEs": "cansarse de + algo/acción",
      "questionEn": "How do you say that someone gets tired of or fed up with something?",
      "answerEn": "Use the matching pronoun and a form of cansarse, followed by de.",
      "noteEn": "The pronoun changes with the person: me canso, te cansas, se cansa, nos cansamos. After de, use a noun or an unchanged action verb.",
      "example": { "es": "Nos cansamos de discutir.", "en": "We get tired of arguing." },
      "tags": ["phrase", "verb pattern", "emotion", "A2"]
    },
    {
      "id": "phrase-algun-dia",
      "kind": "phrase",
      "promptEs": "algún día",
      "questionEn": "How do you say “someday,” without naming a particular day?",
      "answerEn": "Use algún día.",
      "noteEn": "This expression refers to an unspecified day, often in the future. Algún is the shortened form of alguno used before the masculine noun día.",
      "example": { "es": "Algún día visitaré Chile.", "en": "Someday I will visit Chile." },
      "tags": ["phrase", "time", "future", "A1"]
    },
    {
      "id": "phrase-dentro-de-duration",
      "kind": "phrase",
      "promptEs": "dentro de + cantidad de tiempo",
      "questionEn": "How do you say that something will happen a certain amount of time from now?",
      "answerEn": "Use dentro de before the length of time.",
      "noteEn": "Dentro de looks forward from the present: dentro de dos horas means “in two hours.” This differs from hace dos horas, which looks backward and means “two hours ago.”",
      "example": { "es": "El tren sale dentro de media hora.", "en": "The train leaves in half an hour." },
      "tags": ["phrase", "time", "future", "A2"]
    },
    {
      "id": "grammar-future-perfect",
      "kind": "grammar",
      "promptEs": "futuro de haber + participio",
      "questionEn": "How do you say that an action will already be complete by a future point?",
      "answerEn": "Use a future form of haber, then the action's completed-action form.",
      "noteEn": "The helper changes with the person: habré, habrás, habrá, habremos, habréis, habrán. The following completed-action form stays unchanged: habrá llegado means “will have arrived.”",
      "example": { "es": "Para el viernes, habremos terminado.", "en": "By Friday, we will have finished." },
      "tags": ["grammar", "future perfect", "completed action", "B1"]
    },
    {
      "id": "phrase-otra-vez",
      "kind": "phrase",
      "promptEs": "otra vez",
      "questionEn": "How do you say that something happens again?",
      "answerEn": "Use otra vez.",
      "noteEn": "The expression literally uses “another time,” but natural English normally translates it as “again.”",
      "example": { "es": "Inténtalo otra vez.", "en": "Try it again." },
      "tags": ["phrase", "repetition", "A1"]
    },
    {
      "id": "phrase-o-algo",
      "kind": "phrase",
      "promptEs": "o algo",
      "questionEn": "How can you make a suggestion less exact by adding “or something”?",
      "answerEn": "Add o algo after the example or suggestion.",
      "noteEn": "O algo leaves the alternatives open. It often makes an informal suggestion sound broad rather than precise.",
      "example": { "es": "Podemos tomar un café o algo.", "en": "We can have a coffee or something." },
      "tags": ["phrase", "hedge", "conversation", "A1"]
    },
    {
      "id": "phrase-todavia-no",
      "kind": "phrase",
      "promptEs": "todavía no",
      "questionEn": "How do you say that something has not happened yet?",
      "answerEn": "Use todavía no before the action, or alone when the action is understood.",
      "noteEn": "The Spanish order literally resembles “still not,” while natural English often uses “not yet.”",
      "example": { "es": "Todavía no estoy listo.", "en": "I am not ready yet." },
      "tags": ["phrase", "time", "negation", "A1"]
    },
    {
      "id": "grammar-subject-si-no-ellipsis",
      "kind": "grammar",
      "promptEs": "persona + sí/no con la acción ya entendida",
      "questionEn": "How can Spanish say that one person does or does not do an already-mentioned action without repeating the action?",
      "answerEn": "Name the person, then use sí or no; the earlier action can be left unstated.",
      "noteEn": "Spanish often leaves out a verb or whole action when the listener can recover it from context. In Marta fue, pero yo no, yo no means that I did not go. For a positive contrast, use yo sí.",
      "example": { "es": "Luis cocina hoy, pero Ana no.", "en": "Luis is cooking today, but Ana isn't." },
      "tags": ["grammar", "ellipsis", "contrast", "conversation", "A2"]
    },
    {
      "id": "concept-all-your-base-meme",
      "kind": "concept",
      "promptEs": "meme de internet «All Your Base»",
      "answerEn": "an early internet meme based on awkward English from the game Zero Wing",
      "noteEn": "The best-known line is “All your base are belong to us.” “What you say!!” comes from the same badly translated game opening. The meme spread widely online around 2000–2001 and later became a marker of early-web nostalgia.",
      "tags": ["concept", "internet culture", "video games", "meme"]
    }
  ],
