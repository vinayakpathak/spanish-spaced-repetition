    {
      "id": "word-de--donante-complement",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "of; links a donor to what is donated",
      "noteEn": "After donante, de introduces the thing that the person donates: donante de sangre, donante de órganos, or donante de médula.",
      "example": { "es": "Buscan un donante de sangre.", "en": "They are looking for a blood donor." },
      "tags": ["word", "preposition", "collocation", "A2"]
    },
    {
      "id": "grammar-cuando-present-general-time",
      "kind": "grammar",
      "promptEs": "cuando + presente para hechos generales",
      "questionEn": "How do you say what normally happens whenever another event happens?",
      "answerEn": "Use cuando, then an ordinary present-time verb form, and state the usual result.",
      "noteEn": "Cuando can introduce a repeated event or a general fact. For that settled, recurring meaning, both actions can use ordinary present forms. This differs from a specific future event, where Spanish normally changes the verb after cuando to a subjunctive form—a form used when that future event is still pending.",
      "example": { "es": "Cuando llueve, llevo paraguas.", "en": "When it rains, I carry an umbrella." },
      "tags": ["grammar", "time clauses", "present", "A2"]
    },
    {
      "id": "phrase-donante-de-organos",
      "kind": "phrase",
      "promptEs": "donante de órganos",
      "questionEn": "How do you refer to an organ donor?",
      "answerEn": "Say donante de órganos.",
      "noteEn": "Donante names the donor, and de introduces what is donated. Change the noun after de for other kinds of donation, such as donante de sangre.",
      "example": { "es": "Ana decidió ser donante de órganos.", "en": "Ana decided to be an organ donor." },
      "tags": ["phrase", "health", "donation", "A2"]
    },
    {
      "id": "concept-lego-house-organ-donor-identity",
      "kind": "concept",
      "promptEs": "casa de LEGO · piezas · ordenación · donante de órganos",
      "answerEn": "a joke about whether identity survives when the same material is rearranged",
      "noteEn": "The father distinguishes a LEGO house from the plastic pieces that compose it: once its particular arrangement is gone, the house no longer exists as that object. The later organ-donor choice extends the same unsettling question to a person, whose organs may remain even though their arrangement as one living person does not.",
      "tags": ["concept", "identity", "philosophy", "joke"]
    }
