  "titleEn": "You Hang Up First",
  "titleEs": "Cuelga tú primero",
  "titleText": {
    "es": "No, pasa TÚ primero por una serie de rollitos en el aturdimiento de la post-ruptura mientras te das cuenta lentamente de lo que has perdido y lo improbable que es que lo vuelvas a conseguir.",
    "en": "No, YOU stumble past a series of post-breakup hookups in a daze as you slowly realize what you've lost and how unlikely you are ever to get it back first.",
    "noteEn": "The Spanish text is the exact title attribute in the Spanish archive; the English text is the exact official xkcd title attribute."
  },
  "cardDefinitions": [
    {
      "id": "word-cuelga--hang-up-command",
      "kind": "word",
      "promptEs": "cuelga",
      "answerEn": "hang up (an informal command to one person)",
      "noteEn": "Cuelga is the tú command of colgar. With a telephone understood or stated, it tells one familiar person to end the call.",
      "example": { "es": "Cuelga cuando termine la llamada.", "en": "Hang up when the call ends." },
      "tags": ["word", "commands", "telephone", "A2"]
    },
    {
      "id": "word-pasa--turn-page-command",
      "kind": "word",
      "promptEs": "pasa",
      "answerEn": "turn; move on (an informal command to one person)",
      "noteEn": "Pasa is the tú command of pasar. Before de página, it tells one familiar person to turn the page or, figuratively, move on.",
      "example": { "es": "Pasa de página con cuidado.", "en": "Turn the page carefully." },
      "tags": ["word", "commands", "reading", "A2"]
    },
    {
      "id": "word-de--fixed-pasar-de-pagina",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; part of pasar de página",
      "noteEn": "The preposition de links pasar to página in the expression pasar de página.",
      "example": { "es": "Es hora de pasar de página.", "en": "It is time to turn the page and move on." },
      "tags": ["word", "fixed expression", "preposition", "A2"]
    },
    {
      "id": "word-encuentra--find-command",
      "kind": "word",
      "promptEs": "encuentra",
      "answerEn": "find (an informal command to one person)",
      "noteEn": "Encuentra is the positive tú command of encontrar, used to tell one familiar person to find something or someone.",
      "example": { "es": "Encuentra una silla libre.", "en": "Find an empty chair." },
      "tags": ["word", "commands", "verbs", "A2"]
    },
    {
      "id": "phrase-colgar-el-telefono",
      "kind": "phrase",
      "promptEs": "colgar el teléfono",
      "questionEn": "How do you say to hang up or end a telephone call?",
      "answerEn": "Use colgar el teléfono.",
      "noteEn": "Colgar literally often means to hang something. With el teléfono, it conventionally means to end a call; colgar changes for the person and time.",
      "example": { "es": "Ana colgó el teléfono.", "en": "Ana hung up the phone." },
      "tags": ["phrase", "telephone", "conversation", "A2"]
    },
    {
      "id": "phrase-pasar-de-pagina",
      "kind": "phrase",
      "promptEs": "pasar de página",
      "questionEn": "How do you say to turn the page, or figuratively to leave something behind and move on?",
      "answerEn": "Use pasar de página.",
      "noteEn": "The expression can describe physically turning to another page. It is also commonly used for moving on from a past situation. Pasar changes for the person and time; de página stays unchanged.",
      "example": { "es": "Después del error, decidimos pasar de página.", "en": "After the mistake, we decided to move on." },
      "tags": ["phrase", "change", "figurative language", "B1"]
    }
  ],
