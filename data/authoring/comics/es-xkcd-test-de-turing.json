    {
      "id": "word-unos--some-before-noun",
      "kind": "word",
      "promptEs": "unos",
      "answerEn": "some; a few (before a masculine plural noun)",
      "noteEn": "Unos introduces an indefinite masculine plural group or amount. Use unas before a feminine plural noun.",
      "example": { "es": "Tengo unos libros nuevos.", "en": "I have some new books." },
      "tags": ["word", "indefinite", "plural", "A1"]
    },
    {
      "id": "word-bastante--degree",
      "kind": "word",
      "promptEs": "bastante",
      "answerEn": "quite; fairly (before a description)",
      "noteEn": "Before a describing word, bastante increases its degree and often means ‘quite,’ ‘fairly,’ or ‘pretty.’ It stays unchanged even when the following description changes for gender or number: bastante claro, bastante clara, bastante claros. This differs from bastante meaning ‘enough.’",
      "example": { "es": "Las instrucciones son bastante claras.", "en": "The instructions are quite clear." },
      "tags": ["word", "degree", "adverb", "A2"]
    },
    { "id": "word-buenos", "kind": "word", "promptEs": "buenos", "answerEn": "good (masculine plural)", "noteEn": "", "tags": ["word", "adjective", "plural", "A1"] },
    {
      "id": "word-ya--anymore-ni-siquiera",
      "kind": "word",
      "promptEs": "ya",
      "answerEn": "anymore; by now (before ni siquiera)",
      "noteEn": "Ya often means ‘already’ or ‘now.’ Before a negative expression such as ni siquiera, it marks a change from the past and is naturally translated as ‘anymore’ or ‘no longer.’",
      "example": { "es": "Ya ni siquiera llama.", "en": "He does not even call anymore." },
      "tags": ["word", "time", "negative context", "A2"]
    },
    {
      "id": "word-ni--fixed-ni-siquiera",
      "kind": "word",
      "promptEs": "ni",
      "answerEn": "not even (as part of ni siquiera)",
      "noteEn": "Ni begins the fixed emphasis ni siquiera, which says that even a minimal or surprising possibility does not apply.",
      "example": { "es": "Ni siquiera respondió.", "en": "She did not even answer." },
      "tags": ["word", "fixed expression", "negative emphasis", "A2"]
    },
    {
      "id": "word-siquiera--fixed-ni-siquiera",
      "kind": "word",
      "promptEs": "siquiera",
      "answerEn": "no separate English word; completes ni siquiera, ‘not even’",
      "noteEn": "Siquiera completes ni siquiera. Learn the two words together for the common meaning ‘not even.’",
      "example": { "es": "No tengo ni siquiera un minuto.", "en": "I do not even have one minute." },
      "tags": ["word", "fixed expression", "negative emphasis", "A2"]
    },
    {
      "id": "word-de--seguro-complement",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word here; links seguro to what someone is sure about",
      "noteEn": "The adjective seguro normally takes de before the thing, fact, or question that follows. English often omits a separate preposition before a who, what, or whether clause.",
      "example": { "es": "Estoy segura de que vendrá.", "en": "I am sure that he will come." },
      "tags": ["word", "required complement", "seguro de", "A2"]
    },
    {
      "id": "phrase-ni-siquiera",
      "kind": "phrase",
      "promptEs": "ni siquiera",
      "questionEn": "How do you emphasize that not even a minimal or surprising possibility applies?",
      "answerEn": "Use ni siquiera before the excluded thing or action.",
      "noteEn": "Ni siquiera means ‘not even.’ Before a verb, it can supply negation by itself. When it appears later, Spanish commonly also uses no before the verb.",
      "example": { "es": "Ni siquiera abrió el mensaje.", "en": "He did not even open the message." },
      "tags": ["phrase", "negative emphasis", "A2"]
    },
    {
      "id": "phrase-estar-seguro-de",
      "kind": "phrase",
      "promptEs": "estar seguro/segura de + cosa o pregunta",
      "questionEn": "How do you say what someone is sure or certain about?",
      "answerEn": "Use a form of estar, seguro or segura, then de before what follows.",
      "noteEn": "Seguro changes to match the person being described: seguro for masculine singular and segura for feminine singular. De is required before a noun, before que plus a statement, and before an embedded question such as de quién or de si.",
      "example": { "es": "Ana está segura de la respuesta.", "en": "Ana is sure of the answer." },
      "tags": ["phrase", "certainty", "estar", "required complement", "A2"]
    },
    {
      "id": "concept-turing-test",
      "kind": "concept",
      "promptEs": "el test de Turing",
      "answerEn": "A Turing test asks whether a human evaluator can distinguish a machine's conversation from a human's.",
      "noteEn": "The usual challenge is for a machine to persuade an evaluator that it is human. The comic reverses the task: the human earns extra credit by persuading the evaluator that the evaluator is a computer, leaving him uncertain about his own identity.",
      "tags": ["concept", "artificial intelligence", "Turing test", "joke"]
    }
  ],
