  "titleEn": "Drawing Stars",
  "titleEs": "Dibujar estrellas",
  "titleText": {
    "es": "Que les den a esos ángulos de 36 grados. Me voy a convertir al judaísmo.",
    "en": "Screw these 36-degree angles. I'm converting to Judaism.",
    "noteEn": "The Spanish archive and official English title attributes are preserved exactly. Vision misread both OH tokens, read SEGUIMOS without its final S, reduced EN to N, and hallucinated an L from the final exclamation mark. The arrows and drawing boxes are illustration, not printed lexical units."
  },
  "cardDefinitions": [
    {
      "id": "word-de--fixed-de-momento",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "for; first part of de momento, ‘for now’",
      "noteEn": "De combines with momento in the fixed time expression de momento. Its meaning comes from the whole expression rather than from the usual possession or origin uses of de.",
      "example": {
        "es": "De momento, no hay cambios.",
        "en": "For now, there are no changes."
      },
      "tags": [
        "word",
        "fixed expression",
        "time",
        "A2"
      ]
    },
    {
      "id": "word-momento--fixed-de-momento",
      "kind": "word",
      "promptEs": "momento",
      "answerEn": "now; completes de momento, ‘for now’",
      "noteEn": "Momento completes the fixed expression de momento. By itself, momento means ‘moment,’ but the two-word expression describes the present temporary situation.",
      "example": {
        "es": "De momento, todo funciona.",
        "en": "For now, everything works."
      },
      "tags": [
        "word",
        "fixed expression",
        "time",
        "A2"
      ]
    },
    {
      "id": "word-bien--so-far-so-good",
      "kind": "word",
      "promptEs": "bien",
      "answerEn": "well; going fine so far",
      "noteEn": "Bien can judge how a process is going. It often follows a time expression when the result is acceptable up to that point.",
      "example": {
        "es": "Hasta ahora, el plan va bien.",
        "en": "So far, the plan is going well."
      },
      "tags": [
        "word",
        "evaluation",
        "progress",
        "A1"
      ]
    },
    {
      "id": "word-seguimos--continue",
      "kind": "word",
      "promptEs": "seguimos",
      "answerEn": "we continue; we are still going",
      "noteEn": "Seguimos is the present form of seguir for nosotros. It can describe continuing an action or remaining on a course.",
      "example": {
        "es": "Seguimos por el mismo camino.",
        "en": "We continue along the same road."
      },
      "tags": [
        "word",
        "seguir",
        "present",
        "A2"
      ]
    },
    {
      "id": "word-mierdamierda--panic",
      "kind": "word",
      "promptEs": "mierdamierda",
      "answerEn": "shitshit; a fused panicked curse",
      "noteEn": "This informal written outburst repeats mierda without a space to show a rapid, panicked reaction. It is vulgar and belongs only in very informal contexts.",
      "example": {
        "es": "Mierdamierda, perdí las llaves.",
        "en": "Shitshit, I lost the keys."
      },
      "tags": [
        "word",
        "interjection",
        "vulgar",
        "emotion",
        "B1"
      ]
    },
    {
      "id": "word-abortar--emergency-command",
      "kind": "word",
      "promptEs": "abortar",
      "answerEn": "abort; stop the operation",
      "noteEn": "Abortar is the dictionary form ‘to abort.’ In terse warnings, procedures, and urgent commands, Spanish can use the unchanged infinitive as an order.",
      "example": {
        "es": "Si falla el motor, abortar la misión.",
        "en": "If the engine fails, abort the mission."
      },
      "tags": [
        "word",
        "command",
        "emergency",
        "infinitive",
        "B1"
      ]
    },
    {
      "id": "phrase-de-momento",
      "kind": "phrase",
      "promptEs": "de momento",
      "questionEn": "How do you say that something is true for now, but may change later?",
      "answerEn": "Use de momento.",
      "noteEn": "De momento refers to the current temporary situation. It is close to ‘for now’ or ‘at the moment.’",
      "example": {
        "es": "De momento, esperamos aquí.",
        "en": "For now, we are waiting here."
      },
      "tags": [
        "phrase",
        "time",
        "temporary state",
        "A2"
      ]
    },
    {
      "id": "concept-drawing-five-point-star-failure",
      "kind": "concept",
      "promptEs": "dibujar · estrella · rumbo · abortar",
      "questionEn": "Why does the calm drawing guide turn into an emergency?",
      "answerEn": "The attempted five-point star drifts off course, so the instructional captions escalate from reassurance to panic and an abort order.",
      "noteEn": "A regular five-point star requires carefully chosen turns. The official title text jokes that the frustrated artist would rather abandon the troublesome 36-degree geometry entirely.",
      "tags": [
        "concept",
        "geometry",
        "five-point star",
        "joke"
      ]
    }
  ],
