  "titleText": {
    "es": "Mierda, tengo clase de levitación a las 25:131. Tengo que poner el despertador en 'canela'.",
    "en": "Crap, I have levitation class at 25:131. Better set the alarm to 'cinnamon'.",
    "noteEn": "The impossible time and nonsensical alarm setting extend the comic's depiction of exhausted, distorted thinking."
  },
  "cardDefinitions": [
    {
      "id": "word-despierto--awake",
      "kind": "word",
      "promptEs": "despierto",
      "answerEn": "awake (masculine singular)",
      "noteEn": "Despierto can be a form of despertar, “I wake up,” or a describing word meaning “awake.” When it describes a masculine singular person, its feminine form is despierta.",
      "example": { "es": "Sigo despierto a medianoche.", "en": "I am still awake at midnight." },
      "tags": ["word", "state", "masculine singular", "A1"]
    },
    {
      "id": "word-en--at-time-period",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "at (with a time period such as night)",
      "noteEn": "Before a part of the day, en can place an event within that period. Natural English often uses “at” with night where Spanish uses en; usage varies, and por la noche is also very common.",
      "example": { "es": "Leemos en la noche.", "en": "We read at night." },
      "tags": ["word", "time", "preposition", "contextual sense"]
    },
    {
      "id": "word-doy--darse-cuenta",
      "kind": "word",
      "promptEs": "doy",
      "answerEn": "I realize (as part of me doy cuenta)",
      "noteEn": "Doy normally means “I give.” In the expression darse cuenta, the matching form of dar combines with cuenta to mean “to realize” or “to notice.”",
      "example": { "es": "Me doy cuenta del error.", "en": "I realize the mistake." },
      "tags": ["word", "fixed expression", "present", "first person"]
    },
    {
      "id": "word-cuenta--darse-cuenta",
      "kind": "word",
      "promptEs": "cuenta",
      "answerEn": "no separate English word; completes darse cuenta, “to realize”",
      "noteEn": "Cuenta can mean an account, bill, or calculation. In darse cuenta, it is part of a fixed expression and is not translated separately.",
      "example": { "es": "Ella se dio cuenta muy tarde.", "en": "She realized very late." },
      "tags": ["word", "fixed expression", "realization"]
    },
    {
      "id": "word-de--darse-cuenta",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word here; introduces what is realized after darse cuenta",
      "noteEn": "After darse cuenta, de introduces the fact or thing that becomes clear. Before a full statement, Spanish normally uses de que.",
      "example": { "es": "Se dio cuenta de que era tarde.", "en": "She realized that it was late." },
      "tags": ["word", "verb complement", "fixed expression"]
    },
    {
      "id": "word-cuántas--how-many-feminine",
      "kind": "word",
      "promptEs": "cuántas",
      "answerEn": "how many (feminine plural)",
      "noteEn": "Cuánto changes to match the thing being counted: cuánto, cuánta, cuántos, or cuántas. It keeps its written accent in both direct and embedded questions or exclamations.",
      "example": { "es": "No sé cuántas cartas llegaron.", "en": "I don't know how many letters arrived." },
      "tags": ["word", "question word", "feminine plural", "A1"]
    },
    { "id": "word-lucecitas", "kind": "word", "promptEs": "lucecitas", "answerEn": "little lights", "noteEn": "Lucecitas is the plural diminutive of luz. The ending -ecita adds the idea of smallness, and z changes to c before e.", "example": { "es": "Veo unas lucecitas en la ventana.", "en": "I see some little lights in the window." }, "tags": ["word", "diminutive", "plural", "spelling change"] },
    { "id": "word-cuarto--room", "kind": "word", "promptEs": "cuarto", "answerEn": "room; bedroom", "noteEn": "Cuarto can also mean “fourth” or “quarter.” When it names a part of a home, it means a room and often specifically a bedroom.", "example": { "es": "Mi cuarto está arriba.", "en": "My room is upstairs." }, "tags": ["word", "home", "contextual sense"] },
    { "id": "word-despertador", "kind": "word", "promptEs": "despertador", "answerEn": "alarm clock", "noteEn": "Despertador comes from despertar, “to wake up.” As a noun it names a device that wakes someone.", "example": { "es": "El despertador suena a las siete.", "en": "The alarm clock rings at seven." }, "tags": ["word", "time", "object"] },
    {
      "id": "word-la--omitted-feminine-noun",
      "kind": "word",
      "promptEs": "la",
      "answerEn": "the one (feminine singular)",
      "noteEn": "Spanish can use el, la, los, or las before a description when an understood noun is left unstated. La refers to one feminine thing already clear from context.",
      "example": { "es": "De las dos lámparas, esta es la más alta.", "en": "Of the two lamps, this one is the tallest." },
      "tags": ["word", "article", "ellipsis", "feminine singular"]
    },
    {
      "id": "word-más--superlative",
      "kind": "word",
      "promptEs": "más",
      "answerEn": "most (in a superlative description)",
      "noteEn": "Más normally means “more.” After el, la, los, or las, it can instead mark the highest degree in a group: la más rápida means “the fastest one.”",
      "example": { "es": "Ana es la más rápida.", "en": "Ana is the fastest." },
      "tags": ["word", "superlative", "degree"]
    },
    { "id": "word-brillante--bright", "kind": "word", "promptEs": "brillante", "answerEn": "bright; shining", "noteEn": "Brillante has the same form for masculine and feminine singular nouns. Its plural is brillantes.", "example": { "es": "La luna está brillante esta noche.", "en": "The moon is bright tonight." }, "tags": ["word", "light", "description"] },
    { "id": "word-esos--demonstrative", "kind": "word", "promptEs": "esos", "answerEn": "those (masculine plural)", "noteEn": "Esos points to masculine plural people or things that are not right beside the speaker. It changes to esas before feminine plural nouns.", "example": { "es": "Esos libros son nuevos.", "en": "Those books are new." }, "tags": ["word", "demonstrative", "masculine plural"] },
    { "id": "word-rojos", "kind": "word", "promptEs": "rojos", "answerEn": "red (masculine plural)", "noteEn": "Rojo changes to match the noun it describes. Rojos is masculine plural; the other forms are rojo, roja, and rojas.", "example": { "es": "Compré dos cuadernos rojos.", "en": "I bought two red notebooks." }, "tags": ["word", "color", "masculine plural"] },
    { "id": "word-luminosos", "kind": "word", "promptEs": "luminosos", "answerEn": "glowing; luminous (masculine plural)", "noteEn": "Luminosos describes masculine plural things that give off or reflect noticeable light.", "example": { "es": "Vimos varios carteles luminosos.", "en": "We saw several illuminated signs." }, "tags": ["word", "light", "masculine plural"] },
    {
      "id": "word-pasa--time-passes",
      "kind": "word",
      "promptEs": "pasa",
      "answerEn": "passes; goes by",
      "noteEn": "Pasar has many meanings. When its subject is time, pasa means that time passes or goes by.",
      "example": { "es": "El tiempo pasa rápido.", "en": "Time passes quickly." },
      "tags": ["word", "time", "contextual sense", "present"]
    },
    {
      "id": "word-acaso--rhetorical-question",
      "kind": "word",
      "promptEs": "acaso",
      "answerEn": "even; really (adds skeptical doubt to a question)",
      "noteEn": "At the start of a doubtful or rhetorical question, acaso can challenge whether something is true. Natural English may use “even” or “really,” or convey the skeptical tone without a separate word.",
      "example": { "es": "¿Acaso no me crees?", "en": "Do you really not believe me?" },
      "tags": ["word", "questions", "doubt", "B1"]
    },
    {
      "id": "word-se--arremolinarse",
      "kind": "word",
      "promptEs": "se",
      "answerEn": "no separate English word; marks arremolinarse, “to swirl or churn”",
      "noteEn": "Arremolinarse is normally used with me, te, se, nos, or os. With él, ella, usted, ellos, ellas, or ustedes, the matching small word is se.",
      "example": { "es": "Las hojas se arremolinan en la calle.", "en": "The leaves swirl in the street." },
      "tags": ["word", "pronominal verb", "movement"]
    },
    {
      "id": "word-arremolinan",
      "kind": "word",
      "promptEs": "arremolinan",
      "answerEn": "they swirl; churn",
      "noteEn": "Arremolinan is the plural present form of arremolinar. It commonly appears as arremolinarse for things that gather and move around one another in a confused circular way.",
      "example": { "es": "Las nubes se arremolinan sobre la montaña.", "en": "The clouds swirl over the mountain." },
      "tags": ["word", "movement", "present", "plural"]
    },
    { "id": "word-locura", "kind": "word", "promptEs": "locura", "answerEn": "madness; insanity", "noteEn": "", "tags": ["word", "mental state", "noun"] },
    {
      "id": "word-debe--inference",
      "kind": "word",
      "promptEs": "debe",
      "answerEn": "must; is probably (an inference, not an obligation)",
      "noteEn": "Debe is a form of deber. In deber de followed by an unchanged action verb, it presents a conclusion or likely guess rather than saying that someone has a duty.",
      "example": { "es": "Debe de estar ocupado.", "en": "He must be busy." },
      "tags": ["word", "inference", "probability", "present"]
    },
    {
      "id": "word-ah--realization",
      "kind": "word",
      "promptEs": "ah",
      "answerEn": "ah; oh (recognition or realization)",
      "noteEn": "Ah can show that the speaker has just understood, noticed, or recognized something. Its exact English equivalent depends on tone.",
      "example": { "es": "Ah, sí, ahora lo recuerdo.", "en": "Oh, yes, now I remember." },
      "tags": ["word", "interjection", "realization"]
    },
    { "id": "word-ahí--there", "kind": "word", "promptEs": "ahí", "answerEn": "there", "noteEn": "Ahí points to a place away from the speaker but normally not as distant as allí. The distinction varies by region and context.", "example": { "es": "Deja la caja ahí.", "en": "Leave the box there." }, "tags": ["word", "location", "adverb"] },
    {
      "id": "phrase-darse-cuenta-de",
      "kind": "phrase",
      "promptEs": "darse cuenta de (que) + hecho o situación",
      "questionEn": "How do you say that someone realizes or becomes aware of something?",
      "answerEn": "Use the matching small pronoun, a form of dar, cuenta, and then de before what is realized.",
      "noteEn": "The small pronoun and dar must match the person: me doy cuenta, te das cuenta, se da cuenta, nos damos cuenta, and so on. Use de before a noun and de que before a full statement. Cuenta is not translated separately in this expression.",
      "example": { "es": "Nos dimos cuenta de que faltaba una llave.", "en": "We realized that a key was missing." },
      "tags": ["phrase", "realization", "verb pattern", "A2"]
    },
    {
      "id": "grammar-article-mas-adjective-ellipsis",
      "kind": "grammar",
      "promptEs": "el/la/los/las + más + descripción (nombre ya entendido)",
      "questionEn": "How do you say “the brightest one,” “the fastest ones,” or a similar highest-degree description without repeating the noun?",
      "answerEn": "Use the matching form of el, then más, then the describing word; leave out the noun when it is already clear.",
      "noteEn": "El, la, los, or las agrees with the understood person or thing. The describing word also agrees when it has different forms. For example, of several casas, la más pequeña means “the smallest one.”",
      "example": { "es": "De todas las mesas, elegí la más pequeña.", "en": "Of all the tables, I chose the smallest one." },
      "tags": ["grammar", "superlative", "ellipsis", "A2"]
    },
    {
      "id": "phrase-ahi-esta",
      "kind": "phrase",
      "promptEs": "ahí está / ahí están",
      "questionEn": "How do you point out that a person or thing has appeared or been found?",
      "answerEn": "Use ahí está for one person or thing and ahí están for more than one.",
      "noteEn": "This expression literally locates something “there,” but it is also a common reaction when the speaker finally notices or finds what they were looking for. Está changes to están for a plural subject.",
      "example": { "es": "¡Ahí están mis llaves!", "en": "There are my keys!" },
      "tags": ["phrase", "location", "recognition", "A1"]
    }
  ],
