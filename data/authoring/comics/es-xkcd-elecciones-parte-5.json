      "id": "phrase-perdona-si",
      "kind": "phrase",
      "promptEs": "perdona si...",
      "questionEn": "How do you politely acknowledge that what you are about to say may be awkward or inconvenient?",
      "answerEn": "Use perdona si followed by the situation.",
      "noteEn": "Perdona is an informal singular request for forgiveness. Si introduces the condition the speaker is apologizing for, such as si esto es raro (“if this is weird”).",
      "example": { "es": "Perdona si llego tarde.", "en": "Sorry if I arrive late." },
      "tags": ["A2", "phrase", "politeness"]
    },
    {
      "id": "grammar-gustar-infinitive",
      "kind": "grammar",
      "promptEs": "me/te/le gusta + infinitivo",
      "questionEn": "How do you say that someone likes doing an activity?",
      "answerEn": "Use me, te, or le for the person, then gusta, then the action verb in its basic form.",
      "noteEn": "Spanish builds this idea as the activity being pleasing to someone. The action verb stays in its dictionary form ending in -ar, -er, or -ir, and gusta remains singular for one whole activity.",
      "example": { "es": "Me gusta leer.", "en": "I like reading." },
      "tags": ["A1", "grammar", "gustar", "verb pattern"]
    },
    {
      "id": "phrase-volar-cometas",
      "kind": "phrase",
      "promptEs": "volar cometas",
      "questionEn": "How do you say “to fly kites”?",
      "answerEn": "Use volar cometas.",
      "noteEn": "Cometa can mean either a kite or a comet. With volar and an activity context, volar cometas means making kites fly.",
      "example": { "es": "Los niños salen a volar cometas.", "en": "The children go out to fly kites." },
      "tags": ["A2", "phrase", "activity"]
    }
