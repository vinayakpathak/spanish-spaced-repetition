      "kind": "word",
      "promptEs": "patio",
      "answerEn": "playground; schoolyard",
      "noteEn": "Patio can mean a courtyard or yard more generally. With de mi colegio, it refers to the school's outdoor play area.",
      "example": { "es": "Los niños juegan en el patio del colegio.", "en": "The children play in the school playground." },
      "tags": ["word", "school", "place", "A2"]
    },
