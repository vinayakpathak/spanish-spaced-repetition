    {
      "id": "word-ponía--made-state",
      "kind": "word",
      "promptEs": "ponía",
      "answerEn": "made; used to make (someone feel a certain way)",
      "noteEn": "Ponía is a past form of poner used for a repeated or background past situation. With an affected person and a describing word, poner means to cause that person to enter the stated condition.",
      "example": { "es": "La espera me ponía impaciente.", "en": "The wait used to make me impatient." },
      "tags": ["word", "verb", "past", "state", "A2"]
    },
    { "id": "word-nervioso", "kind": "word", "promptEs": "nervioso", "answerEn": "nervous (masculine singular)", "noteEn": "", "tags": ["word", "feeling", "adjective", "A1"] },
    {
      "id": "word-mudamos--moved-home",
      "kind": "word",
      "promptEs": "mudamos",
      "answerEn": "we moved home (with nos)",
      "noteEn": "Nos mudamos is the completed-past form here. Mudarse means to change where one lives; nos is the matching short word used with we.",
      "example": { "es": "Nos mudamos a Sevilla el año pasado.", "en": "We moved to Seville last year." },
      "tags": ["word", "verb", "moving home", "completed past", "A2"]
    },
    {
      "id": "word-se--unnamed-agent-event",
      "kind": "word",
      "promptEs": "se",
      "answerEn": "no separate English word; presents the subject as undergoing an event without naming a doer",
      "noteEn": "This use of se lets Spanish focus on what receives or undergoes the action. English may use a passive form or describe the result as happening on its own.",
      "example": { "es": "La imagen se grabó con claridad.", "en": "The image was recorded clearly." },
      "tags": ["word", "se", "unnamed doer", "B1"]
    },
    {
      "id": "word-grabó--etched-memory",
      "kind": "word",
      "promptEs": "grabó",
      "answerEn": "became etched; became fixed (in memory, with se)",
      "noteEn": "Grabar literally means to record or engrave. In se grabó en la memoria or en el recuerdo, it describes an image or experience becoming firmly fixed in someone's memory.",
      "example": { "es": "La escena se grabó en su memoria.", "en": "The scene became etched in her memory." },
      "tags": ["word", "verb", "memory", "completed past", "B1"]
    },
    { "id": "word-recuerdo--memory", "kind": "word", "promptEs": "recuerdo", "answerEn": "memory; recollection", "noteEn": "", "tags": ["word", "memory", "noun", "A2"] },
    {
      "id": "word-convirtiéndose--becoming",
      "kind": "word",
      "promptEs": "convirtiéndose",
      "answerEn": "becoming; turning into",
      "noteEn": "Convirtiendo is the ongoing -iendo form of convertir. The attached se makes convirtiéndose part of convertirse, and en introduces the resulting identity or form.",
      "example": { "es": "La nube está convirtiéndose en lluvia.", "en": "The cloud is turning into rain." },
      "tags": ["word", "verb", "change", "ongoing form", "B1"]
    },
    {
      "id": "word-en--change-result",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "into; introduces the result after convertirse",
      "noteEn": "After convertirse, en links the changing person or thing to what it becomes. Keep en even though English may simply use become before a noun.",
      "example": { "es": "El agua se convierte en hielo.", "en": "Water turns into ice." },
      "tags": ["word", "preposition", "change", "B1"]
    },
    { "id": "word-monstruo", "kind": "word", "promptEs": "monstruo", "answerEn": "monster", "noteEn": "", "tags": ["word", "noun", "A2"] },
    {
      "id": "word-rascacielos--towering",
      "kind": "word",
      "promptEs": "rascacielos",
      "answerEn": "skyscraping; skyscraper-like (here)",
      "noteEn": "Rascacielos is normally the noun for a skyscraper. Here it follows monstruo as an imaginative modifier, making the monster seem as tall as a skyscraper.",
      "example": { "es": "Un rascacielos domina el centro de la ciudad.", "en": "A skyscraper dominates the city center." },
      "tags": ["word", "noun used as modifier", "height", "B1"]
    },
    {
      "id": "word-pasaba--passing-through",
      "kind": "word",
      "promptEs": "pasaba",
      "answerEn": "was passing through; used to pass (with por)",
      "noteEn": "Pasaba is a background-past form of pasar. Followed by por and a place, it describes going through or by that place.",
      "example": { "es": "Pasaba por el centro cuando empezó a llover.", "en": "I was passing through downtown when it started to rain." },
      "tags": ["word", "verb", "movement", "past", "A2"]
    },
    {
      "id": "word-viejo--former-place",
      "kind": "word",
      "promptEs": "viejo",
      "answerEn": "old; former (a place from one's past)",
      "noteEn": "Before a place connected to someone's earlier life, viejo can mean the old or former place they remember, not necessarily a physically aged place.",
      "example": { "es": "Volvió a su viejo barrio.", "en": "She returned to her old neighborhood." },
      "tags": ["word", "adjective", "past connection", "A2"]
    },
    { "id": "word-pueblo--town", "kind": "word", "promptEs": "pueblo", "answerEn": "town; village", "noteEn": "", "tags": ["word", "place", "noun", "A1"] },
    { "id": "word-recordé", "kind": "word", "promptEs": "recordé", "answerEn": "I remembered; I recalled", "noteEn": "Recordé is a completed-past form used for a memory that came to the speaker at a particular moment.", "example": { "es": "De pronto recordé su nombre.", "en": "Suddenly I remembered her name." }, "tags": ["word", "verb", "memory", "completed past", "A2"] },
    { "id": "word-conduje", "kind": "word", "promptEs": "conduje", "answerEn": "I drove", "noteEn": "Conduje is the completed-past form of conducir used by the speaker.", "example": { "es": "Ayer conduje hasta la costa.", "en": "Yesterday I drove to the coast." }, "tags": ["word", "verb", "driving", "completed past", "A2"] },
    {
      "id": "word-hasta--destination",
      "kind": "word",
      "promptEs": "hasta",
      "answerEn": "to; as far as (a destination)",
      "noteEn": "Before a place, hasta marks the endpoint reached by movement. English often uses simply to, while as far as makes the endpoint emphasis explicit.",
      "example": { "es": "Caminamos hasta la estación.", "en": "We walked to the station." },
      "tags": ["word", "preposition", "destination", "A2"]
    },
    {
      "id": "word-yo--inner-self",
      "kind": "word",
      "promptEs": "yo",
      "answerEn": "self (as a noun in el yo interior)",
      "noteEn": "Yo normally means I. With an article or possessive word, it can instead be a noun meaning a person's self: el yo, mi yo, or tu yo.",
      "example": { "es": "Su yo adulto entiende la decisión.", "en": "Her adult self understands the decision." },
      "tags": ["word", "noun use", "self", "B1"]
    },
    { "id": "word-interior--inner", "kind": "word", "promptEs": "interior", "answerEn": "inner; interior", "noteEn": "After yo, interior describes the private inner self rather than a physical interior space.", "example": { "es": "Busca calma interior.", "en": "Seek inner calm." }, "tags": ["word", "adjective", "self", "A2"] },
    {
      "id": "word-creía--thought",
      "kind": "word",
      "promptEs": "creía",
      "answerEn": "thought; believed; used to think",
      "noteEn": "Creía is a background-past form of creer. It presents a belief or opinion that was held over a stretch of past time rather than a single completed act of believing.",
      "example": { "es": "De niño, creía que la Luna era pequeña.", "en": "As a child, I thought the Moon was small." },
      "tags": ["word", "verb", "belief", "past", "A2"]
    },
    { "id": "word-gigantesco", "kind": "word", "promptEs": "gigantesco", "answerEn": "gigantic; enormous (masculine singular)", "noteEn": "", "tags": ["word", "adjective", "size", "A2"] },
    {
      "id": "grammar-poner-a-alguien-descripcion",
      "kind": "grammar",
      "promptEs": "poner a alguien + descripción",
      "questionEn": "How do you say that something makes someone feel or become a certain way?",
      "answerEn": "Use a form of poner, identify the affected person, and add a word describing the resulting state.",
      "noteEn": "Change poner to match the time and the thing causing the change. A short word such as me, te, nos, or lo can identify the affected person and goes before a conjugated form of poner: me pone nervioso. The describing word normally matches that person: nervioso for a man or boy, nerviosa for a woman or girl.",
      "example": { "es": "La espera me pone nerviosa.", "en": "The wait makes me nervous." },
      "tags": ["grammar", "caused state", "poner", "A2"]
    },
    {
      "id": "phrase-grabarse-en-la-memoria",
      "kind": "phrase",
      "promptEs": "algo se graba en la memoria o el recuerdo",
      "questionEn": "How do you say that something becomes vividly fixed in someone's memory?",
      "answerEn": "Say that the thing se graba en la memoria or se graba en el recuerdo.",
      "noteEn": "Grabar literally means to record or engrave. In this expression, se plus a matching form of grabar presents an image, sound, or experience as becoming etched in memory. Change graba for the time: se grabó for a completed past event, or se grabará for a future one.",
      "example": { "es": "Su voz se grabó en mi memoria.", "en": "Her voice became etched in my memory." },
      "tags": ["phrase", "memory", "figurative language", "B1"]
    },
    {
      "id": "grammar-convertirse-en",
      "kind": "grammar",
      "promptEs": "convertirse en + resultado",
      "questionEn": "How do you say that someone or something becomes or turns into something else?",
      "answerEn": "Use a matching form of convertirse, then en, then name the result.",
      "noteEn": "Convertirse is used with a matching short word such as me, te, se, or nos. Change convertir to match the person, thing, and time, but keep en before the resulting identity or form: se convierte en, se convirtió en, or se está convirtiendo en.",
      "example": { "es": "La oruga se convierte en mariposa.", "en": "The caterpillar turns into a butterfly." },
      "tags": ["grammar", "change", "convertirse", "A2"]
    },
    {
      "id": "phrase-yo-interior",
      "kind": "phrase",
      "promptEs": "el yo interior",
      "questionEn": "How do you refer to the private or instinctive part of someone's self?",
      "answerEn": "Use el yo interior for “the inner self”; use mi, tu, or su instead of el when saying whose.",
      "noteEn": "Here yo is a noun meaning self, not the subject word I. Interior stays after yo and means inner. The first word changes to identify the owner: mi yo interior, tu yo interior, or su yo interior.",
      "example": { "es": "Escucha a tu yo interior.", "en": "Listen to your inner self." },
      "tags": ["phrase", "self", "fixed expression", "B1"]
    }
  ],
