      "id": "word-colegio--school",
      "kind": "word",
      "promptEs": "colegio",
      "answerEn": "school",
      "noteEn": "Colegio commonly means a primary or secondary school. It does not normally mean a university-level college.",
      "example": { "es": "Mi colegio está cerca de casa.", "en": "My school is close to home." },
      "tags": ["word", "school", "false friend", "A1"]
    },
