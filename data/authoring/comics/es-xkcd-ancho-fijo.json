    {
      "id": "phrase-que-pasa",
      "kind": "phrase",
      "promptEs": "¿qué pasa?",
      "questionEn": "How do you casually ask “what's up?” or ask what is happening?",
      "answerEn": "Ask ¿Qué pasa?",
      "noteEn": "The phrase can be a casual greeting or a genuine question about a situation. Qué keeps its written accent because it asks for information.",
      "example": {
        "es": "Hola, Marta. ¿Qué pasa?",
        "en": "Hi, Marta. What's up?"
      },
      "tags": ["phrase", "greeting", "question", "A1"]
    },
    {
      "id": "phrase-lo-de",
      "kind": "phrase",
      "promptEs": "lo de + tema, persona o momento",
      "questionEn": "How do you refer informally to “the thing about” a topic or to what happened at a certain time?",
      "answerEn": "Use lo de followed by the topic, person, or time reference.",
      "noteEn": "Neutral lo leaves the event or matter unnamed, while de identifies it indirectly. The listener must recover the specific event or subject from context.",
      "example": {
        "es": "Tenemos que hablar de lo de ayer.",
        "en": "We have to talk about what happened yesterday."
      },
      "tags": ["phrase", "topic", "conversation", "A2"]
    },
    {
      "id": "phrase-te-quiero",
      "kind": "phrase",
      "promptEs": "te quiero",
      "questionEn": "How do you tell someone that you love or care deeply for them?",
      "answerEn": "Say te quiero.",
      "noteEn": "Te identifies the person receiving the affection, and quiero comes from querer. The phrase is common with partners, relatives, and close friends; te amo can sound stronger or more solemn in many places.",
      "example": {
        "es": "Te quiero, mamá.",
        "en": "I love you, Mom."
      },
      "tags": ["phrase", "affection", "relationships", "A1"]
    },
    {
      "id": "phrase-estar-en-sincronia",
      "kind": "phrase",
      "promptEs": "estar en sincronía",
      "questionEn": "How do you say that two people or things are synchronized or in sync?",
      "answerEn": "Use a form of estar followed by en sincronía.",
      "noteEn": "The form of estar changes for the subject and time, while en sincronía stays fixed. The expression can describe timing, movement, plans, or ideas that match.",
      "example": {
        "es": "Los dos relojes están en sincronía.",
        "en": "The two clocks are in sync."
      },
      "tags": ["phrase", "coordination", "timing", "A2"]
    },
    {
      "id": "grammar-conditional-perfect",
      "kind": "grammar",
      "promptEs": "habría/habrías/habríamos… + participio",
      "questionEn": "How do you say that something would have happened in the past but did not or was only imagined?",
      "answerEn": "Use a conditional form of haber such as habría, followed by the action's completed form.",
      "noteEn": "The first word changes for the person: habría, habrías, habríamos, and so on. The second word stays in its completed-action form, usually ending in -ado or -ido, such as hablado or vivido; some are irregular, such as roto.",
      "example": {
        "es": "Yo habría aceptado la oferta.",
        "en": "I would have accepted the offer."
      },
      "tags": ["grammar", "conditional perfect", "imagined past", "B1"]
    },
    {
      "id": "grammar-lo-que-intensity",
      "kind": "grammar",
      "promptEs": "lo que + verbo (cantidad o intensidad)",
      "questionEn": "How can you emphasize how much an action happens or how strong its effect is?",
      "answerEn": "Use lo que before the verb in an emphatic context, often after no sabes.",
      "noteEn": "In this use, lo que works like English “how much,” not “what” or “the thing that.” A lead-in such as no sabes or an exclamatory tone selects the intensity reading.",
      "example": {
        "es": "¡No sabes lo que llovió!",
        "en": "You have no idea how much it rained!"
      },
      "tags": ["grammar", "intensity", "quantity", "B1"]
    },
    {
      "id": "grammar-doler-experiencer",
      "kind": "grammar",
      "promptEs": "me/te/le/nos… + doler",
      "questionEn": "How does Spanish say who feels a pain?",
      "answerEn": "Put me, te, le, nos, os, or les before a form of doler to identify the person who feels it.",
      "noteEn": "The thing that hurts controls singular duele or plural duelen. In a completed construction, use ha or han followed by dolido; the short pronoun still names the person who feels the pain.",
      "example": {
        "es": "A Marta le duelen los pies.",
        "en": "Marta's feet hurt."
      },
      "tags": ["grammar", "doler", "experiencer", "pain", "A2"]
    },
    {
      "id": "concept-fixed-width-text",
      "kind": "concept",
      "promptEs": "ancho fijo · texto monoespaciado · líneas alineadas",
      "answerEn": "fixed-width text gives every character the same horizontal width",
      "noteEn": "In a monospaced or fixed-width font, narrow letters and wide letters occupy equal space. Text strings with the same number of characters therefore have the same visual length, which is useful for code, terminals, and aligned text art.",
      "tags": ["typography", "computing", "monospace", "joke concept"]
    }
