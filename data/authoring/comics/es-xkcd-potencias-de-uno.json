  "cardDefinitions": [
    {
      "id": "word-potencias--mathematical",
      "kind": "word",
      "promptEs": "potencias",
      "answerEn": "powers; exponentiated values",
      "noteEn": "In mathematics, a potencia is the result of raising a number to an exponent. The plural is potencias.",
      "example": {
        "es": "Dos, cuatro y ocho son potencias de dos.",
        "en": "Two, four, and eight are powers of two."
      },
      "tags": ["word", "mathematics", "plural"]
    },
    {
      "id": "word-iluminadora",
      "kind": "word",
      "promptEs": "iluminadora",
      "answerEn": "illuminating; enlightening (feminine singular)",
      "noteEn": "Iluminadora describes something that makes an idea clearer or gives new understanding, not only something that produces physical light.",
      "example": {
        "es": "La charla fue muy iluminadora.",
        "en": "The talk was very enlightening."
      },
      "tags": ["word", "understanding", "description"]
    },
    {
      "id": "word-mirada--look",
      "kind": "word",
      "promptEs": "mirada",
      "answerEn": "look; view",
      "noteEn": "Mirada can name the act or manner of looking, and it can also mean a way of viewing a topic.",
      "example": {
        "es": "El libro ofrece una mirada distinta al problema.",
        "en": "The book offers a different look at the problem."
      },
      "tags": ["word", "seeing", "viewpoint"]
    },
    {
      "id": "word-a--look-at",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "at; toward (after mirada)",
      "noteEn": "After mirada, a introduces the person, thing, or topic being looked at or examined.",
      "example": {
        "es": "Demos una mirada al mapa.",
        "en": "Let us take a look at the map."
      },
      "tags": ["word", "preposition", "viewpoint"]
    },
    {
      "id": "phrase-mirada-a",
      "kind": "phrase",
      "promptEs": "mirada a + tema",
      "questionEn": "How do you introduce a look at, overview of, or examination of a topic?",
      "answerEn": "Use mirada a followed by the topic, normally with an article such as una before mirada.",
      "noteEn": "Mirada literally relates to looking, but this expression often introduces a discussion or overview. Use al when a is followed by the masculine article el.",
      "example": {
        "es": "El artículo ofrece una mirada a la historia local.",
        "en": "The article offers a look at local history."
      },
      "tags": ["phrase", "viewpoint", "overview", "A2"]
    },
    {
      "id": "concept-powers-of-one",
      "kind": "concept",
      "promptEs": "potencias de uno · 1ⁿ = 1",
      "answerEn": "any power of one is still one",
      "noteEn": "Raising one to an integer power means multiplying copies of one, so the value remains one: 1⁰, 1¹, 1², and 1³ all equal 1. A negative power also remains one because its reciprocal is 1/1.",
      "tags": ["mathematics", "exponents", "joke concept"]
    }
  ],
