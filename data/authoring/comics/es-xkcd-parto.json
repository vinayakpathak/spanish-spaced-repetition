  "cardDefinitions": [
    {
      "id": "word-mirando--looking-at",
      "kind": "word",
      "promptEs": "mirando",
      "answerEn": "looking at; watching",
      "noteEn": "Mirar already includes the idea expressed by English ‘at.’ Spanish normally puts the thing being watched directly after mirar, without adding a separate word for ‘at.’",
      "example": { "es": "Estoy mirando la pantalla.", "en": "I am looking at the screen." },
      "tags": ["word", "mirar", "gerund", "A2"]
    },
    {
      "id": "word-espere--formal-command",
      "kind": "word",
      "promptEs": "espere",
      "answerEn": "wait; a formal command to one person",
      "noteEn": "Espere tells usted, the polite singular ‘you,’ to wait. With a regular verb ending in -ar, the polite command changes that ending to -e: esperar becomes espere. The informal command is espera.",
      "example": { "es": "Espere aquí, por favor.", "en": "Wait here, please." },
      "tags": ["word", "esperar", "formal command", "A2"]
    },
    {
      "id": "word-arrastrándose--crawling",
      "kind": "word",
      "promptEs": "arrastrándose",
      "answerEn": "crawling; dragging itself along",
      "noteEn": "Arrastrarse means ‘to crawl’ or literally to drag oneself along. For an action in progress, arrastrar becomes arrastrando and the matching se is attached at the end. The written accent keeps the original stress: arrastrándose.",
      "example": { "es": "El gato está arrastrándose bajo la mesa.", "en": "The cat is crawling under the table." },
      "tags": ["word", "arrastrarse", "gerund", "attached pronoun", "B1"]
    },
