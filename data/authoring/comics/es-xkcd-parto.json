    {
      "id": "grammar-gerund-attached-reflexive-pronoun",
      "kind": "grammar",
      "promptEs": "gerundio + me/te/se/nos/os/se",
      "questionEn": "How do you attach the matching self-directed word to an ongoing action?",
      "answerEn": "Attach me, te, se, nos, os, or se to the action form ending in -ando or -iendo, and add a written accent when needed to keep the original stress.",
      "noteEn": "An action form ending in -ando or -iendo is called a gerund and describes an action in progress. A verb such as lavarse uses a small matching word when people do the action to themselves: me means ‘myself,’ te means informal singular ‘yourself,’ se can mean ‘himself,’ ‘herself,’ formal ‘yourself,’ or ‘themselves,’ nos means ‘ourselves,’ and os means informal plural ‘yourselves’ mainly in Spain. When that word is attached, lavando becomes lavándome or lavándose so the voice still stresses the same syllable.",
      "example": { "es": "Ana está lavándose las manos.", "en": "Ana is washing her hands." },
      "tags": ["grammar", "gerund", "reflexive pronoun", "attached pronoun", "A2"]
    },
    {
      "id": "grammar-cantidad-sustantivo-mas",
      "kind": "grammar",
      "promptEs": "cantidad + sustantivo + más",
      "questionEn": "How do you express an additional number of things, as in ‘three more chairs’?",
      "answerEn": "Put the number or amount first, then the thing being counted, and place más after it.",
      "noteEn": "Spanish places más after the counted noun even though English puts ‘more’ before it: un día más is ‘one more day,’ and dos días más is ‘two more days.’ The noun changes between singular and plural to match the amount.",
      "example": { "es": "Necesitamos dos sillas más.", "en": "We need two more chairs." },
      "tags": ["grammar", "quantity", "más", "word order", "A2"]
    },
    {
      "id": "concept-groundhog-day-six-weeks-winter",
      "kind": "concept",
      "promptEs": "Día de la Marmota · seis semanas más de invierno",
      "answerEn": "a Groundhog Day prediction that winter will last six more weeks",
      "noteEn": "In the North American Groundhog Day tradition, a groundhog that sees its shadow and returns to its burrow supposedly predicts six more weeks of winter. The comic replaces the groundhog with a newborn retreating into the womb, which makes the doctor's prediction absurdly literal.",
      "tags": ["concept", "Groundhog Day", "cultural reference", "comic joke"]
    }
  ],
