    {
      "id": "phrase-a-ver",
      "kind": "phrase",
      "promptEs": "a ver",
      "questionEn": "How can you pause to inspect or consider something with the sense of “let's see” or “let me see”?",
      "answerEn": "Use the short expression a ver.",
      "noteEn": "A ver often introduces a pause while the speaker checks, considers, or waits to discover something. The two words work together as a conversational expression; it is not the same as haber, the one-word verb used in forms such as hay.",
      "example": { "es": "A ver, ¿qué tenemos aquí?", "en": "Let's see, what do we have here?" },
      "tags": ["phrase", "conversation", "discourse", "A2"]
    },
    {
      "id": "phrase-estar-libre--available",
      "kind": "phrase",
      "promptEs": "estar libre",
      "questionEn": "How do you say that someone is available or not busy at a particular time?",
      "answerEn": "Use a matching form of estar followed by libre.",
      "noteEn": "Estar changes for the person and time: estoy libre, está libre, and so on. Libre stays the same for one man or woman and becomes libres for more than one person. Ser libre usually describes being free rather than availability in a schedule.",
      "example": { "es": "Clara está libre el viernes.", "en": "Clara is available on Friday." },
      "tags": ["phrase", "availability", "estar", "A2"]
    },
