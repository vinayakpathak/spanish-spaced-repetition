  "cardDefinitions": [
    { "id": "word-pueda--passive-possibility", "kind": "word", "promptEs": "pueda", "answerEn": "can (special form used when a possibility is not stated as a fact)", "noteEn": "Pueda is a special form of poder, the verb meaning “can.” Spanish can use it after que when a description is uncertain, sought, or denied rather than presented as a fact. The ordinary statement form puede changes to pueda.", "example": { "es": "Busco a alguien que pueda ayudar.", "en": "I am looking for someone who can help." }, "tags": ["word", "poder", "subjunctive", "possibility"] },
    { "id": "word-apagar", "kind": "word", "promptEs": "apagar", "answerEn": "to turn off; switch off", "noteEn": "", "tags": ["word", "action"] },
    { "id": "word-parte--portion", "kind": "word", "promptEs": "parte", "answerEn": "part; portion", "noteEn": "", "tags": ["word", "part"] },
    { "id": "word-separada--detached", "kind": "word", "promptEs": "separada", "answerEn": "separate; detached (feminine singular)", "noteEn": "Separada is the feminine singular form of separado. Its -a ending matches a feminine singular person or thing.", "example": { "es": "Una pieza está separada del resto.", "en": "One piece is separate from the rest." }, "tags": ["word", "state", "adjective", "feminine"] },
    { "id": "word-abstrayendo", "kind": "word", "promptEs": "abstrayendo", "answerEn": "abstracting; reducing something to its underlying pattern", "noteEn": "Abstrayendo is the ongoing-action form of abstraer. The spelling changes to yendo in this form, like leyendo from leer.", "example": { "es": "Sigue abstrayendo los detalles del problema.", "en": "She keeps abstracting the details of the problem." }, "tags": ["word", "abstraer", "gerund", "analysis"] },
    { "id": "word-viendo--looking-at", "kind": "word", "promptEs": "viendo", "answerEn": "looking at; observing", "noteEn": "Viendo is the ongoing-action form of ver. It can mean seeing, watching, or looking at something, depending on context.", "example": { "es": "Estoy viendo los datos.", "en": "I am looking at the data." }, "tags": ["word", "ver", "gerund", "observation"] },
    { "id": "word-números", "kind": "word", "promptEs": "números", "answerEn": "numbers", "noteEn": "", "tags": ["word", "mathematics", "plural"] },
    { "id": "word-patrones", "kind": "word", "promptEs": "patrones", "answerEn": "patterns", "noteEn": "", "tags": ["word", "patterns", "plural"] },
    { "id": "word-deberíamos", "kind": "word", "promptEs": "deberíamos", "answerEn": "we should; we ought to", "noteEn": "Deberíamos is the “we” form of deber used for advice or what ought to happen. The -ríamos ending adds the “would/should” viewpoint: deber becomes deberíamos.", "example": { "es": "Deberíamos hablar mañana.", "en": "We should talk tomorrow." }, "tags": ["word", "deber", "conditional", "we"] },
    { "id": "word-contando", "kind": "word", "promptEs": "contando", "answerEn": "counting", "noteEn": "Contando is the ongoing-action form of contar, “to count.”", "example": { "es": "Está contando las monedas.", "en": "She is counting the coins." }, "tags": ["word", "contar", "gerund"] },
    { "id": "word-roces", "kind": "word", "promptEs": "roces", "answerEn": "touches; light brushes", "noteEn": "A roce is light contact or a brushing touch. The plural is roces.", "example": { "es": "Notó unos roces en la mano.", "en": "He noticed a few light touches on his hand." }, "tags": ["word", "touch", "plural"] },
    { "id": "word-sus--her", "kind": "word", "promptEs": "sus", "answerEn": "her (before plural things)", "noteEn": "When context identifies a female owner, sus means “her” before plural things. It agrees with the things owned, not with the owner.", "example": { "es": "Ana levantó sus manos.", "en": "Ana raised her hands." }, "tags": ["word", "possessive", "her", "plural"] },
    { "id": "word-roce--touch", "kind": "word", "promptEs": "roce", "answerEn": "touch; light brush", "noteEn": "", "tags": ["word", "touch"] },
    { "id": "word-serie--sequence", "kind": "word", "promptEs": "serie", "answerEn": "sequence; series", "noteEn": "In mathematics, serie can name an ordered sequence of values, although secuencia is also common and is more technically precise in some contexts.", "example": { "es": "La serie empieza con uno y uno.", "en": "The sequence begins with one and one." }, "tags": ["word", "mathematics", "sequence"] },
    { "id": "word-fibonacci--name", "kind": "word", "promptEs": "fibonacci", "answerEn": "Fibonacci (name associated with a famous number sequence)", "noteEn": "Fibonacci is the conventional name of the sequence in which each later number is the sum of the two before it.", "example": { "es": "Estudiamos la sucesión de Fibonacci.", "en": "We are studying the Fibonacci sequence." }, "tags": ["word", "proper name", "mathematics"] },
    { "id": "word-hiciera--subjunctive", "kind": "word", "promptEs": "hiciera", "answerEn": "I did (special past form used in “whatever I did”)", "noteEn": "Hiciera is a special past form of hacer, “to do.” This form is called the imperfect subjunctive: it leaves possible past actions open rather than stating one as a fact. Repeating hiciera around lo que creates the reusable pattern hiciera lo que hiciera, “whatever I did.”", "example": { "es": "Hiciera lo que hiciera, el resultado era igual.", "en": "Whatever I did, the result was the same." }, "tags": ["word", "hacer", "past subjunctive"] },
    { "id": "word-merecerte", "kind": "word", "promptEs": "merecerte", "answerEn": "to deserve you", "noteEn": "Merecerte combines merecer, “to deserve,” with te, “you.” A short object word such as te can attach to the end of an unchanged verb ending in -ar, -er, or -ir.", "example": { "es": "Espero merecerte algún día.", "en": "I hope to deserve you someday." }, "tags": ["word", "merecer", "attached pronoun", "infinitive"] },
    { "id": "word-pudo--could", "kind": "word", "promptEs": "pudo", "answerEn": "could (expressing a possibility about the past)", "noteEn": "Pudo is a completed-past form of poder for one person or thing. Followed by haber and another completed-action form, it can evaluate what could have happened or been true.", "example": { "es": "Pudo haber sido un error.", "en": "It could have been a mistake." }, "tags": ["word", "poder", "past", "third person"] },
    { "id": "word-sido", "kind": "word", "promptEs": "sido", "answerEn": "been", "noteEn": "Sido is the completed-action form of ser. It follows a form of haber: ha sido means “has been,” and haber sido means “to have been.”", "example": { "es": "Debe haber sido difícil.", "en": "It must have been difficult." }, "tags": ["word", "ser", "participle"] },
    { "id": "word-bastante--enough", "kind": "word", "promptEs": "bastante", "answerEn": "enough", "noteEn": "After a verb or adjective, bastante can mean that the amount or degree is sufficient: no es bastante means “it is not enough.”", "example": { "es": "Una hora no es bastante.", "en": "One hour is not enough." }, "tags": ["word", "quantity", "sufficiency"] },
    {
      "id": "grammar-negated-relative-subjunctive",
      "kind": "grammar",
      "promptEs": "antecedente negado + que + subjuntivo",
      "questionEn": "Which verb form follows que when you deny that a person or thing exists or has the described property?",
      "answerEn": "Use the special subjunctive form after que because the description is being denied, not stated as a fact.",
      "noteEn": "An antecedent is the person or thing described by que; a negated antecedent is one the wording presents as absent or not fitting. The special verb form is called the subjunctive. Compare the ordinary statement vive in Conozco a alguien que vive aquí with viva in No conozco a nadie que viva aquí. The plus signs in the prompt mean “followed by.”",
      "example": { "es": "No conozco a nadie que viva aquí.", "en": "I do not know anyone who lives here." },
      "tags": ["grammar", "subjunctive", "negation", "relative clause", "B1"]
    },
    {
      "id": "grammar-subjunctive-lo-que-subjunctive",
      "kind": "grammar",
      "promptEs": "verbo en subjuntivo + lo que + mismo verbo",
      "questionEn": "How can you say “whatever someone does” or “whatever happens” when the conclusion stays the same?",
      "answerEn": "Use the same special form of the verb before and after lo que.",
      "noteEn": "This special form is called the subjunctive. It leaves every possible action open instead of stating one action as a fact. For present time, ordinary hace (“does”) changes to haga: haga lo que haga. In a past setting, hizo or hacía (“did” or “was doing”) can become hiciera: hiciera lo que hiciera. Both repeated forms must match. The plus signs in the prompt mean “followed by.”",
      "example": { "es": "Pase lo que pase, te llamaré.", "en": "Whatever happens, I will call you." },
      "tags": ["grammar", "subjunctive", "concession", "B1"]
    },
    {
      "id": "grammar-perfect-infinitive",
      "kind": "grammar",
      "promptEs": "haber + participio",
      "questionEn": "How do you refer to an action that was already completed after another verb such as poder, deber, or parecer?",
      "answerEn": "Use the unchanged helper haber followed by the completed-action form of the main verb.",
      "noteEn": "The completed-action form is often called a participle: terminar becomes terminado, hacer becomes hecho, and ser becomes sido. After another verb, haber stays unchanged. The plus sign in the prompt means “followed by.”",
      "example": { "es": "Parece haber terminado.", "en": "It seems to have ended." },
      "tags": ["grammar", "perfect infinitive", "completed action", "B1"]
    },
    {
      "id": "concept-fibonacci-sequence",
      "kind": "concept",
      "promptEs": "serie de Fibonacci",
      "answerEn": "the number sequence 1, 1, 2, 3, 5, 8… in which each later number is the sum of the previous two",
      "noteEn": "Starting with 1 and 1, add them to get 2; add 1 and 2 to get 3; then 2 and 3 to get 5. The repeated touches in the comic follow those group sizes, which is why the character recognizes the pattern.",
      "tags": ["concept", "mathematics", "sequence", "Fibonacci"]
    }
  ],
