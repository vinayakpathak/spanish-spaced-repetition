        "A2"
      ]
    },
    {
      "id": "word-arbitrarios",
      "kind": "word",
      "promptEs": "arbitrarios",
      "answerEn": "arbitrary; unrestricted by a fixed choice",
      "noteEn": "Arbitrarios is masculine plural to match a masculine plural noun. It describes choices that are not limited to one predetermined case.",
      "example": {
        "es": "El programa acepta valores arbitrarios.",
        "en": "The program accepts arbitrary values."
      },
      "tags": [
        "word",
