    {
      "id": "word-pasas--pass-request",
      "kind": "word",
      "promptEs": "pasas",
      "answerEn": "you pass; could you pass",
      "noteEn": "Pasas is the familiar singular present form of pasar. With a recipient word such as me and an object, it means passing or handing that object to the listener.",
      "example": {
        "es": "¿Me pasas el agua?",
        "en": "Could you pass me the water?"
      },
      "tags": [
        "word",
        "pasar",
        "request",
        "present",
        "A2"
      ]
    },
    {
      "id": "word-sal--salt",
      "kind": "word",
      "promptEs": "sal",
      "answerEn": "salt",
      "noteEn": "Sal is the feminine noun for salt. Do not confuse it with sal, the informal command of salir meaning ‘leave.’",
      "example": {
        "es": "La sopa necesita sal.",
        "en": "The soup needs salt."
      },
      "tags": [
        "word",
        "food",
        "noun",
        "A1"
      ]
    },
    {
      "id": "word-desarrollando",
      "kind": "word",
      "promptEs": "desarrollando",
      "answerEn": "developing; working on",
      "noteEn": "Desarrollando is the ongoing-action form of desarrollar. It describes a process that is currently being created or improved.",
      "example": {
        "es": "Estamos desarrollando una aplicación.",
        "en": "We are developing an application."
      },
      "tags": [
        "word",
        "gerund",
        "development",
        "A2"
      ]
    },
    {
      "id": "word-pasarte--pass-to-you",
      "kind": "word",
      "promptEs": "pasarte",
      "answerEn": "to pass to you; to hand to you",
      "noteEn": "Pasarte combines the unchanged dictionary form pasar with te, which identifies one familiar listener as the recipient.",
      "example": {
        "es": "Voy a pasarte el informe.",
        "en": "I am going to pass you the report."
      },
      "tags": [
        "word",
        "infinitive",
        "attached pronoun",
        "recipient",
        "A2"
      ]
    },
    {
      "id": "word-condimentos",
      "kind": "word",
