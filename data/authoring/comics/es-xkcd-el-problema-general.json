        "technical",
        "B1"
      ]
    },
    {
      "id": "word-a--fixed-a-la-larga",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "in; begins a la larga, ‘in the long run’",
      "noteEn": "A is the first fixed part of a la larga. Its English meaning is supplied by the whole expression.",
      "example": {
        "es": "A la larga, la práctica ayuda.",
        "en": "In the long run, practice helps."
      },
      "tags": [
        "word",
        "fixed expression",
        "time",
        "A2"
      ]
    },
    {
      "id": "word-la--fixed-a-la-larga",
      "kind": "word",
      "promptEs": "la",
      "answerEn": "no separate English word; middle of a la larga",
      "noteEn": "La is fixed between a and larga in the expression a la larga, ‘in the long run.’",
      "example": {
        "es": "A la larga, será más fácil.",
        "en": "In the long run, it will be easier."
      },
      "tags": [
        "word",
        "fixed expression",
        "article",
        "A2"
      ]
    },
    {
      "id": "word-larga--fixed-a-la-larga",
      "kind": "word",
      "promptEs": "larga",
      "answerEn": "long run; completes a la larga",
      "noteEn": "Larga completes the fixed expression a la larga. Outside the expression, larga is the feminine form of largo, ‘long.’",
      "example": {
        "es": "A la larga, ahorraremos dinero.",
        "en": "In the long run, we will save money."
      },
      "tags": [
        "word",
        "fixed expression",
        "time",
        "A2"
      ]
    },
    {
      "id": "word-ahorrará",
      "kind": "word",
      "promptEs": "ahorrará",
      "answerEn": "will save",
      "noteEn": "Ahorrará is the simple future form of ahorrar for one person or thing. The written accent marks the stressed final syllable.",
      "example": {
        "es": "La reparación ahorrará energía.",
        "en": "The repair will save energy."
      },
      "tags": [
        "word",
        "future",
        "ahorrar",
        "A2"
      ]
    },
    {
      "id": "phrase-pasar-objeto-a-alguien",
      "kind": "phrase",
      "promptEs": "pasar + objeto + a alguien",
      "questionEn": "How do you say that someone passes or hands an object to another person?",
      "answerEn": "Use pasar for the handing action, name the object, and identify the recipient with a short word such as me or te, or with a + person.",
      "noteEn": "The short recipient word normally comes before a changed form of pasar, as in me pasas, or attaches to an unchanged infinitive, as in pasarte. The object is the thing being handed.",
      "example": {
        "es": "Lucía me pasó las llaves.",
        "en": "Lucía passed me the keys."
      },
      "tags": [
        "phrase",
        "passing objects",
        "recipient",
        "A2"
      ]
    },
    {
      "id": "phrase-pasar-tiempo-elapsed",
      "kind": "phrase",
      "promptEs": "pasar + cantidad de tiempo",
      "questionEn": "How do you say that an amount of time passes or has elapsed?",
      "answerEn": "Use the matching form of pasar followed by the amount of time.",
      "noteEn": "The time amount acts as the subject: pasó una hora, pasaron dos días, or han pasado veinte minutos. This is different from pasar tiempo haciendo algo, which means spending time on an activity.",
      "example": {
        "es": "Han pasado tres semanas.",
        "en": "Three weeks have passed."
      },
      "tags": [
        "phrase",
        "elapsed time",
        "pasar",
        "A2"
      ]
    },
    {
      "id": "phrase-a-la-larga",
      "kind": "phrase",
      "promptEs": "a la larga",
      "questionEn": "How do you say ‘in the long run’?",
      "answerEn": "Use a la larga.",
      "noteEn": "A la larga looks beyond the immediate situation to the eventual result over time.",
      "example": {
        "es": "A la larga, el cambio será útil.",
        "en": "In the long run, the change will be useful."
      },
      "tags": [
        "phrase",
        "time",
        "eventual result",
        "A2"
      ]
    },
    {
      "id": "phrase-ahorrarle-tiempo-a-alguien",
      "kind": "phrase",
      "promptEs": "ahorrarle tiempo a alguien",
      "questionEn": "How do you say that something saves someone time?",
      "answerEn": "Use a short beneficiary word such as me, te, le, nos, os, or les with ahorrar, followed by tiempo.",
      "noteEn": "The short word identifies who benefits: me ahorra tiempo, nos ahorrará tiempo, and so on. A phrase beginning with a may name that beneficiary explicitly.",
      "example": {
        "es": "Esta herramienta nos ahorra tiempo.",
        "en": "This tool saves us time."
      },
      "tags": [
        "phrase",
        "time",
        "beneficiary",
        "ahorrar",
        "A2"
      ]
    },
    {
      "id": "concept-general-problem-overengineering",
      "kind": "concept",
      "promptEs": "pasar la sal · sistema · condimentos arbitrarios · ahorrar tiempo",
      "questionEn": "Why does the promised time-saving system make the exchange absurd?",
      "answerEn": "A simple request to pass the salt is delayed while the listener builds a general-purpose condiment-passing system.",
      "noteEn": "The joke contrasts solving one immediate task with overengineering a reusable solution. The official title text extends the contrast by showing how present-day thoroughness can look like poor prioritization while similar past work is praised as craftsmanship.",
      "tags": [
        "concept",
        "overengineering",
        "software design",
        "joke"
      ]
    }
  ],
