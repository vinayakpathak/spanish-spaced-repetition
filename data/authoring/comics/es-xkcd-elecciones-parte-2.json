    {
      "id": "word-sendos",
      "kind": "word",
      "promptEs": "sendos",
      "answerEn": "one each; one apiece",
      "noteEn": "Sendos comes before a plural masculine noun and says that each previously named person or thing has one of that noun. The feminine form is sendas. It does not simply mean “two” or “both.”",
      "example": { "es": "Ana y Luis llevan sendas mochilas.", "en": "Ana and Luis each carry a backpack." },
      "tags": ["word", "distributive", "B2"]
    },
    { "id": "word-mensajes", "kind": "word", "promptEs": "mensajes", "answerEn": "messages", "noteEn": "", "tags": ["word"] },
    { "id": "word-pasan--move-past", "kind": "word", "promptEs": "pasan", "answerEn": "they pass; they move past", "noteEn": "", "tags": ["word", "verb"] },
    { "id": "word-velocidades", "kind": "word", "promptEs": "velocidades", "answerEn": "speeds; velocities", "noteEn": "", "tags": ["word", "physics"] },
    { "id": "word-constantes", "kind": "word", "promptEs": "constantes", "answerEn": "constant; unchanging (plural)", "noteEn": "", "tags": ["word", "adjective"] },
    {
      "id": "word-jo--frustration",
      "kind": "word",
      "promptEs": "jo",
      "answerEn": "ugh; darn (a mild frustrated reaction, especially in Spain)",
      "noteEn": "Jo is a mild exclamation of annoyance, disappointment, or surprise. It does not literally name a sigh, even when it replaces a written sigh in a translation.",
      "example": { "es": "¡Jo, otra vez!", "en": "Ugh, not again!" },
      "tags": ["word", "interjection", "Spain"]
    },
    { "id": "word-mientras--meanwhile", "kind": "word", "promptEs": "mientras", "answerEn": "meanwhile", "noteEn": "", "tags": ["word", "discourse"] },
    { "id": "word-observamos", "kind": "word", "promptEs": "observamos", "answerEn": "we observe; we see", "noteEn": "", "tags": ["word", "verb"] },
    {
      "id": "word-un--before-percentage",
      "kind": "word",
      "promptEs": "un",
      "answerEn": "no separate English word; Spanish commonly uses un before a percentage",
      "noteEn": "A percentage can behave like a masculine quantity in Spanish, so it often follows un: un 20%. Natural English normally says only “20%,” without “a” or “one.”",
      "example": { "es": "Un 20% de los asientos está libre.", "en": "Twenty percent of the seats are free." },
      "tags": ["word", "percentage", "A2"]
    },
    {
      "id": "word-la--before-possessive-pronoun",
      "kind": "word",
      "promptEs": "la",
      "answerEn": "no separate English word; the article used before nuestra (“ours”)",
      "noteEn": "When a feminine noun has already been named, la can introduce a possessive form that means “the one belonging to us.” La matches the omitted feminine noun; natural English usually says only “ours.”",
      "example": { "es": "Su bicicleta es azul; la nuestra es roja.", "en": "Her bicycle is blue; ours is red." },
      "tags": ["word", "article", "possessive"]
    },
    { "id": "word-nuestra--possessive-pronoun", "kind": "word", "promptEs": "nuestra", "answerEn": "ours (feminine singular)", "noteEn": "", "tags": ["word", "possessive"] },
    { "id": "word-corre--time-passes", "kind": "word", "promptEs": "corre", "answerEn": "passes; runs (said of time)", "noteEn": "", "tags": ["word", "verb", "time"] },
    { "id": "word-ritmo--rate", "kind": "word", "promptEs": "ritmo", "answerEn": "rate; pace", "noteEn": "", "tags": ["word"] },
    {
      "id": "word-del--before-possessive-pronoun",
      "kind": "word",
      "promptEs": "del",
      "answerEn": "of the; combines de + el before nuestro (“ours”)",
      "noteEn": "Spanish always contracts de + el to del. Here el introduces a masculine possessive form that replaces an already named noun, so del nuestro can contribute the meaning “of ours.”",
      "example": { "es": "El motor de tu coche es más potente que el del nuestro.", "en": "Your car's engine is more powerful than ours." },
      "tags": ["word", "possessive"]
    },
    { "id": "word-nuestro--possessive-pronoun", "kind": "word", "promptEs": "nuestro", "answerEn": "ours (masculine singular)", "noteEn": "", "tags": ["word", "possessive"] },
    { "id": "word-se--corresponderse-con", "kind": "word", "promptEs": "se", "answerEn": "no separate English word; part of corresponderse con (“to match”)", "noteEn": "", "tags": ["word", "verb pattern"] },
    { "id": "word-corresponde--matches", "kind": "word", "promptEs": "corresponde", "answerEn": "corresponds; matches", "noteEn": "", "tags": ["word", "verb"] },
    { "id": "word-observaciones", "kind": "word", "promptEs": "observaciones", "answerEn": "observations", "noteEn": "", "tags": ["word"] },
    { "id": "word-ayuda--plea", "kind": "word", "promptEs": "ayuda", "answerEn": "help; help me! (informal command)", "noteEn": "", "tags": ["word", "command"] },
    {
      "id": "grammar-reciprocal-se",
      "kind": "grammar",
      "promptEs": "se + verbo plural: el uno al otro",
      "questionEn": "How can you say that two or more people do the same action to each other?",
      "answerEn": "Put se before a verb whose form matches the plural group doing the action.",
      "noteEn": "With a plural subject, se can show that the members exchange an action: se escriben can mean “they write to each other.” Se can have other uses too, so the surrounding meaning tells you whether the action is reciprocal.",
      "example": { "es": "Ana y Luis se escriben cada semana.", "en": "Ana and Luis write to each other every week." },
      "tags": ["grammar", "reciprocal", "A2"]
    },
    {
      "id": "grammar-article-plus-possessive-pronoun",
      "kind": "grammar",
      "promptEs": "el/la/los/las + mío, tuyo, suyo, nuestro…",
      "questionEn": "How do you say “the one that is mine, yours, or ours” without repeating a noun?",
      "answerEn": "Use el, la, los, or las before a possessive form such as mío, tuya, suyo, or nuestro.",
      "noteEn": "This pattern points back to a previously named thing: la nuestra means “the feminine one that is ours,” while el nuestro means “the masculine one that is ours.” The article and the ending match that omitted thing, not its owner. After de + el, Spanish contracts the two words to del, as in del nuestro. For a simple statement of ownership after ser, the article is normally absent: Es nuestro means “It is ours.”",
      "example": { "es": "Tu mesa es grande, pero la nuestra es pequeña.", "en": "Your table is large, but ours is small." },
      "tags": ["grammar", "possessives", "A2"]
    },
    {
      "id": "phrase-corresponderse-con",
      "kind": "phrase",
      "promptEs": "corresponderse con",
      "questionEn": "How do you say that one result, description, or set of facts matches another?",
      "answerEn": "Use a form of corresponderse followed by con and the thing it matches.",
      "noteEn": "Keep the short se with the changed form of corresponder: se corresponde for one thing and se corresponden for several. Con introduces the other information used for the comparison.",
      "example": { "es": "El dibujo se corresponde con la descripción.", "en": "The drawing matches the description." },
      "tags": ["phrase", "comparison", "B1"]
    },
    {
      "id": "phrase-perderse--get-lost",
      "kind": "phrase",
      "promptEs": "perderse",
      "questionEn": "How do you say that someone gets lost?",
      "answerEn": "Use perder with a matching short word such as me, te, or se: me pierdo, te pierdes, se pierde.",
      "noteEn": "Perder by itself usually means “to lose something.” Perderse describes the person becoming lost, so the short word changes with that person. In a completed-action form such as me he perdido, me still identifies the person who became lost.",
      "example": { "es": "Nos perdimos en el parque.", "en": "We got lost in the park." },
      "tags": ["phrase", "pronominal verb", "A2"]
    },
    {
      "id": "concept-special-relativity-time-dilation",
      "kind": "concept",
      "promptEs": "relatividad especial · dilatación del tiempo",
      "answerEn": "In special relativity, observers moving relative to one another can measure different elapsed times; a moving clock is measured as running more slowly.",
      "noteEn": "The effect becomes substantial only at speeds that are a significant fraction of the speed of light.",
      "tags": ["concept", "physics", "relativity"]
    },
    {
      "id": "concept-speed-of-light-c",
      "kind": "concept",
      "promptEs": "c · velocidad de la luz",
      "answerEn": "In physics, c is the speed of light in a vacuum; 0,2 c means twenty percent of that speed.",
      "noteEn": "The decimal comma in 0,2 is the Spanish notation for 0.2.",
      "tags": ["concept", "physics", "relativity"]
    }
  ],
