    {
      "id": "grammar-quizas-indicative-possibility",
      "kind": "grammar",
      "promptEs": "quizás + forma normal de afirmación",
      "questionEn": "How can you say “maybe” while presenting an idea as a neutral or fairly plausible possibility?",
      "answerEn": "Put quizás before the idea and use the verb form you would use in an ordinary statement.",
      "noteEn": "This ordinary statement form is called the indicative: es stays es, and tiene stays tiene. Spanish can instead use a special possibility form called the subjunctive after quizás when the speaker wants to emphasize uncertainty; quizás alone does not force either choice.",
      "example": {
        "es": "Quizás Ana tiene razón.",
        "en": "Maybe Ana is right."
      },
      "tags": ["grammar", "possibility", "indicative", "B1"]
    },
    {
      "id": "phrase-busqueda-de",
      "kind": "phrase",
      "promptEs": "búsqueda de + persona, cosa u objetivo",
      "questionEn": "What word follows búsqueda before the person, thing, or goal being sought?",
      "answerEn": "Use búsqueda de, then name what the search is for.",
      "noteEn": "Búsqueda is the noun “search” or “pursuit,” related to the verb buscar. The de remains in the expression while the article and following noun change to fit what is being sought.",
      "example": {
        "es": "Sigue la búsqueda de una solución.",
        "en": "The search for a solution continues."
      },
      "tags": ["phrase", "collocation", "search", "A2"]
    },
    {
      "id": "phrase-precio-a-pagar",
      "kind": "phrase",
      "promptEs": "precio a pagar · total a pagar · cantidad a pagar",
      "questionEn": "How can a bill or payment notice label the price or amount that must be paid?",
      "answerEn": "Use precio, total, or cantidad followed by a pagar.",
      "noteEn": "Choose the first noun for the kind of amount, then keep a pagar fixed; pagar is the verb's unchanged dictionary form. This noun-a-verb pattern has limited established use in economic and administrative expressions and should not be freely copied with every noun. Elsewhere, Spanish often prefers que hay que or por before the action.",
      "example": {
        "es": "El total a pagar aparece al final.",
        "en": "The total to pay appears at the end."
      },
      "tags": ["phrase", "payment", "administrative language", "B1"]
    },
    {
      "id": "phrase-pagar-por-algo",
      "kind": "phrase",
      "promptEs": "pagar por + algo",
      "questionEn": "How do you say what someone pays for, literally or as a consequence?",
      "answerEn": "Use a form of pagar followed by por, then name what the payment or consequence is for.",
      "noteEn": "Pagar changes for the person and time, while por stays fixed before its complement. The cost can be literal money, as in pagar por una entrada, or a figurative consequence, as in pagar por un error.",
      "example": {
        "es": "Todos pagamos por nuestros errores.",
        "en": "We all pay for our mistakes."
      },
      "tags": ["phrase", "collocation", "payment", "consequence", "A2"]
    },
    {
      "id": "phrase-no-poder-evitar",
      "kind": "phrase",
      "promptEs": "no poder evitar + nombre o verbo en forma de diccionario",
      "questionEn": "How do you say that someone cannot help doing an action or cannot avoid a feeling?",
      "answerEn": "Use no, a form of poder, evitar, and then the action or feeling that cannot be avoided.",
      "noteEn": "Only poder changes for the person and time; evitar remains in its unchanged dictionary form. Another action also stays in its dictionary form: no puedo evitar reír means “I cannot help laughing.” A noun can follow instead, as in no pudo evitar la duda.",
      "example": {
        "es": "No puedo evitar sonreír.",
        "en": "I can't help smiling."
      },
      "tags": ["phrase", "involuntary reaction", "verb pattern", "A2"]
    },
    {
      "id": "concept-murphys-law",
      "kind": "concept",
      "promptEs": "la ley de Murphy",
      "answerEn": "the humorous rule that if something can go wrong, it will",
      "noteEn": "Murphy's law is an engineering and everyday-life adage, not a scientific law. References to Murphy often personify bad luck, failure, or the unforeseen ways a design can break.",
      "tags": ["concept", "engineering", "failure", "joke context"]
    },
    {
      "id": "concept-road-runner-acme",
      "kind": "concept",
      "promptEs": "el Correcaminos, el Coyote y ACME",
      "answerEn": "Wile E. Coyote repeatedly uses elaborate ACME products to try—and fail—to catch the Road Runner",
      "noteEn": "The Road Runner cartoons were created by Chuck Jones and Michael Maltese. Their recurring joke is that the Coyote's traps and mail-order ACME devices backfire while the Road Runner escapes.",
      "tags": ["concept", "cartoon", "ACME", "joke context"]
    }
