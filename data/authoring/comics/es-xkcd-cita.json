        "A1"
      ]
    },
    {
      "id": "word-pierdas--miss-out-negative-command",
      "kind": "word",
      "promptEs": "pierdas",
      "answerEn": "miss out; miss it (in a negative informal command)",
      "noteEn": "In no te lo pierdas, ordinary pierdes changes to pierdas because the speaker is telling one familiar person not to miss something.",
      "example": {
        "es": "No te pierdas el concierto.",
        "en": "Don't miss the concert."
      },
      "tags": [
        "word",
        "perderse",
        "negative command",
        "A2"
      ]
    },
    {
      "id": "word-dato--fact",
      "kind": "word",
      "promptEs": "dato",
      "answerEn": "fact; piece of information",
      "noteEn": "Dato can introduce a stated fact or statistic, as well as mean an individual piece of data.",
      "example": {
        "es": "Tengo un dato curioso.",
        "en": "I have an interesting fact."
      },
      "tags": [
        "word",
        "information",
        "fact",
        "A2"
      ]
    },
    {
      "id": "word-primeras",
      "kind": "word",
      "promptEs": "primeras",
      "answerEn": "first (feminine plural)",
      "noteEn": "Primeras matches a feminine plural noun.",
      "example": {
        "es": "Fueron las primeras visitas.",
        "en": "They were the first visits."
      },
      "tags": [
        "word",
        "ordinal",
        "feminine",
        "plural",
        "A1"
      ]
    },
    {
      "id": "word-citas--romantic-dates",
      "kind": "word",
      "promptEs": "citas",
      "answerEn": "dates; romantic meetings",
      "noteEn": "Cita can also mean an appointment or a quotation. Here citas are meetings between potential romantic partners.",
      "example": {
        "es": "Tuvieron dos citas.",
        "en": "They went on two dates."
      },
      "tags": [
        "word",
        "dating",
        "plural",
        "A2"
      ]
    },
    {
      "id": "word-degeneran--turn-into",
      "kind": "word",
      "promptEs": "degeneran",
      "answerEn": "degenerate; deteriorate; turn into something worse",
      "noteEn": "Degeneran is the present plural form of degenerar. With en, it names the undesirable result that situations turn into.",
      "example": {
        "es": "Las reuniones degeneran en discusiones.",
        "en": "The meetings degenerate into arguments."
      },
      "tags": [
        "word",
        "degenerar",
        "change",
        "present",
        "B1"
      ]
    },
    {
      "id": "word-en--degenerar-result",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "into; introduces the result after degenerar",
      "noteEn": "Degenerar en presents what a situation deteriorates or turns into.",
      "example": {
        "es": "La charla degeneró en una pelea.",
        "en": "The conversation degenerated into a fight."
      },
      "tags": [
        "word",
        "preposition",
        "change",
        "B1"
      ]
    },
    {
      "id": "word-cuadros--punnett-squares",
      "kind": "word",
      "promptEs": "cuadros",
      "answerEn": "squares; grids (in the name “Punnett squares”)",
      "noteEn": "Cuadro can mean a square, chart, frame, or painting. In genetics, cuadro de Punnett is the Spanish name for a Punnett square.",
      "example": {
        "es": "La clase dibujó un cuadro de Punnett.",
        "en": "The class drew a Punnett square."
      },
      "tags": [
        "word",
        "genetics",
        "grid",
        "plural",
        "B1"
      ]
    },
    {
      "id": "phrase-degenerar-en",
      "kind": "phrase",
      "promptEs": "degenerar en + resultado",
      "questionEn": "How can you say that a situation deteriorates or turns into an undesirable result?",
      "answerEn": "Use a form of degenerar followed by en and the resulting situation.",
      "noteEn": "Degenerar changes for the person or thing and the time: degenera now, degeneró in a completed past event. En stays fixed and introduces the worse or less controlled result.",
      "example": {
        "es": "El debate degeneró en insultos.",
        "en": "The debate degenerated into insults."
      },
      "tags": [
        "phrase",
        "change",
        "result",
        "B1"
      ]
    },
    {
      "id": "concept-punnett-square-genetic-inheritance",
      "kind": "concept",
      "promptEs": "cuadro de Punnett · herencia de rasgos",
      "questionEn": "What genetics idea connects the parents' traits, the imagined children, and the joke about the date?",
      "answerEn": "A Punnett square is a grid used to show possible combinations of gene variants inherited from two parents. The couple treats possible children's visible traits like outcomes to optimize on a genetics worksheet.",
      "noteEn": "Color-vision deficiency, hair color, and eye color have more complicated inheritance than a single simple grid can fully predict. The joke deliberately turns romantic conversation into an overconfident classroom genetics exercise.",
      "tags": [
        "concept",
        "genetics",
        "Punnett square",
        "inheritance",
        "xkcd joke"
      ]
    }
  ],
