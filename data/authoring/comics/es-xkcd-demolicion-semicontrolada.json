    { "id": "word-simultáneo", "kind": "word", "promptEs": "simultáneo", "answerEn": "simultaneous (masculine singular)", "noteEn": "", "tags": ["word", "time", "adjective", "B1"] },
    { "id": "word-derribada--brought-down", "kind": "word", "promptEs": "derribada", "answerEn": "brought down; knocked down (feminine singular)", "noteEn": "Derribada comes from derribar, ‘to knock down.’ Its -ada ending is used because the thing described is feminine singular, as in la pared; with fue, it says that the thing was brought down.", "example": { "es": "La pared fue derribada ayer.", "en": "The wall was knocked down yesterday." }, "tags": ["word", "verbs", "participle", "B1"] },
    { "id": "word-terroristas", "kind": "word", "promptEs": "terroristas", "answerEn": "terrorists", "noteEn": "", "tags": ["word", "people", "plural", "B1"] },
    { "id": "word-reaccionaron", "kind": "word", "promptEs": "reaccionaron", "answerEn": "they reacted; you all reacted (formal)", "noteEn": "Reaccionaron is the completed-past form of reaccionar used with ellos, ellas, or formal ustedes.", "example": { "es": "Los vecinos reaccionaron con calma.", "en": "The neighbors reacted calmly." }, "tags": ["word", "verbs", "past", "A2"] },
    { "id": "word-tibiamente", "kind": "word", "promptEs": "tibiamente", "answerEn": "lukewarmly; without enthusiasm", "noteEn": "Tibiamente is formed from tibia plus -mente and describes a response lacking warmth or enthusiasm.", "example": { "es": "El público aplaudió tibiamente.", "en": "The audience applauded without enthusiasm." }, "tags": ["word", "adverbs", "attitude", "B2"] },
    { "id": "word-compromiso--middle-ground", "kind": "word", "promptEs": "compromiso", "answerEn": "compromise; middle-ground solution", "noteEn": "Compromiso can mean a commitment. In a disagreement or negotiation, it can instead mean a middle position accepted between competing proposals.", "example": { "es": "Buscamos un compromiso entre las dos propuestas.", "en": "We are looking for a compromise between the two proposals." }, "tags": ["word", "agreement", "sense split", "B1"] },
    { "id": "word-los--the-ones-before-de", "kind": "word", "promptEs": "los", "answerEn": "the ones; the people", "noteEn": "Before a de phrase, los can stand on its own for an understood masculine or mixed plural group instead of introducing a stated noun.", "example": { "es": "Los de la oficina ya llegaron.", "en": "The people from the office have already arrived." }, "tags": ["word", "articles", "omitted noun", "A2"] },
    { "id": "word-primero--first-one", "kind": "word", "promptEs": "primero", "answerEn": "first one; former one (masculine singular)", "noteEn": "After el, primero can stand on its own and refer back to the first previously mentioned masculine item; the name of that item does not need to be repeated.", "example": { "es": "Prefiero el primero de los dos planes.", "en": "I prefer the first of the two plans." }, "tags": ["word", "sequence", "omitted noun", "A2"] },
    { "id": "word-con--relacion-complement", "kind": "word", "promptEs": "con", "answerEn": "to; required after relación before what is connected", "noteEn": "In tener relación con or sin relación con, con introduces what something is or is not connected to.", "example": { "es": "El cambio no tiene relación con el precio.", "en": "The change is not related to the price." }, "tags": ["word", "preposition", "connection", "A2"] },
    { "id": "word-por--supported-cause", "kind": "word", "promptEs": "por", "answerEn": "for; in support of a cause", "noteEn": "After a group, campaign, or movement, por can introduce the cause it supports.", "example": { "es": "Participan en una campaña por la igualdad.", "en": "They are taking part in a campaign for equality." }, "tags": ["word", "preposition", "support", "B1"] },
    { "id": "word-a--reaction-target", "kind": "word", "promptEs": "a", "answerEn": "to; required after reaccionar before what prompts the reaction", "noteEn": "Spanish uses reaccionar a to introduce the event, idea, or thing that receives a reaction.", "example": { "es": "Reaccionó bien a la noticia.", "en": "She reacted well to the news." }, "tags": ["word", "preposition", "verb complement", "A2"] },
    {
      "id": "grammar-article-de-phrase-omitted-noun",
      "kind": "grammar",
      "promptEs": "el/la/los/las + de + grupo o lugar, sin sustantivo expreso",
      "questionEn": "How can el, la, los, or las plus a de phrase identify people or things without repeating their name?",
      "answerEn": "Use el, la, los, or las on its own, followed by de and the identifying group, place, or source.",
      "noteEn": "Choose el, la, los, or las to match the single item or group understood from context. Its name is left out because the context makes it clear; the following de phrase identifies which one or ones are meant.",
      "example": { "es": "Las de mi clase vienen mañana.", "en": "The women or girls from my class are coming tomorrow." },
      "tags": ["grammar", "omitted noun", "articles", "A2"]
    },
    {
      "id": "phrase-sin-relacion-con",
      "kind": "phrase",
      "promptEs": "sin relación con + algo",
      "questionEn": "How do you say that something has no connection to something else?",
      "answerEn": "Use sin relación con, followed by the other thing.",
      "noteEn": "Sin marks the absence of a connection, relación names that connection, and con introduces what it would be connected to. All three words stay unchanged.",
      "example": { "es": "Es un problema sin relación con el clima.", "en": "It is a problem unrelated to the weather." },
      "tags": ["phrase", "connection", "preposition", "B1"]
    },
    {
      "id": "phrase-reaccionar-a",
      "kind": "phrase",
      "promptEs": "reaccionar a + algo",
      "questionEn": "How do you introduce the thing that someone reacts to?",
      "answerEn": "Use a form of reaccionar, then a, then the event, idea, or thing prompting the reaction.",
      "noteEn": "Reaccionar changes for the person and time. The preposition a remains unchanged before the target of the reaction, even when English also uses “to.”",
      "example": { "es": "Mario reaccionó a la pregunta.", "en": "Mario reacted to the question." },
      "tags": ["phrase", "reaction", "verb pattern", "A2"]
    },
    {
      "id": "concept-semicontrolled-demolition-false-compromise",
      "kind": "concept",
      "promptEs": "demolición semicontrolada · teoría de compromiso",
      "answerEn": "the joke invents a nonsensical midpoint between incompatible explanations of the two tower collapses",
      "noteEn": "The speaker applies the idea that truth must lie halfway between extreme claims: one tower is assigned to a staged demolition and the other to real terrorists. Combining mutually exclusive stories does not create evidence, which is why the proposed “compromise” is absurd.",
      "tags": ["concept", "logic", "false balance", "joke"]
    }
