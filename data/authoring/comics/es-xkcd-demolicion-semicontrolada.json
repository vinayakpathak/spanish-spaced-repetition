  "cardDefinitions": [
    { "id": "word-según--according-to", "kind": "word", "promptEs": "según", "answerEn": "according to; based on", "noteEn": "Según introduces the source, standard, or evidence on which a statement is based.", "example": { "es": "Según el mapa, estamos cerca.", "en": "According to the map, we are close." }, "tags": ["word", "preposition", "evidence", "A2"] },
    { "id": "word-amañó--staged", "kind": "word", "promptEs": "amañó", "answerEn": "staged; rigged", "noteEn": "Amañó is the completed-past form of amañar used with él, ella, or formal usted. It suggests secretly arranging an event or result dishonestly.", "example": { "es": "El promotor amañó el resultado.", "en": "The promoter rigged the result." }, "tags": ["word", "verbs", "deception", "B2"] },
    { "id": "word-choque--crash", "kind": "word", "promptEs": "choque", "answerEn": "crash; collision", "noteEn": "", "tags": ["word", "events", "A2"] },
    { "id": "word-avión", "kind": "word", "promptEs": "avión", "answerEn": "airplane; plane", "noteEn": "", "tags": ["word", "transport", "A1"] },
    { "id": "word-demolió", "kind": "word", "promptEs": "demolió", "answerEn": "demolished", "noteEn": "Demolió is the completed-past form of demoler used with él, ella, or formal usted.", "example": { "es": "La empresa demolió el edificio vacío.", "en": "The company demolished the empty building." }, "tags": ["word", "verbs", "past", "B1"] },
    { "id": "word-torre", "kind": "word", "promptEs": "torre", "answerEn": "tower", "noteEn": "", "tags": ["word", "buildings", "A1"] },
