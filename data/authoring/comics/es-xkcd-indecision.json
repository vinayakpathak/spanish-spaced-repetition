      "tags": ["word", "adjective", "society", "A2"]
    },
    {
      "id": "word-pasan--spend-time",
      "kind": "word",
      "promptEs": "pasan",
      "answerEn": "they spend (an amount of time)",
      "noteEn": "Pasar often means “to pass,” but before a duration it can mean “to spend” that time. Pasan is the present form used for more than one person or thing.",
      "example": { "es": "Pasan dos horas en el parque.", "en": "They spend two hours in the park." },
      "tags": ["word", "pasar", "time", "present", "A2"]
    },
    {
      "id": "word-de--after-mas-than",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "than (after más before a quantity)",
      "noteEn": "Before a number or other quantity, Spanish uses más de for “more than.” This de is different from más que, which commonly compares one person, thing, or action with another.",
      "example": { "es": "Hay más de veinte personas.", "en": "There are more than twenty people." },
      "tags": ["word", "comparison", "quantity", "A2"]
    },
    { "id": "word-decidir", "kind": "word", "promptEs": "decidir", "answerEn": "to decide", "noteEn": "", "tags": ["word", "verb", "A1"] },
    {
      "id": "word-deben--obligation",
      "kind": "word",
      "promptEs": "deben",
      "answerEn": "they must; they are required to",
      "noteEn": "Deben is a present form of deber used with a plural subject. A following action verb stays in its unchanged dictionary form.",
      "example": { "es": "Deben salir ahora.", "en": "They must leave now." },
      "tags": ["word", "deber", "obligation", "present", "A2"]
    },
    {
      "id": "word-por--fixed-por-omision",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "by (as part of por omisión, “by default”)",
      "noteEn": "Por begins the fixed expression por omisión, which describes what happens automatically when no other choice is made.",
      "example": { "es": "La respuesta por omisión es no.", "en": "The default answer is no." },
      "tags": ["word", "fixed expression", "default", "A2"]
    },
    {
      "id": "word-omision--default",
      "kind": "word",
      "promptEs": "omisión",
      "answerEn": "omission; default (in por omisión)",
      "noteEn": "Omisión literally names something left out. In por omisión, it refers to the option used when nothing else is specified.",
      "example": { "es": "El valor por omisión es cero.", "en": "The default value is zero." },
      "tags": ["word", "noun", "default", "A2"]
    },
    {
      "id": "word-dedicarse",
      "kind": "word",
      "promptEs": "dedicarse",
      "answerEn": "to devote themselves; to engage in",
      "noteEn": "Dedicarse is a verb used with a short marker that changes with the person: me dedico, te dedicas, se dedica, nos dedicamos, se dedican. It normally takes a before the activity.",
      "example": { "es": "Se dedican a la música.", "en": "They devote themselves to music." },
      "tags": ["word", "pronominal verb", "activity", "A2"]
    },
    {
      "id": "word-a--dedicarse-complement",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "to; introduces the activity after dedicarse",
      "noteEn": "Dedicarse requires a before a noun or an action verb that names the activity.",
      "example": { "es": "Me dedico a escribir.", "en": "I devote myself to writing." },
      "tags": ["word", "required complement", "dedicarse a", "A2"]
    },
    { "id": "word-experimentacion", "kind": "word", "promptEs": "experimentación", "answerEn": "experimentation", "noteEn": "", "tags": ["word", "noun", "B1"] },
    { "id": "word-sexual", "kind": "word", "promptEs": "sexual", "answerEn": "sexual", "noteEn": "", "tags": ["word", "adjective", "A2"] },
    {
      "id": "word-je--heh",
      "kind": "word",
      "promptEs": "je",
      "answerEn": "heh; a short amused reaction",
      "noteEn": "Spanish writes laughter with repeated j sounds, such as ja, je, ji, jo, or ju. Je can suggest a restrained, knowing, or slightly awkward laugh.",
      "example": { "es": "Je, qué coincidencia.", "en": "Heh, what a coincidence." },
      "tags": ["word", "interjection", "laughter", "A1"]
    },
    {
      "id": "word-conocia--knew-state",
      "kind": "word",
      "promptEs": "conocía",
      "answerEn": "I knew; I was familiar with",
      "noteEn": "Conocía is a past form of conocer. It presents knowing or familiarity as a past state, rather than the moment when someone first found something out.",
      "example": { "es": "No conocía esa canción.", "en": "I did not know that song." },
      "tags": ["word", "conocer", "past", "imperfect", "A2"]
    },
    {
      "id": "word-tampoco--negative-agreement",
      "kind": "word",
      "promptEs": "tampoco",
      "answerEn": "neither; not either",
      "noteEn": "Tampoco adds a second negative case. In a short reply, yo tampoco means “me neither”; the negative verb does not need to be repeated.",
      "example": { "es": "Yo tampoco lo sé.", "en": "I do not know either." },
      "tags": ["word", "negative agreement", "A2"]
    },
    {
      "id": "word-a--fixed-ir-a-por",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; part of ir a por, “to go get”",
      "noteEn": "In the Spain usage ir a por something, a and por appear together before the thing someone goes to get.",
      "example": { "es": "Voy a por agua.", "en": "I am going to get water." },
      "tags": ["word", "fixed expression", "Spain", "A2"]
    },
    {
      "id": "word-por--fixed-ir-a-por",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "no separate English word; completes ir a por, “to go get”",
      "noteEn": "Por completes a por before the item being fetched in this common Spain construction.",
      "example": { "es": "Fue a por el abrigo.", "en": "She went to get the coat." },
      "tags": ["word", "fixed expression", "Spain", "A2"]
    },
    { "id": "word-margarina", "kind": "word", "promptEs": "margarina", "answerEn": "margarine", "noteEn": "", "tags": ["word", "food", "feminine noun", "A1"] },
    {
      "id": "grammar-querer-infinitive",
      "kind": "grammar",
      "promptEs": "querer + infinitivo",
      "questionEn": "How do you say what someone wants to do?",
      "answerEn": "Use a form of querer, then the action verb in its unchanged dictionary form.",
      "noteEn": "The dictionary form is the unchanged verb ending in -ar, -er, or -ir. Querer changes to match the person and time, while the desired action stays unchanged: quiero salir, quieres comer, queremos dormir. Spanish does not insert a between the two verbs.",
      "example": { "es": "Lucía quiere descansar.", "en": "Lucía wants to rest." },
      "tags": ["grammar", "wanting", "infinitive", "A1"]
    },
    {
      "id": "grammar-question-word-infinitive",
      "kind": "grammar",
      "promptEs": "qué/cómo/dónde + infinitivo",
      "questionEn": "How do you say what, how, or where to do something without naming a new person who does it?",
      "answerEn": "Use an accented question word, then the action verb in its unchanged dictionary form.",
      "noteEn": "The dictionary form is the unchanged verb ending in -ar, -er, or -ir. This compact pattern is used when the person who would perform the action is already clear from context. The question word keeps its written accent even inside a larger statement: qué hacer, cómo llegar, dónde aparcar.",
      "example": { "es": "No sé dónde aparcar.", "en": "I do not know where to park." },
      "tags": ["grammar", "embedded question", "infinitive", "A2"]
    },
    {
      "id": "grammar-mas-de-quantity",
      "kind": "grammar",
      "promptEs": "más de + cantidad",
      "questionEn": "How do you say that an amount is more than a particular number or quantity?",
      "answerEn": "Put más de directly before the number or amount.",
      "noteEn": "Use más de when the next element is a quantity being exceeded. Use más que instead when directly comparing people, things, qualities, or actions: más de diez libros, but Ana lee más que Luis.",
      "example": { "es": "Compró más de tres libros.", "en": "She bought more than three books." },
      "tags": ["grammar", "comparison", "quantity", "A2"]
    },
    {
      "id": "phrase-ni-idea",
      "kind": "phrase",
      "promptEs": "ni idea",
      "questionEn": "What short informal reply means that you have no idea?",
      "answerEn": "Say ni idea, meaning “no idea.”",
      "noteEn": "Ni idea is a conventional shortened reply. The fuller form is no tengo ni idea, but speakers often omit no tengo when the situation makes it obvious that they are answering a question.",
      "example": { "es": "—¿Dónde está Ana? —Ni idea.", "en": "—Where is Ana? —No idea." },
      "tags": ["phrase", "informal reply", "uncertainty", "A2"]
    },
    {
      "id": "phrase-por-omision",
      "kind": "phrase",
      "promptEs": "por omisión",
      "questionEn": "How can you say that something happens by default when no other choice is made?",
      "answerEn": "Use por omisión to mean “by default.”",
      "noteEn": "Omisión literally refers to leaving something out. Por omisión describes the setting, rule, or result used automatically when nobody specifies another option. Por defecto is another very common expression with the same technical sense.",
      "example": { "es": "La opción está activada por omisión.", "en": "The option is enabled by default." },
      "tags": ["phrase", "default", "technical", "B1"]
    },
    {
      "id": "phrase-dedicarse-a",
      "kind": "phrase",
      "promptEs": "dedicarse a + actividad",
      "questionEn": "How do you say that someone devotes themselves to or regularly works at an activity?",
      "answerEn": "Use a matching form of dedicarse, then a, then a noun or an action verb in its dictionary form.",
      "noteEn": "The short marker changes with the person: me dedico, te dedicas, se dedica, nos dedicamos, se dedican. The a stays before the activity. When the activity is a verb, it remains in the unchanged form ending in -ar, -er, or -ir.",
      "example": { "es": "Marta se dedica a enseñar.", "en": "Marta devotes herself to teaching." },
      "tags": ["phrase", "pronominal verb", "occupation", "A2"]
    },
    {
      "id": "phrase-yo-tampoco",
      "kind": "phrase",
      "promptEs": "yo tampoco",
      "questionEn": "How do you agree with a negative statement and say “me neither”?",
      "answerEn": "Reply yo tampoco; change yo if a different person is agreeing.",
      "noteEn": "Tampoco adds another person or case to an existing negative statement, so the reply does not need to repeat the verb. With expressions built like me gusta, Spanish commonly says a mí tampoco instead.",
      "example": { "es": "—No tengo hambre. —Yo tampoco.", "en": "—I am not hungry. —Me neither." },
      "tags": ["phrase", "negative agreement", "conversation", "A2"]
    },
    {
      "id": "phrase-ir-a-por",
      "kind": "phrase",
      "promptEs": "ir a por + cosa",
      "questionEn": "How do speakers in Spain commonly say that someone goes to get or fetch something?",
      "answerEn": "Use a form of ir, then a por, then the thing being fetched.",
      "noteEn": "In this Spain usage, both a and por stay before the object: voy a por, fue a por, iremos a por. This is not the ir a plus action-verb pattern for “going to do” something. Speakers elsewhere often say ir por or ir a buscar instead.",
      "example": { "es": "Voy a por las llaves.", "en": "I am going to get the keys." },
      "tags": ["phrase", "movement", "fetching", "Spain", "A2"]
    },
    {
      "id": "concept-margarine-lubricant-joke",
      "kind": "concept",
      "promptEs": "la margarina como lubricante improvisado",
      "answerEn": "Margarine is greasy, so fetching it implies an immediate plan to use it as an improvised sexual lubricant.",
      "noteEn": "The original English comic names Crisco, a brand of vegetable shortening, for the same implication. The Spanish version substitutes margarina. That unexpectedly practical response is the final escalation of the joke.",
      "tags": ["concept", "joke", "cultural adaptation", "adult humor"]
    }
  ],
