  "cardDefinitions": [
    {
      "id": "word-da--give-talk",
      "kind": "word",
      "promptEs": "da",
      "answerEn": "gives; delivers (a talk)",
      "noteEn": "Da is a present form of dar for one person or thing, or for formal singular you. With ponencia, dar means to give or deliver a formal talk.",
      "example": { "es": "La profesora da una ponencia mañana.", "en": "The professor is giving a talk tomorrow." },
      "tags": ["word", "dar", "talk", "present", "A2"]
    },
    {
      "id": "word-ponencia",
      "kind": "word",
      "promptEs": "ponencia",
      "answerEn": "formal talk; presentation; keynote",
      "noteEn": "A ponencia is a formal presentation, often at a conference or professional event.",
      "example": { "es": "La ponencia empieza a las diez.", "en": "The talk starts at ten." },
      "tags": ["word", "presentation", "event", "B1"]
    },
    {
      "id": "word-alegando--citing-reason",
      "kind": "word",
      "promptEs": "alegando",
      "answerEn": "citing; claiming as a reason",
      "noteEn": "Alegando is the -ando form of alegar. It can add the reason or explanation that someone gives for another action.",
      "example": { "es": "Canceló la reunión alegando cansancio.", "en": "She canceled the meeting, citing tiredness." },
      "tags": ["word", "reason", "gerund", "B1"]
    },
    { "id": "word-pérdida", "kind": "word", "promptEs": "pérdida", "answerEn": "loss", "noteEn": "", "tags": ["word", "noun", "A2"] },
    { "id": "word-peso", "kind": "word", "promptEs": "peso", "answerEn": "weight", "noteEn": "", "tags": ["word", "noun", "A2"] },
    {
      "id": "word-debido--fixed-debido-a",
      "kind": "word",
      "promptEs": "debido",
      "answerEn": "due; because of (as part of debido a)",
      "noteEn": "Debido joins a to form the connector debido a, which introduces a cause.",
      "example": { "es": "El partido se canceló debido a la lluvia.", "en": "The game was canceled because of the rain." },
      "tags": ["word", "fixed expression", "cause", "B1"]
    },
    {
      "id": "word-a--fixed-debido-a",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "to; completes debido a (‘due to; because of’)",
      "noteEn": "This a stays after debido and introduces the cause that follows.",
      "example": { "es": "Llegamos tarde debido a un accidente.", "en": "We arrived late because of an accident." },
      "tags": ["word", "fixed expression", "cause", "B1"]
    },
    { "id": "word-hormonal", "kind": "word", "promptEs": "hormonal", "answerEn": "hormonal; hormone-related", "noteEn": "", "tags": ["word", "adjective", "health", "B1"] },
    {
      "id": "word-pena--shame",
      "kind": "word",
      "promptEs": "pena",
      "answerEn": "shame; pity",
      "noteEn": "Pena can name sorrow or distress. In una pena, it commonly expresses that something is unfortunate or disappointing.",
      "example": { "es": "Fue una pena perder el tren.", "en": "It was a shame to miss the train." },
      "tags": ["word", "reaction", "noun", "A2"]
    },
    {
      "id": "word-seguro--fixed-seguro-que",
      "kind": "word",
      "promptEs": "seguro",
      "answerEn": "surely; I bet (before que)",
      "noteEn": "Seguro que is a common conversational opener for something the speaker strongly expects to be true. Seguro stays masculine singular in this use.",
      "example": { "es": "Seguro que Marta llega pronto.", "en": "I'm sure Marta will arrive soon." },
      "tags": ["word", "certainty", "conversation", "B1"]
    },
    {
      "id": "word-deseando--eager-to",
      "kind": "word",
      "promptEs": "deseando",
      "answerEn": "eager to; really wanting to",
      "noteEn": "After a form of estar, deseando can show strong eagerness for the action that follows.",
      "example": { "es": "Estamos deseando viajar.", "en": "We are eager to travel." },
      "tags": ["word", "desire", "verb form", "B1"]
    },
    {
      "id": "word-presentar--introduce-unveil",
      "kind": "word",
      "promptEs": "presentar",
      "answerEn": "to introduce; unveil; present",
      "noteEn": "Presentar can introduce a person to an audience or unveil something publicly.",
      "example": { "es": "Van a presentar el nuevo diseño.", "en": "They are going to unveil the new design." },
      "tags": ["word", "presentation", "verb", "A2"]
    },
    { "id": "word-delgado--thin", "kind": "word", "promptEs": "delgado", "answerEn": "thin; slim (masculine singular)", "noteEn": "", "tags": ["word", "adjective", "description", "A2"] },
    { "id": "word-ligero--lightweight", "kind": "word", "promptEs": "ligero", "answerEn": "light; lightweight (not heavy)", "noteEn": "Ligero can describe something that has little weight. In other contexts it can also mean quick or slight.", "example": { "es": "Busco un portátil ligero.", "en": "I'm looking for a lightweight laptop." }, "tags": ["word", "adjective", "weight", "A2"] },
    {
      "id": "phrase-dar-una-ponencia",
      "kind": "phrase",
      "promptEs": "dar una ponencia",
      "questionEn": "How do you say that someone gives or delivers a formal talk?",
      "answerEn": "Use a matching form of dar with una ponencia; replace una with another small specifying word when needed.",
      "noteEn": "Dar changes for the person and time: doy, da, damos, dio, and so on. Ponencia stays the name of the formal talk. A word such as una, alguna, or ninguna can come before it.",
      "example": { "es": "Marta dio una ponencia sobre salud.", "en": "Marta gave a talk about health." },
      "tags": ["phrase", "collocation", "presentation", "B1"]
    },
    {
      "id": "phrase-perdida-de-peso",
      "kind": "phrase",
      "promptEs": "pérdida de peso",
      "questionEn": "How do you refer to a loss of body weight?",
      "answerEn": "Use pérdida de peso for ‘weight loss.’",
      "noteEn": "Pérdida names a loss, de connects it to what is lost, and peso names weight. The three words form a conventional health-related combination.",
      "example": { "es": "La pérdida de peso fue gradual.", "en": "The weight loss was gradual." },
      "tags": ["phrase", "collocation", "health", "B1"]
    },
    {
      "id": "phrase-debido-a",
      "kind": "phrase",
      "promptEs": "debido a + causa",
      "questionEn": "How do you introduce the cause of something with the meaning ‘due to’ or ‘because of’?",
      "answerEn": "Use debido a, then name the cause.",
      "noteEn": "Debido remains masculine singular in this connector, and a stays directly after it. The cause can be a noun or a longer naming phrase. Debido a is common in neutral and formal explanations.",
      "example": { "es": "El vuelo se retrasó debido a la niebla.", "en": "The flight was delayed because of the fog." },
      "tags": ["phrase", "cause", "connector", "B1"]
    },
    {
      "id": "phrase-seguro-que",
      "kind": "phrase",
      "promptEs": "seguro que",
      "questionEn": "How do you introduce something you strongly expect to be true?",
      "answerEn": "Put seguro que before the statement: it means ‘I'm sure…’ or ‘I bet…’.",
      "noteEn": "Treat seguro que as a conversational opener here. Seguro stays masculine singular, and que introduces the statement the speaker expects to be true.",
      "example": { "es": "Seguro que Ana ya lo sabe.", "en": "I'm sure Ana already knows." },
      "tags": ["phrase", "certainty", "conversation", "B1"]
    },
    {
      "id": "grammar-estar-deseando-infinitive",
      "kind": "grammar",
      "promptEs": "estar deseando + verbo en forma de diccionario",
      "questionEn": "How do you say that someone is eager or looking forward to doing something?",
      "answerEn": "Use a matching form of estar, then deseando, then the action verb in its unchanged dictionary form.",
      "noteEn": "Only estar changes for the person and time: estoy, está, estaba, and so on. Deseando stays unchanged, and the final action keeps its dictionary ending in -ar, -er, or -ir.",
      "example": { "es": "Estamos deseando viajar.", "en": "We are looking forward to traveling." },
      "tags": ["grammar", "desire", "verb pattern", "B1"]
    },
    {
      "id": "concept-apple-thinnest-lightest-marketing",
      "kind": "concept",
      "promptEs": "ponencia · presentar · delgado y ligero",
      "questionEn": "What marketing language turns the description of the CEO into a joke?",
      "answerEn": "Apple product presentations often emphasize devices as exceptionally thin and light; the speaker applies that product language to a person.",
      "noteEn": "Steve Jobs was Apple's CEO and delivered its prominent keynote presentations. The comic turns his reported weight loss into a grim parody of a product unveiling.",
      "tags": ["concept", "Apple", "marketing", "keynote", "humor"]
    }
  ],
