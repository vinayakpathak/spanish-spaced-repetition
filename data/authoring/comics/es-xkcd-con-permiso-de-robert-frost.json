    {
      "id": "word-que--fixed-ahora-que",
      "kind": "word",
      "promptEs": "que",
      "answerEn": "no separate English word; completes ahora que, “now that”",
      "noteEn": "After ahora, que introduces the situation that is now true. It is written without an accent because it is a linking word, not the question word qué.",
      "example": { "es": "Ahora que estás aquí, podemos salir.", "en": "Now that you are here, we can leave." },
      "tags": ["word", "ahora que", "linking word"]
    },
    { "id": "word-ambos", "kind": "word", "promptEs": "ambos", "answerEn": "both; both of them", "noteEn": "", "tags": ["word", "quantity", "pronoun"] },
    {
      "id": "word-adverti--noticed",
      "kind": "word",
      "promptEs": "advertí",
      "answerEn": "I noticed; I became aware of",
      "noteEn": "Advertí is a completed-past form of advertir. Advertir can mean either “to notice” or “to warn”; this card teaches the notice sense.",
      "example": { "es": "Advertí el error demasiado tarde.", "en": "I noticed the error too late." },
      "tags": ["word", "advertir", "noticing", "preterite"]
    },
    {
      "id": "word-los--those-who",
      "kind": "word",
      "promptEs": "los",
      "answerEn": "those; the ones (as part of los que)",
      "noteEn": "Los normally means “the” before a masculine plural noun. In los que followed by a description, the noun is left unstated and los identifies a masculine or mixed group: los que llegaron means “those who arrived.”",
      "example": { "es": "Conozco a los que viven aquí.", "en": "I know those who live here." },
      "tags": ["word", "los que", "people", "omitted noun"]
    },
    { "id": "word-infieren", "kind": "word", "promptEs": "infieren", "answerEn": "they infer; they deduce", "noteEn": "", "tags": ["word", "inferir", "reasoning", "present"] },
    {
      "id": "word-mas--but-literary",
      "kind": "word",
      "promptEs": "mas",
      "answerEn": "but (literary or formal)",
      "noteEn": "Unaccented mas is an old-fashioned or literary alternative to pero. Do not confuse it with más, written with an accent, which means “more” or “most.”",
      "example": { "es": "Quise ayudar, mas no pude.", "en": "I wanted to help, but I could not." },
      "tags": ["word", "contrast", "literary"]
    },
    { "id": "word-temo", "kind": "word", "promptEs": "temo", "answerEn": "I fear; I am afraid", "noteEn": "", "tags": ["word", "temer", "emotion", "present"] },
    {
      "id": "word-hombre--humankind",
      "kind": "word",
      "promptEs": "hombre",
      "answerEn": "humankind; humanity",
      "noteEn": "El hombre can refer collectively to humanity in older or literary language. La humanidad is a more explicitly inclusive choice in modern neutral prose.",
      "example": { "es": "La humanidad ha observado las estrellas durante siglos.", "en": "Humankind has observed the stars for centuries." },
      "tags": ["word", "humanity", "collective", "literary"]
    },
    {
      "id": "word-venere--subjunctive",
      "kind": "word",
      "promptEs": "venere",
      "answerEn": "may worship; may revere",
      "noteEn": "Venere is a special form of venerar, “to worship” or “to revere.” After an expression of fear followed by que, Spanish uses this form to present the feared event rather than state it as a fact.",
      "example": { "es": "Temo que la gente venere al líder.", "en": "I fear that people may revere the leader." },
      "tags": ["word", "venerar", "fear", "subjunctive"]
    },
    { "id": "word-decepcionante", "kind": "word", "promptEs": "decepcionante", "answerEn": "disappointing", "noteEn": "", "tags": ["word", "description"] },
    { "id": "word-mito", "kind": "word", "promptEs": "mito", "answerEn": "myth", "noteEn": "", "tags": ["word", "story", "noun"] },
    {
      "id": "word-alguna--alguna-vez",
      "kind": "word",
      "promptEs": "alguna",
      "answerEn": "some; any (as part of alguna vez)",
      "noteEn": "Alguna is the feminine singular form of alguno. With vez, it helps form alguna vez. Questions and conditions often use it for “ever,” while positive statements can use it for “sometime.”",
      "example": { "es": "¿Has estado aquí alguna vez?", "en": "Have you ever been here?" },
      "tags": ["word", "alguna vez", "quantity"]
    },
    {
      "id": "word-reescribiere--future-subjunctive-i",
      "kind": "word",
      "promptEs": "reescribiere",
      "answerEn": "(if) I should rewrite; (if) I were ever to rewrite (rare, old-fashioned form)",
      "noteEn": "Reescribiere is a future-subjunctive form of reescribir, “to rewrite.” This special -re form is nearly absent from everyday Spanish but still appears in old writing, legal language, and deliberate imitation of those styles.",
      "example": { "es": "Si alguien reescribiere el contrato, deberá avisarnos.", "en": "If anyone should rewrite the contract, they must notify us." },
      "tags": ["word", "reescribir", "future subjunctive", "rare form"]
    },
    {
      "id": "word-seria--would-be",
      "kind": "word",
      "promptEs": "sería",
      "answerEn": "would be",
      "noteEn": "Sería is the “would” form of ser, “to be.” Spanish keeps the full dictionary form ser and adds -ía.",
      "example": { "es": "Sería una buena solución.", "en": "It would be a good solution." },
      "tags": ["word", "ser", "conditional", "would"]
    },
    { "id": "word-finito", "kind": "word", "promptEs": "finito", "answerEn": "finite; limited rather than endless", "noteEn": "", "tags": ["word", "mathematics", "description"] },
    { "id": "word-parentesis", "kind": "word", "promptEs": "paréntesis", "answerEn": "parenthesis", "noteEn": "", "tags": ["word", "punctuation", "computing"] },
    {
      "id": "word-cierre--closing",
      "kind": "word",
      "promptEs": "cierre",
      "answerEn": "closing; close (as part of paréntesis de cierre)",
      "noteEn": "Cierre is a noun meaning a closing or close. After de, it can classify something by its closing function, as in paréntesis de cierre.",
      "example": { "es": "Busca el símbolo de cierre.", "en": "Look for the closing symbol." },
      "tags": ["word", "closing", "punctuation"]
    },
    {
      "id": "phrase-ahora-que",
      "kind": "phrase",
      "promptEs": "ahora que + situación",
      "questionEn": "How do you introduce something that has become true and matters now?",
      "answerEn": "Use ahora que, then state the situation.",
      "noteEn": "Ahora means “now,” and que links it to a complete situation. The situation after que uses an ordinary verb form when the speaker presents it as a fact.",
      "example": { "es": "Ahora que tenemos tiempo, podemos hablar.", "en": "Now that we have time, we can talk." },
      "tags": ["phrase", "time", "clause link", "A2"]
    },
    {
      "id": "phrase-alguna-vez",
      "kind": "phrase",
      "promptEs": "alguna vez",
      "questionEn": "How do you say “ever” or “at some unspecified time”?",
      "answerEn": "Use alguna vez.",
      "noteEn": "In questions and conditions, alguna vez often means “ever.” In a positive statement, it can mean “sometime” or “on some occasion.”",
      "example": { "es": "¿Has visitado Sevilla alguna vez?", "en": "Have you ever visited Seville?" },
      "tags": ["phrase", "time", "ever", "A2"]
    },
    {
      "id": "phrase-parentesis-de-cierre",
      "kind": "phrase",
      "promptEs": "paréntesis de cierre",
      "questionEn": "What is the Spanish term for a closing parenthesis?",
      "answerEn": "Use paréntesis de cierre.",
      "noteEn": "Spanish uses de followed by the noun cierre to identify the parenthesis that closes a pair. The opposite term is paréntesis de apertura, “opening parenthesis.”",
      "example": { "es": "Falta un paréntesis de cierre.", "en": "A closing parenthesis is missing." },
      "tags": ["phrase", "punctuation", "computing", "A2"]
    },
    {
      "id": "grammar-future-subjunctive-rare",
      "kind": "grammar",
      "promptEs": "si + futuro de subjuntivo en -re (forma rara)",
      "questionEn": "What does an old-fashioned verb form ending in -re mean after si?",
      "answerEn": "It presents a possible future event in a rare old, legal, or deliberately formal style.",
      "noteEn": "This form is called the future subjunctive: a special verb form for a future possibility. Forms include llegare, llegares, llegare, llegáremos, llegareis, and llegaren. Modern everyday Spanish normally uses the ordinary present after si instead: Si alguien llega... rather than Si alguien llegare....",
      "example": { "es": "Si alguien incumpliere la norma, pagará una multa.", "en": "If anyone violates the rule, they will pay a fine." },
      "tags": ["grammar", "future subjunctive", "conditions", "formal language", "C1"]
    },
    {
      "id": "concept-robert-frost-fire-and-ice",
      "kind": "concept",
      "promptEs": "«Unos dicen…; otros dicen…» y “Fire and Ice”",
      "answerEn": "The wording and nine-line shape parody Robert Frost's poem “Fire and Ice,” which opens by contrasting two claims about how the world will end.",
      "noteEn": "The comic replaces Frost's fire and ice with programming languages while preserving the recognizable repeated opening and much of the poem's compact form.",
      "tags": ["concept", "Robert Frost", "Fire and Ice", "poetry", "parody"]
    },
    {
      "id": "concept-perl-lisp-close-parenthesis",
      "kind": "concept",
      "promptEs": "PERL, LISP y un paréntesis de cierre",
      "answerEn": "Perl and Lisp are programming languages; Lisp represents code with many nested expressions enclosed in paired parentheses.",
      "noteEn": "The comic imagines the universe as source code. The huge ) at its right edge acts like the final closing parenthesis of a Lisp program; an unmatched parenthesis can change or break the program's structure.",
      "tags": ["concept", "Perl", "Lisp", "parentheses", "programming joke"]
    }
  ],
