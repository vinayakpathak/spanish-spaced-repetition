    { "id": "word-caída--fallen", "kind": "word", "promptEs": "caída", "answerEn": "fallen (feminine singular)", "noteEn": "Caída is the feminine singular form of caído. It can describe something that has fallen rather than naming the action itself.", "example": { "es": "Recogimos una rama caída.", "en": "We picked up a fallen branch." }, "tags": ["word", "adjective", "participle", "A2"] },
