    { "id": "word-antimonio", "kind": "word", "promptEs": "antimonio", "answerEn": "antimony", "noteEn": "El antimonio is the chemical element antimony, symbol Sb.", "example": { "es": "La aleación contiene antimonio.", "en": "The alloy contains antimony." }, "tags": ["word", "chemistry", "B2"] },
    { "id": "word-excepcionalmente", "kind": "word", "promptEs": "excepcionalmente", "answerEn": "exceptionally; unusually", "noteEn": "Excepcionalmente is built from the feminine form excepcional plus -mente and describes an unusually high degree or an exceptional manner.", "example": { "es": "El material es excepcionalmente ligero.", "en": "The material is exceptionally light." }, "tags": ["word", "adverb", "degree", "B1"] },
    { "id": "word-frágil", "kind": "word", "promptEs": "frágil", "answerEn": "fragile; brittle", "noteEn": "", "tags": ["word", "adjective", "materials", "A2"] },
