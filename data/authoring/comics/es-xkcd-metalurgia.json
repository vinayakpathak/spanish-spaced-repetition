    { "id": "word-otorga", "kind": "word", "promptEs": "otorga", "answerEn": "grants; bestows", "noteEn": "Otorga is a form of otorgar for one person or thing. It is used for formally or figuratively giving a right, benefit, title, or power.", "example": { "es": "El permiso otorga acceso al edificio.", "en": "The permit grants access to the building." }, "tags": ["word", "giving", "B1"] },
    { "id": "word-empuña", "kind": "word", "promptEs": "empuña", "answerEn": "wields; grips by the handle", "noteEn": "Empuña is a form of empuñar for one person. It commonly describes holding and using a weapon or tool by its handle.", "example": { "es": "La guardia empuña una lanza.", "en": "The guard wields a spear." }, "tags": ["word", "action", "B1"] },
    { "id": "word-en--rpg-stat", "kind": "word", "promptEs": "en", "answerEn": "to; in (marking a game-stat change)", "noteEn": "In game-like descriptions, a number followed by en can identify which statistic receives that increase or penalty, much like English '+2 to risk.'", "example": { "es": "La armadura da +1 en defensa.", "en": "The armor gives +1 to defense." }, "tags": ["word", "preposition", "games", "B1"] },
