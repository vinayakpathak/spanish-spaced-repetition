    {
      "id": "phrase-proceder-de",
      "kind": "phrase",
      "promptEs": "proceder de + origen",
      "questionEn": "How do you say that something comes from or originates in a particular source?",
      "answerEn": "Use a matching form of proceder, then de, then the source or place of origin.",
      "noteEn": "Proceder changes for the thing and time: procede for one thing now, proceden for several, procedía for background past. De stays in place and introduces the origin; it combines with el as del.",
      "example": { "es": "Estas piezas proceden de Italia.", "en": "These parts come from Italy." },
      "tags": ["phrase", "origin", "B1"]
    },
    {
      "id": "phrase-riesgo-de",
      "kind": "phrase",
      "promptEs": "riesgo de + nombre o acción",
      "questionEn": "How do you name the danger that something may happen or cause harm?",
      "answerEn": "Use riesgo de, then name the harmful event, condition, or action.",
      "noteEn": "Riesgo names the danger or possibility, and de introduces what the risk concerns. After de, an action stays in its unchanged dictionary form, such as caer in riesgo de caer.",
      "example": { "es": "Hay riesgo de inundación.", "en": "There is a risk of flooding." },
      "tags": ["phrase", "risk", "B1"]
    },
    {
      "id": "concept-fantasy-sword-radioactive-metallurgy",
      "kind": "concept",
      "promptEs": "espadas mágicas · metalurgia · radiación · bonificaciones",
      "questionEn": "How does the comic replace the usual magic of fantasy weapons with inconvenient material science?",
      "answerEn": "Each supposedly exotic sword property has a mundane scientific cause, and the final weapon turns radiation exposure into a role-playing-game stat bonus.",
      "noteEn": "Fantasy stories often give named blades supernatural origins, a blue glow near orcs, and numerical bonuses. Here antimony makes one sword brittle, actinium makes another glow constantly through radioactivity, and its '+2' applies to cancer risk rather than combat ability. The title text extends the joke by imagining a meteorite blade that is merely gravel held in a sword shape.",
      "tags": ["concept", "fantasy", "metallurgy", "radiation", "role-playing games", "joke"]
    }
  ],
