    { "id": "word-procede--comes-from", "kind": "word", "promptEs": "procede", "answerEn": "comes from; originates", "noteEn": "Procede is a form of proceder for one thing. Proceder de identifies that thing's source or origin.", "example": { "es": "Este café procede de Colombia.", "en": "This coffee comes from Colombia." }, "tags": ["word", "origin", "B1"] },
    { "id": "word-de--proceder-complement", "kind": "word", "promptEs": "de", "answerEn": "from; required after proceder for an origin", "noteEn": "When proceder means to come or originate, de introduces the source.", "example": { "es": "La palabra procede del latín.", "en": "The word comes from Latin." }, "tags": ["word", "preposition", "origin", "B1"] },
    { "id": "word-lejano", "kind": "word", "promptEs": "lejano", "answerEn": "distant; faraway (masculine singular)", "noteEn": "", "tags": ["word", "adjective", "distance", "A2"] },
    { "id": "word-emite", "kind": "word", "promptEs": "emite", "answerEn": "emits; gives off", "noteEn": "Emite is a form of emitir for one person or thing. It is used for giving off light, heat, sound, radiation, or a signal.", "example": { "es": "La lámpara emite poca luz.", "en": "The lamp gives off little light." }, "tags": ["word", "verb", "emission", "B1"] },
    { "id": "word-brillo", "kind": "word", "promptEs": "brillo", "answerEn": "glow; shine", "noteEn": "", "tags": ["word", "light", "A2"] },
    { "id": "word-azulado", "kind": "word", "promptEs": "azulado", "answerEn": "bluish (masculine singular)", "noteEn": "Azulado describes something with a blue tint, not necessarily something fully blue.", "example": { "es": "El humo tiene un tono azulado.", "en": "The smoke has a bluish tone." }, "tags": ["word", "color", "adjective", "B1"] },
    { "id": "word-radiación", "kind": "word", "promptEs": "radiación", "answerEn": "radiation", "noteEn": "", "tags": ["word", "physics", "B1"] },
    { "id": "word-actinio", "kind": "word", "promptEs": "actinio", "answerEn": "actinium", "noteEn": "El actinio is the radioactive chemical element actinium, symbol Ac.", "example": { "es": "El actinio es un elemento radiactivo.", "en": "Actinium is a radioactive element." }, "tags": ["word", "chemistry", "B2"] },
    { "id": "word-contiene", "kind": "word", "promptEs": "contiene", "answerEn": "contains", "noteEn": "", "tags": ["word", "verb", "A2"] },
