    {
      "id": "grammar-reported-future-conditional",
      "kind": "grammar",
      "promptEs": "verbo o contexto en pasado + que/cuándo/etc. + forma en -ría",
      "questionEn": "How do you report that something was still in the future at an earlier point in time?",
      "answerEn": "Set the reporting viewpoint in the past, introduce the reported statement or question, and put the later action or state in a Spanish 'would' form.",
      "noteEn": "A past verb, or surrounding words that clearly place the report in the past, establishes the earlier viewpoint. Que can introduce a reported statement, while an accented question word such as cuándo or dónde can introduce an embedded question. The later verb uses the conditional—the form usually made by keeping its dictionary form and adding -ía, -ías, -ía, -íamos, -íais, or -ían—to show what would happen or be true after that past point.",
      "example": {
        "es": "Lucía dijo que llegaría el lunes.",
        "en": "Lucía said she would arrive on Monday."
      },
      "tags": ["grammar", "reported speech", "conditional", "future in the past", "B1"]
    }
