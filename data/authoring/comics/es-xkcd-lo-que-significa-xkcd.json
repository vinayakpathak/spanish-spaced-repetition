    {
      "id": "grammar-significar-infinitive",
      "kind": "grammar",
      "promptEs": "significar + infinitivo",
      "questionEn": "How do you say that something means doing an action?",
      "answerEn": "Use a form of significar followed by the action verb in its unchanged dictionary form.",
      "noteEn": "The plus sign means “followed by.” The dictionary form is the unchanged verb ending in -ar, -er, or -ir. Spanish uses that unchanged form where English often uses an -ing form after “mean.”",
      "example": {
        "es": "Ser voluntario significa ayudar.",
        "en": "Being a volunteer means helping."
      },
      "tags": ["grammar", "verb pattern", "A2"]
    },
    {
      "id": "phrase-semáforo-en-rojo",
      "kind": "phrase",
      "promptEs": "semáforo en rojo",
      "questionEn": "How do you describe a traffic light that is showing red?",
      "answerEn": "Say semáforo en rojo.",
      "noteEn": "Spanish commonly uses en plus the color to name the signal's current state. Semáforo names the traffic light, en introduces its state, and rojo names the color.",
      "example": {
        "es": "Esperamos ante un semáforo en rojo.",
        "en": "We wait at a red light."
      },
      "tags": ["phrase", "traffic", "A2"]
    },
    {
      "id": "grammar-hacer-que-subjunctive",
      "kind": "grammar",
      "promptEs": "hacer que + acción causada",
      "questionEn": "How do you say that someone makes or gets another person to do something?",
      "answerEn": "Use a form of hacer, then que, then the person and the action in a special caused-action form.",
      "noteEn": "The plus sign means “followed by.” Hacer changes for who causes the action. The later verb uses a special form called the subjunctive because that action is being caused rather than simply reported: llama becomes llame, and cierra becomes cierre.",
      "example": {
        "es": "Hago que Ana cierre la puerta.",
        "en": "I make Ana close the door."
      },
      "tags": ["grammar", "causation", "subjunctive", "B1"]
    },
    {
      "id": "grammar-se-puede-infinitive",
      "kind": "grammar",
      "promptEs": "se + forma de poder + infinitivo",
      "questionEn": "How do you say that an action can be done without naming who does it?",
      "answerEn": "Use se, then the form of poder that fits the sentence, then the action verb in its unchanged dictionary form.",
      "noteEn": "In a direct statement, one thing normally takes puede and several things take pueden. Other sentence types can require forms such as pueda. The final action verb stays unchanged, ending in -ar, -er, or -ir. Se keeps the person doing the action unnamed.",
      "example": {
        "es": "La puerta se puede abrir.",
        "en": "The door can be opened."
      },
      "tags": ["grammar", "passive se", "possibility", "B1"]
    },
    {
      "id": "grammar-empezar-a-infinitive",
      "kind": "grammar",
      "promptEs": "empezar a + infinitivo",
      "questionEn": "How do you say that someone starts doing an action?",
      "answerEn": "Use a form of empezar, then a, then the action verb in its unchanged dictionary form.",
      "noteEn": "The plus sign means “followed by.” The dictionary form, also called the infinitive, is the unchanged form ending in -ar, -er, or -ir. Empezar changes for the person and time; a stays fixed, and the action verb stays unchanged.",
      "example": {
        "es": "Lucía empieza a leer.",
        "en": "Lucía starts to read."
      },
      "tags": ["grammar", "beginning actions", "A2"]
    },
    {
      "id": "concept-ackermann-function-graham-number",
      "kind": "concept",
      "promptEs": "función de Ackermann con el número de Graham",
      "answerEn": "an intentionally absurd computation involving extraordinarily fast-growing quantities",
      "noteEn": "The Ackermann function grows extremely quickly even from modest inputs, while Graham's number is already unimaginably large. Using Graham's number as both inputs makes the written calculation comically impossible to carry out, which explains the mathematician's reaction.",
      "tags": ["concept", "mathematics", "humor"]
    }
