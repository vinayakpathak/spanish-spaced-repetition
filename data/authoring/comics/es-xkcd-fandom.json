  "titleText": {
    "es": "Ron Paul quiere volver a traer el patrón de gemas Corusca a la Nueva República.",
    "en": "Ron Paul wants to bring the Corusca gem standard back to the New Republic.",
    "noteEn": "The title combines Ron Paul's support for a commodity-backed currency with the fictional Corusca gems and New Republic from Star Wars. The official English wording uses ‘put ... back on’ rather than the Spanish archive's more literal ‘bring back.’"
  },
  "cardDefinitions": [
    {
      "id": "word-libros",
      "kind": "word",
      "promptEs": "libros",
      "answerEn": "books",
      "noteEn": "Libros is the masculine plural of libro.",
      "example": { "es": "Estos libros son nuevos.", "en": "These books are new." },
      "tags": ["word", "books", "plural", "A1"]
    },
    {
      "id": "word-dios--exclamation",
      "kind": "word",
      "promptEs": "dios",
      "answerEn": "God; man (as an exclamation)",
      "noteEn": "Dios names God, but said by itself it can also react to surprise, excitement, frustration, or strong nostalgia. The tone decides whether natural English keeps ‘God’ or uses an exclamation such as ‘man.’",
      "example": { "es": "¡Dios, cuánto tiempo!", "en": "Man, it's been so long!" },
      "tags": ["word", "interjection", "reaction", "A2"]
    },
    {
      "id": "word-trilogía",
      "kind": "word",
      "promptEs": "trilogía",
      "answerEn": "trilogy",
      "noteEn": "A trilogía is a set of three related works. Its written accent belongs on í.",
      "example": { "es": "Leí la trilogía completa.", "en": "I read the complete trilogy." },
      "tags": ["word", "books", "A2"]
    },
    {
      "id": "word-abandonaste",
      "kind": "word",
      "promptEs": "abandonaste",
      "answerEn": "you abandoned; you left behind (informal singular)",
      "noteEn": "Abandonaste presents the action as completed in the past and addresses one person informally.",
      "example": { "es": "¿Por qué abandonaste el proyecto?", "en": "Why did you abandon the project?" },
      "tags": ["word", "past", "verb", "A2"]
    },
    {
      "id": "word-crecido--grown-up",
      "kind": "word",
      "promptEs": "crecido",
      "answerEn": "grown up; matured (after a form of haber)",
      "noteEn": "After he, has, ha, or another form of haber, crecido presents growing or maturing as something that has happened.",
      "example": { "es": "Los niños han crecido mucho.", "en": "The children have grown a lot." },
      "tags": ["word", "participle", "growth", "A2"]
    },
    {
      "id": "word-dejado--left-behind",
      "kind": "word",
      "promptEs": "dejado",
      "answerEn": "left behind; given up (after a form of haber)",
      "noteEn": "With a following thing, dejar can mean to leave that thing behind or give it up. Dejando de + action is a different construction meaning ‘stopping’ the action.",
      "example": { "es": "He dejado esa costumbre.", "en": "I have given up that habit." },
      "tags": ["word", "participle", "change", "A2"]
    },
    {
      "id": "word-mentalidad",
      "kind": "word",
      "promptEs": "mentalidad",
      "answerEn": "mindset; mentality",
      "noteEn": "Mentalidad is feminine, so words that describe it use feminine forms such as nueva or obsesiva.",
      "example": { "es": "Tiene una mentalidad abierta.", "en": "She has an open mindset." },
      "tags": ["word", "mindset", "feminine", "B1"]
    },
    {
      "id": "word-obsesiva",
      "kind": "word",
      "promptEs": "obsesiva",
      "answerEn": "obsessive (feminine singular)",
      "noteEn": "Obsesiva describes a feminine singular person or thing. The masculine singular form is obsesivo.",
      "example": { "es": "Esa preocupación parece obsesiva.", "en": "That concern seems obsessive." },
      "tags": ["word", "adjective", "agreement", "B1"]
    },
    {
      "id": "word-fan",
      "kind": "word",
      "promptEs": "fan",
      "answerEn": "fan; devoted follower",
      "noteEn": "Spanish commonly uses the borrowed word fan for a devoted follower of a person, team, story, or cultural work. The plural can be fans.",
      "example": { "es": "Es fan de esa autora.", "en": "She is a fan of that author." },
      "tags": ["word", "borrowed word", "fandom", "A2"]
    },
    {
      "id": "word-ya--skeptical-acknowledgment",
      "kind": "word",
      "promptEs": "ya",
      "answerEn": "right; sure (a skeptical acknowledgment)",
      "noteEn": "Said alone with a flat or doubtful tone, ya can acknowledge what someone said without fully believing it. This is different from its time meaning ‘already.’",
      "example": { "es": "—Ya no me importa. —Ya...", "en": "—I don't care anymore. —Right..." },
      "tags": ["word", "discourse", "skepticism", "B1"]
    },
    {
      "id": "word-le--how-doing",
      "kind": "word",
      "promptEs": "le",
      "answerEn": "no separate English word; marks the person whose situation is being asked about",
      "noteEn": "In ¿Cómo le va?, le points to one person addressed formally or one other person. English expresses that relationship through the subject of ‘How are you/is he/is she doing?’",
      "example": { "es": "¿Cómo le va a Marta?", "en": "How is Marta doing?" },
      "tags": ["word", "person marker", "conversation", "A2"]
    },
    {
      "id": "word-va--how-doing",
      "kind": "word",
      "promptEs": "va",
      "answerEn": "is doing; is getting on (in ¿cómo le va?)",
      "noteEn": "Here va does not describe physical travel. In ¿Cómo le va?, it asks about someone's progress, circumstances, or general wellbeing.",
      "example": { "es": "¿Cómo te va en el trabajo?", "en": "How are you doing at work?" },
      "tags": ["word", "conversation", "idiomatic ir", "A2"]
    },
    {
      "id": "word-a--how-doing-person",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; introduces the named person after ¿cómo le va?",
      "noteEn": "Le already marks the person whose situation is being discussed. A followed by a name or person phrase makes that person explicit.",
      "example": { "es": "¿Cómo le va a tu hermana?", "en": "How is your sister doing?" },
      "tags": ["word", "preposition", "person marker", "A2"]
    },
    {
      "id": "word-ooh--excitement",
      "kind": "word",
      "promptEs": "ooh",
      "answerEn": "ooh (a sound of sudden interest or excitement)",
      "noteEn": "Ooh represents a drawn-out reaction rather than an ordinary dictionary noun or verb. Its tone can show delight, surprise, or sudden fascination.",
      "example": { "es": "¡Ooh, qué interesante!", "en": "Ooh, how interesting!" },
      "tags": ["word", "interjection", "sound", "A1"]
    },
    {
      "id": "word-mire--allowed-action",
      "kind": "word",
      "promptEs": "mire",
      "answerEn": "I look; I check (special form after deja que)",
      "noteEn": "After deja que, the ordinary first-person form miro changes to mire because the action is being requested or allowed rather than stated as a fact.",
      "example": { "es": "Deja que mire el mapa.", "en": "Let me look at the map." },
      "tags": ["word", "permission", "subjunctive", "A2"]
    },
    {
      "id": "word-blogs",
      "kind": "word",
      "promptEs": "blogs",
      "answerEn": "blogs",
      "noteEn": "Blog is a borrowed technology word used in Spanish; blogs is its common plural form.",
      "example": { "es": "Leo varios blogs cada semana.", "en": "I read several blogs every week." },
      "tags": ["word", "internet", "borrowed word", "A2"]
    },
    {
      "id": "phrase-como-le-va",
      "kind": "phrase",
      "promptEs": "¿cómo le va?",
      "questionEn": "How can you ask how someone is doing or how things are going for them?",
      "answerEn": "Ask ¿Cómo le va?; add a followed by the person's name if you need to make the person explicit.",
      "noteEn": "Le refers to one person addressed formally or to one other person. With an informal tú, use ¿Cómo te va?; for yourself, use ¿Cómo me va? Va remains singular because the expression asks how the overall situation is going.",
      "example": { "es": "¿Cómo le va a Javier?", "en": "How is Javier doing?" },
      "tags": ["phrase", "conversation", "wellbeing", "A2"]
    },
    {
      "id": "concept-fandom-star-wars-ron-paul",
      "kind": "concept",
      "promptEs": "fandom · Star Wars · Ron Paul",
      "answerEn": "The speaker claims to have outgrown obsessive science-fiction fandom, then immediately shows the same obsessive behavior toward politics.",
      "noteEn": "The named books are from the Star Wars expanded universe, while Firefly and Battlestar Galactica are other science-fiction series. Ron Paul's supporters were highly visible online during the 2008 U.S. presidential campaign. The title text completes the joke by mixing his currency views with Star Wars's New Republic and Corusca gems.",
      "tags": ["concept", "fandom", "politics", "science fiction", "xkcd"]
    }
  ],
