    {
      "id": "phrase-a-veces",
      "kind": "phrase",
      "promptEs": "a veces",
      "questionEn": "How do you say “sometimes” in Spanish?",
      "answerEn": "Use a veces.",
      "noteEn": "This common time expression describes something that happens on some occasions but not always. It normally sits before or after the verb without changing form.",
      "example": {
        "es": "A veces cocino en casa.",
        "en": "Sometimes I cook at home."
      },
      "tags": ["A1", "expression", "frequency"]
    },
    {
      "id": "grammar-personal-a",
      "kind": "grammar",
      "promptEs": "a + persona específica",
      "questionEn": "Why does Spanish sometimes put a before the person affected by an action?",
      "answerEn": "Put a before a specific person who directly receives a verb's action.",
      "noteEn": "This a is called the personal a. English usually has no separate word for it. Before the masculine article el, a + el contracts to al.",
      "example": {
        "es": "Conozco a Marta.",
        "en": "I know Marta."
      },
      "tags": ["A2", "grammar", "personal a"]
    },
    {
      "id": "grammar-explicit-subject-pronoun",
      "kind": "grammar",
      "promptEs": "verbo + pronombre de sujeto enfático",
      "questionEn": "Why might Spanish say tú or yo when the verb already tells you who acts?",
      "answerEn": "Say the subject pronoun to add emphasis, contrast, or clarity; otherwise Spanish often leaves it out.",
      "noteEn": "A verb form such as eres already points to “you.” Adding tú can stress that particular person, especially in a contrast or a surprised question. The pronoun may appear after the verb.",
      "example": {
        "es": "Yo no fui; fuiste tú.",
        "en": "I didn't go; you did."
      },
      "tags": ["A2", "grammar", "subject pronouns", "emphasis"]
    },
    {
      "id": "grammar-lo-que",
      "kind": "grammar",
      "promptEs": "lo que",
      "questionEn": "How do you say “what” or “the thing that” without naming a specific object?",
      "answerEn": "Use lo que to refer to an idea, action, situation, or unnamed thing.",
      "noteEn": "Here lo is neutral: it does not stand for a masculine noun. Que introduces the information that identifies the idea or thing. Together they work as one unit.",
      "example": {
        "es": "No entiendo lo que dices.",
        "en": "I don't understand what you're saying."
      },
      "tags": ["A2", "grammar", "neutral lo", "relative expression"]
    },
    {
      "id": "phrase-al-respecto",
      "kind": "phrase",
      "promptEs": "al respecto",
      "questionEn": "How do you refer back to a topic as “about it” or “on that matter”?",
      "answerEn": "Use al respecto.",
      "noteEn": "This expression points back to a matter already being discussed. Al is part of the fixed expression and does not need to name a masculine noun after it.",
      "example": {
        "es": "No tengo más preguntas al respecto.",
        "en": "I have no more questions about it."
      },
      "tags": ["B1", "expression", "reference"]
    },
