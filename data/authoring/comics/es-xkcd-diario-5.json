    {
      "id": "phrase-llamar-a-la-puerta",
      "kind": "phrase",
      "promptEs": "llamar a la puerta",
      "questionEn": "How do you say that someone knocks on a door?",
      "answerEn": "Use the matching form of llamar followed by a la puerta.",
      "noteEn": "Llamar usually means “to call,” but llamar a la puerta is the conventional expression for knocking on a door. Only llamar changes for the person and time; a la puerta stays unchanged unless a different door is named.",
      "example": {
        "es": "Marta llamó a la puerta.",
        "en": "Marta knocked on the door."
      },
      "tags": ["phrase", "door", "fixed expression", "A2"]
    },
    {
      "id": "phrase-haber-tiempo-para-infinitive",
      "kind": "phrase",
      "promptEs": "hay tiempo para + verbo en forma de diccionario",
      "questionEn": "How do you say that there is time available to do something?",
      "answerEn": "Use hay tiempo para, then put the action verb in its unchanged dictionary form.",
      "noteEn": "Hay says that something exists and does not change for one thing or several. Tiempo names the available time, and para introduces its use. The following action stays in its dictionary form, the unchanged form ending in -ar, -er, or -ir. Other times can use había tiempo or habrá tiempo.",
      "example": {
        "es": "Hay tiempo para descansar.",
        "en": "There is time to rest."
      },
      "tags": ["phrase", "time", "infinitive", "A2"]
    }
  ],
