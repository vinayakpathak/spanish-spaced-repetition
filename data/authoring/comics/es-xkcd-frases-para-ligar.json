  "titleText": {
    "es": "Esa camiseta te sienta bien, pero estaría aún mejor metida en el cuello de una botella de vodka y lanzada en llamas por la ventana de nuestro de edificio de oficinas. Hagámoslo de una puta vez y no miremos atrás.",
    "en": "That shirt looks good on you, but it would look even better stuffed into the neck of a vodka bottle and thrown flaming through the window of our office building. Let's fucking do it once and for all and not look back.",
    "noteEn": "The Spanish source contains the wording “nuestro de edificio”; it is preserved exactly above rather than silently corrected."
  },
  "cardDefinitions": [
    {
      "id": "word-pudiera--hypothetical",
      "kind": "word",
      "promptEs": "pudiera",
      "answerEn": "I could; if I were able to",
      "noteEn": "Pudiera is a hypothetical form of poder, “to be able to.” After si, it presents the ability as imagined rather than real.",
      "example": { "es": "Si pudiera elegir, viajaría en tren.", "en": "If I could choose, I would travel by train." },
      "tags": ["word", "poder", "hypothetical", "B1"]
    },
    { "id": "word-reordenar", "kind": "word", "promptEs": "reordenar", "answerEn": "to rearrange; to put in a new order", "noteEn": "", "tags": ["word", "ordering", "infinitive"] },
