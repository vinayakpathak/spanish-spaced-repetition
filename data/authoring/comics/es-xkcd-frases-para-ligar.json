    {
      "id": "word-gritando",
      "kind": "word",
      "promptEs": "gritando",
      "answerEn": "screaming; shouting",
      "noteEn": "Gritando is the ongoing-action form of gritar. When it appears on its own after another action, it can add how that action was happening.",
      "example": { "es": "Entró gritando.", "en": "He came in screaming." },
      "tags": ["word", "gritar", "ongoing action"]
    },
    {
      "id": "phrase-junto-a",
      "kind": "phrase",
      "promptEs": "junto a",
      "questionEn": "How do you say that one person or thing is next to another?",
      "answerEn": "Use junto a before the person or thing that is beside it.",
      "noteEn": "Junto a is a fixed location expression meaning “next to” or “beside,” so junto stays unchanged inside it: la farmacia está junto a la estación. The adjective junto, junta, juntos, or juntas is a different construction, as in Ana y Marta están juntas.",
      "example": { "es": "La farmacia está junto a la estación.", "en": "The pharmacy is next to the station." },
      "tags": ["phrase", "location", "A1"]
    },
    {
      "id": "grammar-adjective-gender-agreement",
      "kind": "grammar",
      "promptEs": "adjetivo que concuerda con masculino o femenino",
      "questionEn": "How does a Spanish describing word change for a man, woman, or gendered noun?",
      "answerEn": "Make the describing word match the gender and number of the person or thing it describes.",
      "noteEn": "Many describing words ending in -o change to -a for a feminine singular person or noun: cansado becomes cansada. Plurals normally add -s. Some describing words have one form for both genders.",
      "example": { "es": "Pedro está cansado y Ana está cansada.", "en": "Pedro is tired and Ana is tired." },
      "tags": ["grammar", "agreement", "gender", "A1"]
    },
    {
      "id": "phrase-correr-por-la-mente",
      "kind": "phrase",
      "promptEs": "correr/pasar por la mente de alguien",
      "questionEn": "How do you say that a thought goes through someone's mind?",
      "answerEn": "Use a form of correr or pasar, then por, then the person's mente.",
      "noteEn": "The expression treats a thought as moving through the mind. A possessive can identify the person: por mi mente, por tu mente, or por su mente.",
      "example": { "es": "La idea pasó por mi mente.", "en": "The idea crossed my mind." },
      "tags": ["phrase", "thought", "metaphor", "A2"]
    },
    {
      "id": "concept-alphabet-pickup-line-twist",
      "kind": "concept",
      "promptEs": "reordenar el alfabeto · junto a tu hermana",
      "answerEn": "a twist on the familiar alphabet pickup line about putting “U and I” together",
      "noteEn": "The stock English line uses the letter names U and I as the words “you” and “I.” This joke breaks the expected romantic ending by choosing the listener's sister instead.",
      "tags": ["concept", "wordplay", "pickup line", "English reference"]
    }
  ],
