    {
      "id": "word-pondria--conditional-place",
      "kind": "word",
      "promptEs": "pondría",
      "answerEn": "I would put; I would place",
      "noteEn": "Pondría is the conditional form of poner for the speaker. The ending -ía supplies the “would” meaning, while pondr- is the irregular conditional stem.",
      "example": { "es": "Yo pondría la mesa junto a la ventana.", "en": "I would put the table next to the window." },
      "tags": ["word", "poner", "conditional", "A2"]
    },
    { "id": "word-junto--junto-a", "kind": "word", "promptEs": "junto", "answerEn": "next to; beside (as part of junto a)", "noteEn": "", "tags": ["word", "location", "fixed expression"] },
    { "id": "word-a--junto-a", "kind": "word", "promptEs": "a", "answerEn": "no separate English word; completes junto a, “next to”", "noteEn": "", "tags": ["word", "preposition", "fixed expression"] },
    { "id": "word-hermana", "kind": "word", "promptEs": "hermana", "answerEn": "sister", "noteEn": "", "tags": ["word", "family", "feminine"] },
    { "id": "word-padre", "kind": "word", "promptEs": "padre", "answerEn": "father", "noteEn": "", "tags": ["word", "family"] },
    { "id": "word-ladron", "kind": "word", "promptEs": "ladrón", "answerEn": "thief; robber", "noteEn": "", "tags": ["word", "person"] },
    {
      "id": "word-aparcado",
      "kind": "word",
      "promptEs": "aparcado",
      "answerEn": "parked",
      "noteEn": "Aparcado is the completed-action form of aparcar, “to park.” It follows a form of haber in a completed-action construction.",
      "example": { "es": "He aparcado cerca de la estación.", "en": "I have parked near the station." },
      "tags": ["word", "driving", "completed action", "Spain"]
    },
    { "id": "word-volkswagen--brand", "kind": "word", "promptEs": "volkswagen", "answerEn": "Volkswagen (a car brand)", "noteEn": "", "tags": ["word", "proper name", "car"] },
    {
      "id": "word-debes--inference",
      "kind": "word",
      "promptEs": "debes",
      "answerEn": "you must; you are probably",
      "noteEn": "Debes is a form of deber for informal singular “you.” In deber de followed by an action verb, it expresses an inference about what is probably true rather than a duty.",
      "example": { "es": "Debes de estar ocupado.", "en": "You must be busy." },
      "tags": ["word", "deber", "inference", "informal singular"]
    },
    {
      "id": "word-estar--state-infinitive",
      "kind": "word",
      "promptEs": "estar",
      "answerEn": "to be (in a state or condition)",
      "noteEn": "Estar is the unchanged dictionary form used for states, conditions, and locations. After another conjugated verb, estar itself remains unchanged.",
      "example": { "es": "Quiero estar tranquilo.", "en": "I want to be calm." },
      "tags": ["word", "estar", "state", "infinitive"]
    },
    { "id": "word-cansada", "kind": "word", "promptEs": "cansada", "answerEn": "tired (feminine singular)", "noteEn": "", "tags": ["word", "description", "feminine"] },
    {
      "id": "word-corriendo",
      "kind": "word",
      "promptEs": "corriendo",
      "answerEn": "running",
      "noteEn": "Corriendo is the ongoing-action form of correr. It ends in -iendo and stays unchanged after estado.",
      "example": { "es": "Han estado corriendo por el parque.", "en": "They have been running through the park." },
      "tags": ["word", "correr", "ongoing action"]
    },
    { "id": "word-por--through-mind", "kind": "word", "promptEs": "por", "answerEn": "through; around (in correr por la mente)", "noteEn": "", "tags": ["word", "preposition", "fixed expression"] },
    { "id": "word-mente", "kind": "word", "promptEs": "mente", "answerEn": "mind", "noteEn": "", "tags": ["word", "thought"] },
