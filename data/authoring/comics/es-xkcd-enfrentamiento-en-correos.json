      "id": "word-por--fixed-por-si-acaso",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "no separate English word; begins por si acaso, ‘just in case’",
      "noteEn": "Por is fixed inside the three-word precaution expression por si acaso.",
      "example": { "es": "Lleva agua por si acaso.", "en": "Take water just in case." },
      "tags": ["word", "fixed expression", "precaution", "A2"]
    },
    {
      "id": "word-si--fixed-por-si-acaso",
      "kind": "word",
      "promptEs": "si",
      "answerEn": "no separate English word; middle of por si acaso, ‘just in case’",
      "noteEn": "Si remains unaccented inside por si acaso. The whole expression introduces a precaution for an uncertain possibility.",
      "example": { "es": "Trae una chaqueta por si acaso.", "en": "Bring a jacket just in case." },
      "tags": ["word", "fixed expression", "precaution", "A2"]
    },
    {
      "id": "word-acaso--fixed-por-si-acaso",
      "kind": "word",
      "promptEs": "acaso",
      "answerEn": "no separate English word; completes por si acaso, ‘just in case’",
      "noteEn": "Acaso completes the fixed precaution expression. This is different from acaso used by itself to add doubt to a question.",
      "example": { "es": "Guarda una copia por si acaso.", "en": "Keep a copy just in case." },
      "tags": ["word", "fixed expression", "precaution", "A2"]
    },
    {
      "id": "grammar-pasar-tiempo-gerund",
      "kind": "grammar",
      "promptEs": "pasar + cantidad de tiempo + verbo en -ando/-iendo",
      "questionEn": "How do you say that someone spends a period of time doing an activity?",
      "answerEn": "Use a form of pasar, name the amount of time, and add the activity verb ending in -ando or -iendo.",
      "noteEn": "Pasar changes to match who spends the time: paso, pasas, pasa, and so on. The activity uses the ongoing-action form: estudiar becomes estudiando and leer becomes leyendo.",
      "example": { "es": "Pasamos la tarde cocinando.", "en": "We spend the afternoon cooking." },
      "tags": ["grammar", "time", "-ando/-iendo", "A2"]
    },
    {
      "id": "phrase-y-si",
      "kind": "phrase",
      "promptEs": "¿y si + posibilidad?",
      "questionEn": "How do you ask someone to consider “what if” a possibility happens?",
      "answerEn": "Begin with ¿y si...? and state the possibility with an ordinary verb form.",
      "noteEn": "The opening y does not merely mean ‘and’ here. Together with unaccented si, it presents a possible situation for consideration. It can introduce a suggestion or a worry.",
      "example": { "es": "¿Y si tomamos el tren?", "en": "What if we take the train?" },
      "tags": ["phrase", "possibility", "question", "A2"]
    },
    {
      "id": "grammar-mejor-present-decision",
      "kind": "grammar",
      "promptEs": "mejor + verbo en presente",
      "questionEn": "How can you say that you had better choose a particular action?",
      "answerEn": "Put mejor before a present-time verb that states the wiser action.",
      "noteEn": "Spanish can omit a phrase such as será and begin directly with mejor. The subject is often clear from the verb: mejor llamo is ‘I'd better call,’ while mejor llamamos is ‘we'd better call.’",
      "example": { "es": "Mejor esperamos aquí.", "en": "We'd better wait here." },
      "tags": ["grammar", "decision", "advice", "present", "A2"]
    },
    {
      "id": "phrase-por-si-acaso",
      "kind": "phrase",
      "promptEs": "por si acaso",
      "questionEn": "How do you say that you take a precaution “just in case”?",
      "answerEn": "Use por si acaso after the precaution.",
      "noteEn": "Por si acaso is a fixed expression for preparing for something uncertain. A shorter por si + clause can name the possibility directly, as in por si llueve, ‘in case it rains.’",
      "example": { "es": "Traigo dinero por si acaso.", "en": "I'm bringing money just in case." },
      "tags": ["phrase", "precaution", "uncertainty", "A2"]
    },
    {
