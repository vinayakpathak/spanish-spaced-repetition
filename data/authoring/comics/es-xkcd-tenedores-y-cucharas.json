    {
      "id": "phrase-cruzar-algo-con-algo",
      "kind": "phrase",
      "promptEs": "cruzar algo con otra cosa",
      "questionEn": "How do you say that one plant, animal, or type is crossed with another?",
      "answerEn": "Use a form of cruzar, name the first item, then use con before the other item.",
      "noteEn": "Cruzar often means to cross a place. In breeding, it means to combine two varieties. Cruzar changes for the person and time, while con stays unchanged. When describing the result, the first item can come before a completed-action form, as in una planta cruzada con otra.",
      "example": {
        "es": "El agricultor cruzó una rosa blanca con una roja.",
        "en": "The farmer crossed a white rose with a red one."
      },
      "tags": ["phrase", "crossbreeding", "science", "B1"]
    },
    {
      "id": "phrase-con-éxito",
      "kind": "phrase",
      "promptEs": "con éxito",
      "questionEn": "How do you say that something happens successfully?",
      "answerEn": "Use con éxito after the action.",
      "noteEn": "Éxito means success. Together with con, the fixed phrase describes a successful outcome, much like the English word “successfully.” It does not change for person or time.",
      "example": {
        "es": "Terminamos la prueba con éxito.",
        "en": "We completed the test successfully."
      },
      "tags": ["phrase", "success", "outcome", "A2"]
    },
    {
      "id": "phrase-correspondiente-a",
      "kind": "phrase",
      "promptEs": "correspondiente a",
      "questionEn": "How do you say that something corresponds to or matches a particular item or value?",
      "answerEn": "Use correspondiente, or correspondientes for more than one thing, followed by a.",
      "noteEn": "Correspondiente changes only for number: correspondiente is singular and correspondientes is plural. The small linking word a stays before the item, category, or value that provides the match.",
      "example": {
        "es": "Busca el número correspondiente a tu mesa.",
        "en": "Find the number corresponding to your table."
      },
      "tags": ["phrase", "matching", "linking word", "B1"]
    },
    {
      "id": "grammar-cualquier-sustantivo-singular",
      "kind": "grammar",
      "promptEs": "cualquier + sustantivo singular",
      "questionEn": "How do you say “any” before one singular thing?",
      "answerEn": "Put cualquier before a singular noun: cualquier libro, cualquier opción.",
      "noteEn": "A noun is a naming word such as libro or opción. Before a noun, cualquiera shortens to cualquier. The noun stays singular even when the meaning is any one out of many. The plus sign in the Spanish prompt means “followed by.”",
      "example": {
        "es": "Puedes elegir cualquier asiento.",
        "en": "You can choose any seat."
      },
      "tags": ["grammar", "indefinite choice", "singular", "A2"]
    },
    {
      "id": "phrase-jugar-con-algo--toy-with",
      "kind": "phrase",
      "promptEs": "jugar con algo (arriesgarse)",
      "questionEn": "How do you warn that someone is toying with or taking risks with something serious?",
      "answerEn": "Use a form of jugar followed by con and the risky thing.",
      "noteEn": "Jugar con literally means to play with. With danger, feelings, power, or another serious matter, it means to toy with it, handle it carelessly, or take a risk. Jugar changes for the person and time; con stays unchanged.",
      "example": {
        "es": "La empresa juega con fuego.",
        "en": "The company is playing with fire."
      },
      "tags": ["phrase", "figurative", "risk", "warning", "B1"]
    },
    {
      "id": "concept-binary-fraction",
      "kind": "concept",
      "promptEs": "fracción binaria",
      "questionEn": "What is a binary fraction, and why do values such as 1/2 or 3/4 fit?",
      "answerEn": "A binary fraction has a denominator that is a power of two, such as 2, 4, 8, or 16.",
      "noteEn": "The denominator is the bottom number in a fraction. Powers of two are made by repeatedly multiplying by two: 2, 4, 8, 16, and so on. That makes 1/2, 1/4, 3/4, and 7/8 binary fractions, while 1/3 is not.",
      "example": {
        "es": "La fracción tres octavos es binaria.",
        "en": "The fraction three eighths is binary."
      },
      "tags": ["concept", "mathematics", "binary", "fractions"]
    }
  ],
