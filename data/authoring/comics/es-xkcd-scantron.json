  "titleText": {
    "es": "Además, con todas las advertencias sobre rellenar completamente los círculos, me pasé como 30 segundos con cada uno.",
    "en": "Also, after all the warnings about filling in the bubbles completely, I spent like 30 seconds on each one.",
    "noteEn": "The Spanish archive closely translates the official title text and preserves the numeral 30."
  },
  "cardDefinitions": [
    {
      "id": "word-entregado--submitted",
      "kind": "word",
      "promptEs": "entregado",
      "answerEn": "submitted; handed in",
      "noteEn": "Entregado is the completed-action form of entregar. After a form of haber, it stays unchanged and can say that work, forms, or documents have been submitted.",
      "example": { "es": "He entregado el informe.", "en": "I have submitted the report." },
      "tags": ["word", "entregar", "completed-action form", "school", "A2"]
    },
    {
      "id": "word-puntúen--grade-purpose",
      "kind": "word",
      "promptEs": "puntúen",
      "answerEn": "they grade; they score, as a desired result",
      "noteEn": "Puntúen is a special form of puntuar used after para que because the grading is the intended next action, not a fact already being reported. The plural ending leaves the graders unnamed.",
      "example": { "es": "Envío las pruebas para que las puntúen.", "en": "I send the tests so that they can be graded." },
      "tags": ["word", "puntuar", "purpose", "subjunctive", "A2"]
    },
    {
      "id": "word-usé",
      "kind": "word",
      "promptEs": "usé",
      "answerEn": "I used",
      "noteEn": "Usé is the completed-past form of usar for the speaker. The written accent distinguishes this past form from the special present form use.",
      "example": { "es": "Usé un bolígrafo azul.", "en": "I used a blue pen." },
      "tags": ["word", "usar", "completed past", "first person", "A1"]
    },
    {
      "id": "word-lápiz",
      "kind": "word",
      "promptEs": "lápiz",
      "answerEn": "pencil",
      "noteEn": "Lápiz is singular. Its plural is lápices, with c instead of z.",
      "example": { "es": "Necesito un lápiz para el examen.", "en": "I need a pencil for the exam." },
      "tags": ["word", "school", "noun", "A1"]
    },
    {
      "id": "word-en--fixed-en-vez-de",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "no separate English word; begins en vez de, ‘instead of’",
      "noteEn": "En belongs to the fixed three-word connector en vez de. Learn the connector as a unit rather than translating en as ordinary ‘in.’",
      "example": { "es": "Tomé té en vez de café.", "en": "I had tea instead of coffee." },
      "tags": ["word", "fixed expression", "substitution", "A2"]
    },
    {
      "id": "word-vez--fixed-en-vez-de",
      "kind": "word",
      "promptEs": "vez",
      "answerEn": "no separate English word; forms en vez de, ‘instead of’",
      "noteEn": "Vez often means an occurrence or time, but inside en vez de it helps form the fixed connector ‘instead of.’",
      "example": { "es": "Fuimos andando en vez de tomar el autobús.", "en": "We walked instead of taking the bus." },
      "tags": ["word", "fixed expression", "substitution", "A2"]
    },
    {
      "id": "word-de--fixed-en-vez-de",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; completes en vez de, ‘instead of’",
      "noteEn": "De finishes the connector en vez de and comes directly before the alternative that is not chosen.",
      "example": { "es": "Escribió un correo en vez de llamar.", "en": "She wrote an email instead of calling." },
      "tags": ["word", "fixed expression", "substitution", "A2"]
    },
    {
      "id": "word-afecta--make-difference",
      "kind": "word",
      "promptEs": "afecta",
      "answerEn": "does it affect; does it make a difference",
      "noteEn": "Afecta is a present form of afectar. In a question, it asks whether something changes the result or matters in some way. English adds ‘does’ before the subject, while the Spanish verb form stays afecta.",
      "example": { "es": "¿Afecta eso al resultado?", "en": "Does that affect the result?" },
      "tags": ["word", "afectar", "effect", "question", "A2"]
    },
    {
      "id": "word-en--extent",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "in; in any way, as part of en algo",
      "noteEn": "After a verb about changing or affecting something, en algo can ask whether there is any effect or difference at all.",
      "example": { "es": "¿Cambió el plan en algo?", "en": "Did the plan change in any way?" },
      "tags": ["word", "preposition", "extent", "A2"]
    },
    {
      "id": "word-algo--anything-question",
      "kind": "word",
      "promptEs": "algo",
      "answerEn": "anything; any way (in a question)",
      "noteEn": "Algo refers to an unspecified thing. In a question, natural English often uses ‘anything’; after en, en algo can mean ‘in any way.’",
      "example": { "es": "¿Necesitas algo?", "en": "Do you need anything?" },
      "tags": ["word", "indefinite", "question", "A1"]
    },
    {
      "id": "word-qué--echo-question",
      "kind": "word",
      "promptEs": "qué",
      "answerEn": "what? (echoing something surprising)",
      "noteEn": "Qué keeps its written accent in a short echo question. The speaker repeats only the missing or unbelievable information instead of forming a longer question.",
      "example": { "es": "—Me voy mañana. —¿Qué?", "en": "‘I'm leaving tomorrow.’ ‘What?’" },
      "tags": ["word", "question", "reaction", "accent", "A1"]
    },
    {
      "id": "word-aaaah--scream",
      "kind": "word",
      "promptEs": "aaaah",
      "answerEn": "aaah! (a scream)",
      "noteEn": "Aaaah stretches the vowel to write a scream or cry of alarm. The number of repeated letters varies with the imagined length of the sound.",
      "example": { "es": "¡Aaaah! ¡Una araña!", "en": "Aaah! A spider!" },
      "tags": ["word", "sound effect", "scream", "interjection"]
    },
    {
      "id": "word-bam--impact-sound",
      "kind": "word",
      "promptEs": "bam",
      "answerEn": "bam! (a sudden impact sound)",
      "noteEn": "Bam represents a loud, abrupt blow, collision, or impact in comics.",
      "example": { "es": "La puerta se cerró: ¡bam!", "en": "The door slammed shut: bam!" },
      "tags": ["word", "sound effect", "impact", "onomatopoeia"]
    },
    {
      "id": "phrase-en-vez-de",
      "kind": "phrase",
      "promptEs": "en vez de + alternativa",
      "questionEn": "How do you say that one option replaces another?",
      "answerEn": "Put en vez de before the alternative that was not chosen: ‘instead of.’",
      "noteEn": "A noun, pronoun, or unchanged action verb can follow: en vez de café, en vez de eso, en vez de llamar. The three words en vez de stay together.",
      "example": { "es": "Usamos el tren en vez del coche.", "en": "We used the train instead of the car." },
      "tags": ["phrase", "substitution", "choice", "A2"]
    },
    {
      "id": "concept-scantron-number-two-pencil",
      "kind": "concept",
      "promptEs": "hoja de respuestas óptica · lápiz n.º 2",
      "answerEn": "A Scantron-style test records answers in filled bubbles that an optical mark reader can score; instructions have traditionally specified a No. 2 pencil.",
      "noteEn": "Scantron still sells No. 2 pencils for optical-mark recognition, although current Scantron equipment can support pencil or ink depending on the form and scanner. The joke turns the minor choice of a No. 3 pencil into an absurdly violent grading disaster.",
      "tags": ["concept", "optical mark recognition", "testing", "Scantron", "joke"]
    }
  ],
