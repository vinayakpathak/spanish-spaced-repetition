    {
      "id": "phrase-en-linea",
      "kind": "phrase",
      "promptEs": "en línea",
      "questionEn": "How do you say that a service or activity is available online?",
      "answerEn": "Use en línea after the noun or verb it describes.",
      "noteEn": "En línea is the standard expression for being online or connected through a network. Línea stays singular and normally has no article in this expression.",
      "example": {
        "es": "La tienda está en línea.",
        "en": "The store is online."
      },
      "tags": ["phrase", "internet", "A1"]
    },
    {
      "id": "grammar-volver-a-alguien-adjetivo",
      "kind": "grammar",
      "promptEs": "volver + persona o cosa + estado",
      "questionEn": "How can volver say that something makes a person or thing become a certain way?",
      "answerEn": "Use a form of volver, the affected person or thing, and a word describing the resulting state.",
      "noteEn": "Here volver describes a caused change rather than a return. The affected person can be a short word such as me, te, lo, or la. A describing word such as loco or nerviosa changes to match that person or thing when gender or number is shown.",
      "example": {
        "es": "El ruido la vuelve nerviosa.",
        "en": "The noise makes her nervous."
      },
      "tags": ["grammar", "caused change", "description", "A2"]
    }
