  "titleText": {
    "es": "Puedes hacer esto 1 de cada 30 veces y seguir teniendo un 97% de votos positivos.",
    "en": "You can do this one in every 30 times and still have 97% positive feedback.",
    "noteEn": "The title jokes that a seller could absorb an occasional disastrous rating while keeping a high overall score."
  },
  "cardDefinitions": [
    {
      "id": "word-hacer--make-transform",
      "kind": "word",
      "promptEs": "hacer",
      "answerEn": "to make; to turn into a new result",
      "noteEn": "Hacer can describe causing a person or thing to become something new. The rest of the construction identifies what changes and the resulting role, state, or description.",
      "example": { "es": "La noticia hizo feliz a Marta.", "en": "The news made Marta happy." },
      "tags": ["word", "verb", "change", "B1"]
    },
    {
      "id": "word-del--hacer-de-result",
      "kind": "word",
      "promptEs": "del",
      "answerEn": "no separate English word; marks what is being changed after hacer",
      "noteEn": "Del combines de and el. In hacer de algo otra cosa, de introduces the thing that is made into a new role, state, or result.",
      "example": { "es": "Hicieron del garaje un taller.", "en": "They turned the garage into a workshop." },
      "tags": ["word", "hacer de", "transformation", "B1"]
    },
    {
      "id": "word-empezando--starting",
      "kind": "word",
      "promptEs": "empezando",
      "answerEn": "starting; beginning",
      "noteEn": "Empezando presents empezar as an action in progress. Before por, it can introduce the first item in a sequence.",
      "example": { "es": "Estoy empezando por la tarea corta.", "en": "I am starting with the short task." },
      "tags": ["word", "verb", "gerund", "A2"]
    },
    {
      "id": "word-por--after-empezar",
      "kind": "word",
      "promptEs": "por",
      "answerEn": "with; by (after empezar)",
      "noteEn": "After empezar or comenzar, por can introduce the first thing or action in an ordered process.",
      "example": { "es": "Comencemos por el principio.", "en": "Let's start with the beginning." },
      "tags": ["word", "preposition", "sequence", "A2"]
    },
    {
      "id": "word-votos--ratings",
      "kind": "word",
      "promptEs": "votos",
      "answerEn": "votes; ratings",
      "noteEn": "Online services may use votos for positive or negative ratings left by users, not only for votes in an election.",
      "example": { "es": "El producto recibió muchos votos positivos.", "en": "The product received many positive ratings." },
      "tags": ["word", "internet", "ratings", "plural"]
    },
    {
      "id": "word-comentarios--reviews",
      "kind": "word",
      "promptEs": "comentarios",
      "answerEn": "comments; reviews",
      "noteEn": "Comentarios can label written feedback that customers leave about a purchase or seller.",
      "example": { "es": "Leí los comentarios de los compradores.", "en": "I read the buyers' reviews." },
      "tags": ["word", "feedback", "internet", "plural"]
    },
    {
      "id": "word-en--fixed-en-lugar-de",
      "kind": "word",
      "promptEs": "en",
      "answerEn": "no separate English word; begins en lugar de, ‘instead of’",
      "noteEn": "Inside en lugar de, en is a fixed part of the expression rather than an independently translated location word.",
      "example": { "es": "Tomé té en lugar de café.", "en": "I had tea instead of coffee." },
      "tags": ["word", "fixed expression", "alternative", "A2"]
    },
    {
      "id": "word-lugar--fixed-en-lugar-de",
      "kind": "word",
      "promptEs": "lugar",
      "answerEn": "no separate English word; middle of en lugar de, ‘instead of’",
      "noteEn": "Lugar normally means ‘place,’ but inside en lugar de the three words form one expression that introduces an alternative.",
      "example": { "es": "Fuimos a pie en lugar de tomar el autobús.", "en": "We walked instead of taking the bus." },
      "tags": ["word", "fixed expression", "alternative", "A2"]
    },
    {
      "id": "word-de--fixed-en-lugar-de",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; completes en lugar de, ‘instead of’",
      "noteEn": "De completes en lugar de and connects it to the alternative thing or action that follows.",
      "example": { "es": "Usó agua en lugar de leche.", "en": "She used water instead of milk." },
      "tags": ["word", "fixed expression", "alternative", "A2"]
    },
    { "id": "word-silla", "kind": "word", "promptEs": "silla", "answerEn": "chair", "noteEn": "", "tags": ["word", "noun", "A1"] },
    { "id": "word-paquete--parcel", "kind": "word", "promptEs": "paquete", "answerEn": "package; parcel", "noteEn": "", "tags": ["word", "noun", "shipping", "A1"] },
    {
      "id": "word-contenía--contained",
      "kind": "word",
      "promptEs": "contenía",
      "answerEn": "contained; had inside",
      "noteEn": "Contenía is a past form of contener. It often describes what something held or had inside over a stretch of past time, rather than a single momentary action.",
      "example": { "es": "La caja contenía documentos antiguos.", "en": "The box contained old documents." },
      "tags": ["word", "verb", "past", "B1"]
    },
    { "id": "word-lince", "kind": "word", "promptEs": "lince", "answerEn": "lynx", "noteEn": "", "tags": ["word", "animal", "noun"] },
    {
      "id": "word-compraría",
      "kind": "word",
      "promptEs": "compraría",
      "answerEn": "I would buy",
      "noteEn": "Compraría keeps the dictionary form comprar and adds -ía. Without an explicit subject, the same form can also mean ‘he, she, or you would buy’; context identifies the person.",
      "example": { "es": "Yo compraría ese libro.", "en": "I would buy that book." },
      "tags": ["word", "verb", "conditional", "A2"]
    },
    {
      "id": "word-de--fixed-de-nuevo",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; begins de nuevo, ‘again’",
      "noteEn": "Inside de nuevo, de is a fixed part of the expression rather than the ordinary word ‘of’ or ‘from.’",
      "example": { "es": "Voy a intentarlo de nuevo.", "en": "I am going to try again." },
      "tags": ["word", "fixed expression", "repetition", "A1"]
    },
    {
      "id": "word-nuevo--fixed-de-nuevo",
      "kind": "word",
      "promptEs": "nuevo",
      "answerEn": "again; anew (as part of de nuevo)",
      "noteEn": "Nuevo normally means ‘new.’ In the fixed expression de nuevo, the pair means ‘again’ or ‘anew.’",
      "example": { "es": "Empezaron de nuevo.", "en": "They started again." },
      "tags": ["word", "fixed expression", "repetition", "A1"]
    },
    {
      "id": "grammar-hacer-de-algo-resultado",
      "kind": "grammar",
      "promptEs": "hacer de + cosa/persona + resultado",
      "questionEn": "How can you say that someone makes or turns a person or thing into a new result?",
      "answerEn": "Use hacer, then de before the thing being changed, and then name the resulting role, state, or description.",
      "noteEn": "When the thing begins with el, de + el contracts to del. Hacer changes for the person and time; the result can be a noun phrase or a description. This is a different use from ordinary hacer meaning simply ‘to do’ or ‘to make.’",
      "example": { "es": "La experiencia hizo de Ana una gran médica.", "en": "The experience made Ana a great doctor." },
      "tags": ["grammar", "hacer de", "transformation", "B1"]
    },
    {
      "id": "phrase-empezar-por",
      "kind": "phrase",
      "promptEs": "empezar/comenzar por + primera cosa o acción",
      "questionEn": "How do you identify the first item or action in a sequence?",
      "answerEn": "Use a form of empezar or comenzar, then por, then the first thing or action.",
      "noteEn": "The verb changes for the person and time. After por, use a noun or an unchanged action verb ending in -ar, -er, or -ir. This pattern means ‘start with’ or ‘start by.’",
      "example": { "es": "Empezaremos por revisar los datos.", "en": "We will start by reviewing the data." },
      "tags": ["phrase", "sequence", "empezar", "A2"]
    },
    {
      "id": "phrase-de-nuevo",
      "kind": "phrase",
      "promptEs": "de nuevo",
      "questionEn": "How do you say that an action happens again?",
      "answerEn": "Use de nuevo after the action.",
      "noteEn": "De nuevo is a common fixed expression meaning ‘again’ or ‘anew.’ Its meaning belongs to the pair, so do not translate de and nuevo separately in this use.",
      "example": { "es": "Lee la pregunta de nuevo.", "en": "Read the question again." },
      "tags": ["phrase", "repetition", "A1"]
    },
    {
      "id": "concept-ebay-feedback-ratings",
      "kind": "concept",
      "promptEs": "valoraciones de compradores en un mercado por internet",
      "answerEn": "Online marketplaces let buyers leave public ratings and written reviews about sellers and purchases.",
      "noteEn": "The joke treats an absurdly dangerous shipment as one occasional bad transaction. The unhappy buyer leaves a negative review, while the title points out that many positive ratings could still hide rare disasters.",
      "tags": ["concept", "online marketplace", "feedback", "joke"]
    }
  ],
