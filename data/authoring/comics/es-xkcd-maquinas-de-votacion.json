    {
      "id": "phrase-maquina-de-votacion",
      "kind": "phrase",
      "promptEs": "máquina de votación",
      "questionEn": "What is the usual Spanish name for a machine used in the voting process?",
      "answerEn": "Use máquina de votación; for more than one, use máquinas de votación.",
      "noteEn": "De links the machine to its function. Máquina changes to máquinas for the plural, while votación remains singular because it names the type of machine.",
      "example": { "es": "El colegio instaló dos máquinas de votación.", "en": "The school installed two voting machines." },
      "tags": ["phrase", "elections", "technology", "A2"]
    },
    {
      "id": "phrase-en-rigor",
      "kind": "phrase",
      "promptEs": "en rigor",
      "questionEn": "How do you introduce a strictly precise qualification?",
      "answerEn": "Use en rigor for ‘strictly speaking’ or ‘properly speaking.’",
      "noteEn": "En rigor is a fixed expression, not a word-for-word use of en and rigor. It often appears between commas before a correction or a more technically exact statement.",
      "example": { "es": "En rigor, aún no es oficial.", "en": "Strictly speaking, it is not official yet." },
      "tags": ["phrase", "precision", "discourse", "B1"]
    },
