  "cardDefinitions": [
    {
      "id": "word-entiendo",
      "kind": "word",
      "promptEs": "entiendo",
      "answerEn": "I understand",
      "noteEn": "",
      "tags": ["word", "understanding", "verb"]
    },
    {
      "id": "word-conoces--meet",
      "kind": "word",
      "promptEs": "conoces",
      "answerEn": "you meet; you get to know",
      "noteEn": "Conocer can mean to know or be familiar with a person, place, or thing. When it describes the start of that familiarity, it means to meet or get to know. Conoces is the informal singular “you” form.",
      "example": {
        "es": "Mañana conoces a la nueva directora.",
        "en": "Tomorrow you meet the new director."
      },
      "tags": ["word", "conocer", "meeting", "present tense"]
    },
    {
      "id": "word-adecuada",
      "kind": "word",
      "promptEs": "adecuada",
      "answerEn": "right; suitable; appropriate (feminine singular)",
      "noteEn": "Adecuada is the feminine singular form of adecuado. Its -a ending matches a feminine singular person or thing.",
      "example": {
        "es": "Es la herramienta adecuada.",
        "en": "It is the right tool."
      },
      "tags": ["word", "adjective", "suitability", "feminine"]
    },
    {
      "id": "word-sale--appears",
      "kind": "word",
      "promptEs": "sale",
      "answerEn": "comes out; appears",
      "noteEn": "Sale is a form of salir. Depending on the setting, salir can mean to leave, to come out, or to appear. Here it describes something suddenly appearing.",
      "example": {
        "es": "De pronto sale un actor al escenario.",
        "en": "Suddenly, an actor appears onstage."
      },
      "tags": ["word", "salir", "appearance", "present tense"]
    },
    {
      "id": "word-coro",
      "kind": "word",
      "promptEs": "coro",
      "answerEn": "choir; chorus",
      "noteEn": "",
      "tags": ["word", "music", "group"]
    },
    {
      "id": "word-ángeles",
      "kind": "word",
      "promptEs": "ángeles",
      "answerEn": "angels",
      "noteEn": "",
      "tags": ["word", "angels", "plural"]
    },
    {
      "id": "word-quiero--wedding-vow",
      "kind": "word",
      "promptEs": "quiero",
      "answerEn": "I do (in a wedding response)",
      "noteEn": "Quiero ordinarily means “I want.” In the conventional wedding response sí, quiero, it confirms that the speaker agrees to marry, so natural English uses “I do.”",
      "example": {
        "es": "En la ceremonia, Luis respondió: «Sí, quiero».",
        "en": "At the ceremony, Luis answered, “I do.”"
      },
      "tags": ["word", "querer", "wedding", "fixed response"]
    },
    {
      "id": "word-se--fixed-se-trata-de",
      "kind": "word",
      "promptEs": "se",
      "answerEn": "no separate English word; begins se trata de, “it is about”",
      "noteEn": "In the fixed expression se trata de, se helps make the statement impersonal: it describes the subject or point under discussion without naming a person who performs the action.",
      "example": {
        "es": "Se trata de elegir bien.",
        "en": "It is about choosing well."
      },
      "tags": ["word", "fixed expression", "impersonal se", "topic"]
    },
    {
      "id": "word-trata--fixed-se-trata-de",
      "kind": "word",
      "promptEs": "trata",
      "answerEn": "is about; concerns (as part of se trata de)",
      "noteEn": "Trata comes from tratar, but se trata de works as a fixed impersonal expression meaning that something concerns a topic or is about an action.",
      "example": {
        "es": "Se trata de una decisión importante.",
        "en": "It is about an important decision."
      },
      "tags": ["word", "tratar", "fixed expression", "topic"]
    },
    {
      "id": "word-de--fixed-se-trata-de",
      "kind": "word",
      "promptEs": "de",
      "answerEn": "no separate English word; completes se trata de, “it is about”",
      "noteEn": "The fixed expression requires de before the topic or action. English includes its meaning in “about” rather than translating de as a separate word.",
      "example": {
        "es": "Se trata de escuchar.",
        "en": "It is about listening."
      },
      "tags": ["word", "fixed expression", "preposition", "topic"]
    },
    {
      "id": "word-perder",
      "kind": "word",
      "promptEs": "perder",
      "answerEn": "to lose",
      "noteEn": "",
      "tags": ["word", "action", "infinitive"]
    },
    {
      "id": "word-a--fear-complement",
      "kind": "word",
      "promptEs": "a",
      "answerEn": "no separate English word; links miedo to what someone fears",
      "noteEn": "Spanish can use miedo a before a feared thing or before an action verb in its unchanged dictionary form. English usually expresses the same link with “of” or “to.”",
      "example": {
        "es": "Tengo miedo a fallar.",
        "en": "I am afraid of failing."
      },
      "tags": ["word", "preposition", "fear", "verb complement"]
    },
    {
      "id": "word-tienes",
      "kind": "word",
      "promptEs": "tienes",
      "answerEn": "you have",
      "noteEn": "",
      "tags": ["word", "tener", "present tense"]
    },
    {
      "id": "phrase-se-trata-de-infinitivo",
      "kind": "phrase",
      "promptEs": "se trata de + verbo en forma de diccionario",
      "questionEn": "How do you say that something is about doing an action?",
      "answerEn": "Use se trata de, then the action verb in its unchanged dictionary form.",
      "noteEn": "Se trata de is a fixed impersonal expression: it introduces the topic or central point without naming a person who does tratar. The action after de stays in its dictionary form, the form ending in -ar, -er, or -ir. The plus sign in the prompt means “followed by.”",
      "example": {
        "es": "Se trata de aprender juntos.",
        "en": "It is about learning together."
      },
      "tags": ["phrase", "fixed expression", "topic", "infinitive", "A2"]
    },
    {
      "id": "phrase-perder-el-miedo-a-infinitivo",
      "kind": "phrase",
      "promptEs": "perder el miedo a + verbo en forma de diccionario",
      "questionEn": "How do you say that someone stops being afraid to do something?",
      "answerEn": "Use a form of perder, then el miedo a, then the action verb in its unchanged dictionary form.",
      "noteEn": "Perder changes to show who stops being afraid and when; for example, perdió refers to a completed past event. El miedo a stays together, and the following action keeps its dictionary form ending in -ar, -er, or -ir. The plus sign in the prompt means “followed by.”",
      "example": {
        "es": "Lucía perdió el miedo a preguntar.",
        "en": "Lucía stopped being afraid to ask."
      },
      "tags": ["phrase", "collocation", "fear", "infinitive", "A2"]
    },
    {
      "id": "phrase-si-quiero--wedding-vow",
      "kind": "phrase",
      "promptEs": "sí, quiero",
      "questionEn": "What conventional Spanish response means “I do” in a wedding ceremony?",
      "answerEn": "Say sí, quiero.",
      "noteEn": "Sí means “yes” and carries an accent. Quiero usually means “I want,” but together these words are the conventional response that confirms consent to marry. English wedding wording uses “I do” rather than translating the two words separately.",
      "example": {
        "es": "La novia sonrió y dijo: «Sí, quiero».",
        "en": "The bride smiled and said, “I do.”"
      },
      "tags": ["phrase", "fixed response", "wedding", "culture", "A1"]
    }
  ],
