      "promptEs": "Kama Sutra",
      "answerEn": "a classical Sanskrit work widely known for its descriptions of sexual positions",
      "noteEn": "The work covers a broader range of ideas about desire, relationships, and social life, but popular culture most often associates its name with illustrated sexual positions.",
      "tags": ["concept", "literature", "cultural reference", "Kama Sutra"]
    }
