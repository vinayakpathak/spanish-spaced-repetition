      "kind": "word",
      "promptEs": "trimestre",
      "answerEn": "trimester; three-month period",
      "noteEn": "A trimestre is a period of three months. It is commonly used for stages of pregnancy and for divisions of an academic or financial year.",
      "example": { "es": "El curso dura un trimestre.", "en": "The course lasts one trimester." },
      "tags": ["word", "time period", "pregnancy", "A2"]
    },
    {
      "id": "word-bebé",
      "kind": "word",
      "promptEs": "bebé",
      "answerEn": "baby",
      "noteEn": "Bebé keeps its written accent on the final é. It can refer to a baby of any sex.",
      "example": { "es": "El bebé está dormido.", "en": "The baby is asleep." },
      "tags": ["word", "people", "family", "A1"]
    },
    {
      "id": "word-decidido--made-decision",
      "kind": "word",
      "promptEs": "decidido",
      "answerEn": "decided; made a decision",
      "noteEn": "Decidido is the completed-action form of decidir. After ha, it says that one person or thing has made a decision that matters now.",
      "example": { "es": "Marta ha decidido quedarse.", "en": "Marta has decided to stay." },
      "tags": ["word", "decidir", "past participle", "A2"]
    },
    {
      "id": "word-qué--which-before-noun",
      "kind": "word",
      "promptEs": "qué",
      "answerEn": "which; what (selecting before a noun)",
      "noteEn": "Qué goes directly before a noun when asking which member or type is meant. It keeps the written accent in a direct question and in an embedded question inside a larger statement.",
      "example": { "es": "No sé qué ruta elegir.", "en": "I do not know which route to choose." },
      "tags": ["word", "question word", "selection", "A1"]
    },
    {
      "id": "word-abertura--opening",
      "kind": "word",
      "promptEs": "abertura",
      "answerEn": "opening; aperture",
      "noteEn": "Abertura is a feminine noun for an open space or passage through something.",
      "example": { "es": "La luz entra por una abertura pequeña.", "en": "The light enters through a small opening." },
      "tags": ["word", "space", "feminine noun", "A2"]
    },
    {
      "id": "word-salir--come-out",
      "kind": "word",
      "promptEs": "salir",
      "answerEn": "to come out; to exit",
      "noteEn": "Salir describes movement from inside to outside. English may choose ‘come out’ or ‘go out’ depending on the viewpoint.",
      "example": { "es": "El tren va a salir del túnel.", "en": "The train is going to come out of the tunnel." },
      "tags": ["word", "movement", "infinitive", "A1"]
    },
    {
      "id": "word-esperemos--hope",
      "kind": "word",
      "promptEs": "esperemos",
      "answerEn": "let's hope; we hope",
      "noteEn": "Esperemos is a special nosotros form of esperar used to express a shared hope. A hoped-for event introduced by que follows in the subjunctive, the form used when that event is desired rather than stated as fact.",
      "example": { "es": "Esperemos que llegue pronto.", "en": "Let's hope she arrives soon." },
      "tags": ["word", "hope", "subjunctive", "A2"]
    },
    {
      "id": "word-inferiores--lower-ones",
      "kind": "word",
      "promptEs": "inferiores",
      "answerEn": "lower ones",
      "noteEn": "Inferiores normally describes plural things as lower. With an article and no repeated noun, los inferiores means the lower masculine or mixed-group ones; context supplies the omitted noun.",
      "example": { "es": "Los cajones superiores están llenos; usa los inferiores.", "en": "The upper drawers are full; use the lower ones." },
      "tags": ["word", "adjective as noun", "plural", "A2"]
    },
    {
      "id": "word-contra--opposing-force",
      "kind": "word",
      "promptEs": "contra",
      "answerEn": "against; in opposition to",
      "noteEn": "After a verb such as luchar, contra introduces the person, obstacle, or force being opposed.",
      "example": { "es": "Nadaron contra la corriente.", "en": "They swam against the current." },
      "tags": ["word", "preposition", "opposition", "A2"]
    },
    {
      "id": "word-sabías--did-you-know",
      "kind": "word",
      "promptEs": "sabías",
      "answerEn": "did you know; you knew (informal singular)",
      "noteEn": "Sabías is the imperfect past form of saber for tú. The imperfect presents knowledge as a state that existed at that past time; in ¿Sabías que...?, English commonly says ‘Did you know that...?’",
      "example": { "es": "¿Sabías que Ana vive aquí?", "en": "Did you know that Ana lives here?" },
      "tags": ["word", "saber", "past", "tú", "A2"]
    },
    {
      "id": "word-bata--lab-coat",
      "kind": "word",
      "promptEs": "bata",
      "answerEn": "lab coat",
      "noteEn": "A bata is a loose garment worn over other clothes. In a laboratory or medical setting, it refers to a lab coat; in other settings the same noun can mean a gown or robe.",
      "example": { "es": "La científica se puso una bata blanca.", "en": "The scientist put on a white lab coat." },
      "tags": ["word", "clothing", "laboratory", "A2"]
    },
    {
      "id": "phrase-luchar-contra",
      "kind": "phrase",
      "promptEs": "luchar contra + obstáculo, fuerza o adversario",
      "questionEn": "How do you say that someone fights or struggles against an obstacle, force, or opponent?",
      "answerEn": "Use a matching form of luchar, then contra, then name what is being opposed.",
      "noteEn": "Luchar changes for the person and time. Contra stays unchanged and introduces the opposing person, thing, condition, or force.",
      "example": { "es": "Luchamos contra el viento.", "en": "We struggle against the wind." },
      "tags": ["phrase", "verb complement", "opposition", "A2"]
    },
    {
      "id": "phrase-bata-de-laboratorio",
      "kind": "phrase",
      "promptEs": "bata de laboratorio",
      "questionEn": "What is the usual Spanish expression for a lab coat?",
      "answerEn": "Say bata de laboratorio.",
      "noteEn": "Bata names the loose protective garment, and de laboratorio identifies its laboratory use. Laboratorio stays singular in this expression.",
      "example": { "es": "Necesito una bata de laboratorio limpia.", "en": "I need a clean lab coat." },
      "tags": ["phrase", "clothing", "laboratory", "A2"]
    },
