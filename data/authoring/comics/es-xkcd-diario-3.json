    {
      "id": "word-patina--skate-command",
      "kind": "word",
      "promptEs": "patina",
      "answerEn": "skate (informal singular command)",
      "noteEn": "Patina tells one familiar person to skate. It is the positive tú command of patinar.",
      "example": { "es": "Patina con cuidado.", "en": "Skate carefully." },
      "tags": ["word", "command", "skating", "informal singular"]
    },
    {
      "id": "word-bruum--rumble",
      "kind": "word",
      "promptEs": "bruum",
      "answerEn": "rumble; vroom (sound effect)",
      "noteEn": "Bruum imitates a low, sustained rumbling or roaring sound. Its repeated vowel stretches the sound on the page.",
      "example": { "es": "El motor hizo «bruum».", "en": "The engine went “vroom.”" },
      "tags": ["word", "sound effect", "onomatopoeia"]
    },
    {
      "id": "word-neec--creak",
      "kind": "word",
      "promptEs": "neec",
      "answerEn": "creak (sound effect)",
      "noteEn": "Neec is a drawn-out comic sound for a heavy object or hinge creaking open.",
      "example": { "es": "La puerta hizo «neec».", "en": "The door creaked." },
      "tags": ["word", "sound effect", "onomatopoeia"]
    },
    {
      "id": "word-llevas--wear",
      "kind": "word",
      "promptEs": "llevas",
      "answerEn": "you are wearing; you have on",
      "noteEn": "Llevar often means “to carry,” but with clothes or an accessory it means to wear or have that item on. Llevas addresses one familiar person.",
      "example": { "es": "Llevas una chaqueta azul.", "en": "You are wearing a blue jacket." },
      "tags": ["word", "wearing", "verb", "informal singular"]
    },
    {
      "id": "word-sombrero",
      "kind": "word",
      "promptEs": "sombrero",
      "answerEn": "hat",
      "noteEn": "Sombrero is the general Spanish word for a hat with a brim; it does not name only the Mexican style called a sombrero in English.",
      "example": { "es": "Dejó el sombrero junto a la puerta.", "en": "He left the hat beside the door." },
      "tags": ["word", "clothing", "noun"]
    },
    {
      "id": "word-me--recipient-ponerlo-facil",
      "kind": "word",
      "promptEs": "me",
      "answerEn": "for me; marks the person something is made easy or difficult for",
      "noteEn": "With ponerlo fácil or ponerlo difícil, me identifies the speaker as the person who experiences the easier or harder situation.",
      "example": { "es": "No me lo ponen fácil.", "en": "They do not make it easy for me." },
      "tags": ["word", "pronoun", "affected person", "idiom"]
    },
    {
      "id": "word-lo--fixed-ponerlo-facil",
      "kind": "word",
      "promptEs": "lo",
      "answerEn": "no separate English word; completes ponerlo fácil",
      "noteEn": "In ponerlo fácil, lo stands for the situation being made easy. Natural English normally expresses this as “make it easy” without translating lo separately.",
      "example": { "es": "El profesor nos lo puso fácil.", "en": "The teacher made it easy for us." },
      "tags": ["word", "pronoun", "idiom", "poner"]
    },
    {
      "id": "word-puesto--made-easy",
      "kind": "word",
      "promptEs": "puesto",
      "answerEn": "made it easy (completed-action form in ponerlo fácil)",
      "noteEn": "Puesto is poner's irregular completed-action form. With a form of haber and ponerlo fácil or difícil, it describes how someone has made a situation.",
      "example": { "es": "Nos lo han puesto difícil.", "en": "They have made it difficult for us." },
      "tags": ["word", "verb", "participle", "idiom"]
    },
    {
      "id": "word-penetraste--entered",
      "kind": "word",
      "promptEs": "penetraste",
      "answerEn": "you penetrated; you got inside",
      "noteEn": "Penetraste is the completed past form of penetrar for one familiar person. Penetrar en can describe entering a physical place or reaching into someone's private thoughts and feelings.",
      "example": { "es": "Penetraste en la cueva.", "en": "You entered the cave." },
      "tags": ["word", "verb", "preterite", "informal singular"]
    },
    {
      "id": "word-suficiente",
      "kind": "word",
      "promptEs": "suficiente",
      "answerEn": "enough; sufficient",
      "noteEn": "Suficiente describes an adequate amount or degree. After neutral lo, lo suficiente means “enough” or “what is sufficient.”",
      "example": { "es": "Con eso es suficiente.", "en": "That is enough." },
      "tags": ["word", "amount", "adjective"]
    },
    {
      "id": "word-pretendías--intended",
      "kind": "word",
      "promptEs": "pretendías",
      "answerEn": "you intended; you meant to",
      "noteEn": "Pretender usually means to intend, aim, or claim—not the English verb “pretend.” Pretendías presents one familiar person's intention as background in the past.",
      "example": { "es": "¿Pretendías quedarte aquí?", "en": "Did you intend to stay here?" },
      "tags": ["word", "verb", "false friend", "imperfect"]
    },
    {
      "id": "word-permanecer",
      "kind": "word",
      "promptEs": "permanecer",
      "answerEn": "to remain; to stay",
      "noteEn": "Permanecer emphasizes continuing in the same place, condition, or state.",
      "example": { "es": "La puerta debe permanecer cerrada.", "en": "The door must remain closed." },
      "tags": ["word", "verb", "continuing state"]
    },
    {
      "id": "word-perdida--lost-state",
      "kind": "word",
      "promptEs": "perdida",
      "answerEn": "lost (feminine singular)",
      "noteEn": "Perdida describes a feminine person or thing that is lost. It can describe not knowing where one is or being unable to find one's way.",
      "example": { "es": "La excursionista seguía perdida.", "en": "The hiker was still lost." },
      "tags": ["word", "adjective", "feminine singular", "state"]
    },
    {
      "id": "word-para--fixed-para-siempre",
      "kind": "word",
      "promptEs": "para",
      "answerEn": "no separate English word; begins para siempre, “forever”",
      "noteEn": "Para and siempre form the fixed time expression para siempre. Here para does not introduce a purpose.",
      "example": { "es": "Quiero vivir aquí para siempre.", "en": "I want to live here forever." },
      "tags": ["word", "fixed expression", "time"]
    },
    {
      "id": "word-siempre--fixed-para-siempre",
      "kind": "word",
      "promptEs": "siempre",
      "answerEn": "ever; completes para siempre, “forever”",
      "noteEn": "Siempre alone commonly means “always.” After para, the complete expression para siempre means “forever.”",
      "example": { "es": "Guardará la carta para siempre.", "en": "She will keep the letter forever." },
      "tags": ["word", "fixed expression", "time"]
    },
    {
      "id": "word-cometiste",
      "kind": "word",
      "promptEs": "cometiste",
      "answerEn": "you made; you committed",
      "noteEn": "Cometiste is the completed past form of cometer for one familiar person. Spanish commonly uses cometer with an error, crime, or other wrongful act.",
      "example": { "es": "Cometiste un error pequeño.", "en": "You made a small mistake." },
      "tags": ["word", "verb", "preterite", "collocation"]
    },
    {
      "id": "word-error--mistake",
      "kind": "word",
      "promptEs": "error",
      "answerEn": "mistake; error",
      "noteEn": "Error can describe a mistaken action, judgment, or result. In computing it can also mean an error or bug, but this card teaches the ordinary mistake sense.",
      "example": { "es": "Fue un error sincero.", "en": "It was an honest mistake." },
      "tags": ["word", "mistake", "noun"]
    },
    {
      "id": "word-me--person-losing-thing",
      "kind": "word",
      "promptEs": "me",
      "answerEn": "from me; marks me as the person who loses the thing",
      "noteEn": "With quitar, me identifies the speaker as the person something is taken away from. Natural English often uses “from me” or a possessive such as “my.”",
      "example": { "es": "Me quitaron el teléfono.", "en": "They took my phone away." },
      "tags": ["word", "pronoun", "affected person", "quitar"]
    },
    {
      "id": "word-quitaste--took-away",
      "kind": "word",
      "promptEs": "quitaste",
      "answerEn": "you took away; you removed",
      "noteEn": "Quitaste is the completed past form of quitar for one familiar person. A short person word before it can identify who loses the thing.",
      "example": { "es": "Le quitaste la llave.", "en": "You took the key away from him." },
      "tags": ["word", "verb", "preterite", "quitar"]
    },
    {
      "id": "word-el--owned-item-after-person-pronoun",
      "kind": "word",
      "promptEs": "el",
      "answerEn": "my here; Spanish uses el because me already marks the affected owner",
      "noteEn": "Spanish often uses the definite article before an owned item when a short word such as me, te, or le already identifies the affected owner. English commonly uses a possessive instead.",
      "example": { "es": "Me rompieron el teléfono.", "en": "They broke my phone." },
      "tags": ["word", "article", "possession", "affected person"]
    },
    {
      "id": "phrase-ponerselo-facil-a-alguien",
      "kind": "phrase",
      "promptEs": "ponérselo fácil a alguien",
      "questionEn": "How do you say that someone makes a situation easy for another person?",
      "answerEn": "Use a short person word, lo, a form of poner, and fácil: me lo pones fácil, nos lo puso fácil, and so on.",
      "noteEn": "The short person word identifies who benefits: me, te, le, nos, os, or les. Lo stands for the situation, poner changes for person and time, and fácil describes the resulting difficulty. With haber, use the irregular completed-action form puesto.",
      "example": { "es": "Nos lo pusieron fácil.", "en": "They made it easy for us." },
      "tags": ["phrase", "poner", "pronouns", "difficulty", "A2"]
    },
    {
      "id": "grammar-permanecer-adjective-state",
      "kind": "grammar",
      "promptEs": "permanecer + descripción de estado",
      "questionEn": "How do you say that someone or something remains in the same state?",
      "answerEn": "Use permanecer followed by a describing word that matches the person or thing.",
      "noteEn": "Permanecer emphasizes that the state continues. The description changes when needed: permanecer cerrado, permanecer abierta, permanecer tranquilos.",
      "example": { "es": "Las ventanas permanecieron abiertas.", "en": "The windows remained open." },
      "tags": ["grammar", "permanecer", "state", "agreement", "A2"]
    },
    {
      "id": "phrase-para-siempre",
      "kind": "phrase",
      "promptEs": "para siempre",
      "questionEn": "How do you say that something continues forever?",
      "answerEn": "Use the fixed expression para siempre.",
      "noteEn": "The two words stay together for the time meaning “forever” or “for good.” It does not use para's ordinary purpose meaning.",
      "example": { "es": "No estaremos aquí para siempre.", "en": "We will not be here forever." },
      "tags": ["phrase", "time", "duration", "A1"]
    },
    {
      "id": "phrase-cometer-un-error",
      "kind": "phrase",
      "promptEs": "cometer un error",
      "questionEn": "What verb does Spanish commonly use for making a mistake?",
      "answerEn": "Use cometer un error.",
      "noteEn": "Spanish uses cometer with errors, mistakes, crimes, and similar wrongful acts. English says “make a mistake” but “commit an error,” so the most natural English verb depends on the noun.",
      "example": { "es": "Todos podemos cometer un error.", "en": "We can all make a mistake." },
      "tags": ["phrase", "collocation", "mistake", "A2"]
    }
  ],
