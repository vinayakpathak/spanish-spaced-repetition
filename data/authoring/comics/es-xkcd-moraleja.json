      "id": "word-ayudarme",
      "kind": "word",
      "promptEs": "ayudarme",
      "answerEn": "to help me",
      "noteEn": "Ayudarme combines ayudar, “to help,” with me, which identifies the speaker as the person receiving help. The short word attaches to the unchanged verb ending in -ar.",
      "example": { "es": "Gracias por ayudarme.", "en": "Thank you for helping me." },
      "tags": ["word", "help", "infinitive", "attached pronoun", "A2"]
