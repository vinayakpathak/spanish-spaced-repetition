  "titleText": {
    "es": "Dejando a un lado los cerebros, me pregunto cuántos scripts que parsean xkcd.com se romperán con este título (o con \\\\;;",
    "en": "Brains aside, I wonder how many poorly-written xkcd.com-parsing scripts will break on this title (or ;;\"''{<<[' this mouseover text.\"",
    "noteEn": "The Spanish title text is preserved exactly as the manifest stores it, including its two literal backslashes and abrupt ending after semicolons. The translation page's raw title attribute is malformed and truncates the continuation; this artifact documents the defect without repairing the source manifest. The English field preserves the complete official title text, including its deliberately troublesome punctuation and markup-like characters. The raster's giant opening parenthesis is a separate printed symbol exclusion, while OCR's LIN is corrected and split into that symbol plus the Spanish word UN."
  },
  "cardDefinitions": [
    {
      "id": "word-tensión",
      "kind": "word",
      "promptEs": "tensión",
      "answerEn": "tension; strain",
      "noteEn": "Tensión can be physical tightness, emotional suspense, or mental strain that has not been settled. Its final syllable is stressed, so it carries a written accent.",
      "example": {
        "es": "La espera creó mucha tensión.",
        "en": "The wait created a lot of tension."
      },
      "tags": [
        "word",
        "emotion",
        "noun",
        "A2"
      ]
    },
    {
      "id": "word-resuelta",
      "kind": "word",
      "promptEs": "resuelta",
      "answerEn": "resolved; settled (feminine singular)",
      "noteEn": "Resuelta is the irregular completed-action form of resolver used here as a description. It changes to match the noun: resuelto, resuelta, resueltos, or resueltas.",
      "example": {
        "es": "La duda quedó resuelta.",
        "en": "The doubt was resolved."
      },
      "tags": [
        "word",
        "resolver",
        "participle",
        "adjective",
        "agreement",
        "A2"
      ]
    },
    {
      "id": "concept-unmatched-opening-parenthesis-tension",
      "kind": "concept",
      "promptEs": "( · paréntesis sin cerrar · tensión no resuelta",
      "questionEn": "How do the title, the first symbol, and the sentence create the same unresolved feeling?",
      "answerEn": "The comic opens a parenthesis but never prints its matching closing mark, so the reader visually experiences the tension that the text leaves open.",
      "noteEn": "An opening parenthesis conventionally promises a later closing parenthesis. Here the title is itself “(”, the raster begins with another large opening mark, and neither is balanced. The form of the comic therefore performs its claim rather than merely mentioning it.",
      "example": {
        "es": "En «Ana (mi vecina llegó», falta cerrar el paréntesis.",
        "en": "In “Ana (my neighbor arrived,” the parenthesis still needs to be closed."
      },
      "tags": [
        "concept",
        "punctuation",
        "parenthesis",
        "typography",
        "joke"
      ]
    }
  ],
